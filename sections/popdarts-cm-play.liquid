{%- liquid
  assign st = section.settings
  assign poster_1 = ''
  if st.video_1_poster != blank
    assign poster_1 = st.video_1_poster | image_url: width: 720
  elsif st.video_1_poster_asset != blank
    assign poster_1 = st.video_1_poster_asset | asset_url
  endif
  assign poster_2 = ''
  if st.video_2_poster != blank
    assign poster_2 = st.video_2_poster | image_url: width: 720
  elsif st.video_2_poster_asset != blank
    assign poster_2 = st.video_2_poster_asset | asset_url
  endif
  assign clip_1 = 'cm-clip-' | append: section.id | append: '-1'
  assign clip_2 = 'cm-clip-' | append: section.id | append: '-2'
-%}
{% render 'popdarts-cm-assets' %}
<section class="pdcm pdcm-play" id="cm-play" aria-labelledby="cm-play-title-{{ section.id }}">
  <div class="pdcm-wrap pdcm-play__grid">
    <div class="pdcm-play__head">
      <p class="pdcm-eyebrow">{{ st.eyebrow }}</p>
      <h2 class="pdcm-h2" id="cm-play-title-{{ section.id }}">{{ st.heading | escape | replace: '. ', '.<br>' }}</h2>
      <p class="pdcm-lead">{{ st.sub }}</p>
    </div>

    {%- if st.video_1_url != blank or st.video_2_url != blank -%}
      <div class="pdcm-play__media{% if st.video_1_url == blank or st.video_2_url == blank %} is-single{% endif %}">
        {%- if st.video_1_url != blank -%}
          <figure class="pdcm-play__clip">
            {% render 'popdarts-cm-video', id: clip_1, src: st.video_1_url, poster: poster_1, start: st.video_1_start, end: st.video_1_end, focus: st.video_1_focus, autoplay: true, label: st.video_1_caption %}
            {%- if st.video_1_caption != blank -%}<figcaption>{{ st.video_1_caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
        {%- if st.video_2_url != blank -%}
          <figure class="pdcm-play__clip pdcm-play__clip--second">
            {% render 'popdarts-cm-video', id: clip_2, src: st.video_2_url, poster: poster_2, start: st.video_2_start, end: st.video_2_end, focus: st.video_2_focus, autoplay: false, label: st.video_2_caption %}
            {%- if st.video_2_caption != blank -%}<figcaption>{{ st.video_2_caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pdcm-play__rules">
      <ul class="pdcm-scores">
        {%- for i in (1..3) -%}
          {%- assign vk = 'score_' | append: i | append: '_value' -%}
          {%- assign lk = 'score_' | append: i | append: '_label' -%}
          {%- if st[vk] != blank -%}
            <li class="pdcm-score"><b class="pdcm-score__value">{{ st[vk] }}</b><span class="pdcm-score__label">{{ st[lk] }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if st.footnote != blank -%}<p class="pdcm-play__foot">{{ st.footnote }}</p>{%- endif -%}
      <p class="pdcm-play__links">
        {%- if st.rules_text != blank -%}<a class="pdcm-btn pdcm-btn--outline-ink" href="{{ st.rules_link | default: '/pages/play' }}">{{ st.rules_text }}</a>{%- endif -%}
        {%- if st.app_text != blank -%}<a class="pdcm-link" href="{{ st.app_link | default: '/pages/scorekeeper' }}">{{ st.app_text }}</a>{%- endif -%}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cyber Monday: Gameplay",
  "tag": "div",
  "class": "pdcm-play-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it plays" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Throw it. Stick it. First to 21." },
    { "type": "textarea", "id": "sub", "label": "Text", "default": "Popdarts stick to smooth surfaces — glass, windows, countertops, even the fridge — indoors or out. Not wood or other textured, porous surfaces." },
    { "type": "header", "content": "Scoring (verified rules)" },
    { "type": "text", "id": "score_1_value", "label": "Score 1", "default": "+3" },
    { "type": "text", "id": "score_1_label", "label": "Score 1 label", "default": "Closest Popdart to the Target Marker" },
    { "type": "text", "id": "score_2_value", "label": "Score 2", "default": "+1" },
    { "type": "text", "id": "score_2_label", "label": "Score 2 label", "default": "Every other Popdart that sticks" },
    { "type": "text", "id": "score_3_value", "label": "Score 3", "default": "+10" },
    { "type": "text", "id": "score_3_label", "label": "Score 3 label", "default": "Land on top of the PRO Target Marker™" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Cancellation scoring, just like cornhole. Going over 21 is allowed." },
    { "type": "text", "id": "rules_text", "label": "Rules button", "default": "Read the full rules" },
    { "type": "url", "id": "rules_link", "label": "Rules link", "info": "Empty = /pages/play" },
    { "type": "text", "id": "app_text", "label": "App link", "default": "Get the Score Keeper app" },
    { "type": "url", "id": "app_link", "label": "App link target", "info": "Empty = /pages/scorekeeper" },
    { "type": "header", "content": "Clip 1 (plays on every screen)" },
    { "type": "text", "id": "video_1_url", "label": "MP4 URL", "info": "A Shopify-hosted .mp4 (Content → Files). Use clips without burned-in captions." },
    { "type": "image_picker", "id": "video_1_poster", "label": "Poster image" },
    { "type": "text", "id": "video_1_poster_asset", "label": "Poster (theme asset)", "default": "pd-cm-poster-kitchen.jpg", "info": "Used when no poster image is picked." },
    { "type": "number", "id": "video_1_start", "label": "Start at (seconds)", "info": "Skips captions/stickers at the start." },
    { "type": "number", "id": "video_1_end", "label": "Loop back at (seconds)" },
    { "type": "range", "id": "video_1_focus", "label": "Crop focus (vertical)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "text", "id": "video_1_caption", "label": "Caption", "default": "Game night at home" },
    { "type": "header", "content": "Clip 2 (desktop and tablet only)" },
    { "type": "text", "id": "video_2_url", "label": "MP4 URL" },
    { "type": "image_picker", "id": "video_2_poster", "label": "Poster image" },
    { "type": "text", "id": "video_2_poster_asset", "label": "Poster (theme asset)", "default": "pd-cm-poster-arena.jpg" },
    { "type": "number", "id": "video_2_start", "label": "Start at (seconds)" },
    { "type": "number", "id": "video_2_end", "label": "Loop back at (seconds)" },
    { "type": "range", "id": "video_2_focus", "label": "Crop focus (vertical)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "text", "id": "video_2_caption", "label": "Caption", "default": "Under the arena lights" }
  ],
  "presets": [{ "name": "Cyber Monday: Gameplay" }]
}
{% endschema %}
