{%- comment -%}
  ============================================================
  PRODIGY REPLICA — static, 1:1 snapshot of templates/page.popdarts-
  prodigy.json as it currently renders (2026), baked into ONE section
  with no schema settings or blocks. Every value that used to be a
  customizer setting is now a hardcoded Liquid variable below each
  section's comment header; block loops are unrolled into literal
  repeated markup. The only things still resolved live are real
  Shopify objects (product price/compare-at/image/url via
  all_products[handle]) — hardcoding those as static text would show
  customers stale prices, so they stay dynamic on purpose.

  Excluded on purpose: the "experience", "why" and "products2" sections
  are currently DISABLED on the live page, so they render nothing there
  — this replica matches what actually shows, not what merely exists
  in the template file.

  Known-as-is quirks carried over unchanged (present on the live page
  today, not introduced here):
    - American Classic's second photo URL has a stray trailing
      backslash in its configured value, which breaks that one image.
    - American Classic's "american-classic" product handle doesn't
      match a real product, so its price renders blank rather than
      falling back to the configured fallback price (an existing
      Liquid/data quirk, reproduced faithfully here).

  This section renders no header or footer of its own — sections never
  do. To get a page with NO site header/footer at all, assign a page to
  a template with "layout": "none" (see templates/page.prodigy-replo.json)
  and give that template only this one section.
  ============================================================
{%- endcomment -%}

{% render 'popdarts-assets' %}

{%- comment -%} ============ HERO ============ {%- endcomment -%}
{%- liquid
  assign hero_lead = 'Become the'
  assign hero_word1 = 'Popdarts'
  assign hero_word2 = 'Champion.'
  assign hero_sub = 'Join The New American Classic Game that has taken over ESPN and gotten over a BILLION social media views.'
  assign hero_cta_text = 'Get Your Pro Pack'
  assign hero_cta_link = '/products/pro-pack'
  assign hero_secondary_text = "See how it's played"
  assign hero_secondary_anchor = '#experience'
  assign hero_bg1 = 'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/ChatGPT_Image_13_08_2026_10_29_35_1.png?v=1786659640'
  assign hero_bg2 = 'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/ChatGPT_Image_13_08_2026_10_18_43_1.png?v=1786659640'
  assign hero_bg3 = 'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/ChatGPT_Image_13_08_2026_10_19_07_1.png?v=1786659641'
  assign hero_sticky_label = 'The Pro Pack'
  assign hero_sticky_handle = 'pro-pack'
  assign hero_sticky_sub = 'Free shipping on orders $50+'
  assign hero_sticky_cta_text = 'Shop Now'
  assign hero_sticky_product = all_products[hero_sticky_handle]
-%}
<section class="pd-page hero" id="hero-{{ section.id }}" aria-label="Introduction">
  <div class="hero__media" aria-hidden="true">
    <img class="hero__bg hero__bg--1" loading="eager" fetchpriority="high" decoding="async" alt=""
      src="{{ hero_bg1 }}&width=2000"
      srcset="{{ hero_bg1 }}&width=800 800w, {{ hero_bg1 }}&width=1200 1200w, {{ hero_bg1 }}&width=1600 1600w, {{ hero_bg1 }}&width=2000 2000w"
      sizes="100vw">
    <img class="hero__bg hero__bg--2" loading="lazy" decoding="async" alt=""
      src="{{ hero_bg2 }}&width=2000"
      srcset="{{ hero_bg2 }}&width=800 800w, {{ hero_bg2 }}&width=1200 1200w, {{ hero_bg2 }}&width=1600 1600w, {{ hero_bg2 }}&width=2000 2000w"
      sizes="100vw">
    <img class="hero__bg hero__bg--3" loading="lazy" decoding="async" alt=""
      src="{{ hero_bg3 }}&width=2000"
      srcset="{{ hero_bg3 }}&width=800 800w, {{ hero_bg3 }}&width=1200 1200w, {{ hero_bg3 }}&width=1600 1600w, {{ hero_bg3 }}&width=2000 2000w"
      sizes="100vw">
    <div class="hero__scrim"></div>
    <div class="hero__vignette"></div>
  </div>

  <div class="pd-wrap">
    <div class="hero__inner">
      <h1 class="hero__title" style="color: #fdfdfd;">
        <span class="hero__title-lead" style="color: rgba(253,253,253,0.78);">{{ hero_lead }}</span>
        <span class="hero__title-main">
          <span style="color: #fdfdfd;">{{ hero_word1 }}</span>
          <span class="c-blue" style="color: #2b99ff;">{{ hero_word2 }}</span>
        </span>
      </h1>

      <p class="hero__sub">{{ hero_sub }}</p>

      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="{{ hero_cta_link }}">{{ hero_cta_text }}</a>
        <a class="btn btn--ghost btn--lg hero__secondary" href="{{ hero_secondary_anchor }}">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" fill="currentColor"/></svg>
          <span>{{ hero_secondary_text }}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="pd-sticky-cta" data-sticky-cta>
    <div class="pd-sticky-cta__text">
      <span class="pd-sticky-cta__label">{{ hero_sticky_label }}</span>
      <span class="pd-sticky-cta__sub">
        {%- if hero_sticky_product -%}
          {{ hero_sticky_product.price | money }}
          {%- if hero_sticky_product.compare_at_price > hero_sticky_product.price %} <s>{{ hero_sticky_product.compare_at_price | money }}</s>{% endif -%}
        {%- else -%}
          {{ hero_sticky_sub }}
        {%- endif -%}
      </span>
    </div>
    <a class="btn btn--primary" href="{% if hero_sticky_product %}{{ hero_sticky_product.url }}{% else %}/products/pro-pack{% endif %}">{{ hero_sticky_cta_text }}</a>
  </div>
</section>

{%- comment -%} ============ TICKER ============ {%- endcomment -%}
{%- liquid
  assign ticker_phrases = 'The New American Classic Game|As Seen On ESPN|1 Billion+ Views|Play Anywhere. Anytime.|Ages 5 to 95|Free Shipping $50+' | split: '|'
-%}
<section class="pd-page home-ticker" id="home-ticker-{{ section.id }}">
  <p class="pd-sr-only">{{ ticker_phrases | join: ', ' }}</p>
  <div class="home-ticker__track" aria-hidden="true">
    {%- for i in (1..2) -%}
      {%- for phrase in ticker_phrases -%}
        <span>{{ phrase }}</span><span class="dot" aria-hidden="true">&middot;</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%} ============ HALLOWEEN PROMO ============ {%- endcomment -%}
{%- liquid
