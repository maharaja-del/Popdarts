    <div class="hw-card is-auto" data-hw-card>
      <a class="hw-card__media" href="{{ hw_cta_link }}" aria-hidden="true" tabindex="-1">
        <img src="{{ hw_src }}" alt="" loading="lazy" decoding="async"
          srcset="{{ hw_src }}&width=800 800w, {{ hw_src }}&width=1200 1200w, {{ hw_src }}&width=1600 1600w, {{ hw_src }}&width=2000 2000w"
          sizes="(max-width: 1440px) 100vw, 1400px">
        <span class="hw-card__vignette"></span>
        <span class="hw-card__light"></span>
        <span class="hw-card__flash"></span>
      </a>

      <div class="hw-card__bar">
        <div class="hw-card__text">
          <p class="hw-card__eyebrow">{{ hw_eyebrow }}</p>
          <h2 id="hw-promo-title-{{ section.id }}" style="color: #fdfdfd !important;">
            {{ hw_heading }} <span class="hw-card__accent">{{ hw_heading_accent }}</span>
          </h2>
        </div>
        <div class="hw-card__cta">
          <a class="btn btn--lg hw-card__btn" href="{{ hw_cta_link }}">{{ hw_cta_text }}</a>
          <span class="hw-card__note" data-hw-countdown data-end="{{ hw_end_date }}" data-ended="{{ hw_note | escape }}">
            <span>Sale ends in</span> <strong data-hw-countdown-value>—</strong>
