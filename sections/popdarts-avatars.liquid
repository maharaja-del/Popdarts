          "label": "Tagline",
          "default": "Ready to own the pressure"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Accent",
          "options": [
            { "value": "rookie", "label": "Light blue (Rookie)" },
            { "value": "pro", "label": "Blue (Pro)" },
            { "value": "elite", "label": "Ink (Elite)" },
            { "value": "swaptop", "label": "Green (Swaptop)" }
          ],
          "default": "pro"
        },
        {
          "type": "header",
          "content": "Card copy"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Pro Pack"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow line (unused in lineup layout)"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Easy to Learn."
        },
        {
          "type": "text",
          "id": "headline_accent",
          "label": "Headline, accent part",
          "default": "Built to Compete."
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Hero copy",
          "default": "The rules are simple. The pressure is not. Call the shot. Play the angle. Chase the 10-pointer. First to 21 gets the last word."
        },
        {
          "type": "text",
          "id": "point_1",
          "label": "Point 1"
        },
        {
          "type": "text",
          "id": "point_2",
          "label": "Point 2"
        },
        {
          "type": "text",
          "id": "point_3",
          "label": "Point 3"
        },
        {
          "type": "header",
          "content": "Backdrop photo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "asset_filename",
          "label": "Bundled theme asset filename",
          "info": "Used if Photo is empty, e.g. pd-dadbod-sunglasses.jpg"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "Photo URL",
          "info": "Used if both above are empty. If everything is empty a photo matching the accent is used."
        },
        {
          "type": "header",
          "content": "Product"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "If left empty, the theme looks up the product handle below. If neither resolves, the fallback fields underneath are used."
        },
        {
          "type": "text",
          "id": "product_handle",
          "label": "Fallback product handle",
          "info": "e.g. rookie-pack, pro-pack, elite-full-pack, swaptop-kit"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Fallback product name"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Fallback product image"
        },
        {
          "type": "url",
          "id": "product_image_url",
          "label": "Fallback product image URL"
        },
        {
          "type": "text",
          "id": "product_asset_filename",
          "label": "Fallback product image asset filename"
        },
        {
          "type": "text",
          "id": "fallback_price",
          "label": "Fallback price text",
          "default": "$31.99"
        },
        {
          "type": "text",
          "id": "fallback_price_was",
          "label": "Fallback compare-at price text"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button text",
          "default": "Shop the Pro Pack"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link",
          "info": "Leave empty to link to the resolved product."
        }
