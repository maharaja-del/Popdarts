<section class="pd-page avatars" id="avatars-{{ section.id }}" aria-labelledby="avatars-title-{{ section.id }}">
  <div class="pd-wrap">
    <div class="avatars__head">
      <p class="avatars__eyebrow">{{ section.settings.eyebrow | default: 'Find Your Player' }}</p>
      <h2 id="avatars-title-{{ section.id }}" style="color: #0a0c10 !important;">
        {{ section.settings.heading | default: 'Which shot' }}
        {%- if section.settings.heading_accent != blank %} <span class="c-blue" style="color: #2b99ff;">{{ section.settings.heading_accent }}</span>{% endif -%}
      </h2>
      <p>{{ section.settings.subheading | default: 'For first shots. For clutch shots. For comeback shots. For everyone who makes the weekend happen.' }}</p>
    </div>

    <p class="avatars__hint" aria-hidden="true">
      <span>Swipe</span>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M4 12h14m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </p>

    <div class="avatars__grid">
      {%- for block in section.blocks -%}
        {%- assign style = block.settings.style | default: 'pro' -%}
        {%- assign num = block.settings.number | default: forloop.index | prepend: '0' | slice: -2, 2 -%}
        {%- assign fallback_handle = block.settings.product_handle -%}
        {%- assign p = block.settings.product | default: all_products[fallback_handle] -%}

        {%- comment -%}
          Backdrop photo: picker → bundled asset → URL → per-style default.
          Picker images and Shopify-CDN URLs get a responsive srcset so
          phones download ~700px, not the full-size original.
        {%- endcomment -%}
        {%- assign bg_srcset = '' -%}
        {%- if block.settings.image -%}
          {%- assign bg_src = block.settings.image | image_url: width: 1400 -%}
          {%- capture bg_srcset -%}{{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1000 }} 1000w, {{ block.settings.image | image_url: width: 1400 }} 1400w{%- endcapture -%}
        {%- elsif block.settings.asset_filename != blank -%}
          {%- assign bg_src = block.settings.asset_filename | asset_url -%}
        {%- elsif block.settings.image_url != blank -%}
          {%- assign bg_src = block.settings.image_url -%}
          {%- if bg_src contains 'cdn.shopify.com' -%}
            {%- if bg_src contains '?' -%}{%- assign sep = '&' -%}{%- else -%}{%- assign sep = '?' -%}{%- endif -%}
            {%- capture bg_srcset -%}{{ bg_src }}{{ sep }}width=700 700w, {{ bg_src }}{{ sep }}width=1000 1000w, {{ bg_src }}{{ sep }}width=1400 1400w{%- endcapture -%}
          {%- endif -%}
        {%- elsif style == 'rookie' -%}
          {%- assign bg_src = 'pd-marquee-family-group.jpg' | asset_url -%}
        {%- elsif style == 'elite' -%}
          {%- assign bg_src = 'pd-dadbod-sunglasses.jpg' | asset_url -%}
        {%- elsif style == 'swaptop' -%}
          {%- assign bg_src = 'pd-bento-players-ready.jpg' | asset_url -%}
        {%- else -%}
          {%- assign bg_src = 'pd-bento-player-point.jpg' | asset_url -%}
        {%- endif -%}

        {%- comment -%} Product thumb: live product → picker → URL → bundled asset → none {%- endcomment -%}
        {%- assign thumb_src = '' -%}
        {%- if p and p.featured_image -%}
          {%- assign thumb_src = p.featured_image | image_url: width: 240 -%}
        {%- elsif block.settings.product_image -%}
          {%- assign thumb_src = block.settings.product_image | image_url: width: 240 -%}
        {%- elsif block.settings.product_image_url != blank -%}
          {%- assign thumb_src = block.settings.product_image_url -%}
        {%- elsif block.settings.product_asset_filename != blank -%}
          {%- assign thumb_src = block.settings.product_asset_filename | asset_url -%}
        {%- endif -%}

        {%- if block.settings.cta_link != blank -%}
          {%- assign cta_href = block.settings.cta_link -%}
        {%- elsif p -%}
          {%- assign cta_href = p.url -%}
        {%- else -%}
          {%- assign cta_href = '/products' -%}
        {%- endif -%}

        <article class="avatar-card avatar-card--{{ style }}" {{ block.shopify_attributes }}>
          <div class="avatar-card__media" aria-hidden="true">
            <img src="{{ bg_src }}" alt="" loading="lazy" decoding="async"
              {%- if bg_srcset != blank %} srcset="{{ bg_srcset }}" sizes="(max-width: 600px) 82vw, (max-width: 1100px) 50vw, 25vw"{% endif %}>
            <div class="avatar-card__scrim"></div>
            <div class="avatar-card__glow"></div>
          </div>

          <div class="avatar-card__top">
            <span class="avatar-card__badge">{{ block.settings.badge | default: 'Pro Pack' }}</span>
            <span class="avatar-card__num" aria-hidden="true">{{ num }}</span>
          </div>

          <div class="avatar-card__inner">
            <h3 style="color: #fdfdfd !important;">
              <span class="avatar-card__line" data-fit-line>{{ block.settings.headline | default: 'Easy to Learn.' }}</span>
              {%- if block.settings.headline_accent != blank -%}
                <br>
                <span class="avatar-card__line avatar-card__accent" data-fit-line>{{ block.settings.headline_accent }}</span>
              {%- endif -%}
            </h3>

            <div class="avatar-card__foot">
              <div class="avatar-card__product">
                {%- if thumb_src != blank -%}
                  <span class="avatar-card__thumb"><img src="{{ thumb_src }}" alt="" loading="lazy" width="104" height="104"></span>
                {%- endif -%}
                <span class="avatar-card__meta">
                  <span class="avatar-card__price">
                    {%- if p -%}
                      <span class="avatar-card__price-now">{{ p.price | money }}</span>
                      {%- if p.compare_at_price > p.price -%}
                        <span class="avatar-card__price-was">{{ p.compare_at_price | money }}</span>
                      {%- endif -%}
                    {%- elsif block.settings.fallback_price != blank -%}
                      <span class="avatar-card__price-now">{{ block.settings.fallback_price }}</span>
                      {%- if block.settings.fallback_price_was != blank -%}
                        <span class="avatar-card__price-was">{{ block.settings.fallback_price_was }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </span>
                </span>
              </div>
              <a class="btn {% if style == 'swaptop' or style == 'green' %}btn--green{% else %}btn--primary{% endif %}" href="{{ cta_href }}">{{ block.settings.cta_text | default: 'Shop Now' }}</a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pick Your Player",
  "tag": "section",
  "class": "pd-section-avatars",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find Your Player"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which shot"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, blue part",
      "default": "is yours?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "For first shots. For clutch shots. For comeback shots. For everyone who makes the weekend happen."
    }
  ],
  "blocks": [
    {
      "type": "avatar",
      "name": "Player",
      "settings": [
        {
          "type": "header",
          "content": "Player"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "info": "Leave empty to auto-number (01, 02…)"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Accent",
          "options": [
            {
              "value": "blue",
              "label": "Blue"
            },
            {
              "value": "green",
              "label": "Green"
            },
            {
              "value": "rookie",
              "label": "Light blue outline"
            },
            {
              "value": "elite",
              "label": "White (ink text)"
            },
            {
              "value": "pro",
              "label": "Blue (legacy)"
            },
            {
              "value": "swaptop",
              "label": "Green (legacy)"
            }
          ],
          "default": "blue"
        },
        {
          "type": "header",
          "content": "Card copy"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Pro Pack"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Easy to Learn."
        },
        {
          "type": "text",
          "id": "headline_accent",
          "label": "Headline, accent part",
          "default": "Built to Compete."
        },
        {
          "type": "header",
          "content": "Backdrop photo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "asset_filename",
          "label": "Bundled theme asset filename",
          "info": "Used if Photo is empty, e.g. pd-dadbod-sunglasses.jpg"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "Photo URL",
          "info": "Used if both above are empty. If everything is empty a photo matching the accent is used."
        },
        {
          "type": "header",
          "content": "Product"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "If left empty, the theme looks up the product handle below. If neither resolves, the fallback fields underneath are used."
        },
        {
          "type": "text",
          "id": "product_handle",
          "label": "Fallback product handle",
          "info": "e.g. rookie-pack, pro-pack, elite-full-pack, swaptop-kit"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Fallback product image"
        },
        {
          "type": "url",
          "id": "product_image_url",
          "label": "Fallback product image URL"
        },
        {
          "type": "text",
          "id": "product_asset_filename",
          "label": "Fallback product image asset filename"
        },
        {
          "type": "text",
          "id": "fallback_price",
          "label": "Fallback price text",
          "default": "$31.99"
        },
        {
          "type": "text",
          "id": "fallback_price_was",
          "label": "Fallback compare-at price text"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button text",
          "default": "Shop the Pro Pack"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link",
          "info": "Leave empty to link to the resolved product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pick Your Player",
      "blocks": [
        {
          "type": "avatar",
          "settings": {
            "style": "rookie",
            "badge": "Rookie Pack",
            "headline": "Small Players.",
            "headline_accent": "Big-Time Moments.",
            "product_handle": "rookie-pack",
            "fallback_price": "$24.99",
            "cta_text": "Shop the Rookie Pack",
            "cta_link": "/products/rookie-pack"
          }
        },
        {
          "type": "avatar",
          "settings": {
            "style": "pro",
            "badge": "Pro Pack",
            "headline": "Easy to Learn.",
            "headline_accent": "Built to Compete.",
            "product_handle": "pro-pack",
            "fallback_price": "$31.99",
            "fallback_price_was": "$39.99",
            "cta_text": "Shop the Pro Pack",
            "cta_link": "/products/pro-pack"
          }
        },
        {
          "type": "avatar",
          "settings": {
            "style": "elite",
            "badge": "Elite Pack",
            "headline": "The Glory Days",
            "headline_accent": "Aren't Over.",
            "product_handle": "elite-full-pack",
            "fallback_price": "$44.99",
            "cta_text": "Shop the Elite Pack",
            "cta_link": "/products/elite-full-pack"
          }
        },
        {
          "type": "avatar",
          "settings": {
            "style": "swaptop",
            "badge": "Swaptop™ Kit",
            "headline": "The Game Plan",
            "headline_accent": "For People Who Make the Plans.",
            "product_handle": "swaptop-kit",
            "fallback_price": "$159.99",
            "fallback_price_was": "$179.99",
            "cta_text": "Shop the Swaptop Kit",
            "cta_link": "/products/swaptop-kit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
