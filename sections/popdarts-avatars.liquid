<section class="pd-page avatars" id="avatars-{{ section.id }}" aria-labelledby="avatars-title-{{ section.id }}">
  <div class="pd-wrap">
    <div class="avatars__head">
      <p class="avatars__eyebrow">{{ section.settings.eyebrow | default: 'Find Your Player' }}</p>
      <h2 id="avatars-title-{{ section.id }}" style="color: #0a0c10 !important;">
        {{ section.settings.heading | default: 'Which shot' }}
        {%- if section.settings.heading_accent != blank %} <span class="c-blue" style="color: #2b99ff;">{{ section.settings.heading_accent }}</span>{% endif -%}
      </h2>
      <p>{{ section.settings.subheading | default: 'For first shots. For clutch shots. For comeback shots. For everyone who makes the weekend happen.' }}</p>
    </div>

    <div class="avatars__grid">
      {%- for block in section.blocks -%}
        {%- assign style = block.settings.style | default: 'pro' -%}
        {%- assign num = block.settings.number | default: forloop.index | prepend: '0' | slice: -2, 2 -%}
        {%- assign fallback_handle = block.settings.product_handle -%}
        {%- assign p = block.settings.product | default: all_products[fallback_handle] -%}

        {%- comment -%} Backdrop photo: picker → bundled asset → URL → per-style default {%- endcomment -%}
        {%- if block.settings.image -%}
          {%- assign bg_src = block.settings.image | image_url: width: 1000 -%}
        {%- elsif block.settings.asset_filename != blank -%}
          {%- assign bg_src = block.settings.asset_filename | asset_url -%}
        {%- elsif block.settings.image_url != blank -%}
          {%- assign bg_src = block.settings.image_url -%}
        {%- elsif style == 'rookie' -%}
          {%- assign bg_src = 'pd-marquee-family-group.jpg' | asset_url -%}
        {%- elsif style == 'elite' -%}
          {%- assign bg_src = 'pd-dadbod-sunglasses.jpg' | asset_url -%}
        {%- elsif style == 'swaptop' -%}
          {%- assign bg_src = 'pd-bento-players-ready.jpg' | asset_url -%}
        {%- else -%}
          {%- assign bg_src = 'pd-bento-player-point.jpg' | asset_url -%}
        {%- endif -%}

        {%- comment -%} Product thumb: live product → picker → URL → bundled asset → none {%- endcomment -%}
        {%- assign thumb_src = '' -%}
        {%- if p and p.featured_image -%}
          {%- assign thumb_src = p.featured_image | image_url: width: 240 -%}
        {%- elsif block.settings.product_image -%}
          {%- assign thumb_src = block.settings.product_image | image_url: width: 240 -%}
        {%- elsif block.settings.product_image_url != blank -%}
          {%- assign thumb_src = block.settings.product_image_url -%}
        {%- elsif block.settings.product_asset_filename != blank -%}
          {%- assign thumb_src = block.settings.product_asset_filename | asset_url -%}
        {%- endif -%}

        {%- if block.settings.cta_link != blank -%}
          {%- assign cta_href = block.settings.cta_link -%}
        {%- elsif p -%}
          {%- assign cta_href = p.url -%}
        {%- else -%}
          {%- assign cta_href = '/products' -%}
        {%- endif -%}

        <article class="avatar-card avatar-card--{{ style }}" {{ block.shopify_attributes }}>
          <div class="avatar-card__media" aria-hidden="true">
            <img src="{{ bg_src }}" alt="" loading="lazy">
            <div class="avatar-card__scrim"></div>
            <div class="avatar-card__glow"></div>
          </div>

          <div class="avatar-card__top">
            <span class="avatar-card__badge">{{ block.settings.badge | default: 'Pro Pack' }}</span>
            <span class="avatar-card__num" aria-hidden="true">{{ num }}</span>
          </div>

          <div class="avatar-card__inner">
            <p class="avatar-card__name">{{ block.settings.name | default: 'The Contender' }}{% if block.settings.tagline != blank %} <span>· {{ block.settings.tagline }}</span>{% endif %}</p>
            <h3 style="color: #fdfdfd !important;">
              {{ block.settings.headline | default: 'Easy to Learn.' }}
              {%- if block.settings.headline_accent != blank %} <span class="avatar-card__accent">{{ block.settings.headline_accent }}</span>{% endif -%}
            </h3>
            <p class="avatar-card__copy">{{ block.settings.copy | default: 'The rules are simple. The pressure is not.' }}</p>

            {%- if block.settings.point_1 != blank or block.settings.point_2 != blank or block.settings.point_3 != blank -%}
              <div class="avatar-card__more">
                <ul class="avatar-card__points">
                  {%- if block.settings.point_1 != blank %}<li>{{ block.settings.point_1 }}</li>{% endif -%}
                  {%- if block.settings.point_2 != blank %}<li>{{ block.settings.point_2 }}</li>{% endif -%}
                  {%- if block.settings.point_3 != blank %}<li>{{ block.settings.point_3 }}</li>{% endif -%}
                </ul>
              </div>
            {%- endif -%}

            <div class="avatar-card__foot">
              <div class="avatar-card__product">
                {%- if thumb_src != blank -%}
                  <span class="avatar-card__thumb"><img src="{{ thumb_src }}" alt="" loading="lazy" width="104" height="104"></span>
                {%- endif -%}
                <span class="avatar-card__meta">
                  <span class="avatar-card__pname">{% if p %}{{ p.title }}{% else %}{{ block.settings.product_title | default: block.settings.badge | default: 'Pro Pack' }}{% endif %}</span>
                  <span class="avatar-card__price">
                    {%- if p -%}
                      <span class="avatar-card__price-now">{{ p.price | money }}</span>
                      {%- if p.compare_at_price > p.price -%}
                        <span class="avatar-card__price-was">{{ p.compare_at_price | money }}</span>
                      {%- endif -%}
                    {%- elsif block.settings.fallback_price != blank -%}
                      <span class="avatar-card__price-now">{{ block.settings.fallback_price }}</span>
                      {%- if block.settings.fallback_price_was != blank -%}
                        <span class="avatar-card__price-was">{{ block.settings.fallback_price_was }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </span>
                </span>
              </div>
              <a class="btn {% if style == 'swaptop' %}btn--green{% else %}btn--primary{% endif %}" href="{{ cta_href }}">{{ block.settings.cta_text | default: 'Shop Now' }}</a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pick Your Player",
  "tag": "section",
  "class": "pd-section-avatars",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find Your Player"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which shot"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, blue part",
