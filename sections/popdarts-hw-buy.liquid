{%- assign handle = section.settings.product_handle | default: 'pro-pack' -%}
{%- if section.settings.image -%}
  {%- assign box_src = section.settings.image | image_url: width: 1400 -%}
{%- else -%}
  {%- assign box_src = 'pd-hw-box.png' | asset_url -%}
{%- endif -%}

<section class="pd-page hwp hwp-buy" id="hw-buy" aria-labelledby="hw-buy-title-{{ section.id }}">
  <div class="pd-wrap hwp-buy__grid">
    <div class="hwp-buy__stage" data-hw-card>
      <div class="hwp-buy__glow" aria-hidden="true"></div>
      <img class="hwp-buy__box" src="{{ box_src }}" alt="{{ section.settings.image_alt | escape }}" width="1466" height="861" loading="lazy" decoding="async">
      <img class="hwp-buy__dart hwp-buy__dart--a" src="{{ 'pd-hw-dart-6.png' | asset_url }}" alt="" width="935" height="1000" loading="lazy" decoding="async" aria-hidden="true">
      <img class="hwp-buy__dart hwp-buy__dart--b" src="{{ 'pd-hw-dart-1.png' | asset_url }}" alt="" width="901" height="1000" loading="lazy" decoding="async" aria-hidden="true">
    </div>

    <div class="hwp-buy__panel">
      <p class="hwp__eyebrow">{{ section.settings.eyebrow | default: 'Limited Halloween colorway' }}</p>
      <h2 id="hw-buy-title-{{ section.id }}" style="color: #fdfdfd !important;">{{ section.settings.title | default: 'Halloween Pro Pack' }}</h2>
      <p class="hwp-buy__rating"><span class="hwp-stars" aria-hidden="true">★★★★★</span> {{ section.settings.rating_text | default: '4.9 · 250+ verified reviews' }}</p>

      <div class="hwp-price">
        {%- render 'popdarts-hw-price', handle: handle, variant_id: section.settings.variant_id, price_text: section.settings.price_text, compare_text: section.settings.compare_text -%}
        {%- if section.settings.flag_text != blank -%}<span class="hwp-price__tag">{{ section.settings.flag_text }}</span>{%- endif -%}
      </div>

      <ul class="hwp-checks">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>

      <div class="hwp-cwchips" aria-label="Colorways">
        <span class="hwp-cwchip hwp-cwchip--green"><img src="{{ 'pd-hw-dart-6.png' | asset_url }}" alt="" width="935" height="1000" loading="lazy"><b>{{ section.settings.cw1_name | default: 'Toxic Slime' }}</b><small>{{ section.settings.cw_note | default: '3 darts' }}</small></span>
        <span class="hwp-cwchip hwp-cwchip--orange"><img src="{{ 'pd-hw-dart-1.png' | asset_url }}" alt="" width="901" height="1000" loading="lazy"><b>{{ section.settings.cw2_name | default: 'Pumpkin Fright' }}</b><small>{{ section.settings.cw_note | default: '3 darts' }}</small></span>
      </div>

      {%- render 'popdarts-hw-atc', handle: handle, variant_id: section.settings.variant_id, label: section.settings.cta_label, classes: 'btn--lg hwp-buy__btn', fallback: section.settings.cta_fallback -%}
      {%- if section.settings.micro != blank -%}<p class="hwp-micro">{{ section.settings.micro }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HW · Buy Box",
  "tag": "section",
  "class": "pd-section-hw-buy",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Product image", "info": "Empty = the built-in box render" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Popdarts PRO Pack Halloween edition retail box" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited Halloween colorway" },
    { "type": "text", "id": "title", "label": "Product title", "default": "Halloween Pro Pack" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 · 250+ verified reviews" },
    { "type": "header", "content": "Product" },
    { "type": "text", "id": "product_handle", "label": "Product handle", "default": "pro-pack" },
    { "type": "text", "id": "variant_id", "label": "Variant ID (optional)" },
    { "type": "text", "id": "price_text", "label": "Fallback price text", "default": "$39.99" },
    { "type": "text", "id": "compare_text", "label": "Fallback compare-at text" },
    { "type": "text", "id": "flag_text", "label": "Price flag", "default": "Final run" },
    { "type": "text", "id": "cw1_name", "label": "Colorway 1", "default": "Toxic Slime" },
    { "type": "text", "id": "cw2_name", "label": "Colorway 2", "default": "Pumpkin Fright" },
    { "type": "text", "id": "cw_note", "label": "Colorway note", "default": "3 darts" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
    { "type": "url", "id": "cta_fallback", "label": "Fallback link" },
    { "type": "text", "id": "micro", "label": "Line under button", "default": "In stock now. No restocks after Halloween." }
  ],
  "blocks": [
    { "type": "item", "name": "Included item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "6 Popdarts in two Halloween colorways" } ] }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "HW · Buy Box",
    "blocks": [
      { "type": "item", "settings": { "text": "6 Popdarts in two Halloween colorways" } },
      { "type": "item", "settings": { "text": "1 PRO Target Marker™ (worth 10 points)" } },
      { "type": "item", "settings": { "text": "1 carrying bag with printed rules and ruler" } },
      { "type": "item", "settings": { "text": "2 Popdarts stickers" } }
    ]
  }]
}
{% endschema %}
