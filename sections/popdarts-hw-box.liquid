{%- liquid
  if section.settings.image
    assign lineup = section.settings.image | image_url: width: 1600
  elsif section.settings.image_url != blank
    assign lineup = section.settings.image_url
  else
    assign lineup = 'pd-hw-lineup.png' | asset_url
  endif

  assign lineup_slides = lineup | append: '::'
  if section.settings.image_2_url != blank
    assign lineup_slides = lineup_slides | append: section.settings.image_2_url | append: '::'
  endif
  if section.settings.image_3_url != blank
    assign lineup_slides = lineup_slides | append: section.settings.image_3_url | append: '::'
  endif
  if section.settings.image_4_url != blank
    assign lineup_slides = lineup_slides | append: section.settings.image_4_url | append: '::'
  endif
  assign lineup_slides = lineup_slides | split: '::'
-%}

<section class="pd-page hwp hwp-box" id="hw-box" aria-labelledby="hw-box-title-{{ section.id }}">
  <div class="pd-wrap hwp-box__grid">
    {%- if section.settings.figure_image != blank -%}
      <div class="hwp-box__figure" aria-hidden="true">
        <img src="{{ section.settings.figure_image | image_url: width: 420 }}" alt="" width="420" height="908" loading="lazy" decoding="async">
      </div>
    {%- endif -%}
    <div class="hwp-box__stage">
      <div class="hwp-box__slider" data-hw-autoslide>
        {%- for src in lineup_slides -%}
          <img class="{% if forloop.first %}is-active{% endif %}" src="{{ src }}" alt="{{ section.settings.image_alt | escape }}" width="1600" height="1038" loading="lazy" decoding="async">
        {%- endfor -%}
      </div>
      {%- if lineup_slides.size > 1 -%}
        <button class="hwp-slide-arrow hwp-slide-arrow--prev" type="button" data-hw-prev aria-label="Previous image">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="hwp-slide-arrow hwp-slide-arrow--next" type="button" data-hw-next aria-label="Next image">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {%- endif -%}
    </div>
    <div class="hwp-box__content">
      <div class="hwp__head">
        <p class="hwp__eyebrow">{{ section.settings.eyebrow | default: 'What’s in the box' }}</p>
        <h2 id="hw-box-title-{{ section.id }}" style="color: #fdfdfd !important;">{{ section.settings.heading | default: 'Everything for a' }} <span class="hwp-accent-orange">{{ section.settings.heading_accent | default: 'two-player showdown.' }}</span></h2>
      </div>
      <ol class="hwp-list hwp-grid">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="hwp-list__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <h3 style="color: #fdfdfd !important;">{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HW · In The Box",
  "tag": "section",
  "class": "pd-section-hw-box",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Lineup image (slide 1)", "info": "Empty = the built-in lineup render" },
    { "type": "url", "id": "image_url", "label": "Slide 1 URL", "info": "Used if the picker above is empty." },
    { "type": "url", "id": "image_2_url", "label": "Slide 2 URL", "info": "Optional — adding any of slides 2-4 turns the image into an auto-playing slider." },
    { "type": "url", "id": "image_3_url", "label": "Slide 3 URL" },
    { "type": "url", "id": "image_4_url", "label": "Slide 4 URL" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "The full Halloween Pro Pack lineup — Toxic Slime and Pumpkin Fright Popdarts" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What’s in the box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything for a" },
    { "type": "text", "id": "heading_accent", "label": "Heading, orange part", "default": "two-player showdown." },
    { "type": "header", "content": "Background figure (optional)" },
    { "type": "image_picker", "id": "figure_image", "label": "Figure image", "info": "Tall portrait image, ~853 x 1844px. Shown small and faded behind the box art, hidden on mobile. Leave empty to hide." }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "6 Popdarts®" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "3 Toxic Slime + 3 Pumpkin Fright." }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "HW · In The Box",
    "blocks": [
      { "type": "item", "settings": { "title": "6 Popdarts®", "text": "3 Toxic Slime + 3 Pumpkin Fright — a full two-player showdown." } },
      { "type": "item", "settings": { "title": "1 PRO Target Marker™", "text": "Land on top of it for 10 bonus points." } },
      { "type": "item", "settings": { "title": "1 Carrying bag", "text": "Rules printed on it, built-in ruler for close calls." } },
      { "type": "item", "settings": { "title": "2 Popdarts stickers", "text": "So everyone knows you're part of the club." } }
    ]
  }]
}
{% endschema %}
