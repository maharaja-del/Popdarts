<section class="pd-page hwp hwp-faq" id="hw-faq" aria-labelledby="hw-faq-title-{{ section.id }}">
  <div class="pd-wrap hwp-faq__grid">
    <div class="hwp__head">
      <p class="hwp__eyebrow">{{ section.settings.eyebrow | default: 'Questions' }}</p>
      <h2 id="hw-faq-title-{{ section.id }}" style="color: #fdfdfd !important;">{{ section.settings.heading | default: 'Before you claim yours.' }}</h2>
      <p>{{ section.settings.subheading | default: 'Everything you need to know before your first throw.' }}</p>
    </div>
    <div class="hwp-faq__list hwp-grid">
      {%- for block in section.blocks -%}
        <details class="hwp-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <p>{{ block.settings.answer }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HW · FAQ",
  "tag": "section",
  "class": "pd-section-hw-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you claim yours." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Everything you need to know before your first throw." }
  ],
  "blocks": [
    { "type": "faq", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "When will it sell out?" },
      { "type": "textarea", "id": "answer", "label": "Answer", "default": "Honestly, we don't know." }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "HW · FAQ",
    "blocks": [
      { "type": "faq", "settings": { "question": "When will it sell out?", "answer": "Honestly, we don't know. Last year's Halloween run sold out before Halloween itself. When the last box ships it's gone for good, with no restocks and no re-runs." } },
      { "type": "faq", "settings": { "question": "What exactly comes in the pack?", "answer": "6 Popdarts (3 Toxic Slime and 3 Pumpkin Fright), 1 PRO Target Marker™, a carrying bag with the rules and a built-in ruler, and 2 stickers." } },
      { "type": "faq", "settings": { "question": "Where can I play it?", "answer": "Any smooth, flat surface: kitchen counters, tables, glass, windows, hardwood, and tile, indoors or outdoors." } },
      { "type": "faq", "settings": { "question": "Is it beginner friendly?", "answer": "Yes. The rules take about 30 seconds: throw, stick, score, first to 21. Ages 5 and up." } },
      { "type": "faq", "settings": { "question": "Will it arrive before Halloween?", "answer": "We ship every order fast. The earlier you order, the safer you are — the only real deadline is inventory." } }
    ]
  }]
}
{% endschema %}
