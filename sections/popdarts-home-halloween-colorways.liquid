{%- comment -%}
  Homepage → Halloween page redirect banner (colorway showcase style).
  Self-contained: own scoped styles, only depends on bundled pd-hw-*
  image assets already shipped with the theme. Presets under "Add
  section" as "Halloween Colorways Banner".
{%- endcomment -%}
{%- assign hwr2_link = section.settings.button_link | default: '/pages/halloween' -%}
{%- assign hwr2_dart_1 = section.settings.card_1_image | default: 'pd-hw-dart-6.png' | asset_url -%}
{%- assign hwr2_dart_2 = section.settings.card_2_image | default: 'pd-hw-dart-1.png' | asset_url -%}

<section class="hwr2" id="hwr2-{{ section.id }}" aria-labelledby="hwr2-title-{{ section.id }}">
  <div class="hwr2__wrap">
    <div class="hwr2__head">
      <p class="hwr2__eyebrow">{{ section.settings.eyebrow | default: '👻 Halloween Colorways' }}</p>
      <h2 class="hwr2__heading" id="hwr2-title-{{ section.id }}">{{ section.settings.heading | default: 'Two colorways. One night.' }}</h2>
      <p class="hwr2__body">{{ section.settings.body | default: 'Toxic Slime and Pumpkin Fright — exclusive to the Halloween Pro Pack.' }}</p>
    </div>

    <div class="hwr2__grid">
      <a class="hwr2__card hwr2__card--slime" href="{{ hwr2_link }}">
        <div class="hwr2__card-glow" aria-hidden="true"></div>
        <img class="hwr2__card-img" src="{{ hwr2_dart_1 }}" alt="{{ section.settings.card_1_name | default: 'Toxic Slime' }} Popdarts colorway" width="935" height="1000" loading="lazy" decoding="async">
        <div class="hwr2__card-body">
          <span class="hwr2__card-name">{{ section.settings.card_1_name | default: 'Toxic Slime' }}</span>
          <span class="hwr2__card-cta">{{ section.settings.card_cta_text | default: 'Shop now' }}
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <a class="hwr2__card hwr2__card--pumpkin" href="{{ hwr2_link }}">
        <div class="hwr2__card-glow" aria-hidden="true"></div>
        <img class="hwr2__card-img" src="{{ hwr2_dart_2 }}" alt="{{ section.settings.card_2_name | default: 'Pumpkin Fright' }} Popdarts colorway" width="901" height="1000" loading="lazy" decoding="async">
        <div class="hwr2__card-body">
          <span class="hwr2__card-name">{{ section.settings.card_2_name | default: 'Pumpkin Fright' }}</span>
          <span class="hwr2__card-cta">{{ section.settings.card_cta_text | default: 'Shop now' }}
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>
    </div>

    <div class="hwr2__foot">
      <a class="hwr2__btn" href="{{ hwr2_link }}">{{ section.settings.button_text | default: 'See The Full Halloween Collection' }}</a>
    </div>
  </div>
</section>

<style>
  #hwr2-{{ section.id }} {
    --hwr2-orange: #ff8a1f;
    --hwr2-green: #a8f321;
    --hwr2-purple: #7c3aed;
    --hwr2-ink: #0a0710;
    --hwr2-line: rgba(255, 255, 255, 0.1);
    background: var(--hwr2-ink);
    padding: clamp(56px, 9vh, 112px) 0;
  }
  #hwr2-{{ section.id }} * { box-sizing: border-box; }

  #hwr2-{{ section.id }} .hwr2__wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 56px);
  }

  #hwr2-{{ section.id }} .hwr2__head { text-align: center; max-width: 620px; margin: 0 auto clamp(32px, 5vh, 56px); }
  #hwr2-{{ section.id }} .hwr2__eyebrow {
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hwr2-orange);
    margin: 0 0 14px;
  }
  #hwr2-{{ section.id }} .hwr2__heading {
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.08;
    font-size: clamp(28px, 4.4vw, 44px);
    color: #fdfdfd;
    margin: 0 0 14px;
  }
  #hwr2-{{ section.id }} .hwr2__body { font-size: clamp(15px, 1.6vw, 17px); color: rgba(253, 253, 253, 0.65); margin: 0; }

  #hwr2-{{ section.id }} .hwr2__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 28px);
  }

  #hwr2-{{ section.id }} .hwr2__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    border: 1px solid var(--hwr2-line);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease;
  }
  #hwr2-{{ section.id }} .hwr2__card:hover { transform: translateY(-6px); border-color: rgba(255,255,255,0.24); }

  #hwr2-{{ section.id }} .hwr2__card--slime { background: radial-gradient(120% 100% at 50% 100%, rgba(168, 243, 33, 0.22), transparent 65%), #10131a; }
  #hwr2-{{ section.id }} .hwr2__card--pumpkin { background: radial-gradient(120% 100% at 50% 100%, rgba(255, 138, 31, 0.22), transparent 65%), #16101a; }

  #hwr2-{{ section.id }} .hwr2__card-glow {
    position: absolute;
    left: 50%; top: 38%;
    width: 70%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.5;
    z-index: -1;
  }
  #hwr2-{{ section.id }} .hwr2__card--slime .hwr2__card-glow { background: var(--hwr2-green); }
  #hwr2-{{ section.id }} .hwr2__card--pumpkin .hwr2__card-glow { background: var(--hwr2-orange); }

  #hwr2-{{ section.id }} .hwr2__card-img {
    position: absolute;
    left: 50%; top: 42%;
    width: 52%;
    height: auto;
    max-height: 62%;
    object-fit: contain;
    transform: translate(-50%, -50%) rotate(-6deg);
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.6));
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #hwr2-{{ section.id }} .hwr2__card--pumpkin .hwr2__card-img { transform: translate(-50%, -50%) rotate(6deg); }
  #hwr2-{{ section.id }} .hwr2__card:hover .hwr2__card-img { transform: translate(-50%, -50%) rotate(0deg) scale(1.05); }

  #hwr2-{{ section.id }} .hwr2__card-body {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 20px;
    background: linear-gradient(0deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 100%);
  }
  #hwr2-{{ section.id }} .hwr2__card-name {
    font-weight: 800;
    font-size: clamp(17px, 2.4vw, 22px);
    color: #fdfdfd;
    letter-spacing: -0.01em;
  }
  #hwr2-{{ section.id }} .hwr2__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 700;
    color: rgba(253, 253, 253, 0.85);
    white-space: nowrap;
  }
  #hwr2-{{ section.id }} .hwr2__card--slime .hwr2__card-cta { color: var(--hwr2-green); }
  #hwr2-{{ section.id }} .hwr2__card--pumpkin .hwr2__card-cta { color: var(--hwr2-orange); }
  #hwr2-{{ section.id }} .hwr2__card-cta svg { transition: transform 0.2s ease; }
  #hwr2-{{ section.id }} .hwr2__card:hover .hwr2__card-cta svg { transform: translateX(3px); }

  #hwr2-{{ section.id }} .hwr2__foot { display: flex; justify-content: center; margin-top: clamp(28px, 4vh, 44px); }
  #hwr2-{{ section.id }} .hwr2__btn {
    display: inline-flex;
    align-items: center;
    height: 54px;
    padding-inline: 30px;
    border-radius: 999px;
    border: 1.5px solid rgba(253, 253, 253, 0.28);
    color: #fdfdfd;
    font-weight: 800;
    font-size: 14px;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  #hwr2-{{ section.id }} .hwr2__btn:hover { background: rgba(253, 253, 253, 0.08); border-color: rgba(253, 253, 253, 0.5); transform: translateY(-2px); }

  @media (max-width: 640px) {
    #hwr2-{{ section.id }} .hwr2__grid { grid-template-columns: 1fr; }
    #hwr2-{{ section.id }} .hwr2__card { aspect-ratio: 16 / 11; }
    #hwr2-{{ section.id }} .hwr2__btn { width: 100%; justify-content: center; }
  }

  @media (hover: none) {
    #hwr2-{{ section.id }} .hwr2__card:hover { transform: none; }
    #hwr2-{{ section.id }} .hwr2__card:hover .hwr2__card-img { transform: translate(-50%, -50%) rotate(-6deg); }
    #hwr2-{{ section.id }} .hwr2__card--pumpkin:hover .hwr2__card-img { transform: translate(-50%, -50%) rotate(6deg); }
  }
</style>

{% schema %}
{
  "name": "Halloween Colorways",
  "tag": "section",
  "class": "pd-section-hwr2",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "👻 Halloween Colorways" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two colorways. One night." },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Toxic Slime and Pumpkin Fright — exclusive to the Halloween Pro Pack." },
    { "type": "header", "content": "Card 1" },
    { "type": "text", "id": "card_1_name", "label": "Name", "default": "Toxic Slime" },
    { "type": "image_picker", "id": "card_1_image", "label": "Image", "info": "Empty = the built-in green dart render." },
    { "type": "header", "content": "Card 2" },
    { "type": "text", "id": "card_2_name", "label": "Name", "default": "Pumpkin Fright" },
    { "type": "image_picker", "id": "card_2_image", "label": "Image", "info": "Empty = the built-in orange dart render." },
    { "type": "header", "content": "Links" },
    { "type": "text", "id": "card_cta_text", "label": "Card link text", "default": "Shop now" },
    { "type": "text", "id": "button_text", "label": "Bottom button text", "default": "See The Full Halloween Collection" },
    { "type": "url", "id": "button_link", "label": "Link (cards + button)", "info": "Defaults to /pages/halloween if left empty." }
  ],
  "presets": [{ "name": "Halloween Colorways" }]
}
{% endschema %}
