{% render 'popdarts-assets' %}

{%- comment -%}
  Background images: picker images get a responsive srcset (phones pull
  ~800px instead of 2000px). Bundled fallbacks can't be resized by Shopify.
{%- endcomment -%}
{%- capture hero_sizes -%}100vw{%- endcapture -%}

<section class="pd-page hero" id="hero-{{ section.id }}" aria-label="Introduction">
  <div class="hero__media" aria-hidden="true">
    {%- if section.settings.background_mode == 'single' -%}
      {%- assign img = section.settings.single_image -%}
      <img class="hero__bg hero__bg--single" loading="eager" fetchpriority="high" decoding="async" alt=""
        {%- if img %}
          src="{{ img | image_url: width: 2000 }}"
          srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w"
          sizes="{{ hero_sizes }}"
        {%- else %}
          src="{{ 'pd-hero-dart-strike.jpg' | asset_url }}"
        {%- endif %}>
      <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | default: 55 }}%;"></div>
    {%- else -%}
      {%- assign img = section.settings.bg_image_1 -%}
      <img class="hero__bg hero__bg--1" loading="eager" fetchpriority="high" decoding="async" alt=""
        {%- if img %}
          src="{{ img | image_url: width: 2000 }}"
          srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w"
          sizes="{{ hero_sizes }}"
        {%- else %}
          src="{{ 'pd-hero-dart-strike.jpg' | asset_url }}"
        {%- endif %}>
      {%- assign img = section.settings.bg_image_2 -%}
      <img class="hero__bg hero__bg--2" loading="lazy" decoding="async" alt=""
        {%- if img %}
          src="{{ img | image_url: width: 2000 }}"
          srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w"
          sizes="{{ hero_sizes }}"
        {%- else %}
          src="{{ 'pd-hero-arena-wide.jpg' | asset_url }}"
        {%- endif %}>
      {%- assign img = section.settings.bg_image_3 -%}
      <img class="hero__bg hero__bg--3" loading="lazy" decoding="async" alt=""
        {%- if img %}
          src="{{ img | image_url: width: 2000 }}"
          srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w"
          sizes="{{ hero_sizes }}"
        {%- else %}
          src="{{ 'pd-hero-trophy-lift.jpg' | asset_url }}"
        {%- endif %}>
    {%- endif -%}
    <div class="hero__scrim"></div>
    <div class="hero__vignette"></div>
  </div>

  <div class="pd-wrap">
    <div class="hero__inner">
      <h1 class="hero__title" style="color: #fdfdfd;">
        <span class="hero__title-lead" style="color: rgba(253,253,253,0.78);">{{ section.settings.heading_lead | default: 'Become the' }}</span>
        <span class="hero__title-main">
          <span style="color: #fdfdfd;">{{ section.settings.heading_word_1 | default: 'Popdarts' }}</span>
          <span class="c-blue" style="color: #2b99ff;">{{ section.settings.heading_word_2 | default: 'Champion.' }}</span>
        </span>
      </h1>

      <p class="hero__sub">
        {{ section.settings.subheading | default: "Every backyard has one. Three darts, one target — the closest stick wins, and the bragging rights are yours." }}
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="{{ section.settings.cta_link | default: '/products/pro-pack' }}">{{ section.settings.cta_text | default: 'Get Your Pro Pack' }}</a>
        {%- if section.settings.secondary_text != blank -%}
          <a class="btn btn--ghost btn--lg hero__secondary" href="{{ section.settings.secondary_anchor | default: '#experience' }}">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" fill="currentColor"/></svg>
            <span>{{ section.settings.secondary_text }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_sticky_cta -%}
    {%- assign sticky_handle = section.settings.sticky_product_handle -%}
    {%- assign sticky_product = all_products[sticky_handle] -%}
    <div class="pd-sticky-cta" data-sticky-cta>
      <div class="pd-sticky-cta__text">
        <span class="pd-sticky-cta__label">{{ section.settings.sticky_label | default: 'The Pro Pack' }}</span>
        <span class="pd-sticky-cta__sub">
          {%- if sticky_product -%}
            {{ sticky_product.price | money }}
            {%- if sticky_product.compare_at_price > sticky_product.price %} <s>{{ sticky_product.compare_at_price | money }}</s>{% endif -%}
          {%- elsif section.settings.sticky_sub != blank -%}
            {{ section.settings.sticky_sub }}
          {%- endif -%}
        </span>
      </div>
      <a class="btn btn--primary" href="{% if section.settings.cta_link != blank %}{{ section.settings.cta_link }}{% elsif sticky_product %}{{ sticky_product.url }}{% else %}/products/pro-pack{% endif %}">{{ section.settings.sticky_cta_text | default: 'Shop Now' }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Prodigy Hero",
  "tag": "section",
  "class": "pd-section-hero",
  "settings": [
    {
      "type": "select",
      "id": "background_mode",
      "label": "Background style",
      "options": [
        { "value": "crossfade", "label": "Crossfade (3 images)" },
        { "value": "single", "label": "Single image with overlay" }
      ],
      "default": "crossfade"
    },
    {
      "type": "header",
      "content": "Crossfade images (3)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_1",
      "label": "Background image 1"
    },
    {
      "type": "image_picker",
      "id": "bg_image_2",
      "label": "Background image 2"
    },
    {
      "type": "image_picker",
      "id": "bg_image_3",
      "label": "Background image 3"
    },
    {
      "type": "header",
      "content": "Single image"
    },
    {
      "type": "image_picker",
      "id": "single_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Black overlay opacity",
      "info": "Single image mode only. Crossfade mode uses the built-in cinematic scrim.",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "heading_lead",
      "label": "Small lead-in text",
      "default": "Become the"
    },
    {
      "type": "text",
      "id": "heading_word_1",
      "label": "Headline word 1 (white)",
      "default": "Popdarts"
    },
    {
      "type": "text",
      "id": "heading_word_2",
      "label": "Headline word 2 (blue)",
      "default": "Champion."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every backyard has one. Three darts, one target — the closest stick wins, and the bragging rights are yours."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary button text",
      "default": "Get Your Pro Pack"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary button text",
      "info": "Leave empty to hide.",
      "default": "See how it's played"
    },
    {
      "type": "text",
      "id": "secondary_anchor",
      "label": "Secondary button anchor",
      "default": "#experience"
    },
    {
      "type": "header",
      "content": "Mobile sticky bar",
      "info": "A slim bar pinned to the bottom of phone screens once the hero scrolls away. Hides over the final CTA and footer."
    },
    {
      "type": "checkbox",
      "id": "show_sticky_cta",
      "label": "Show sticky bar on phones",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_label",
      "label": "Label",
      "default": "The Pro Pack"
    },
    {
      "type": "text",
      "id": "sticky_product_handle",
      "label": "Product handle for live price",
      "default": "pro-pack"
    },
    {
      "type": "text",
      "id": "sticky_sub",
      "label": "Fallback sub-line",
      "info": "Shown only if the product handle doesn't resolve.",
      "default": "Free shipping on orders $50+"
    },
    {
      "type": "text",
      "id": "sticky_cta_text",
      "label": "Button text",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "Prodigy Hero"
    }
  ]
}
{% endschema %}
