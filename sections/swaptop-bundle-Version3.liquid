{% comment %}
  Swaptop Bundle v4 — Clean Configurator (restyled to match v1 aesthetic)
  Drop into: sections/swaptop-bundle-v4.liquid

  Aesthetic: clean white surface · Inter typography · green #23ff53 accent
  - Inter font throughout (no Fraunces / Space Grotesk)
  - White paper with subtle gray surfaces
  - Green primary accent, gold star rating
  - Soft rounded corners, no hard offset shadows
  - No tilted/rotated decorations, no italic display type

  Keeps every cart action, modal, lightbox and reel from v4.
  Uses sw4- prefix so both versions can coexist.
{% endcomment %}

{% assign main_product   = all_products['swaptop-kit'] %}
{% assign addon_football = all_products['swaptop-football'] %}
{% assign addon_og       = all_products['swaptop-og'] %}
{% assign addon_popgolf  = all_products['swaptop-popgolf'] %}

{% assign sid = section.id | replace: '-', '_' | replace: '.', '_' %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

  .sw4-section-{{ sid }} {
    --sw4-bg:       #ffffff;
    --sw4-bg-2:     #fafafa;
    --sw4-bg-3:     #f3f4f6;
    --sw4-text:     #0a0a0a;
    --sw4-text-2:   #525252;
    --sw4-text-3:   #a3a3a3;
    --sw4-line:     #ececec;
    --sw4-line-2:   #f4f4f4;
    --sw4-accent:   #23ff53;
    --sw4-accent-2: #16a34a;
    --sw4-accent-3: #065f46;
    --sw4-accent-soft: #f0fdf4;
    --sw4-accent-soft-2: #dcfce7;
    --sw4-star:     #f59e0b;
    --sw4-ink:      #0a0a0a;
    --sw4-font:     'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    --sw4-ease:     cubic-bezier(0.16, 1, 0.3, 1);

    position: relative;
    background: var(--sw4-bg);
    color: var(--sw4-text);
    overflow-x: clip;
    isolation: isolate;
    font-family: var(--sw4-font);
  }
  /* ambient glow behind hero area */
  .sw4-section-{{ sid }}::before {
    content: '';
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: min(900px, 90%);
    height: 520px;
    background:
      radial-gradient(60% 80% at 30% 40%, rgba(35,255,83,0.10) 0%, rgba(35,255,83,0) 70%),
      radial-gradient(50% 80% at 80% 30%, rgba(35,255,83,0.06) 0%, rgba(35,255,83,0) 70%);
    pointer-events: none;
    z-index: 0;
    filter: blur(8px);
  }
  .sw4-section-{{ sid }} *,
  .sw4-section-{{ sid }} *::before,
  .sw4-section-{{ sid }} *::after { box-sizing: border-box; }

  .sw4-section-{{ sid }}-inner {
    position: relative;
    z-index: 1;
    max-width: 1380px;
    margin: 0 auto;
    padding: 44px 20px 64px;
  }

  /* BUTTON RESET */
  .sw4-section-{{ sid }} button,
  body > .sw4-modal-{{ sid }} button {
    -webkit-appearance: none !important;
    appearance: none !important;
    border: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    min-width: 0 !important;
    min-height: 0 !important;
    line-height: 1 !important;
    font: inherit !important;
    color: inherit !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    cursor: pointer;
    box-sizing: border-box !important;
    box-shadow: none;
    background: transparent;
  }
  .sw4-section-{{ sid }} button::before,
  .sw4-section-{{ sid }} button::after,
  body > .sw4-modal-{{ sid }} button::before,
  body > .sw4-modal-{{ sid }} button::after {
    display: none !important;
    content: none !important;
  }

  /* HEADER */
  .sw4-header-{{ sid }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 40px;
    position: relative;
    max-width: 720px;
  }
  .sw4-eyebrow-{{ sid }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--sw4-font);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sw4-text-2);
  }
  .sw4-eyebrow-{{ sid }}::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--sw4-text);
  }
  .sw4-eyebrow-{{ sid }}::after {
    content: '— 04';
    color: var(--sw4-accent-2);
    font-weight: 800;
    letter-spacing: 0.06em;
    margin-left: 2px;
  }
  .sw4-headline-{{ sid }} {
    margin: 0;
    font-family: var(--sw4-font);
    font-weight: 800;
    font-size: clamp(44px, 9vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--sw4-text);
  }
  .sw4-headline-{{ sid }} em {
    font-style: normal;
    font-weight: 800;
    background: linear-gradient(120deg, var(--sw4-accent-2) 0%, var(--sw4-accent) 60%, var(--sw4-accent-2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
  }
  .sw4-headline-{{ sid }} em::after {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-left: -2px;
    margin-bottom: 0.08em;
    border-radius: 50%;
    background: var(--sw4-accent);
    vertical-align: baseline;
    box-shadow: 0 0 14px rgba(35,255,83,0.6);
  }
  .sw4-sub-{{ sid }} {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--sw4-text-2);
    max-width: 540px;
    font-weight: 400;
  }
  .sw4-header-meta-{{ sid }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    margin-top: 4px;
    padding-top: 18px;
    border-top: 1px solid var(--sw4-line);
  }
  .sw4-stars-{{ sid }} {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    background: transparent !important;
    padding: 0 !important;
  }
  .sw4-stars-icons-{{ sid }} { display: flex; gap: 2px; }
  .sw4-stars-icons-{{ sid }} span { color: var(--sw4-star); font-size: 16px; line-height: 1; }
  .sw4-stars-label-{{ sid }} {
    font-family: var(--sw4-font);
    font-size: 13px;
    font-weight: 600;
    color: var(--sw4-text);
    transition: color 0.2s ease;
  }
  .sw4-stars-label-{{ sid }}::after {
    content: '↗';
    margin-left: 4px;
    font-size: 11px;
    color: var(--sw4-text-3);
  }
  .sw4-stars-{{ sid }}:hover .sw4-stars-label-{{ sid }} { color: var(--sw4-accent-2); }
  .sw4-live-{{ sid }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sw4-font);
    font-size: 12px;
    font-weight: 600;
    color: var(--sw4-text-2);
    letter-spacing: 0;
    text-transform: none;
    background: transparent;
    border: 0;
    padding: 0;
  }
  .sw4-live-dot-{{ sid }} {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--sw4-accent-2);
    animation: sw4pulse-{{ sid }} 1.6s ease-in-out infinite;
  }
  @keyframes sw4pulse-{{ sid }} {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.5; transform: scale(0.85); }
  }

  /* BUILDER GRID */
  .sw4-builder-{{ sid }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: start;
  }
  .sw4-hero-col-{{ sid }} {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  /* HERO */
  .sw4-hero-{{ sid }} {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: var(--sw4-bg-2);
    border: 1px solid var(--sw4-line);
    aspect-ratio: 1 / 1;
    box-shadow:
      0 1px 2px rgba(0,0,0,0.04),
      0 8px 30px rgba(0,0,0,0.05);
  }
  .sw4-hero-stage-{{ sid }} {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: pointer;
  }
  .sw4-hero-num-{{ sid }} {
    display: none;
  }
  .sw4-hero-img-{{ sid }} {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    padding: 48px 32px 96px;
    display: block;
    z-index: 2;
    transition: opacity 0.25s ease;
  }
  .sw4-hero-pill-{{ sid }} {
    position: absolute;
    top: 16px; left: 16px;
    z-index: 4;
    padding: 7px 12px 7px 10px;
    border-radius: 100px;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--sw4-text);
    border: 1px solid rgba(0,0,0,0.06);
    font-family: var(--sw4-font);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .sw4-hero-pill-{{ sid }} .sw4-pulse {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--sw4-accent);
    box-shadow: 0 0 0 3px rgba(35,255,83,0.25);
    animation: sw4pulse-{{ sid }} 1.6s ease-in-out infinite;
  }
  .sw4-hero-counter-{{ sid }} {
    position: absolute;
    top: 16px; right: 16px;
    z-index: 4;
    padding: 7px 12px;
    border-radius: 100px;
    background: rgba(10,10,10,0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    font-family: var(--sw4-font);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }
  .sw4-hero-thumbs-{{ sid }} {
    position: absolute;
    bottom: 14px; left: 14px; right: 14px;
    z-index: 4;
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sw4-hero-thumbs-{{ sid }}::-webkit-scrollbar { display: none; }
  .sw4-hero-thumb-{{ sid }} {
    width: 54px !important; height: 54px !important;
    border-radius: 10px !important;
    overflow: hidden !important;
    cursor: pointer;
    border: 2px solid transparent !important;
    background: #fff !important;
    flex-shrink: 0;
    transition: border-color 0.2s !important;
    padding: 0 !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08) !important;
  }
  .sw4-hero-thumb-{{ sid }}.active,
  .sw4-hero-thumb-{{ sid }}:hover {
    border-color: var(--sw4-accent) !important;
  }
  .sw4-hero-thumb-{{ sid }} img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* KIT COMPOSITION */
  .sw4-comp-{{ sid }} {
    position: relative;
    padding: 16px 18px 18px;
    border-radius: 14px;
    border: 1px solid var(--sw4-line);
    background: #fff;
  }
  .sw4-comp-head-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--sw4-line);
  }
  .sw4-comp-eyebrow-{{ sid }} {
    font-family: var(--sw4-font);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sw4-text-2);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .sw4-comp-eyebrow-{{ sid }}::before {
    content: '';
    width: 5px; height: 5px;
    background: var(--sw4-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(35,255,83,0.2);
  }
  .sw4-comp-count-{{ sid }} {
    font-family: var(--sw4-font);
    font-weight: 800;
    font-size: 12px;
    color: var(--sw4-text);
    letter-spacing: 0.08em;
    padding: 4px 8px;
    background: var(--sw4-bg-2);
    border-radius: 6px;
    font-variant-numeric: tabular-nums;
  }
  .sw4-comp-pills-{{ sid }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .sw4-comp-pill-{{ sid }} {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 11px 4px 4px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid var(--sw4-line);
    font-family: var(--sw4-font);
    font-size: 12px;
    font-weight: 600;
    color: var(--sw4-text);
    animation: sw4pillin-{{ sid }} 0.3s ease-out both;
  }
  @keyframes sw4pillin-{{ sid }} {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 1; transform: scale(1); }
  }
  .sw4-comp-pill-img-{{ sid }} {
    width: 22px; height: 22px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--sw4-bg-3);
  }
  .sw4-comp-pill-img-{{ sid }} img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sw4-comp-plus-{{ sid }} {
    color: var(--sw4-text-3);
    font-family: var(--sw4-font);
    font-weight: 700;
    font-size: 14px;
  }

  /* CONFIGURATOR */
  .sw4-config-col-{{ sid }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .sw4-config-head-{{ sid }} {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 6px 2px 4px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--sw4-line);
    padding-bottom: 14px;
  }
  .sw4-config-title-{{ sid }} {
    margin: 0;
    font-family: var(--sw4-font);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.02em;
    text-transform: none;
    line-height: 1;
    color: var(--sw4-text);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .sw4-config-title-{{ sid }}::before {
    display: none;
    content: none;
  }
  .sw4-config-title-{{ sid }} em {
    font-style: normal;
    font-weight: 800;
    background: linear-gradient(120deg, var(--sw4-accent-2), var(--sw4-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .sw4-config-meta-{{ sid }} {
    font-family: var(--sw4-font);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--sw4-text-3);
    text-transform: none;
  }

  /* WIDE CARD */
  .sw4-card-{{ sid }} {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    border: 1.5px solid var(--sw4-line);
    transition: border-color 0.3s var(--sw4-ease), box-shadow 0.3s var(--sw4-ease), transform 0.3s var(--sw4-ease);
    display: grid;
    grid-template-columns: 110px 1fr;
    min-height: 110px;
  }
  .sw4-card-{{ sid }}::before { content: none; }
  .sw4-card-{{ sid }}:not(.locked):hover {
    border-color: #d4d4d4;
    box-shadow: 0 6px 20px rgba(0,0,0,0.05);
    transform: translateY(-1px);
  }
  .sw4-card-{{ sid }}.selected {
    border-color: var(--sw4-accent);
    box-shadow:
      0 0 0 1px var(--sw4-accent),
      0 6px 24px rgba(35,255,83,0.16);
  }
  .sw4-card-{{ sid }}.locked {
    border-color: var(--sw4-accent);
    box-shadow: 0 0 0 1px var(--sw4-accent);
  }
  /* subtle inner highlight on selected/locked */
  .sw4-card-{{ sid }}.selected::after,
  .sw4-card-{{ sid }}.locked::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(35,255,83,0.5), transparent);
    pointer-events: none;
    z-index: 5;
  }

  .sw4-card-img-{{ sid }} {
    position: relative;
    overflow: hidden;
    background: var(--sw4-bg-2);
    cursor: pointer;
  }
  .sw4-card-img-{{ sid }}::before { content: none; }
  .sw4-card-img-{{ sid }} img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    z-index: 1;
    transition: transform 0.3s ease;
  }
  .sw4-card-{{ sid }}:not(.locked):hover .sw4-card-img-{{ sid }} img { transform: scale(1.04); }

  .sw4-card-tag-{{ sid }} {
    position: absolute;
    top: 8px; left: 8px;
    z-index: 4;
    padding: 4px 9px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid var(--sw4-line);
    font-family: var(--sw4-font);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sw4-text);
  }
  .sw4-card-tag-{{ sid }}.is-included {
    background: var(--sw4-accent-soft);
    color: var(--sw4-accent-2);
    border-color: var(--sw4-accent-soft-2);
  }
  .sw4-card-tag-{{ sid }}.is-fave {
    background: #fffbeb;
    color: #b45309;
    border-color: #fde68a;
  }

  .sw4-card-body-{{ sid }} {
    padding: 12px 14px 12px 16px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px 14px;
    align-items: center;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }
  .sw4-card-{{ sid }}.locked .sw4-card-body-{{ sid }} { cursor: default; }
  .sw4-card-info-{{ sid }} { min-width: 0; }
  .sw4-card-eyebrow-{{ sid }} {
    display: block;
    font-family: var(--sw4-font);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sw4-text-3);
    margin-bottom: 4px;
  }
  .sw4-card-{{ sid }}.selected .sw4-card-eyebrow-{{ sid }},
  .sw4-card-{{ sid }}.locked   .sw4-card-eyebrow-{{ sid }} { color: var(--sw4-accent-2); }
  .sw4-card-title-{{ sid }} {
    margin: 0;
    font-family: var(--sw4-font);
    font-weight: 800;
    font-size: 17px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--sw4-text);
  }
  .sw4-card-sub-{{ sid }} {
    margin: 5px 0 0;
    font-size: 12px;
    color: var(--sw4-text-2);
    font-weight: 400;
    line-height: 1.4;
    display: none;
  }
  .sw4-card-aside-{{ sid }} {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    flex-shrink: 0;
  }
  .sw4-card-price-{{ sid }} {
    font-family: var(--sw4-font);
    font-weight: 800;
    font-size: 15px;
    color: var(--sw4-text);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .sw4-card-{{ sid }}.selected .sw4-card-price-{{ sid }},
  .sw4-card-{{ sid }}.locked   .sw4-card-price-{{ sid }} { color: var(--sw4-accent-2); }

  .sw4-card-action-{{ sid }} {
    width: 36px !important; height: 36px !important;
    aspect-ratio: 1 !important;
    border-radius: 50% !important;
    background: var(--sw4-bg-2) !important;
    border: 1px solid var(--sw4-line) !important;
    display: flex !important; align-items: center !important; justify-content: center !important;
    transition: background 0.2s ease, border-color 0.2s ease !important;
  }
  .sw4-card-action-{{ sid }}:hover {
    background: var(--sw4-bg-3) !important;
    border-color: #d1d5db !important;
  }
  .sw4-card-action-{{ sid }} svg { width: 14px; height: 14px; stroke: var(--sw4-text); transition: stroke 0.2s ease; }
  .sw4-card-{{ sid }}.selected .sw4-card-action-{{ sid }} {
    background: var(--sw4-accent) !important;
    border-color: var(--sw4-accent) !important;
  }
  .sw4-card-{{ sid }}.selected .sw4-card-action-{{ sid }} svg { stroke: #111 !important; }
  .sw4-card-{{ sid }}.locked .sw4-card-action-{{ sid }} {
    background: var(--sw4-accent) !important;
    border-color: var(--sw4-accent) !important;
    pointer-events: none !important;
  }
  .sw4-card-{{ sid }}.locked .sw4-card-action-{{ sid }} svg { stroke: #111 !important; }
  .sw4-card-action-{{ sid }} .sw4-icon-check { display: none; }
  .sw4-card-action-{{ sid }} .sw4-icon-plus  { display: block; }
  .sw4-card-{{ sid }}.selected .sw4-card-action-{{ sid }} .sw4-icon-plus  { display: none; }
  .sw4-card-{{ sid }}.selected .sw4-card-action-{{ sid }} .sw4-icon-check { display: block; }
  .sw4-card-{{ sid }}.locked .sw4-card-action-{{ sid }} .sw4-icon-plus  { display: none; }
  .sw4-card-{{ sid }}.locked .sw4-card-action-{{ sid }} .sw4-icon-check { display: block; }

  .sw4-card-detail-{{ sid }} {
    font-family: var(--sw4-font) !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.04em !important;
    color: var(--sw4-text-2) !important;
    background: transparent !important;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }
