    'sw4-card-og-{{ sid }}':       { name: '{{ addon_og.title | escape }}',       img: '{{ addon_og.featured_image | image_url: width: 80 }}' },
    'sw4-card-popgolf-{{ sid }}':  { name: '{{ addon_popgolf.title | escape }}',  img: '{{ addon_popgolf.featured_image | image_url: width: 80 }}' }
  };

  function sw4MakePillHtml(imgUrl, name) {
    return '<span class="sw4-comp-pill-{{ sid }}">' +
             '<span class="sw4-comp-pill-img-{{ sid }}"><img src="' + imgUrl + '" alt=""></span>' +
             name +
           '</span>';
  }
  function sw4PadTwo(n) { return n < 10 ? '0' + n : String(n); }

  function sw4ShowAddedPopup(card) {
    var overlay = card && card.querySelector('.sw4-card-popup-{{ sid }}');
    if (!overlay) return;
    if (overlay._hideTimer) clearTimeout(overlay._hideTimer);
    overlay.classList.add('show');
    overlay._hideTimer = setTimeout(function () { overlay.classList.remove('show'); }, 1400);
  }

  heroThumbBtns.forEach(function (t, i) {
    t.addEventListener('click', function () {
      heroThumbBtns.forEach(function (x) { x.classList.remove('active'); });
      t.classList.add('active');
      heroImg.style.opacity = '0';
      setTimeout(function () {
        heroImg.src = t.dataset.src;
        heroImg.style.opacity = '1';
      }, 180);
      var total = heroThumbBtns.length;
      heroCounter.textContent = sw4PadTwo(i + 1) + ' / ' + sw4PadTwo(total);
    });
  });
  if (heroCounter) heroCounter.textContent = '01 / ' + sw4PadTwo(heroThumbBtns.length);

  function sw4OpenCartDrawer() {
    var btn = document.querySelector('[data-cart-toggle],.cart-toggle,#cart-toggle,.js-cart-open');
    if (btn) { btn.click(); return; }
    document.dispatchEvent(new CustomEvent('cart:open'));
    document.dispatchEvent(new CustomEvent('theme:cart:open'));
  }

  function sw4RefreshCart() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var n = cart.item_count;
      document.querySelectorAll(
        '[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,#CartCount,.header__cart-count,.cart-count-bubble [aria-hidden]'
      ).forEach(function(el){ el.textContent = n; });
    }).catch(function(){});
    fetch('/?sections=cart-drawer,cart-icon-bubble').then(function(r){ return r.json(); }).then(function(sections){
      if (sections['cart-drawer']) {
        var liveDrawer  = document.querySelector('cart-drawer');
        var sectionWrap = liveDrawer && liveDrawer.closest('[id^="shopify-section-"]');
        if (sectionWrap) {
          sectionWrap.innerHTML = sections['cart-drawer'];
        } else if (liveDrawer) {
          var doc = new DOMParser().parseFromString(sections['cart-drawer'], 'text/html');
          var fd  = doc.querySelector('cart-drawer');
          if (fd) liveDrawer.outerHTML = fd.outerHTML;
        }
      }
      if (sections['cart-icon-bubble']) {
        var countEl  = document.querySelector('[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,.cart-count-bubble');
        var iconWrap = countEl && countEl.closest('[id^="shopify-section-"]');
        if (iconWrap) iconWrap.innerHTML = sections['cart-icon-bubble'];
      }
    }).catch(function(){});
  }

  function sw4EnforceKitQty() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      for (var i = 0; i < cart.items.length; i++) {
        if (cart.items[i].variant_id === SW4_MAIN_VARIANT && cart.items[i].quantity > 1) {
          fetch('/cart/change.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ id: cart.items[i].key, quantity: 1 })
          }).then(function(r){ return r.json(); }).then(sw4RefreshCart).catch(function(){});
          break;
        }
      }
    }).catch(function(){});
  }

  function sw4ApplySelected(card, selected) { card.classList.toggle('selected', selected); }

  function sw4RenderKit() {
    if (!compPillsEl) return;
    var html = sw4MakePillHtml('{{ main_product.featured_image | image_url: width: 80 }}', 'Frame');
    var count = 1;
    document.querySelectorAll('.sw4-card-{{ sid }}.selected:not(.locked)').forEach(function (card) {
      var d = SW4_PILL_DATA[card.id];
      if (!d) return;
      html += '<span class="sw4-comp-plus-{{ sid }}">+</span>';
      html += sw4MakePillHtml(d.img, d.name.split(' ')[0]);
      count++;
    });
    compPillsEl.innerHTML = html;
    if (compCountEl) compCountEl.textContent = sw4PadTwo(count) + (count === 1 ? ' ITEM' : ' ITEMS');
    if (heroNum)    heroNum.textContent = sw4PadTwo(count);
  }

  function sw4SyncFromCart() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var inCart = cart.items.map(function(i){ return i.variant_id; });
      document.querySelectorAll('.sw4-card-{{ sid }}:not(.locked)').forEach(function(card){
        var v = parseInt(card.dataset.variant, 10);
        if (v && inCart.indexOf(v) !== -1) sw4ApplySelected(card, true);
      });
      sw4UpdateTotal();
      sw4RenderKit();
    }).catch(function(){});
  }

  window['sw4ToggleAddon_{{ sid }}'] = function (card) {
    if (!card || card.classList.contains('locked')) return;
    var selecting    = !card.classList.contains('selected');
    var addonVariant = parseInt(card.dataset.variant, 10);

    sw4ApplySelected(card, selecting);
    sw4UpdateTotal();
    sw4RenderKit();

    if (selecting) sw4ShowAddedPopup(card);
    if (!addonVariant) return;

    if (selecting) {
      fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
        var inCart = cart.items.map(function(i){ return i.variant_id; });
        var items  = [];
        if (SW4_MAIN_VARIANT && inCart.indexOf(SW4_MAIN_VARIANT) === -1)
          items.push({ id: SW4_MAIN_VARIANT, quantity: 1 });
        if (inCart.indexOf(addonVariant) === -1)
          items.push({ id: addonVariant, quantity: 1 });
        if (!items.length) { sw4OpenCartDrawer(); return null; }
        return fetch('/cart/add.js', {
          method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
          body: JSON.stringify({ items: items })
        }).then(function(r){ return r.json(); });
      }).then(function(result){
        if (!result) return;
        sw4EnforceKitQty();
        sw4RefreshCart();
        sw4OpenCartDrawer();
      }).catch(function(){
        sw4ApplySelected(card, false);
        sw4UpdateTotal();
        sw4RenderKit();
      });
    } else {
      fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
        var addonKey = null;
        var kitKeys  = [];
        cart.items.forEach(function(item){
          if (String(item.variant_id) === String(addonVariant)) addonKey = item.key;
          if (item.variant_id === SW4_MAIN_VARIANT)             kitKeys.push(item.key);
        });
        var toRemove = kitKeys.slice();
        if (addonKey) toRemove.push(addonKey);
        if (!toRemove.length) return null;
        return Promise.all(toRemove.map(function(key){
          return fetch('/cart/change.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ id: key, quantity: 0 })
          }).then(function(r){ return r.json(); });
        }));
      }).then(function(result){
        if (result === null) return null;
        return fetch('/cart.js').then(function(r){ return r.json(); });
      }).then(function(cart){
        if (!cart) return null;
        var remaining = cart.items.filter(function(i){ return i.variant_id === SW4_MAIN_VARIANT; });
        if (!remaining.length) return true;
        return Promise.all(remaining.map(function(item){
          return fetch('/cart/change.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ id: item.key, quantity: 0 })
          }).then(function(r){ return r.json(); });
        })).then(function(){ return true; });
      }).then(function(ok){
        if (!ok) return null;
        return fetch('/cart/add.js', {
          method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
          body: JSON.stringify({ items: [{ id: SW4_MAIN_VARIANT, quantity: 1 }] })
        }).then(function(r){ return r.json(); });
      }).then(function(result){
        if (!result) return;
        sw4RefreshCart();
      }).catch(function(){
        sw4ApplySelected(card, true);
        sw4UpdateTotal();
        sw4RenderKit();
      });
    }
  };

  function sw4Money(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function sw4UpdateTotal() {
    var total   = SW4_BASE_PRICE;
    var compare = SW4_BASE_COMPARE;
    document.querySelectorAll('.sw4-card-{{ sid }}:not(.locked).selected').forEach(function (card) {
      var p = parseInt(card.dataset.price,   10) || 0;
      var c = parseInt(card.dataset.compare, 10) || 0;
      total   += p;
      compare += (c > 0 ? c : p);
    });
    if (totalEl) totalEl.textContent = sw4Money(total);
    var saved = compare - total;
    if (saved > 0) {
      if (totalCompareEl) { totalCompareEl.textContent = sw4Money(compare); totalCompareEl.style.cssText = 'display:inline;'; }
      if (totalSavingsEl) { totalSavingsEl.textContent = 'SAVE ' + sw4Money(saved); totalSavingsEl.style.cssText = 'display:inline-flex;'; }
    } else {
      if (totalCompareEl) totalCompareEl.style.cssText = 'display:none;';
      if (totalSavingsEl) totalSavingsEl.style.cssText = 'display:none;';
    }
    if (totalEl) {
      totalEl.classList.remove('bump');
      void totalEl.offsetWidth;
      totalEl.classList.add('bump');
      setTimeout(function () { totalEl.classList.remove('bump'); }, 300);
    }
  }

  function sw4GetItems() {
    var items = [{ id: SW4_MAIN_VARIANT, quantity: 1 }];
    document.querySelectorAll('.sw4-card-{{ sid }}:not(.locked).selected').forEach(function (card) {
      if (card.dataset.variant) items.push({ id: parseInt(card.dataset.variant, 10), quantity: 1 });
    });
    return items;
  }

  window['sw4AddToCart_{{ sid }}'] = function () {
    if (!ctaBtn || ctaBtn.classList.contains('loading')) return;
    ctaBtn.classList.add('loading');
    if (ctaText) ctaText.textContent = 'Adding...';
    document.querySelectorAll('.sw4-card-{{ sid }}:not(.locked).selected').forEach(function(card, i) {
      setTimeout(function(){ sw4ShowAddedPopup(card); }, i * 120);
    });
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var inCart   = cart.items.map(function(i){ return i.variant_id; });
      var allItems = sw4GetItems();
      var toAdd    = allItems.filter(function(item){ return inCart.indexOf(item.id) === -1; });
      sw4OpenCartDrawer();
      if (!toAdd.length) {
        ctaBtn.classList.remove('loading');
        if (ctaText) ctaText.textContent = 'Added ✓';
        setTimeout(function() { if (ctaText) ctaText.textContent = 'Add to Cart'; }, 2000);
        return null;
      }
      return fetch('/cart/add.js', {
        method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
        body: JSON.stringify({ items: toAdd })
      }).then(function(r){ return r.json(); });
    }).then(function(data){
      if (!data) return;
      if (data.status && data.status >= 400) throw new Error(data.description || 'Cart error');
      sw4EnforceKitQty();
      sw4RefreshCart();
      ctaBtn.classList.remove('loading');
      if (ctaText) ctaText.textContent = 'Added ✓';
      setTimeout(function() { if (ctaText) ctaText.textContent = 'Add to Cart'; }, 2000);
    }).catch(function(){
      ctaBtn.classList.remove('loading');
      if (ctaText) ctaText.textContent = 'Try Again';
      setTimeout(function() { if (ctaText) ctaText.textContent = 'Add to Cart'; }, 2500);
    });
  };

  window['sw4ScrollToReviews_{{ sid }}'] = function () {
    var target = document.querySelector('.jdgm-rev-widg__header');
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  document.querySelectorAll('.sw4-acc-{{ sid }} .sw4-acc-trigger-{{ sid }}').forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      var item   = trigger.closest('.sw4-acc-item-{{ sid }}');
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.sw4-acc-{{ sid }} .sw4-acc-item-{{ sid }}').forEach(function (i) {
        i.classList.remove('open');
        var trg = i.querySelector('.sw4-acc-trigger-{{ sid }}');
        if (trg) trg.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  sw4UpdateTotal();
  sw4RenderKit();
  sw4SyncFromCart();
})();
</script>

<script>
(function () {
  /* ── LIGHTBOX ── */
  var SW4_LB_IMAGES_DEFAULT = [
    {% assign first_img = main_product.images | first %}
    '{{ first_img | image_url: width: 1600 }}',
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Images_Popdarts_Images1.jpg?v=1778015525',
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Group_1484581343.png?v=1778015640'
    {% for image in main_product.images limit: 3 %}{% unless forloop.first %},'{{ image | image_url: width: 1600 }}'{% endunless %}{% endfor %}
  ];

  var SW4_FOOTBALL_LB = [{% for img in addon_football.images %}'{{ img | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}{% endfor %}];
  var SW4_OG_LB       = [{% for img in addon_og.images       %}'{{ img | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}{% endfor %}];
  var SW4_POPGOLF_LB  = [{% for img in addon_popgolf.images  %}'{{ img | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}{% endfor %}];

  var SW4_CARD_LB_MAP = {
    'sw4-card-football-{{ sid }}': SW4_FOOTBALL_LB,
    'sw4-card-og-{{ sid }}':       SW4_OG_LB,
    'sw4-card-popgolf-{{ sid }}':  SW4_POPGOLF_LB
  };

  var lbEl       = document.getElementById('sw4-lightbox-{{ sid }}');
  var lbImg      = document.getElementById('sw4-lb-img-{{ sid }}');
  var lbPrev     = document.getElementById('sw4-lb-prev-{{ sid }}');
  var lbNext     = document.getElementById('sw4-lb-next-{{ sid }}');
  var lbCounter  = document.getElementById('sw4-lb-counter-{{ sid }}');
  var lbImages   = SW4_LB_IMAGES_DEFAULT.slice();
  var lbIndex    = 0;

  function sw4RenderLb() {
    if (!lbImg) return;
    lbImg.style.opacity = '0';
    setTimeout(function () {
      lbImg.src = lbImages[lbIndex];
      lbImg.style.opacity = '1';
    }, 120);
    if (lbCounter) lbCounter.textContent = String(lbIndex + 1).padStart(2,'0') + ' / ' + String(lbImages.length).padStart(2,'0');
    if (lbPrev) lbPrev.disabled = lbIndex === 0;
    if (lbNext) lbNext.disabled = lbIndex === lbImages.length - 1;
  }

  window['sw4OpenLightbox_{{ sid }}'] = function (imageList, startIndex) {
    if (!lbEl) return;
    if (Array.isArray(imageList) && imageList.length) {
      lbImages = imageList.slice();
      lbIndex  = startIndex || 0;
    } else {
      lbImages = SW4_LB_IMAGES_DEFAULT.slice();
      var activeThumb = document.querySelector('.sw4-hero-thumb-{{ sid }}.active');
      lbIndex = activeThumb ? parseInt(activeThumb.dataset.idx, 10) || 0 : 0;
    }
    lbEl.classList.add('active');
    document.body.style.overflow = 'hidden';
    sw4RenderLb();
  };
  window['sw4CloseLightbox_{{ sid }}'] = function () {
    if (!lbEl) return;
    lbEl.classList.remove('active');
    document.body.style.overflow = '';
  };
  window['sw4LightboxNav_{{ sid }}'] = function (delta) {
    var next = lbIndex + delta;
    if (next < 0 || next > lbImages.length - 1) return;
    lbIndex = next;
    sw4RenderLb();
  };
  window['sw4CardImgClick_{{ sid }}'] = function (e, imgEl) {
    e.stopPropagation();
    var card = imgEl.closest('.sw4-card-{{ sid }}');
    if (!card) return;
    var imgList = SW4_CARD_LB_MAP[card.id];
    if (imgList && imgList.length > 0) {
      window['sw4OpenLightbox_{{ sid }}'](imgList, 0);
    } else {
      window['sw4ToggleAddon_{{ sid }}'](card);
    }
  };

  if (lbEl) {
    lbEl.addEventListener('click', function (e) {
      if (e.target === lbEl) window['sw4CloseLightbox_{{ sid }}']();
    });
  }
  document.addEventListener('keydown', function (e) {
    if (!lbEl || !lbEl.classList.contains('active')) return;
    if (e.key === 'Escape')      window['sw4CloseLightbox_{{ sid }}']();
    if (e.key === 'ArrowLeft')   window['sw4LightboxNav_{{ sid }}'](-1);
    if (e.key === 'ArrowRight')  window['sw4LightboxNav_{{ sid }}'](1);
  });
  var lbTouchX = null;
  if (lbEl) {
    lbEl.addEventListener('touchstart', function (e) { lbTouchX = e.touches[0].clientX; }, { passive: true });
    lbEl.addEventListener('touchend',   function (e) {
      if (lbTouchX === null) return;
      var dx = e.changedTouches[0].clientX - lbTouchX;
      if (Math.abs(dx) > 60) window['sw4LightboxNav_{{ sid }}'](dx > 0 ? -1 : 1);
      lbTouchX = null;
    }, { passive: true });
  }
})();
</script>

<script>
(function () {
  /* ── QUICK VIEW ── */
  var SW4_QV_DATA = {
    'sw4-card-football-{{ sid }}': {
      title:   '{{ addon_football.title | escape }}',
      desc:    {{ addon_football.description | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_football.price }},
      compare: {{ addon_football.compare_at_price | default: 0 }},
      images:  [{% for img in addon_football.images %}'{{ img | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}],
      thumbs:  [{% for img in addon_football.images %}'{{ img | image_url: width: 120 }}'{% unless forloop.last %},{% endunless %}{% endfor %}]
    },
    'sw4-card-og-{{ sid }}': {
      title:   '{{ addon_og.title | escape }}',
      desc:    {{ addon_og.description | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_og.price }},
      compare: {{ addon_og.compare_at_price | default: 0 }},
      images:  [{% for img in addon_og.images %}'{{ img | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}],
      thumbs:  [{% for img in addon_og.images %}'{{ img | image_url: width: 120 }}'{% unless forloop.last %},{% endunless %}{% endfor %}]
    },
    'sw4-card-popgolf-{{ sid }}': {
      title:   '{{ addon_popgolf.title | escape }}',
      desc:    {{ addon_popgolf.description | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_popgolf.price }},
      compare: {{ addon_popgolf.compare_at_price | default: 0 }},
      images:  [{% for img in addon_popgolf.images %}'{{ img | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}],
      thumbs:  [{% for img in addon_popgolf.images %}'{{ img | image_url: width: 120 }}'{% unless forloop.last %},{% endunless %}{% endfor %}]
    }
  };

  var qvOverlay = document.getElementById('sw4-qv-overlay-{{ sid }}');
  var qvPanel   = document.getElementById('sw4-qv-panel-{{ sid }}');
  var qvTitle   = document.getElementById('sw4-qv-title-{{ sid }}');
  var qvDesc    = document.getElementById('sw4-qv-desc-{{ sid }}');
  var qvImg     = document.getElementById('sw4-qv-main-img-{{ sid }}');
  var qvThumbs  = document.getElementById('sw4-qv-thumbs-{{ sid }}');
  var qvPrev    = document.getElementById('sw4-qv-prev-{{ sid }}');
  var qvNext    = document.getElementById('sw4-qv-next-{{ sid }}');
  var qvCount   = document.getElementById('sw4-qv-count-{{ sid }}');
  var qvSale    = document.getElementById('sw4-qv-price-sale-{{ sid }}');
  var qvCompare = document.getElementById('sw4-qv-price-compare-{{ sid }}');
  var qvBadge   = document.getElementById('sw4-qv-price-badge-{{ sid }}');
  var qvBtn     = document.getElementById('sw4-qv-add-{{ sid }}');
  var qvBtnLabel = document.getElementById('sw4-qv-add-label-{{ sid }}');

  var qvCurrentCardId = null;
  var qvImgIdx = 0;

  function sw4QvMoney(c) { return '$' + (c / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

  function sw4QvRenderImg() {
    var d = SW4_QV_DATA[qvCurrentCardId];
    if (!d || !qvImg) return;
    qvImg.style.opacity = '0';
    setTimeout(function () {
      qvImg.src = d.images[qvImgIdx];
      qvImg.style.opacity = '1';
    }, 120);
    if (qvCount) qvCount.textContent = (qvImgIdx + 1) + ' / ' + d.images.length;
    if (qvPrev) qvPrev.classList.toggle('off', qvImgIdx === 0);
    if (qvNext) qvNext.classList.toggle('off', qvImgIdx === d.images.length - 1);
    if (qvThumbs) {
      qvThumbs.querySelectorAll('.sw4-qv-thumb-{{ sid }}').forEach(function (t, i) {
        t.classList.toggle('active', i === qvImgIdx);
      });
    }
  }

  function sw4QvSyncBtn() {
    if (!qvCurrentCardId || !qvBtn) return;
    var card = document.getElementById(qvCurrentCardId);
    var inBundle = card && card.classList.contains('selected');
    if (inBundle) {
      qvBtn.classList.add('in-bundle');
      if (qvBtnLabel) qvBtnLabel.textContent = 'Already in Bundle';
    } else {
      qvBtn.classList.remove('in-bundle');
      if (qvBtnLabel) qvBtnLabel.textContent = 'Add to Bundle';
    }
  }

  window['sw4QvOpen_{{ sid }}'] = function (cardId) {
    var d = SW4_QV_DATA[cardId];
    if (!d || !qvOverlay) return;
    qvCurrentCardId = cardId;
    qvImgIdx = 0;
    if (qvTitle) qvTitle.textContent = d.title;
    if (qvDesc)  qvDesc.innerHTML    = d.desc || '';
    if (qvSale)  qvSale.textContent  = sw4QvMoney(d.price);
    if (d.compare && d.compare > d.price) {
      if (qvCompare) { qvCompare.textContent = sw4QvMoney(d.compare); qvCompare.style.cssText = 'display:inline;'; }
      if (qvBadge)   { qvBadge.textContent   = 'SAVE ' + sw4QvMoney(d.compare - d.price); qvBadge.style.cssText = 'display:inline-flex;'; }
    } else {
      if (qvCompare) qvCompare.style.cssText = 'display:none;';
      if (qvBadge)   qvBadge.style.cssText   = 'display:none;';
    }
    if (qvThumbs) {
      qvThumbs.innerHTML = '';
      d.thumbs.forEach(function (t, i) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'sw4-qv-thumb-{{ sid }}' + (i === 0 ? ' active' : '');
        btn.innerHTML = '<img src="' + t + '" alt="">';
        btn.onclick = function () { qvImgIdx = i; sw4QvRenderImg(); };
        qvThumbs.appendChild(btn);
      });
    }
    sw4QvRenderImg();
    sw4QvSyncBtn();
    qvOverlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  };

  window['sw4QvClose_{{ sid }}'] = function () {
    if (!qvOverlay) return;
    qvOverlay.style.display = 'none';
    document.body.style.overflow = '';
    qvCurrentCardId = null;
    if (qvPanel) {
      qvPanel.querySelectorAll('.sw4-qv-acc-{{ sid }}.open').forEach(function (acc) { acc.classList.remove('open'); });
    }
  };

  window['sw4QvNav_{{ sid }}'] = function (delta) {
    var d = SW4_QV_DATA[qvCurrentCardId];
    if (!d) return;
    var next = qvImgIdx + delta;
    if (next < 0 || next > d.images.length - 1) return;
    qvImgIdx = next;
    sw4QvRenderImg();
  };

  window['sw4QvAccToggle_{{ sid }}'] = function (trigger) {
    var item = trigger.parentElement;
    item.classList.toggle('open');
    trigger.setAttribute('aria-expanded', item.classList.contains('open') ? 'true' : 'false');
  };

  window['sw4QvCtaClick_{{ sid }}'] = function () {
    if (!qvCurrentCardId) return;
    if (qvBtn && qvBtn.classList.contains('in-bundle')) return;
    var card = document.getElementById(qvCurrentCardId);
    if (!card) return;
    if (typeof window['sw4ToggleAddon_{{ sid }}'] === 'function') {
      window['sw4ToggleAddon_{{ sid }}'](card);
    }
    setTimeout(function () { sw4QvSyncBtn(); }, 120);
    setTimeout(function () { window['sw4QvClose_{{ sid }}'](); }, 350);
  };

  if (qvOverlay) {
    qvOverlay.addEventListener('click', function (e) {
      if (e.target === qvOverlay) window['sw4QvClose_{{ sid }}']();
    });
  }
  document.addEventListener('keydown', function (e) {
    if (!qvOverlay || qvOverlay.style.display !== 'flex') return;
    if (e.key === 'Escape')     window['sw4QvClose_{{ sid }}']();
    if (e.key === 'ArrowLeft')  window['sw4QvNav_{{ sid }}'](-1);
    if (e.key === 'ArrowRight') window['sw4QvNav_{{ sid }}'](1);
  });
  var qvTouchX = null;
  var imgWrap  = qvPanel && qvPanel.querySelector('.sw4-qv-img-wrap-{{ sid }}');
  if (imgWrap) {
    imgWrap.addEventListener('touchstart', function (e) { qvTouchX = e.touches[0].clientX; }, { passive: true });
    imgWrap.addEventListener('touchend',   function (e) {
      if (qvTouchX === null) return;
      var dx = e.changedTouches[0].clientX - qvTouchX;
      if (Math.abs(dx) > 50) window['sw4QvNav_{{ sid }}'](dx > 0 ? -1 : 1);
      qvTouchX = null;
    }, { passive: true });
  }
})();
</script>

<script>
(function () {
  /* ── VIDEO REELS ── */
  var SW4_REELS = [
    { url: 'https://cdn.shopify.com/videos/c/o/v/82b6e4e61510421e8d96ec8939aeb02f.mp4', title: "What's Swaptop?" },
    { url: 'https://cdn.shopify.com/videos/c/o/v/b163bf830556460ba6fa9ac912debc50.mp4', title: "What's Included" },
    { url: 'https://cdn.shopify.com/videos/c/o/v/c093e4799d554399a99542aa17674570.mp4', title: 'Other Tops' }
  ];

  /* Inline reel autoplay */
  var inlineReels = document.querySelectorAll('.sw4-section-{{ sid }} .sw4-reel-{{ sid }}');
  inlineReels.forEach(function (reelEl, i) {
    var video = reelEl.querySelector('.sw4-reel-video-{{ sid }}');
    var data  = SW4_REELS[i];
    if (!video || !data) return;
    video.src = data.url;
    video.muted = true;
    video.playsInline = true;
    video.loop = true;
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');
    video.load();
    var attemptPlay = function () {
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    };
    video.addEventListener('loadeddata', attemptPlay);
    setTimeout(attemptPlay, 200);
  });

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var video = entry.target.querySelector('.sw4-reel-video-{{ sid }}');
        if (!video) return;
        if (entry.isIntersecting) {
          var p = video.play();
          if (p && p.catch) p.catch(function () {});
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.25 });
    inlineReels.forEach(function (r) { io.observe(r); });
  }

  /* Reel overlay */
  var reelOverlay = document.getElementById('sw4-reel-overlay-{{ sid }}');
  var reelVideo   = document.getElementById('sw4-reel-video-{{ sid }}');
  var reelTitleEl = document.getElementById('sw4-reel-overlay-title-{{ sid }}');
  var reelCounter = document.getElementById('sw4-reel-counter-{{ sid }}');
  var reelMute    = document.getElementById('sw4-reel-mute-{{ sid }}');
  var reelPrev    = document.getElementById('sw4-reel-prev-{{ sid }}');
  var reelNext    = document.getElementById('sw4-reel-next-{{ sid }}');
  var reelClose   = document.getElementById('sw4-reel-close-{{ sid }}');
  var reelIdx     = 0;

  function sw4OpenReel(i) {
    if (!reelOverlay || !reelVideo) return;
    reelIdx = i;
    var d = SW4_REELS[i];
    if (!d) return;
    reelVideo.src = d.url;
    reelVideo.muted = false;
    reelVideo.load();
    var p = reelVideo.play();
    if (p && p.catch) p.catch(function () { reelVideo.muted = true; reelVideo.play(); });
    if (reelTitleEl) reelTitleEl.textContent = d.title;
    if (reelCounter) reelCounter.textContent = (i + 1) + ' / ' + SW4_REELS.length;
    if (reelMute)    reelMute.classList.toggle('is-on', !reelVideo.muted);
    if (reelPrev)    reelPrev.disabled = i === 0;
    if (reelNext)    reelNext.disabled = i === SW4_REELS.length - 1;
    reelOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function sw4CloseReel() {
    if (!reelOverlay) return;
    reelOverlay.classList.remove('active');
    document.body.style.overflow = '';
    if (reelVideo) { reelVideo.pause(); reelVideo.removeAttribute('src'); reelVideo.load(); }
  }
  function sw4NavReel(delta) {
    var next = reelIdx + delta;
    if (next < 0 || next > SW4_REELS.length - 1) return;
    sw4OpenReel(next);
  }
  function sw4ToggleReelMute() {
    if (!reelVideo || !reelMute) return;
    reelVideo.muted = !reelVideo.muted;
    reelMute.classList.toggle('is-on', !reelVideo.muted);
  }

  inlineReels.forEach(function (reelEl, i) {
    reelEl.addEventListener('click', function () { sw4OpenReel(i); });
  });
  if (reelClose) reelClose.addEventListener('click', sw4CloseReel);
  if (reelPrev)  reelPrev.addEventListener('click',  function () { sw4NavReel(-1); });
  if (reelNext)  reelNext.addEventListener('click',  function () { sw4NavReel(1); });
  if (reelMute)  reelMute.addEventListener('click',  function (e) { e.stopPropagation(); sw4ToggleReelMute(); });
  if (reelOverlay) {
    reelOverlay.addEventListener('click', function (e) {
      if (e.target === reelOverlay) sw4CloseReel();
    });
  }
  document.addEventListener('keydown', function (e) {
    if (!reelOverlay || !reelOverlay.classList.contains('active')) return;
    if (e.key === 'Escape')     sw4CloseReel();
    if (e.key === 'ArrowLeft')  sw4NavReel(-1);
    if (e.key === 'ArrowRight') sw4NavReel(1);
    if (e.key === 'm' || e.key === 'M') sw4ToggleReelMute();
  });
  var reelTouchX = null, reelTouchY = null;
  if (reelOverlay) {
    reelOverlay.addEventListener('touchstart', function (e) {
      reelTouchX = e.touches[0].clientX;
      reelTouchY = e.touches[0].clientY;
    }, { passive: true });
    reelOverlay.addEventListener('touchend', function (e) {
      if (reelTouchX === null) return;
      var dx = e.changedTouches[0].clientX - reelTouchX;
      var dy = e.changedTouches[0].clientY - reelTouchY;
      if (Math.abs(dy) > Math.abs(dx) && dy < -80) {
        sw4CloseReel();
      } else if (Math.abs(dx) > 60) {
        sw4NavReel(dx > 0 ? -1 : 1);
      }
      reelTouchX = null; reelTouchY = null;
    }, { passive: true });
  }
})();
</script>

<script>
(function () {
  /* ── CART POLLING ── */
  var SW4_LAST_FP = null;
  var SW4_MAIN_VARIANT = {{ main_product.first_available_variant.id }};

  function sw4PollFp(cart) {
    return cart.items.map(function (i) { return i.variant_id + ':' + i.quantity; }).sort().join('|');
  }

  function sw4PollRebuildKit(cart) {
    var inCart = cart.items.map(function (i) { return i.variant_id; });
    document.querySelectorAll('.sw4-section-{{ sid }} .sw4-card-{{ sid }}:not(.locked)').forEach(function (card) {
      var v = parseInt(card.dataset.variant, 10);
      if (!v) return;
      var shouldBe = inCart.indexOf(v) !== -1;
      card.classList.toggle('selected', shouldBe);
    });
  }

  function sw4PollUpdateTotal() {
    var totalEl    = document.getElementById('sw4-total-{{ sid }}');
    var compareEl  = document.getElementById('sw4-total-compare-{{ sid }}');
    var savingsEl  = document.getElementById('sw4-total-savings-{{ sid }}');
    var compPills  = document.getElementById('sw4-comp-pills-{{ sid }}');
    var compCount  = document.getElementById('sw4-comp-count-{{ sid }}');
    var heroNumEl  = document.getElementById('sw4-hero-num-{{ sid }}');
    var basePrice   = {{ main_product.price }};
    var baseCompare = {{ main_product.compare_at_price | default: main_product.price }};
    var total = basePrice;
    var compare = baseCompare;
    document.querySelectorAll('.sw4-section-{{ sid }} .sw4-card-{{ sid }}:not(.locked).selected').forEach(function (card) {
      var p = parseInt(card.dataset.price,   10) || 0;
      var c = parseInt(card.dataset.compare, 10) || 0;
      total   += p;
      compare += (c > 0 ? c : p);
    });
    function money(c) { return '$' + (c / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
    function padTwo(n) { return n < 10 ? '0' + n : String(n); }
    if (totalEl) totalEl.textContent = money(total);
    var saved = compare - total;
    if (saved > 0) {
      if (compareEl) { compareEl.textContent = money(compare); compareEl.style.cssText = 'display:inline;'; }
      if (savingsEl) { savingsEl.textContent = 'SAVE ' + money(saved); savingsEl.style.cssText = 'display:inline-flex;'; }
    } else {
      if (compareEl) compareEl.style.cssText = 'display:none;';
      if (savingsEl) savingsEl.style.cssText = 'display:none;';
    }
    if (totalEl) {
      totalEl.classList.remove('bump');
      void totalEl.offsetWidth;
      totalEl.classList.add('bump');
      setTimeout(function () { totalEl.classList.remove('bump'); }, 300);
    }
    var PILL_DATA = {
      'sw4-card-football-{{ sid }}': { name: '{{ addon_football.title | escape | split: " " | first }}', img: '{{ addon_football.featured_image | image_url: width: 80 }}' },
      'sw4-card-og-{{ sid }}':       { name: '{{ addon_og.title       | escape | split: " " | first }}', img: '{{ addon_og.featured_image       | image_url: width: 80 }}' },
      'sw4-card-popgolf-{{ sid }}':  { name: '{{ addon_popgolf.title  | escape | split: " " | first }}', img: '{{ addon_popgolf.featured_image  | image_url: width: 80 }}' }
    };
    if (compPills) {
      var html = '<span class="sw4-comp-pill-{{ sid }}">' +
                   '<span class="sw4-comp-pill-img-{{ sid }}"><img src="{{ main_product.featured_image | image_url: width: 80 }}" alt=""></span>' +
                   'Frame' +
                 '</span>';
      var count = 1;
      document.querySelectorAll('.sw4-section-{{ sid }} .sw4-card-{{ sid }}.selected:not(.locked)').forEach(function (card) {
        var d = PILL_DATA[card.id];
        if (!d) return;
        html += '<span class="sw4-comp-plus-{{ sid }}">+</span>';
        html += '<span class="sw4-comp-pill-{{ sid }}">' +
                  '<span class="sw4-comp-pill-img-{{ sid }}"><img src="' + d.img + '" alt=""></span>' +
                  d.name +
                '</span>';
        count++;
      });
      compPills.innerHTML = html;
      if (compCount) compCount.textContent = padTwo(count) + (count === 1 ? ' ITEM' : ' ITEMS');
      if (heroNumEl) heroNumEl.textContent = padTwo(count);
    }
  }

  function sw4PollCart() {
    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var fp = sw4PollFp(cart);
        if (SW4_LAST_FP === null) { SW4_LAST_FP = fp; return; }
        if (fp === SW4_LAST_FP) return;
        SW4_LAST_FP = fp;
        sw4PollRebuildKit(cart);
        sw4PollUpdateTotal();
        document.dispatchEvent(new CustomEvent('sw4:cartUpdated-{{ sid }}', { detail: { cart: cart } }));
      })
      .catch(function () {});
  }

  setInterval(sw4PollCart, 2500);
  setTimeout(sw4PollCart, 600);
})();
</script>

<script>
(function () {
  /* ── UPCART STYLE OVERRIDES (scoped to #CartPopup) — matches v1 clean aesthetic ── */
  var SW4_UPCART_CSS = [
    '#CartPopup,#CartPopup *{font-family:"Inter",-apple-system,BlinkMacSystemFont,system-ui,sans-serif!important;box-sizing:border-box!important}',

    /* HEADER */
