<section class="sw4-section-{{ sid }}">
  <div class="sw4-section-{{ sid }}-inner">



    <!-- BUILDER -->
    <div class="sw4-builder-{{ sid }}">

      <!-- LEFT: Hero + Kit Composition -->
      <div class="sw4-hero-col-{{ sid }}">

        <div class="sw4-hero-{{ sid }}">
          <div class="sw4-hero-stage-{{ sid }}" onclick="sw4OpenLightbox_{{ sid }}()">
            <span class="sw4-hero-pill-{{ sid }}">
              <span class="sw4-pulse"></span>
              Live Preview
            </span>
            <span class="sw4-hero-counter-{{ sid }}" id="sw4-hero-counter-{{ sid }}">01 / 05</span>
            <span class="sw4-hero-num-{{ sid }}" id="sw4-hero-num-{{ sid }}">01</span>
            <img
              id="sw4-hero-img-{{ sid }}"
              class="sw4-hero-img-{{ sid }}"
              src="{{ main_product.featured_image | image_url: width: 1200 }}"
              alt="{{ main_product.title }}"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            >
          </div>

          <div class="sw4-hero-thumbs-{{ sid }}" id="sw4-hero-thumbs-{{ sid }}">
            {% assign first_img = main_product.images | first %}
            <button type="button" class="sw4-hero-thumb-{{ sid }} active" data-src="{{ first_img | image_url: width: 1600 }}" data-idx="0" aria-label="Image 1">
              <img src="{{ first_img | image_url: width: 200 }}" alt="{{ main_product.title }} 1" loading="eager">
            </button>
            
            {% for image in main_product.images limit: 3 %}
              {% unless forloop.first %}
                <button type="button" class="sw4-hero-thumb-{{ sid }}" data-src="{{ image | image_url: width: 1600 }}" data-idx="{{ forloop.index | plus: 2 }}" aria-label="Image {{ forloop.index | plus: 2 }}">
                  <img src="{{ image | image_url: width: 200 }}" alt="{{ main_product.title }} {{ forloop.index }}" loading="eager">
                </button>
              {% endunless %}
            {% endfor %}
          </div>
        </div>

        <!-- KIT COMPOSITION -->
        <div class="sw4-comp-{{ sid }}">
          <div class="sw4-comp-head-{{ sid }}">
            <span class="sw4-comp-eyebrow-{{ sid }}">Your Kit</span>
            <span class="sw4-comp-count-{{ sid }}" id="sw4-comp-count-{{ sid }}">01 ITEM</span>
          </div>
          <div class="sw4-comp-pills-{{ sid }}" id="sw4-comp-pills-{{ sid }}"></div>
        </div>

      </div>

      <!-- RIGHT: Configurator -->
      <div class="sw4-config-col-{{ sid }}">

        <div class="sw4-config-head-{{ sid }}">
          <h3 class="sw4-config-title-{{ sid }}">Add <em>Your Tops</em></h3>
          <span class="sw4-config-meta-{{ sid }}">More you stack, more you save</span>
        </div>

        <!-- FRAME (locked) -->
        <div class="sw4-card-{{ sid }} selected locked" data-num="01" id="sw4-card-main-{{ sid }}">
          <div class="sw4-card-img-{{ sid }}" onclick="sw4OpenLightbox_{{ sid }}()">
            <span class="sw4-card-tag-{{ sid }} is-included">Included</span>
            <img src="{{ main_product.featured_image | image_url: width: 600 }}" alt="{{ main_product.title }}" loading="eager">
          </div>
          <div class="sw4-card-body-{{ sid }}">
            <div class="sw4-card-info-{{ sid }}">
              <span class="sw4-card-eyebrow-{{ sid }}">The Frame</span>
              <h4 class="sw4-card-title-{{ sid }}">{{ main_product.title }}</h4>
              <p class="sw4-card-sub-{{ sid }}">The base of every Swaptop kit. One frame, endless tops.</p>
            </div>
            <div class="sw4-card-aside-{{ sid }}">
              <span class="sw4-card-price-{{ sid }}">{{ main_product.price | money_without_trailing_zeros }}</span>
              <button type="button" class="sw4-card-action-{{ sid }}" tabindex="-1" aria-label="Always included">
                <svg class="sw4-icon-plus" viewBox="0 0 16 16" fill="none" stroke-width="2.8" stroke-linecap="round"><line x1="8" y1="3" x2="8" y2="13"/><line x1="3" y1="8" x2="13" y2="8"/></svg>
                <svg class="sw4-icon-check" viewBox="0 0 16 16" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,8 6,12 14,4"/></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- FOOTBALL -->
        <div
          class="sw4-card-{{ sid }}"
          data-num="02"
          id="sw4-card-football-{{ sid }}"
          data-variant="{{ addon_football.first_available_variant.id }}"
          data-price="{{ addon_football.price }}"
          data-compare="{{ addon_football.compare_at_price | default: addon_football.price }}"
        >
          <div class="sw4-card-img-{{ sid }}" onclick="sw4CardImgClick_{{ sid }}(event, this)">
            <div class="sw4-card-popup-{{ sid }}">
              <div class="sw4-card-popup-badge-{{ sid }}">
                <svg viewBox="0 0 16 16" fill="none" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,8 6,12 14,4"/></svg>
                Added
              </div>
            </div>
            <span class="sw4-card-tag-{{ sid }} is-fave">★ Fan Fave</span>
            <img src="{{ addon_football.featured_image | image_url: width: 600 }}" alt="{{ addon_football.title }}" loading="eager">
          </div>
          <div class="sw4-card-body-{{ sid }}" onclick="sw4ToggleAddon_{{ sid }}(this.closest('.sw4-card-{{ sid }}'))">
            <div class="sw4-card-info-{{ sid }}">
              <span class="sw4-card-eyebrow-{{ sid }}">Top 01 — Most Popular</span>
              <h4 class="sw4-card-title-{{ sid }}">{{ addon_football.title }}</h4>
              <p class="sw4-card-sub-{{ sid }}">Score touchdowns with friends — the crowd favorite.</p>
            </div>
            <div class="sw4-card-aside-{{ sid }}">
              <span class="sw4-card-price-{{ sid }}">+{{ addon_football.price | money_without_trailing_zeros }}</span>
              <button type="button" class="sw4-card-action-{{ sid }}" onclick="event.stopPropagation(); sw4ToggleAddon_{{ sid }}(this.closest('.sw4-card-{{ sid }}'))" aria-label="Add to bundle">
                <svg class="sw4-icon-plus" viewBox="0 0 16 16" fill="none" stroke-width="2.8" stroke-linecap="round"><line x1="8" y1="3" x2="8" y2="13"/><line x1="3" y1="8" x2="13" y2="8"/></svg>
                <svg class="sw4-icon-check" viewBox="0 0 16 16" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,8 6,12 14,4"/></svg>
              </button>
              <button type="button" class="sw4-card-detail-{{ sid }}" onclick="event.stopPropagation(); sw4QvOpen_{{ sid }}('sw4-card-football-{{ sid }}')">Details →</button>
            </div>
          </div>
        </div>

        <!-- OG -->
        <div
          class="sw4-card-{{ sid }}"
          data-num="03"
          id="sw4-card-og-{{ sid }}"
          data-variant="{{ addon_og.first_available_variant.id }}"
          data-price="{{ addon_og.price }}"
          data-compare="{{ addon_og.compare_at_price | default: addon_og.price }}"
        >
          <div class="sw4-card-img-{{ sid }}" onclick="sw4CardImgClick_{{ sid }}(event, this)">
            <div class="sw4-card-popup-{{ sid }}">
              <div class="sw4-card-popup-badge-{{ sid }}">
                <svg viewBox="0 0 16 16" fill="none" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,8 6,12 14,4"/></svg>
                Added
              </div>
            </div>
            <img src="{{ addon_og.featured_image | image_url: width: 600 }}" alt="{{ addon_og.title }}" loading="eager">
          </div>
          <div class="sw4-card-body-{{ sid }}" onclick="sw4ToggleAddon_{{ sid }}(this.closest('.sw4-card-{{ sid }}'))">
            <div class="sw4-card-info-{{ sid }}">
