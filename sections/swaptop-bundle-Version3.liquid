    '#CartPopup .upcart-product-image-wrapper img{width:100%!important;height:100%!important;object-fit:cover!important;display:block!important}',
    '#CartPopup .upcart-product-title a,#CartPopup .upcart-product-title{font-size:13px!important;font-weight:700!important;color:#111!important;text-decoration:none!important}',
    '#CartPopup .upcart-item-price{font-size:14px!important;font-weight:800!important;color:#111!important}',
    '#CartPopup .upcart-item-compare-price{font-size:12px!important;color:#aaa!important;text-decoration:line-through!important}',
    '#CartPopup .upcart-product-savings{font-size:11px!important;font-weight:800!important;color:#16a34a!important}',

    /* QUANTITY STEPPER */
    '#CartPopup [class*="QuantityField"]{border:1.5px solid #e5e7eb!important;border-radius:8px!important;overflow:hidden!important;background:#fff!important;display:flex!important;align-items:center!important}',
    '#CartPopup .upcart-product-quantity-minus,#CartPopup .upcart-product-quantity-plus{background:#f9fafb!important;width:30px!important;min-width:30px!important;height:30px!important;border:none!important;display:flex!important;align-items:center!important;justify-content:center!important;cursor:pointer!important}',
    '#CartPopup .upcart-product-quantity-input{font-size:13px!important;font-weight:700!important;color:#111!important;width:36px!important;text-align:center!important;border:none!important;background:#fff!important}',
    '#CartPopup .upcart-product-quantity-minus svg path,#CartPopup .upcart-product-quantity-plus svg path{fill:#111!important}',

    /* TRASH */
    '#CartPopup [class*="TrashButton"]{opacity:.35!important;cursor:pointer!important}',
    '#CartPopup [class*="TrashButton"] svg path{stroke:#ef4444!important}',

    /* DISCOUNT BADGE */
    '#CartPopup .upcart-discount-code-badge{background:#f0fdf4!important;border:1px solid #bbf7d0!important;border-radius:20px!important;padding:3px 8px 3px 6px!important;display:inline-flex!important;align-items:center!important;gap:4px!important;margin-top:4px!important}',
    '#CartPopup .upcart-discount-code-text{font-size:10px!important;font-weight:700!important;color:#16a34a!important;letter-spacing:.04em!important;text-transform:uppercase!important}',
    '#CartPopup .upcart-discount-code-icon svg path{fill:#16a34a!important}',

    /* FOOTER */
    '#CartPopup .upcart-footer{background:#fff!important;border-top:1px solid #e5e7eb!important;padding:14px 18px!important}',
    '#CartPopup .upcart-savings-amount{font-size:15px!important;font-weight:900!important;color:#16a34a!important}',

    /* CHECKOUT BUTTON */
    '#CartPopup .upcart-checkout-button{background:#23ff53!important;color:#000!important;font-family:"Inter",sans-serif!important;font-size:15px!important;font-weight:900!important;letter-spacing:.07em!important;text-transform:uppercase!important;border-radius:10px!important;padding:16px 20px!important;border:none!important;width:100%!important;display:block!important;text-align:center!important;text-decoration:none!important;box-shadow:0 4px 18px rgba(35,255,83,.4)!important}'
  ].join('\n');

  var hoverCss = [
    '#CartPopup .upcart-product-quantity-minus:hover,#CartPopup .upcart-product-quantity-plus:hover{background:#23ff53!important}',
    '#CartPopup [class*="TrashButton"]:hover{opacity:1!important}',
    '#CartPopup .upcart-checkout-button:hover{background:#16a34a!important;color:#fff!important;transform:translateY(-1px)!important;box-shadow:0 8px 28px rgba(22,163,74,.45)!important}',
    '#CartPopup .upcart-checkout-button:active{transform:translateY(0)!important}'
  ].join('\n');

  function sw4InjectUpcartCss() {
    if (document.getElementById('sw4-upcart-styles')) return;
    var style = document.createElement('style');
    style.id = 'sw4-upcart-styles';
    style.textContent = SW4_UPCART_CSS + hoverCss;
    document.head.appendChild(style);
  }

  sw4InjectUpcartCss();

  if (typeof MutationObserver !== 'undefined') {
    var mo = new MutationObserver(function () {
      if (!document.getElementById('sw4-upcart-styles')) sw4InjectUpcartCss();
    });
    mo.observe(document.documentElement, { childList: true, subtree: false });
  }
})();
</script>

