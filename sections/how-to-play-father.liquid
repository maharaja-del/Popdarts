      <button class="vsf-cta" id="vsf-add-btn" aria-label="Add Rookie Pack to cart">
        <span class="vsf-cta__icon">
          <svg viewBox="0 0 24 24">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
        </span>
        <span class="vsf-cta__label">Add Rookie Pack to Cart</span>
      </button>
      <span class="vsf-cta-note">Free shipping in the USA &nbsp;·&nbsp; Free gift card over $210</span>
    </div>

  </div>
</section>

<script>
(function(){
  var split = document.querySelector('.vsf-split');
  var items = document.querySelectorAll('.vsf-item');

  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting) return;
      e.target.classList.add('vsf-in');
      obs.unobserve(e.target);
    });
  },{threshold:0.08, rootMargin:'0px 0px -32px 0px'});

  if(split) obs.observe(split);

  var iObs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting) return;
      var el = e.target;
      setTimeout(function(){ el.classList.add('vsf-item-in'); }, parseInt(el.dataset.idx) * 80);
      iObs.unobserve(el);
    });
  },{threshold:0.1});

  items.forEach(function(el, i){ el.dataset.idx = i; iObs.observe(el); });

  /* ── Add to Cart ── */
  var btn = document.getElementById('vsf-add-btn');
  var label = btn && btn.querySelector('.vsf-cta__label');
  if(!btn) return;

  function openCart(){
    document.dispatchEvent(new CustomEvent('cart:open'));
    document.dispatchEvent(new CustomEvent('theme:cart:open'));
    var d = document.querySelector('cart-drawer');
    if(d && typeof d.open==='function') d.open();
  }

  function doAdd(vid){
    btn.classList.add('is-loading');
    label.textContent = 'Adding…';
    fetch('/cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({id:vid, quantity:1})
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.classList.remove('is-loading');
      if(data.id){
        btn.classList.add('is-added');
        label.textContent = '✓ Added to Cart!';
        openCart();
        setTimeout(function(){
          btn.classList.remove('is-added');
          label.textContent = 'Add Rookie Pack to Cart';
        }, 3000);
      } else {
        label.textContent = 'Try Again';
        setTimeout(function(){ label.textContent = 'Add Rookie Pack to Cart'; }, 2000);
      }
    })
    .catch(function(){
      btn.classList.remove('is-loading');
      label.textContent = 'Error — Try Again';
      setTimeout(function(){ label.textContent = 'Add Rookie Pack to Cart'; }, 2000);
    });
  }

  btn.addEventListener('click', function(){
    if(btn.classList.contains('is-loading') || btn.classList.contains('is-added')) return;
    var vid = {{ section.settings.variant_id | default: 'null' }};
    if(vid){
      doAdd(vid);
    } else {
      fetch('/products/rookie-pack.js')
        .then(function(r){ return r.json(); })
        .then(function(p){
          var id = p.variants && p.variants[0] && p.variants[0].id;
          if(id){ doAdd(id); }
          else {
            label.textContent = 'Product Not Found';
            setTimeout(function(){ label.textContent = 'Add Rookie Pack to Cart'; }, 2000);
          }
        })
        .catch(function(){
          btn.classList.remove('is-loading');
          label.textContent = 'Error — Try Again';
          setTimeout(function(){ label.textContent = 'Add Rookie Pack to Cart'; }, 2000);
        });
    }
  });
})();
</script>

