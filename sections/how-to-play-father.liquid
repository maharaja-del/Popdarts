    {"type":"image_picker","id":"popdarts_img","label":"POPDARTS ROOKIE PACK Image"},
    {
      "type":"text",
      "id":"variant_id",
      "label":"Rookie Pack Variant ID",
      "info":"Optional. Paste the exact variant ID. If blank, auto-discovers from the product handle 'rookie-pack'."
    }
  ],
  "presets":[{"name":"VS Comparison (Father)"}]
}
