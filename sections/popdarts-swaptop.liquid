{%- comment -%} Photo 1 (large, portrait): picker → bundled asset → default {%- endcomment -%}
{%- if section.settings.image -%}
  {%- assign img_a = section.settings.image | image_url: width: 1200 -%}
{%- elsif section.settings.image_asset != blank -%}
  {%- assign img_a = section.settings.image_asset | asset_url -%}
{%- else -%}
  {%- assign img_a = 'pd-marquee-court-cheer.jpg' | asset_url -%}
{%- endif -%}
{%- comment -%} Photo 2 (small, square) {%- endcomment -%}
{%- if section.settings.image_2 -%}
  {%- assign img_b = section.settings.image_2 | image_url: width: 800 -%}
{%- elsif section.settings.image_2_asset != blank -%}
  {%- assign img_b = section.settings.image_2_asset | asset_url -%}
{%- else -%}
  {%- assign img_b = 'pd-bento-family-group2.jpg' | asset_url -%}
{%- endif -%}

<section class="pd-page swaptop" id="swaptop-{{ section.id }}" aria-labelledby="swaptop-title-{{ section.id }}">
  <div class="pd-wrap swaptop__grid">
    <div class="swaptop__content">
      <p class="swaptop__eyebrow">{{ section.settings.eyebrow | default: 'Swaptop™ Kit' }}</p>
      <h2 id="swaptop-title-{{ section.id }}" style="color: #0a0c10 !important;">{{ section.settings.heading | default: 'The Host.' }}</h2>
      {%- if section.settings.heading_2b != blank -%}
        <p class="swaptop__tagline">{{ section.settings.heading_2b }}</p>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="swaptop__body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="swaptop__price">
        <span class="swaptop__price-now">{{ section.settings.price_now | default: '$159.99' }}</span>
        {%- if section.settings.price_was != blank -%}
          <span class="swaptop__price-was">{{ section.settings.price_was }}</span>
        {%- endif -%}
      </div>

      <a class="btn btn--green btn--lg" href="{{ section.settings.cta_link | default: '/products/swaptop-kit' }}">{{ section.settings.cta_text | default: 'Shop the Swaptop Kit' }}</a>
    </div>

    <div class="swaptop__media">
      <div class="swaptop__glow" aria-hidden="true"></div>
      <div class="swaptop__photo swaptop__photo--a">
        <img src="{{ img_a }}" alt="Friends gathered around a Swaptop board, mid-celebration." loading="lazy">
      </div>
      <div class="swaptop__photo swaptop__photo--b">
        <img src="{{ img_b }}" alt="A family playing Popdarts together." loading="lazy">
      </div>
      {%- if section.settings.image_tag != blank -%}
        <span class="swaptop__chip">{{ section.settings.image_tag }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swaptop Showcase",
  "tag": "section",
  "class": "pd-section-swaptop",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Swaptop™ Kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Host."
    },
    {
      "type": "text",
      "id": "heading_2b",
      "label": "Tagline (green)",
      "default": "Be the life of the party."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "One-line body",
      "info": "Keep it to a sentence or two.",
      "default": "One frame, endless games. Swaptop swaps game boards with a single clip-in frame — so game night never has to stop."
    },
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo 1 (large, portrait)"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Photo 1 bundled asset filename",
      "info": "Used if Photo 1 is empty, e.g. pd-marquee-court-cheer.jpg"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Photo 2 (small, square)"
    },
    {
      "type": "text",
      "id": "image_2_asset",
      "label": "Photo 2 bundled asset filename",
      "info": "Used if Photo 2 is empty, e.g. pd-bento-family-group2.jpg"
    },
    {
      "type": "text",
      "id": "image_tag",
      "label": "Floating chip text",
      "info": "Leave empty to hide.",
      "default": "One Frame. Endless Games™"
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "text",
      "id": "price_now",
      "label": "Price",
      "default": "$159.99"
    },
    {
      "type": "text",
      "id": "price_was",
      "label": "Compare-at price",
      "default": "$179.99"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop the Swaptop Kit"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Swaptop Showcase"
    }
  ]
}
{% endschema %}
