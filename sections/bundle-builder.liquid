{%- liquid
  assign bundle_offers = shop.metaobjects['bundle_offer'].values
-%}

<link rel="stylesheet" href="{{ 'bundle-builder.css' | asset_url }}">

<div class="bundle-builder page-width" id="bundle-builder">

  <div class="bb-header">
    <h2 class="bb-header__title">{{ section.settings.heading }}</h2>
    <p class="bb-header__sub">{{ section.settings.subheading }}</p>
    <hr class="bb-header__rule">
  </div>

  <div class="bb-layout">

    <!-- LEFT: Product Picker -->
    <div class="bb-picker">
      <nav class="bb-filter-tabs" id="bb-filter-tabs" aria-label="Product categories"></nav>
      <div class="bb-product-list" id="bb-product-list">
        <div class="bb-loading" id="bb-product-loading">
          <div class="bb-spinner"></div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Sticky Summary Panel -->
    <aside class="bb-summary" id="bb-summary">

      <!-- Deal Picker -->
      <div class="bb-deal-picker">
        <div class="bb-deal-headline">
          <span class="bb-deal-headline__title" id="bb-deal-title">-</span>
          <span class="bb-deal-headline__per" id="bb-deal-per-unit"></span>
        </div>

        <div class="bb-deal-btns" id="bb-deal-btns">
          {%- for offer in bundle_offers -%}
            {%- assign orig  = offer.original_price.value | plus: 0.0 -%}
            {%- assign final = offer.final_price.value    | plus: 0.0 -%}
            {%- assign qty   = offer.quantity.value       | plus: 0 -%}
            {%- assign badge_color = offer.badge_color -%}
            {%- if orig > 0 -%}
              {%- assign saved_pct = orig | minus: final | divided_by: orig | times: 100 | round -%}
            {%- else -%}
              {%- assign saved_pct = 0 -%}
            {%- endif -%}
            <div class="bb-deal-btn-wrap">
              {%- if offer.badge_text.value != blank -%}
                <span class="bb-deal-badge" style="background-color: {{ badge_color }};">{{ offer.badge_text.value }}</span>
              {%- elsif saved_pct > 0 -%}
                <span class="bb-deal-badge" style="background-color: {{ badge_color }};">{{ saved_pct }}% OFF</span>
              {%- else -%}
                <span class="bb-deal-badge bb-deal-badge--ghost"></span>
              {%- endif -%}
              <button class="bb-deal-btn"
                      type="button"
                      data-quantity="{{ qty }}"
                      data-collection="{{ offer.collection.value.handle }}"
                      data-original-price="{{ orig }}"
                      data-final-price="{{ final }}"
                      data-title="{{ offer.title.value | escape }}"
                      data-saved-pct="{{ saved_pct }}">
                {{ qty }} pack
              </button>
            </div>
          {%- else -%}
            <p style="color:#999;font-size:13px">No bundle offers found. Add <strong>bundle_offer</strong> metaobjects in Shopify admin.</p>
          {%- endfor -%}
        </div>

        {%- if section.settings.note_text != blank -%}
          <p class="bb-deal-shipping">{{ section.settings.note_text }}</p>
        {%- endif -%}
      </div>

      <!-- Slots -->
      <div class="bb-slots" id="bb-slots"></div>

      <!-- Add to Cart CTA -->
      <div class="bb-summary__footer">
        <button class="bb-summary__add-btn" id="bb-add-to-cart-btn" type="button" disabled>
          Add to Cart
        </button>
      </div>

    </aside>

  </div>

</div>

<!-- Mobile Sticky Footer -->
<div class="bb-mobile-footer" id="bb-mobile-footer">
  <button class="bb-mobile-toggle" id="bb-mobile-toggle" type="button" aria-expanded="false">
    <span id="bb-mobile-toggle-text">View Your Bundle</span>
    <span class="bb-mobile-toggle-chevron" id="bb-mobile-toggle-chevron">&#8743;</span>
  </button>
  <div class="bb-mobile-bundle" id="bb-mobile-bundle" hidden>
    <div class="bb-mobile-items" id="bb-mobile-items"></div>
  </div>
  <button class="bb-mobile-add-btn" id="bb-mobile-add-btn" type="button" disabled>
    Add To Cart
  </button>
</div>

<!-- Image Gallery Lightbox -->
<div class="bb-gallery-overlay" id="bb-gallery-overlay" role="dialog" aria-modal="true" aria-label="Product image gallery" hidden>
  <button class="bb-gallery-close" id="bb-gallery-close" type="button" aria-label="Close gallery">&#10005;</button>
  <button class="bb-gallery-prev" id="bb-gallery-prev" type="button" aria-label="Previous image">&#8249;</button>
  <button class="bb-gallery-next" id="bb-gallery-next" type="button" aria-label="Next image">&#8250;</button>
  <div class="bb-gallery-inner">
    <img class="bb-gallery-img" id="bb-gallery-img" src="" alt="">
    <p class="bb-gallery-caption" id="bb-gallery-caption"></p>
  </div>
  <div class="bb-gallery-thumbs" id="bb-gallery-thumbs"></div>
</div>

<style>
  .bb-gallery-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
    animation: bb-gallery-fade-in 0.2s ease;
  }
  .bb-gallery-overlay[hidden] { display: none; }
  @keyframes bb-gallery-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .bb-gallery-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 720px;
    width: 100%;
    flex: 1;
    justify-content: center;
  }
  .bb-gallery-img {
    max-height: 65vh;
    max-width: 100%;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.6);
    transition: opacity 0.18s ease;
    display: block;
  }
  .bb-gallery-img.bb-gallery-img--fade {
    opacity: 0;
  }
  .bb-gallery-caption {
    color: #ddd;
    font-size: 14px;
    margin: 12px 0 0;
    text-align: center;
    letter-spacing: 0.02em;
  }
  .bb-gallery-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: rgba(255,255,255,0.12);
    border: none;
    color: #fff;
    font-size: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }
  .bb-gallery-close:hover { background: rgba(255,255,255,0.25); }
  .bb-gallery-prev,
  .bb-gallery-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.12);
    border: none;
    color: #fff;
    font-size: 36px;
    width: 48px;
    height: 64px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    z-index: 2;
  }
  .bb-gallery-prev:hover,
  .bb-gallery-next:hover { background: rgba(255,255,255,0.28); }
  .bb-gallery-prev { left: 12px; }
  .bb-gallery-next { right: 12px; }
  .bb-gallery-prev[disabled],
  .bb-gallery-next[disabled] { opacity: 0.25; cursor: default; }
  .bb-gallery-thumbs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 16px;
    max-width: 720px;
    width: 100%;
  }
  .bb-gallery-thumb {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 5px;
    cursor: pointer;
    border: 2px solid transparent;
    opacity: 0.55;
    transition: opacity 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }
  .bb-gallery-thumb:hover { opacity: 0.85; }
  .bb-gallery-thumb.active {
    border-color: #fff;
    opacity: 1;
  }
  /* Make .bnd-addon-slides look clickable */
  .bnd-addon-slides {
    cursor: zoom-in;
  }
  .bnd-addon-slides img {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    pointer-events: none; /* let the container handle the click */
  }
  .bnd-addon-slides:hover img {
    transform: scale(1.04);
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
  }
  @media (max-width: 600px) {
    .bb-gallery-prev { left: 4px; }
    .bb-gallery-next { right: 4px; }
    .bb-gallery-prev,
    .bb-gallery-next { width: 36px; height: 52px; font-size: 28px; }
  }
</style>

<!-- Variant / Size Drawer -->
<div class="bb-overlay" id="bb-overlay" aria-hidden="true"></div>
<div class="bb-drawer" id="bb-drawer" role="dialog" aria-modal="true">
  <div class="bb-drawer__handle"></div>
  <div class="bb-drawer__header">
    <h3 class="bb-drawer__title" id="bb-drawer-title">Select a Size</h3>
    <button class="bb-drawer__close" id="bb-drawer-close" type="button" aria-label="Close">&#10005;</button>
  </div>
  <div class="bb-drawer__body" id="bb-drawer-body"></div>
</div>

<script>
  /* ── Bundle Builder: Image Gallery Lightbox ── */
  (function () {
    const overlay   = document.getElementById('bb-gallery-overlay');
    const imgEl     = document.getElementById('bb-gallery-img');
    const caption   = document.getElementById('bb-gallery-caption');
    const thumbsEl  = document.getElementById('bb-gallery-thumbs');
    const btnClose  = document.getElementById('bb-gallery-close');
    const btnPrev   = document.getElementById('bb-gallery-prev');
    const btnNext   = document.getElementById('bb-gallery-next');

    let images = [];   // [{ src, alt }]
    let current = 0;

    /* ---- Collect all images from a product card ---- */
    function getCardImages(card) {
      const imgs = card.querySelectorAll('img');
      return Array.from(imgs).map(img => ({
        src: img.dataset.zoom || img.dataset.src || img.src,
        alt: img.alt || ''
      })).filter(i => i.src);
    }

    /* ---- Show a specific index ---- */
    function showIndex(idx) {
      current = Math.max(0, Math.min(idx, images.length - 1));
      const item = images[current];

      /* fade transition */
      imgEl.classList.add('bb-gallery-img--fade');
      setTimeout(() => {
        imgEl.src = item.src;
        imgEl.alt = item.alt;
        caption.textContent = item.alt;
        imgEl.classList.remove('bb-gallery-img--fade');
      }, 120);

      /* update thumbs */
      thumbsEl.querySelectorAll('.bb-gallery-thumb').forEach((th, i) => {
        th.classList.toggle('active', i === current);
      });

      btnPrev.disabled = current === 0;
      btnNext.disabled = current === images.length - 1;
    }

    /* ---- Open gallery ---- */
    function openGallery(cardImages, startIndex) {
      images  = cardImages;
      current = startIndex;

      /* build thumbnails */
      thumbsEl.innerHTML = '';
      if (images.length > 1) {
        images.forEach((item, i) => {
          const th = document.createElement('img');
          th.src = item.src;
          th.alt = item.alt;
          th.className = 'bb-gallery-thumb' + (i === startIndex ? ' active' : '');
          th.addEventListener('click', () => showIndex(i));
          thumbsEl.appendChild(th);
        });
      }

      showIndex(startIndex);
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      btnClose.focus();
    }

    /* ---- Close gallery ---- */
    function closeGallery() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      images = [];
    }

    /* ---- Attach click listener to a .bnd-addon-slides element ---- */
    function attachToSlides(slides) {
      if (slides._bbGalleryBound) return;
      slides._bbGalleryBound = true;
      slides.style.cursor = 'zoom-in';

      slides.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        const allImgs = getCardImages(slides);
        if (!allImgs.length) return;

        const clickedImg = e.target.closest('img');
        let startIndex = 0;
        if (clickedImg) {
          const clickedSrc = clickedImg.dataset.zoom || clickedImg.dataset.src || clickedImg.src;
          const found = allImgs.findIndex(i => i.src === clickedSrc);
          if (found >= 0) startIndex = found;
        }

        openGallery(allImgs, startIndex);
      }, true); /* capture phase — fires before the card's own handlers */
    }

    /* ---- Bind all .bnd-addon-slides currently in the DOM ---- */
    function bindAllSlides() {
      document.querySelectorAll('.bnd-addon-slides').forEach(attachToSlides);
    }

    /* ---- Watch for .bnd-addon-slides injected dynamically ---- */
    const observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (m) {
        m.addedNodes.forEach(function (node) {
          if (node.nodeType !== 1) return;
          if (node.classList && node.classList.contains('bnd-addon-slides')) {
            attachToSlides(node);
          }
          node.querySelectorAll && node.querySelectorAll('.bnd-addon-slides').forEach(attachToSlides);
        });
      });
    });

    function startObserving() {
      observer.observe(document.body, { childList: true, subtree: true });
      bindAllSlides();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startObserving);
    } else {
      startObserving();
    }

    /* ---- Controls ---- */
    btnClose.addEventListener('click', closeGallery);
    btnPrev.addEventListener('click', () => showIndex(current - 1));
    btnNext.addEventListener('click', () => showIndex(current + 1));

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closeGallery();
    });

    document.addEventListener('keydown', function (e) {
      if (overlay.hidden) return;
      if (e.key === 'Escape')     closeGallery();
      if (e.key === 'ArrowLeft')  showIndex(current - 1);
      if (e.key === 'ArrowRight') showIndex(current + 1);
    });
  })();
</script>

<script>
  window.bbBundleData = {
    cartUrl:     '{{ routes.cart_url }}',
    moneyFormat: {{ shop.money_format | json }}
  };
</script>
<script src="{{ 'bundle-builder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Bundle Builder",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "heading",           "label": "Heading",           "default": "Build Your Pack" },
    { "type": "textarea", "id": "subheading",         "label": "Subheading",        "default": "Create a custom bundle from our collection." },
    { "type": "text",     "id": "note_text", "label": "Note","default": "Free shipping with 5 or 10 pack!" }
  ],
  "presets": [{ "name": "Bundle Builder" }]
}
{% endschema %}