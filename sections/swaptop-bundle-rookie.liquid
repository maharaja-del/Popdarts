  ].join('');

  /* Inject hover rules separately (can't use !important on pseudo-classes directly) */
  var hoverCss = [
    '#CartPopup .upcart-product-quantity-minus:hover,#CartPopup .upcart-product-quantity-plus:hover{background:#C8102E!important}',
    '#CartPopup [class*="TrashButton"]:hover{opacity:1!important}',
    '#CartPopup .upcart-checkout-button:hover{background:#8B0000!important;color:#fff!important;transform:translateY(-1px)!important;box-shadow:0 8px 28px rgba(139,0,0,.45)!important}',
    '#CartPopup .upcart-checkout-button:active{transform:translateY(0)!important}'
  ].join('');

  function injectStyles() {
    /* Remove old injection if re-running */
    var old = document.getElementById('popdarts-upcart-css');
    if (old) old.remove();

    var s = document.createElement('style');
    s.id = 'popdarts-upcart-css';
    s.textContent = css + hoverCss;
    /* Append to <head> so it loads after UpCart's own injected styles */
    document.head.appendChild(s);
  }

  /* Run immediately */
  injectStyles();

  /* Re-run whenever UpCart opens the cart (it re-renders on open) */
  var observer = new MutationObserver(function(mutations) {
    for (var i = 0; i < mutations.length; i++) {
      var el = mutations[i].target;
      if (el.id === 'CartPopup' || (el.classList && el.classList.contains('upcart-internal-cart-preview__container'))) {
        injectStyles();
        break;
      }
    }
  });

  observer.observe(document.body, { attributes: true, subtree: true, attributeFilter: ['class', 'style'] });
})();
</script>

