  ══════════════════════════════════════ */
  .bnd-added-popup {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
    pointer-events: none;
    opacity: 0;
    background: rgba(0, 0, 0, 0);
    transition: opacity 0.2s ease, background 0.2s ease;
    border-radius: 8px;
  }

  .bnd-added-popup.show {
    opacity: 1;
    background: rgba(0, 0, 0, 0.42);
  }

  .bnd-added-popup-badge {
    background: #C8102E;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 14px 26px;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 9px;
    box-shadow:
      0 0 0 4px rgba(200,16,46,0.3),
      0 8px 32px rgba(0,0,0,0.45),
      0 0 60px rgba(200,16,46,0.4);
    transform: scale(0.6) rotate(-4deg);
    transition: transform 0.4s cubic-bezier(0.34, 1.7, 0.64, 1);
  }

  .bnd-added-popup.show .bnd-added-popup-badge {
    transform: scale(1) rotate(0deg);
  }

  .bnd-added-popup-badge svg {
    width: 18px;
    height: 18px;
    stroke: #fff;
    flex-shrink: 0;
