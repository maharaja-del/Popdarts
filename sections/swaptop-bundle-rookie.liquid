<script>
(function () {

  /* ── PRICES (cents from Liquid) ── */
  /* These three track the currently selected Rookie Pack variant; bndSelectVariant() reassigns them. */
  var BND_BASE_PRICE   = {{ bnd_default_variant.price }};
  var BND_BASE_COMPARE = {{ bnd_default_variant.compare_at_price | default: bnd_default_variant.price }};
  var BND_MAIN_VARIANT = {{ bnd_default_variant.id }};
  /* Every Rookie Pack color variant ID — used to keep only ONE color in the cart at a time. */
  var BND_ALL_VARIANT_IDS = [{% for v in main_product.variants %}{{ v.id }}{% unless forloop.last %}, {% endunless %}{% endfor %}];

  /* ══════════════════════════════════════
     ✓ ADDED POPUP — shows on the card image
     when a top is added to the bundle
  ══════════════════════════════════════ */
  function bndShowAddedPopup(card) {
    var overlay = card && card.querySelector('.bnd-added-popup');
    if (!overlay) return;
    /* Clear any existing timer so rapid clicks don't stack */
    if (overlay._hideTimer) clearTimeout(overlay._hideTimer);
    overlay.classList.add('show');
    overlay._hideTimer = setTimeout(function () {
      overlay.classList.remove('show');
    }, 1500);
  }

  /* ── THUMBNAIL SWITCHING ── */
  var mainImg = document.getElementById('bnd-main-img');
  document.querySelectorAll('.bnd-thumb').forEach(function (t) {
    t.addEventListener('click', function () {
      document.querySelectorAll('.bnd-thumb').forEach(function (x) { x.classList.remove('active'); });
      t.classList.add('active');
      mainImg.style.opacity = '0';
      setTimeout(function () { mainImg.src = t.dataset.src; mainImg.style.opacity = '1'; }, 180);
    });
  });

  /* ── PRELOAD EACH COLOR'S MAIN IMAGE so the swap on click is instant ── */
  document.querySelectorAll('#bnd-variant-opts .bnd-variant-opt').forEach(function (b) {
    if (b.dataset.img) { var im = new Image(); im.src = b.dataset.img; }
  });

  /* ── SHARED HELPERS ── */
  function bndOpenCartDrawer() {
    var btn = document.querySelector('[data-cart-toggle],.cart-toggle,#cart-toggle,.js-cart-open');
    if (btn) { btn.click(); return; }
    document.dispatchEvent(new CustomEvent('cart:open'));
    document.dispatchEvent(new CustomEvent('theme:cart:open'));
  }

  function bndRefreshCart() {
    fetch('/cart.js')
      .then(function(r){ return r.json(); })
      .then(function(cart){
        var n = cart.item_count;
        document.querySelectorAll(
          '[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,#CartCount,.header__cart-count,.cart-count-bubble [aria-hidden]'
        ).forEach(function(el){ el.textContent = n; });
      }).catch(function(){});

    fetch('/?sections=cart-drawer,cart-icon-bubble')
      .then(function(r){ return r.json(); })
      .then(function(sections){
        if (sections['cart-drawer']) {
          var liveDrawer  = document.querySelector('cart-drawer');
          var sectionWrap = liveDrawer && liveDrawer.closest('[id^="shopify-section-"]');
          if (sectionWrap) {
            sectionWrap.innerHTML = sections['cart-drawer'];
          } else if (liveDrawer) {
            var doc = new DOMParser().parseFromString(sections['cart-drawer'], 'text/html');
            var fd  = doc.querySelector('cart-drawer');
            if (fd) liveDrawer.outerHTML = fd.outerHTML;
          }
        }
        if (sections['cart-icon-bubble']) {
          var countEl  = document.querySelector('[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,.cart-count-bubble');
          var iconWrap = countEl && countEl.closest('[id^="shopify-section-"]');
          if (iconWrap) iconWrap.innerHTML = sections['cart-icon-bubble'];
        }
      }).catch(function(){});
  }

  function bndEnforceKitQty() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      for (var i = 0; i < cart.items.length; i++) {
        if (cart.items[i].variant_id === BND_MAIN_VARIANT && cart.items[i].quantity > 1) {
          fetch('/cart/change.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ id: cart.items[i].key, quantity: 1 })
          }).then(function(r){ return r.json(); }).then(bndRefreshCart).catch(function(){});
          break;
        }
      }
    }).catch(function(){});
  }

  /* ── APPLY SELECTED STATE TO A CARD ── */
  function bndApplySelected(card, selected) {
    card.classList.toggle('selected', selected);
    var btn = card.querySelector('.bnd-add-top-btn');
    if (btn) {
      var lbl = btn.querySelector('.bnd-add-top-label');
      if (lbl) lbl.textContent = selected ? 'Added' : 'Add';
    }
  }

  /* ── SYNC BUNDLE UI FROM CART ON LOAD ── */
  function bndSyncFromCart() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var inCart = cart.items.map(function(i){ return i.variant_id; });
      document.querySelectorAll('.bnd-addon-card:not(.locked)').forEach(function(card){
        var v = parseInt(card.dataset.variant, 10);
        if (v && inCart.indexOf(v) !== -1) bndApplySelected(card, true);
      });
      bndUpdateTotal();
    }).catch(function(){});
  }

  /* ── TOGGLE ADDON — syncs both UI and cart ── */
  window.bndToggleAddon = function(card) {
    if (!card || card.classList.contains('locked')) return;

    var selecting    = !card.classList.contains('selected');
    var addonVariant = parseInt(card.dataset.variant, 10);

    bndApplySelected(card, selecting);
    bndUpdateTotal();

    /* ✨ ADDED POPUP when toggling on ✨ */
    if (selecting) bndShowAddedPopup(card);

    if (!addonVariant) return;

    if (selecting) {
      /* ── ADD ── */
      fetch('/cart.js')
        .then(function(r){ return r.json(); })
        .then(function(cart){
          var inCart = cart.items.map(function(i){ return i.variant_id; });
          var items  = [];
          if (BND_MAIN_VARIANT && inCart.indexOf(BND_MAIN_VARIANT) === -1)
            items.push({ id: BND_MAIN_VARIANT, quantity: 1 });
          if (inCart.indexOf(addonVariant) === -1)
            items.push({ id: addonVariant, quantity: 1 });
          if (!items.length) { bndOpenCartDrawer(); return null; }
          return fetch('/cart/add.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ items: items })
          }).then(function(r){ return r.json(); });
        })
        .then(function(result){
          if (!result) return;
          bndEnforceKitQty();
          bndRefreshCart();
          bndOpenCartDrawer();
        })
        .catch(function(){ bndApplySelected(card, false); bndUpdateTotal(); });

    } else {
      /* ── REMOVE ── */
      fetch('/cart.js')
        .then(function(r){ return r.json(); })
        .then(function(cart){
          var addonKey = null;
          var kitKeys  = [];
          cart.items.forEach(function(item){
            if (String(item.variant_id) === String(addonVariant)) addonKey = item.key;
            if (item.variant_id === BND_MAIN_VARIANT)             kitKeys.push(item.key);
          });
          var toRemove = kitKeys.slice();
          if (addonKey) toRemove.push(addonKey);
          if (!toRemove.length) return null;
          return Promise.all(toRemove.map(function(key){
            return fetch('/cart/change.js', {
              method:'POST',
              headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
              body: JSON.stringify({ id: key, quantity: 0 })
            }).then(function(r){ return r.json(); });
          }));
        })
        .then(function(result){
          if (result === null) return null;
          return fetch('/cart.js').then(function(r){ return r.json(); });
        })
        .then(function(cart){
          if (!cart) return null;
          var remaining = cart.items.filter(function(i){ return i.variant_id === BND_MAIN_VARIANT; });
          if (!remaining.length) return true;
          return Promise.all(remaining.map(function(item){
            return fetch('/cart/change.js', {
              method:'POST',
              headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
              body: JSON.stringify({ id: item.key, quantity: 0 })
            }).then(function(r){ return r.json(); });
          })).then(function(){ return true; });
        })
        .then(function(ok){
          if (!ok) return null;
          return fetch('/cart/add.js', {
            method:'POST',
            headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ items: [{ id: BND_MAIN_VARIANT, quantity: 1 }] })
          }).then(function(r){ return r.json(); });
        })
        .then(function(result){
          if (!result) return;
          bndRefreshCart();
        })
        .catch(function(){
          bndApplySelected(card, true);
          bndUpdateTotal();
        });
    }
  };

  /* ── FORMAT MONEY ── */
  function bndMoney(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  /* ── UPDATE TOTAL ── */
  function bndUpdateTotal() {
    var total   = BND_BASE_PRICE;
    var compare = BND_BASE_COMPARE;

    document.querySelectorAll('.bnd-addon-card:not(.locked).selected').forEach(function (card) {
      var p = parseInt(card.dataset.price,   10) || 0;
      var c = parseInt(card.dataset.compare, 10) || 0;
      total   += p;
      compare += (c > 0 ? c : p);
    });

    var amountEl  = document.getElementById('bnd-total');
    var compareEl = document.getElementById('bnd-total-compare');
    var savingsEl = document.getElementById('bnd-total-savings');

    amountEl.textContent = bndMoney(total);

    var saved = compare - total;
    if (saved > 0) {
      compareEl.textContent   = bndMoney(compare);
      compareEl.style.cssText = 'display:inline;';
      if (savingsEl) {
        savingsEl.textContent   = 'Save ' + bndMoney(saved);
        savingsEl.style.cssText = 'display:inline-flex;';
      }
    } else {
      compareEl.style.cssText = 'display:none;';
      if (savingsEl) savingsEl.style.cssText = 'display:none;';
    }

    amountEl.classList.remove('bump');
    void amountEl.offsetWidth;
    amountEl.classList.add('bump');
    setTimeout(function () { amountEl.classList.remove('bump'); }, 300);
  }

  /* ── VARIANT SELECTION (Rookie Pack colors) ── */
  window.bndSelectVariant = function (btn) {
    if (!btn || btn.disabled) return;
    document.querySelectorAll('#bnd-variant-opts .bnd-variant-opt').forEach(function (b) {
      b.classList.remove('selected');
    });
    btn.classList.add('selected');

    BND_MAIN_VARIANT = parseInt(btn.dataset.vid, 10);
    BND_BASE_PRICE   = parseInt(btn.dataset.price, 10) || BND_BASE_PRICE;
    var cmp          = parseInt(btn.dataset.compare, 10) || 0;
    BND_BASE_COMPARE = cmp > 0 ? cmp : BND_BASE_PRICE;

    var curEl = document.getElementById('bnd-variant-current');
    if (curEl) curEl.textContent = btn.dataset.title;

    var saleEl = document.getElementById('bnd-main-price-sale');
    if (saleEl) saleEl.textContent = bndMoney(BND_BASE_PRICE);

    var origEl = document.getElementById('bnd-main-price-orig');
    if (origEl) {
      if (BND_BASE_COMPARE > BND_BASE_PRICE) {
        origEl.textContent   = bndMoney(BND_BASE_COMPARE);
        origEl.style.display = 'inline';
      } else {
        origEl.style.display = 'none';
      }
    }

    bndUpdateTotal();

    /* Swap the main gallery image to this color's art (instant — images are preloaded) */
    var mImg = document.getElementById('bnd-main-img');
    if (mImg && btn.dataset.img) {
      document.querySelectorAll('.bnd-thumb').forEach(function (x) { x.classList.remove('active'); });
      mImg.src = btn.dataset.img;
    }

    /* Directly add this color to the cart (only one color at a time) */
    bndSwapColorInCart();
  };

  /* ── DIRECT ADD ON COLOR CLICK — keeps a single Rookie color in the cart ── */
  function bndSwapColorInCart() {
    var updates = {};
    BND_ALL_VARIANT_IDS.forEach(function (id) { updates[String(id)] = 0; });
    updates[String(BND_MAIN_VARIANT)] = 1;
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ updates: updates })
    })
      .then(function (r) { return r.json(); })
      .then(function () { bndOpenCartDrawer(); bndRefreshCart(); })
      .catch(function () {});
  }

  /* ── COLLECT CART ITEMS ── */
  function bndGetItems() {
    var items = [{ id: BND_MAIN_VARIANT, quantity: 1 }];
    document.querySelectorAll('.bnd-addon-card:not(.locked).selected').forEach(function (card) {
      if (card.dataset.variant) items.push({ id: parseInt(card.dataset.variant, 10), quantity: 1 });
    });
    return items;
  }

  /* ── ADD TO CART (main button) ── */
  window.bndAddToCart = function () {
    var btn = document.getElementById('bnd-atc-btn');
    if (btn.classList.contains('loading')) return;
    btn.classList.add('loading');
    btn.textContent = 'Adding...';

    /* ✨ ADDED POPUP on every selected addon card ✨ */
    document.querySelectorAll('.bnd-addon-card:not(.locked).selected').forEach(function(card, i) {
      setTimeout(function(){ bndShowAddedPopup(card); }, i * 120);
    });

    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var inCart   = cart.items.map(function (i) { return i.variant_id; });
        var allItems = bndGetItems();
        var toAdd    = allItems.filter(function (item) { return inCart.indexOf(item.id) === -1; });
        bndOpenCartDrawer();
        if (!toAdd.length) {
          btn.classList.remove('loading');
          btn.textContent = 'Added ✓';
          setTimeout(function () { btn.textContent = 'Add To Cart'; }, 2000);
          return null;
        }
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ items: toAdd })
        }).then(function (r) { return r.json(); });
      })
      .then(function (data) {
        if (!data) return;
        if (data.status && data.status >= 400) throw new Error(data.description || 'Cart error');
        bndEnforceKitQty();
        bndRefreshCart();
        btn.classList.remove('loading');
        btn.textContent = 'Added ✓';
        setTimeout(function () { btn.textContent = 'Add To Cart'; }, 2000);
      })
      .catch(function () {
        btn.classList.remove('loading');
        btn.textContent = 'Try Again';
        setTimeout(function () { btn.textContent = 'Add To Cart'; }, 2500);
      });
  };

  /* ── BUY NOW ── */
  window.bndBuyNow = function () {
    var ids = bndGetItems().map(function (i) { return i.id + ':' + i.quantity; }).join(',');
    window.location.href = '/checkout?items=' + ids;
  };

  /* ────────────────────────────────
     VIDEO SECTION
  ──────────────────────────────── */
  var PD_VIDEOS = [
    { src: 'https://cdn.shopify.com/videos/c/o/v/ba3fa92e0dc048f1a50333e006a7e6e1.mp4',  label: '' },
    { src: 'https://cdn.shopify.com/videos/c/o/v/b1e839ae42544baeaf3c62cb0299c025.mp4',  label: '' },
    { src: 'https://cdn.shopify.com/videos/c/o/v/144f512dd8534fed87ceebfa45ca02f4.mp4',  label: '' }
  ];

  var pdCards     = document.querySelectorAll('.pd-video-card');
  var pdOverlay   = document.getElementById('pd-overlay');
  var pdReelVideo = document.getElementById('pd-video');
  var pdReelTitle = document.getElementById('pd-reel-title');
  var pdMuteBtn   = document.getElementById('pd-mute-btn');
  var pdIconSound = document.getElementById('pd-icon-sound');
  var pdIconMute  = document.getElementById('pd-icon-mute');
  var pdPrevBtn   = document.getElementById('pd-prev-btn');
  var pdNextBtn   = document.getElementById('pd-next-btn');
  var pdCloseBtn  = document.getElementById('pd-close-btn');
  var pdIndex     = 0;
  var pdMuted     = false;

  pdCards.forEach(function (card, i) {
    var vid = card.querySelector('.pd-card-video');
    vid.src = PD_VIDEOS[i].src;
    vid.play().catch(function () {});
  });

  function pdUpdateNav() {
    pdPrevBtn.classList.toggle('pd-hidden', pdIndex === 0);
    pdNextBtn.classList.toggle('pd-hidden', pdIndex === PD_VIDEOS.length - 1);
  }

  function pdSyncMute() {
    pdIconSound.style.display = pdMuted ? 'none' : '';
    pdIconMute.style.display  = pdMuted ? ''     : 'none';
  }

  function pdLoadReel(i) {
    pdIndex = i;
    pdReelVideo.src = PD_VIDEOS[i].src;
    pdReelVideo.muted = pdMuted;
    pdReelTitle.textContent = PD_VIDEOS[i].label;
    pdSyncMute();
    pdReelVideo.load();
    pdReelVideo.play().catch(function () {
      pdReelVideo.muted = true; pdMuted = true; pdSyncMute();
      pdReelVideo.play().catch(function () {});
    });
    pdUpdateNav();
  }

  function pdOpen(i) { pdMuted = false; pdOverlay.classList.add('active'); document.body.style.overflow = 'hidden'; pdLoadReel(i); }
  function pdClose() { pdOverlay.classList.remove('active'); document.body.style.overflow = ''; pdReelVideo.pause(); pdReelVideo.removeAttribute('src'); pdReelVideo.load(); }

  pdCards.forEach(function (card) {
    card.addEventListener('click', function () { pdOpen(parseInt(card.dataset.index, 10)); });
  });

  pdCloseBtn.addEventListener('click', pdClose);
  pdOverlay.addEventListener('click', function (e) { if (e.target === pdOverlay) pdClose(); });
  pdPrevBtn.addEventListener('click', function () { if (pdIndex > 0) pdLoadReel(pdIndex - 1); });
  pdNextBtn.addEventListener('click', function () { if (pdIndex < PD_VIDEOS.length - 1) pdLoadReel(pdIndex + 1); });
  pdMuteBtn.addEventListener('click', function () { pdMuted = !pdMuted; pdReelVideo.muted = pdMuted; pdSyncMute(); });

  document.addEventListener('keydown', function (e) {
    if (!pdOverlay.classList.contains('active')) return;
    if (e.key === 'Escape') pdClose();
    if (e.key === 'ArrowLeft'  && pdIndex > 0)                     pdLoadReel(pdIndex - 1);
    if (e.key === 'ArrowRight' && pdIndex < PD_VIDEOS.length - 1) pdLoadReel(pdIndex + 1);
  });

  var pdTouchX = 0;
  pdOverlay.addEventListener('touchstart', function (e) { pdTouchX = e.touches[0].clientX; }, { passive: true });
  pdOverlay.addEventListener('touchend',   function (e) {
    var diff = pdTouchX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) {
      if (diff > 0 && pdIndex < PD_VIDEOS.length - 1) pdLoadReel(pdIndex + 1);
      if (diff < 0 && pdIndex > 0)                    pdLoadReel(pdIndex - 1);
    }
  });

  /* ── LIGHTBOX ── */
  var BND_IMAGES = [
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Rookie-PDP-1-BG.png?v=1752580369&width=1600',
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Rookie-PDP-2.png?v=1752580369&width=1600',
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Rookie-PDP-3-BG.png?v=1752580369&width=1600',
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Rookie-PDP-5_5426d4e5-e92f-4e4c-8687-a800f311b938.png?v=1762458708&width=1600',
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Rookie-PDP-6_0c2777ef-6176-401b-9447-5e8e1ae55f84.jpg?v=1752590448&width=1600',
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Rookie-PDP-2_0bfacca7-54ef-4542-b028-668292357c25.png?v=1752590448&width=1600'
  ];
  var BND_IMAGES_DEFAULT = BND_IMAGES.slice();
  var bndLbIndex = 0;

  function bndLbRender() {
    document.getElementById('bnd-lb-img').src = BND_IMAGES[bndLbIndex];
    document.getElementById('bnd-lb-counter').textContent = (bndLbIndex + 1) + ' / ' + BND_IMAGES.length;
    document.getElementById('bnd-lb-prev').classList.toggle('disabled', bndLbIndex === 0);
    document.getElementById('bnd-lb-next').classList.toggle('disabled', bndLbIndex === BND_IMAGES.length - 1);
  }

  window.bndOpenLightbox = function () {
    BND_IMAGES = BND_IMAGES_DEFAULT.slice();
    var currentSrc = document.getElementById('bnd-main-img').src;
    bndLbIndex = 0;
    BND_IMAGES.forEach(function(src, i) {
      if (currentSrc.indexOf(src.split('?')[0].split('/').pop().split('.')[0]) > -1) bndLbIndex = i;
    });
    bndLbIndex = Math.max(0, bndLbIndex);
    bndLbRender();
    document.getElementById('bnd-lightbox').classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  window.bndOpenLightboxWith = function (imgs, startIdx) {
    BND_IMAGES = imgs;
    bndLbIndex = Math.max(0, Math.min(imgs.length - 1, startIdx || 0));
    bndLbRender();
    document.getElementById('bnd-lightbox').classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  window.bndCloseLightbox = function () {
    document.getElementById('bnd-lightbox').classList.remove('active');
    document.body.style.overflow = '';
  };

  window.bndLightboxNav = function (dir) {
    bndLbIndex = Math.max(0, Math.min(BND_IMAGES.length - 1, bndLbIndex + dir));
    bndLbRender();
  };

  document.getElementById('bnd-lightbox').addEventListener('click', function (e) {
    if (e.target === this) bndCloseLightbox();
  });

  document.addEventListener('keydown', function (e) {
    if (!document.getElementById('bnd-lightbox').classList.contains('active')) return;
    if (e.key === 'Escape') bndCloseLightbox();
    if (e.key === 'ArrowLeft') bndLightboxNav(-1);
    if (e.key === 'ArrowRight') bndLightboxNav(1);
  });

  var bndLbTouchX = 0;
  var bndLbEl = document.getElementById('bnd-lightbox');
  bndLbEl.addEventListener('touchstart', function (e) { bndLbTouchX = e.touches[0].clientX; }, { passive: true });
  bndLbEl.addEventListener('touchend', function (e) {
    var diff = bndLbTouchX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) bndLightboxNav(diff > 0 ? 1 : -1);
  });

  /* ── ADDON IMAGE SLIDER ── */
  window.bndSliderNav = function (e, btn, dir) {
    e.stopPropagation();
    var slider = btn.closest('.bnd-addon-slider');
    var total  = slider.querySelectorAll('.bnd-addon-slide').length;
    var idx    = parseInt(slider.dataset.idx, 10) + dir;
    idx = Math.max(0, Math.min(total - 1, idx));
    bndSliderGo(slider, idx);
  };

  window.bndSliderDot = function (e, dot) {
    e.stopPropagation();
    var slider = dot.closest('.bnd-addon-slider');
    var dots   = slider.querySelectorAll('.bnd-slide-dot');
    var idx    = Array.prototype.indexOf.call(dots, dot);
    bndSliderGo(slider, idx);
  };

  function bndSliderGo(slider, idx) {
    var total = slider.querySelectorAll('.bnd-addon-slide').length;
    idx = Math.max(0, Math.min(total - 1, idx));
    slider.dataset.idx = idx;
    slider.querySelector('.bnd-addon-slides').style.transform = 'translateX(-' + (idx * 100) + '%)';
    slider.querySelectorAll('.bnd-slide-pill').forEach(function (p, i) {
      p.classList.toggle('active', i === idx);
    });
  }

  document.querySelectorAll('.bnd-addon-slider').forEach(function (slider) {
    var total   = slider.querySelectorAll('.bnd-addon-slide').length;
    var pillWrap = slider.querySelector('.bnd-slide-pills');
    if (total <= 1 && pillWrap) pillWrap.style.display = 'none';

    var tx = 0;
    slider.addEventListener('touchstart', function (e) { tx = e.touches[0].clientX; }, { passive: true });
    slider.addEventListener('touchend', function (e) {
      var diff = tx - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        var idx = parseInt(slider.dataset.idx, 10) || 0;
        bndSliderGo(slider, idx + (diff > 0 ? 1 : -1));
      }
    });

    var mx = 0, dragging = false;
    slider.addEventListener('mousedown', function (e) { mx = e.clientX; dragging = true; });
    slider.addEventListener('mouseup', function (e) {
      if (!dragging) return;
      dragging = false;
      var diff = mx - e.clientX;
      if (Math.abs(diff) > 40) {
        var idx = parseInt(slider.dataset.idx, 10) || 0;
        bndSliderGo(slider, idx + (diff > 0 ? 1 : -1));
      }
    });
    slider.addEventListener('mouseleave', function () { dragging = false; });
  });

  /* ── IMAGE ZONE CLICK → OPEN LIGHTBOX ── */
  window.bndImgZoneClick = function (e, zone) {
    var card = zone.closest('.bnd-addon-card');
    if (!card) return;
    var slides = card.querySelectorAll('.bnd-addon-slide img');
    var imgs = [];
    slides.forEach(function (img) { imgs.push(img.src); });
    if (!imgs.length) return;
    var slider   = card.querySelector('.bnd-addon-slider');
    var startIdx = slider ? parseInt(slider.dataset.idx, 10) || 0 : 0;
    bndOpenLightboxWith(imgs, startIdx);
  };

  /* ── FOOTER BROWSE BUTTONS ── */
  window.bndFooterNav = function (e, btn, dir) {
    e.stopPropagation();
    var card   = btn.closest('.bnd-addon-card');
    var slider = card.querySelector('.bnd-addon-slider');
    if (!slider) return;
    var idx = parseInt(slider.dataset.idx, 10) || 0;
    bndSliderGo(slider, idx + dir);
  };

  /* ── SCROLL TO REVIEWS ── */
  window.bndScrollToReviews = function () {
    var target = document.querySelector('.jdgm-rev-widg__header');
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  /* ── QUICK VIEW MODAL ── */
  var BND_QV_DATA = {
    'bnd-card-mod': {
      title:   '{{ addon_mod.title | escape }}',
      desc:    {{ addon_mod.description | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_mod.price }},
      compare: {{ addon_mod.compare_at_price | default: 0 }},
      images:  [{% for img in addon_mod.images %}'{{ img | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}],
      thumbs:  [{% for img in addon_mod.images %}'{{ img | image_url: width: 120 }}'{% unless forloop.last %},{% endunless %}{% endfor %}]
    },
    'bnd-card-marker': {
      title:   '{{ addon_marker.title | escape }}',
      desc:    {{ addon_marker.description | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_marker.price }},
      compare: {{ addon_marker.compare_at_price | default: 0 }},
      images:  [{% for img in addon_marker.images %}'{{ img | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}],
      thumbs:  [{% for img in addon_marker.images %}'{{ img | image_url: width: 120 }}'{% unless forloop.last %},{% endunless %}{% endfor %}]
    },
  };

  var bndQvCurrentId  = null;
  var bndQvImgIdx     = 0;
  var bndQvOverlay    = document.getElementById('bnd-qv-overlay');
  var bndQvMainImg    = document.getElementById('bnd-qv-main-img');
  var bndQvPrev       = document.getElementById('bnd-qv-prev');
  var bndQvNext       = document.getElementById('bnd-qv-next');
  var bndQvCount      = document.getElementById('bnd-qv-count');
  var bndQvThumbsEl   = document.getElementById('bnd-qv-thumbs');
  var bndQvTitleEl    = document.getElementById('bnd-qv-title');
  var bndQvPriceSale  = document.getElementById('bnd-qv-price-sale');
  var bndQvPriceComp  = document.getElementById('bnd-qv-price-compare');
  var bndQvPriceBadge = document.getElementById('bnd-qv-price-badge');
  var bndQvDescEl     = document.getElementById('bnd-qv-desc');
  var bndQvAddBtn     = document.getElementById('bnd-qv-add-btn');
  var bndQvAddLabel   = document.getElementById('bnd-qv-add-label');

  function bndQvMoney(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function bndQvRenderImg() {
    var data = BND_QV_DATA[bndQvCurrentId];
    bndQvMainImg.style.opacity = '0';
    setTimeout(function () {
      bndQvMainImg.src = data.images[bndQvImgIdx];
      bndQvMainImg.style.opacity = '1';
    }, 120);
    bndQvCount.textContent = (bndQvImgIdx + 1) + ' / ' + data.images.length;
    bndQvPrev.classList.toggle('off', bndQvImgIdx === 0);
    bndQvNext.classList.toggle('off', bndQvImgIdx === data.images.length - 1);
    bndQvThumbsEl.querySelectorAll('.bnd-qv-thumb').forEach(function (t, i) {
      t.classList.toggle('active', i === bndQvImgIdx);
    });
  }

  /* ── CHANGE 2: in-bundle = static "Added" badge, not a remove button ── */
  function bndQvSyncBtn() {
    var card     = document.getElementById(bndQvCurrentId);
    var inBundle = card && card.classList.contains('selected');
    if (inBundle) {
      bndQvAddBtn.classList.add('in-bundle');
      bndQvAddBtn.style.pointerEvents = 'none';
      bndQvAddBtn.style.cursor        = 'default';
      bndQvAddBtn.querySelector('svg').setAttribute('viewBox', '0 0 24 24');
      bndQvAddBtn.querySelector('svg').innerHTML = '<polyline points="4,12 9,17 20,6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>';
      bndQvAddLabel.textContent = 'Added';
    } else {
      bndQvAddBtn.classList.remove('in-bundle');
      bndQvAddBtn.style.pointerEvents = '';
      bndQvAddBtn.style.cursor        = '';
      bndQvAddBtn.querySelector('svg').setAttribute('viewBox', '0 0 24 24');
      bndQvAddBtn.querySelector('svg').innerHTML = '<line x1="12" y1="5" x2="12" y2="19" stroke-width="2.2" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke-width="2.2" stroke-linecap="round"/>';
      bndQvAddLabel.textContent = 'Add';
    }
  }

  /* Description accordion inside quick view */
  window.bndQvAccToggle = function (trigger) {
    var acc    = trigger.closest('.bnd-qv-acc');
    var isOpen = acc.classList.contains('open');
    document.querySelectorAll('#bnd-qv-panel .bnd-qv-acc').forEach(function (a) { a.classList.remove('open'); });
    if (!isOpen) acc.classList.add('open');
  };

  function bndQvAccReset() {
    document.querySelectorAll('#bnd-qv-panel .bnd-qv-acc').forEach(function (a) { a.classList.remove('open'); });
  }

  window.bndQvOpen = function (cardId) {
    var data = BND_QV_DATA[cardId];
    if (!data || !data.images.length) return;
    bndQvCurrentId = cardId;
    bndQvImgIdx    = 0;

    bndQvAccReset();
    bndQvTitleEl.textContent = data.title;
    bndQvDescEl.innerHTML    = data.desc || '<p>No description available.</p>';

    bndQvPriceSale.textContent = bndQvMoney(data.price);
    if (data.compare && data.compare > data.price) {
      var saved = data.compare - data.price;
      bndQvPriceComp.textContent   = bndQvMoney(data.compare);
      bndQvPriceComp.style.display  = '';
      bndQvPriceBadge.textContent  = 'Save ' + bndQvMoney(saved);
      bndQvPriceBadge.style.display = '';
    } else {
      bndQvPriceComp.style.display  = 'none';
      bndQvPriceBadge.style.display = 'none';
    }

    bndQvThumbsEl.innerHTML = '';
    data.thumbs.forEach(function (src, i) {
      var t = document.createElement('div');
      t.className = 'bnd-qv-thumb' + (i === 0 ? ' active' : '');
      t.innerHTML = '<img src="' + src + '" alt="">';
      t.addEventListener('click', function () { bndQvImgIdx = i; bndQvRenderImg(); });
      bndQvThumbsEl.appendChild(t);
    });

    bndQvMainImg.src = data.images[0];
    bndQvMainImg.style.opacity = '1';
    bndQvCount.textContent = '1 / ' + data.images.length;
    bndQvPrev.classList.add('off');
    bndQvNext.classList.toggle('off', data.images.length <= 1);

    bndQvSyncBtn();

    var scrollbarW = window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.style.overflow      = 'hidden';
    document.documentElement.style.paddingRight  = scrollbarW + 'px';
    document.body.style.overflow                 = 'hidden';
    document.body.style.paddingRight             = scrollbarW + 'px';
    bndQvOverlay.style.display = 'flex';
  };

  window.bndQvClose = function () {
    bndQvOverlay.style.display               = 'none';
    document.documentElement.style.overflow  = '';
    document.documentElement.style.paddingRight = '';
    document.body.style.overflow             = '';
    document.body.style.paddingRight         = '';
    bndQvCurrentId = null;
  };

  window.bndQvNav = function (dir) {
    var data = BND_QV_DATA[bndQvCurrentId];
    bndQvImgIdx = Math.max(0, Math.min(data.images.length - 1, bndQvImgIdx + dir));
    bndQvRenderImg();
  };

  /* ── CHANGE 3: CTA click — only adds, never removes; ignores if already selected ── */
  window.bndQvCtaClick = function () {
    if (!bndQvCurrentId) return;
    var card = document.getElementById(bndQvCurrentId);
    if (!card || card.classList.contains('locked')) return;
    /* Already in bundle — do nothing */
    if (card.classList.contains('selected')) return;
    /* ✨ ADDED POPUP from the card ✨ */
    bndShowAddedPopup(card);
    /* Close modal, then add */
    bndQvClose();
    bndToggleAddon(card);
  };

  /* Close on backdrop */
  bndQvOverlay.addEventListener('click', function (e) {
    if (e.target === bndQvOverlay) bndQvClose();
  });

  /* Keyboard navigation */
  document.addEventListener('keydown', function (e) {
    if (bndQvOverlay.style.display !== 'flex') return;
    if (e.key === 'Escape')     bndQvClose();
    if (e.key === 'ArrowLeft')  bndQvNav(-1);
    if (e.key === 'ArrowRight') bndQvNav(1);
  });

  /* Touch swipe on quick view */
  var bndQvTouchX = 0;
  bndQvOverlay.addEventListener('touchstart', function (e) { bndQvTouchX = e.touches[0].clientX; }, { passive: true });
  bndQvOverlay.addEventListener('touchend', function (e) {
    var diff = bndQvTouchX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) bndQvNav(diff > 0 ? 1 : -1);
  });

  /* ── KEEP UI IN SYNC WITH CART ── */
  var bndLastCartToken = null;

  function bndPollCart() {
    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var fingerprint = cart.token + '|' + cart.item_count + '|' +
          cart.items.map(function (i) { return i.variant_id + 'x' + i.quantity; }).join(',');

        if (fingerprint !== bndLastCartToken) {
          bndLastCartToken = fingerprint;
          document.querySelectorAll('.bnd-addon-card:not(.locked)').forEach(function (card) {
            bndApplySelected(card, false);
          });
          var inCart = cart.items.map(function (i) { return i.variant_id; });
          document.querySelectorAll('.bnd-addon-card:not(.locked)').forEach(function (card) {
            var v = parseInt(card.dataset.variant, 10);
            if (v && inCart.indexOf(v) !== -1) bndApplySelected(card, true);
          });
          bndUpdateTotal();
        }
      })
      .catch(function () {});
  }

  setInterval(bndPollCart, 1500);

  bndSyncFromCart();
  bndUpdateTotal();

})();
</script>


