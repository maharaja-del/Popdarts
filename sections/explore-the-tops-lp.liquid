<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
let exploreSwiper = null;

function initExploreSwiper() {
  if (window.innerWidth <= 768) {
    if (!exploreSwiper) {
      exploreSwiper = new Swiper('.explore-swiper-container', {
        slidesPerView: 1.5,
        spaceBetween: 14,
        centeredSlides: false,
        pagination: {
          el: '.explore-swiper-container .swiper-pagination',
          clickable: true,
        },
        breakpoints: {
          480: {
            slidesPerView: 2,
            spaceBetween: 14,
          },
          640: {
            slidesPerView: 2.5,
            spaceBetween: 14,
          }
        }
      });
    }
  } else {
    if (exploreSwiper) {
      exploreSwiper.destroy(true, true);
      exploreSwiper = null;
    }
  }
}

document.addEventListener('DOMContentLoaded', function() {
  initExploreSwiper();
});

let resizeTimer;
window.addEventListener('resize', function() {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(function() {
    initExploreSwiper();
  }, 250);
});
</script>