  /* ---------- ticker ---------- */
  .pd-campaign .pd-campaign__ticker { overflow: hidden; background: var(--pdc-night); color: #fff; padding-block: 16px; }
  .pd-campaign .pd-campaign__ticker-track { display: flex; width: max-content; animation: pdc-ticker 32s linear infinite; }
