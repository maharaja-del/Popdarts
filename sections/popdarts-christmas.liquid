  .pd-campaign .pd-campaign__tag em { font-style: normal; font-weight: 400; color: var(--pdc-muted); margin-right: 4px; }
  .pd-campaign .pd-campaign__tag-hole { position: absolute; left: 18px; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; background: var(--pdc-primary-deep); }

  @media (hover: hover) {
    .pd-campaign .pd-campaign__stack:hover .pd-campaign__tile--a { transform: rotate(-12deg) translate(-8px, -6px); }
    .pd-campaign .pd-campaign__stack:hover .pd-campaign__tile--b { transform: rotate(11deg) translate(8px, -6px); }
    .pd-campaign .pd-campaign__stack:hover .pd-campaign__tile--c { transform: rotate(0deg) translateY(-8px); }
