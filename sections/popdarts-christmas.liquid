    color: var(--pdc-ink);
  }
  .pd-campaign .pd-campaign__faq-item summary::-webkit-details-marker { display: none; }
  .pd-campaign .pd-campaign__faq-icon { position: relative; flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: var(--pdc-primary-tint); }
  .pd-campaign .pd-campaign__faq-icon::before,
  .pd-campaign .pd-campaign__faq-icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; border-radius: 2px; background: var(--pdc-access); transition: transform 0.2s ease; }
  .pd-campaign .pd-campaign__faq-icon::after { transform: rotate(90deg); }
  .pd-campaign .pd-campaign__faq-item[open] .pd-campaign__faq-icon { background: var(--pdc-primary); }
  .pd-campaign .pd-campaign__faq-item[open] .pd-campaign__faq-icon::before,
  .pd-campaign .pd-campaign__faq-item[open] .pd-campaign__faq-icon::after { background: var(--pdc-ink); }
  .pd-campaign .pd-campaign__faq-item[open] .pd-campaign__faq-icon::after { transform: rotate(0deg); }
  .pd-campaign .pd-campaign__faq-a { padding: 0 22px 22px; font-size: 16px; line-height: 1.6; color: var(--pdc-ink-2); }
  .pd-campaign .pd-campaign__faq-a p + p { margin-top: 10px; }

  /* ---------- final ---------- */
  .pd-campaign .pd-campaign__final { position: relative; isolation: isolate; overflow: hidden; background: var(--pdc-primary-grad); padding-block: clamp(72px, 10vw, 136px); text-align: center; }
  .pd-campaign .pd-campaign__final-inner { position: relative; z-index: 1; max-width: 820px; }
  .pd-campaign .pd-campaign__final-title {
    font-family: var(--pdc-head);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.9;
    font-size: clamp(44px, 7.6vw, 104px);
    color: var(--pdc-ink);
  }
  .pd-campaign .pd-campaign__final-body { max-width: 34em; margin: 20px auto 32px; font-size: clamp(17px, 1.6vw, 20px); line-height: 1.5; color: var(--pdc-ink); }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
