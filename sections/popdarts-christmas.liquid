    #pd-campaign-{{ section.id }} .pd-campaign__card-foot { flex-direction: column; align-items: flex-start; gap: 10px; }
    #pd-campaign-{{ section.id }} .pd-campaign__card-foot .pd-campaign__btn { width: 100%; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('pd-campaign-{{ section.id }}');
    if (!root || root.__pdCampaignInit) return;
    root.__pdCampaignInit = true;

    var flakes = root.querySelectorAll('.pd-campaign__flake');
    flakes.forEach(function (f) {
      f.style.left = (Math.random() * 100).toFixed(2) + '%';
      f.style.animationDuration = (7 + Math.random() * 8).toFixed(2) + 's';
      f.style.animationDelay = (Math.random() * -12).toFixed(2) + 's';
    });

    var cd = root.querySelector('[data-pd-campaign-countdown]');
    if (cd) {
      var target = new Date(cd.dataset.target).getTime();
      var textEl = cd.querySelector('[data-pd-campaign-countdown-text]');
      var label = textEl.textContent;
      var tick = function () {
        var diff = target - Date.now();
        var days = Math.max(Math.ceil(diff / 86400000), 0);
        textEl.textContent = days + ' ' + label.replace(/^\d+\s*/, '');
      };
      tick();
      setInterval(tick, 3600000);
    }

    root.querySelectorAll('[data-pd-campaign-atc]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.classList.contains('is-busy')) return;
        var id = parseInt(btn.dataset.variantId, 10);
        if (!id) return;
        var label = btn.querySelector('[data-pd-campaign-atc-label]') || btn;
        var original = label.textContent;
        btn.classList.add('is-busy');
        label.textContent = 'Adding…';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: id, quantity: 1 }] }),
        })
          .then(function (res) {
            if (!res.ok) throw new Error('add failed');
            return fetch('/cart.js').then(function (r) { return r.json(); });
          })
          .then(function (cart) {
            btn.classList.remove('is-busy');
            btn.classList.add('is-done');
            label.textContent = 'Added ✓';
            document.querySelectorAll('[data-cart-count], .cart-count, .cart-count-bubble, [data-header-cart-count]').forEach(function (el) {
              el.textContent = cart.item_count;
            });
            ['cart:refresh', 'cart:change', 'cart:build', 'cart-drawer:refresh'].forEach(function (name) {
              document.documentElement.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: { cart: cart } }));
            });
            var toggle = document.querySelector('[data-cart-toggle], .cart-toggle, #cart-toggle, .js-cart-open');
            if (toggle) toggle.click();
            setTimeout(function () {
              btn.classList.remove('is-done');
              label.textContent = original;
            }, 2400);
          })
          .catch(function () {
            btn.classList.remove('is-busy');
            label.textContent = original;
            window.location.href = '/cart';
          });
      });
    });
  })();
</script>

