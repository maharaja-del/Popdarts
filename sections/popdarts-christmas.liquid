  .pd-campaign .pd-campaign__lede { font-size: clamp(17px, 1.6vw, 20px); line-height: 1.5; color: var(--pdc-ink); max-width: 30em; margin-top: 24px; }
  .pd-campaign .pd-campaign__hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .pd-campaign .pd-campaign__from { margin-top: 18px; font-size: 15px; color: var(--pdc-ink); }
  .pd-campaign .pd-campaign__from strong { font-weight: 900; }

  .pd-campaign .pd-campaign__stack { position: relative; width: 100%; max-width: 560px; margin-left: auto; aspect-ratio: 1 / 0.94; }
  .pd-campaign .pd-campaign__tile {
    position: absolute;
    padding: 10px;
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 30px 60px -28px rgba(11, 21, 34, 0.65);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pd-campaign .pd-campaign__tile img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 16px; }
  .pd-campaign .pd-campaign__tile--a { width: 48%; left: 0; top: 4%; transform: rotate(-9deg); }
  .pd-campaign .pd-campaign__tile--b { width: 48%; right: 0; top: 0; transform: rotate(8deg); }
