{%- comment -%}
  Popdarts Christmas campaign — "Crown the Family Champ".
  Self-contained: scoped styles + JS, theme Inter fonts only, live product
  data (price/compare-at/image/availability) for every product shown.
  Root .pd-campaign, all elements prefixed pd-campaign__.
  Gift finder entries, reviews and FAQs are blocks; everything else is a
  section setting.
{%- endcomment -%}
{%- liquid
  assign gifts = section.blocks | where: 'type', 'gift'
  assign reviews = section.blocks | where: 'type', 'review'
  assign faqs = section.blocks | where: 'type', 'faq'

  assign min_price = 0
  for b in gifts
    assign p = all_products[b.settings.product_handle]
    if p
      assign pv = p.selected_or_first_available_variant
      if min_price == 0 or pv.price < min_price
        assign min_price = pv.price
      endif
    endif
  endfor

  assign now_s = 'now' | date: '%s' | plus: 0
  assign xmas_s = section.settings.christmas_date | default: '2026-12-25' | date: '%s' | plus: 0
  assign days_left = xmas_s | minus: now_s | divided_by: 86400 | plus: 1

  assign hero_back_left = all_products[section.settings.hero_product_1]
  assign hero_back_right = all_products[section.settings.hero_product_2]
  assign hero_front = all_products[section.settings.hero_product_3]

  if section.settings.showdown_image
    assign showdown_src = section.settings.showdown_image | image_url: width: 1400
  else
    assign showdown_src = 'pd-bento-trophy-shoulders.jpg' | asset_url
  endif
-%}

<section class="pd-campaign" id="pd-campaign-{{ section.id }}" aria-label="{{ section.settings.heading_highlight | default: 'Christmas gift guide' }}">

  {%- comment -%} ===================== HERO ===================== {%- endcomment -%}
  <div class="pd-campaign__hero">
    {%- if section.settings.show_snow -%}
      <div class="pd-campaign__snow" aria-hidden="true">
        {%- for i in (1..28) -%}<i></i>{%- endfor -%}
      </div>
    {%- endif -%}

    <div class="pd-campaign__wrap pd-campaign__hero-grid">
      <div class="pd-campaign__hero-copy">
        {%- if days_left > 0 -%}
          <p class="pd-campaign__chip" data-pd-countdown data-target="{{ section.settings.christmas_date | default: '2026-12-25' }}">
            <span aria-hidden="true">🎄</span>
            <strong data-pd-countdown-n>{{ days_left }}</strong>
            <span>{{ section.settings.countdown_suffix | default: 'days until Christmas' }}</span>
          </p>
        {%- endif -%}

        <h1 class="pd-campaign__title">
          <span class="pd-campaign__title-kicker">{{ section.settings.heading_line_1 | default: 'This Christmas,' }}</span>
          <span class="pd-campaign__title-mark">{{ section.settings.heading_highlight | default: 'Crown the' }}</span>
          <span>{{ section.settings.heading_line_3 | default: 'Family Champ.' }}</span>
        </h1>

        <p class="pd-campaign__lede">{{ section.settings.body | default: 'The game that turns every living room into a showdown. Easy to learn, impossible to put down — for ages 5 to 95.' }}</p>

        <div class="pd-campaign__hero-actions">
          <a class="pd-campaign__btn pd-campaign__btn--white" href="#pd-campaign-finder-{{ section.id }}">{{ section.settings.button_text | default: 'Find Their Gift' }}</a>
          <a class="pd-campaign__btn pd-campaign__btn--outline" href="{{ section.settings.secondary_button_link | default: '/collections/all' }}">{{ section.settings.secondary_button_text | default: 'Shop All' }}</a>
        </div>

        {%- if min_price > 0 -%}
          <p class="pd-campaign__from">{{ section.settings.from_prefix | default: 'Gifts from' }} <strong>{{ min_price | money }}</strong></p>
        {%- endif -%}
      </div>

      <div class="pd-campaign__stack" aria-hidden="true">
        {%- if hero_back_left -%}
          <div class="pd-campaign__tile pd-campaign__tile--a">
            <img src="{{ hero_back_left.featured_image | image_url: width: 600 }}" alt="" width="600" height="600" loading="eager" decoding="async">
            <span class="pd-campaign__tile-price">{{ hero_back_left.selected_or_first_available_variant.price | money }}</span>
          </div>
        {%- endif -%}
        {%- if hero_back_right -%}
          <div class="pd-campaign__tile pd-campaign__tile--b">
            <img src="{{ hero_back_right.featured_image | image_url: width: 600 }}" alt="" width="600" height="600" loading="eager" decoding="async">
            <span class="pd-campaign__tile-price">{{ hero_back_right.selected_or_first_available_variant.price | money }}</span>
          </div>
        {%- endif -%}
        {%- if hero_front -%}
          <div class="pd-campaign__tile pd-campaign__tile--c">
            <img src="{{ hero_front.featured_image | image_url: width: 800 }}" alt="" width="800" height="800" loading="eager" fetchpriority="high" decoding="async">
            <span class="pd-campaign__tile-price">{{ hero_front.selected_or_first_available_variant.price | money }}</span>
          </div>
        {%- endif -%}
        <div class="pd-campaign__tag">
          <span class="pd-campaign__tag-hole"></span>
          <span class="pd-campaign__tag-line"><em>To:</em> {{ section.settings.tag_to | default: 'The family champ' }}</span>
          <span class="pd-campaign__tag-line"><em>From:</em> {{ section.settings.tag_from | default: 'You (obviously)' }}</span>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ===================== PERKS TICKER ===================== {%- endcomment -%}
  {%- assign perks = section.settings.ticker_items | default: 'Free shipping on orders $50+|Ages 5 to 95|Play indoors or out|Dishwasher-safe darts|Easy to learn, tough to master' | split: '|' -%}
  <div class="pd-campaign__ticker" aria-label="Perks">
    <div class="pd-campaign__ticker-track">
      {%- for round in (1..2) -%}
        <ul class="pd-campaign__ticker-list"{% if round == 2 %} aria-hidden="true"{% endif %}>
          {%- if min_price > 0 -%}<li>{{ section.settings.from_prefix | default: 'Gifts from' }} {{ min_price | money }}</li>{%- endif -%}
          {%- for perk in perks -%}<li>{{ perk | strip }}</li>{%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ===================== GIFT FINDER ===================== {%- endcomment -%}
  <div class="pd-campaign__finder" id="pd-campaign-finder-{{ section.id }}">
    <div class="pd-campaign__wrap">
      <div class="pd-campaign__head">
        <p class="pd-campaign__eyebrow">{{ section.settings.finder_eyebrow | default: 'Gift finder' }}</p>
        <h2 class="pd-campaign__h2">{{ section.settings.finder_heading | default: "Who's on your list?" }}</h2>
        <p class="pd-campaign__sub">{{ section.settings.finder_body | default: 'Pick a player. We will tell you exactly what to wrap.' }}</p>
      </div>

      <div class="pd-campaign__tabs" role="tablist" aria-label="{{ section.settings.finder_heading | default: 'Gift finder' | escape }}">
        {%- assign tab_i = 0 -%}
        {%- for b in gifts -%}
          {%- assign p = all_products[b.settings.product_handle] -%}
          {%- if p -%}
            {%- assign tab_i = tab_i | plus: 1 -%}
            {%- assign pv = p.selected_or_first_available_variant -%}
            <button type="button" class="pd-campaign__tab{% if tab_i == 1 %} is-active{% endif %}" role="tab" id="pdc-tab-{{ section.id }}-{{ tab_i }}" aria-controls="pdc-panel-{{ section.id }}-{{ tab_i }}" aria-selected="{% if tab_i == 1 %}true{% else %}false{% endif %}" tabindex="{% if tab_i == 1 %}0{% else %}-1{% endif %}" data-pd-tab {{ b.shopify_attributes }}>
              <span class="pd-campaign__tab-thumb"><img src="{{ p.featured_image | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy" decoding="async"></span>
              <span class="pd-campaign__tab-text">
                <span class="pd-campaign__tab-persona">{{ b.settings.persona }}</span>
                <span class="pd-campaign__tab-meta">{{ p.title }} · {{ pv.price | money }}</span>
              </span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- assign panel_i = 0 -%}
      {%- for b in gifts -%}
        {%- assign p = all_products[b.settings.product_handle] -%}
        {%- if p -%}
          {%- assign panel_i = panel_i | plus: 1 -%}
          {%- assign pv = p.selected_or_first_available_variant -%}
          <div class="pd-campaign__panel" role="tabpanel" id="pdc-panel-{{ section.id }}-{{ panel_i }}" aria-labelledby="pdc-tab-{{ section.id }}-{{ panel_i }}"{% if panel_i > 1 %} hidden{% endif %} data-pd-panel>
            <a class="pd-campaign__panel-media" href="{{ p.url }}">
              <img src="{{ p.featured_image | image_url: width: 1000 }}" alt="{{ p.title | escape }}" width="1000" height="1000" loading="lazy" decoding="async">
              {%- if b.settings.badge != blank -%}<span class="pd-campaign__sticker">{{ b.settings.badge }}</span>{%- endif -%}
            </a>
            <div class="pd-campaign__panel-info">
              <p class="pd-campaign__eyebrow">{{ b.settings.persona }}</p>
              <h3 class="pd-campaign__panel-title">{{ p.title }}</h3>
              <div class="pd-campaign__price">
                <span class="pd-campaign__price-now">{{ pv.price | money }}</span>
                {%- if pv.compare_at_price > pv.price -%}
                  <s class="pd-campaign__price-was">{{ pv.compare_at_price | money }}</s>
                  <span class="pd-campaign__save">Save {{ pv.compare_at_price | minus: pv.price | money }}</span>
                {%- endif -%}
              </div>
              {%- if b.settings.description != blank -%}<p class="pd-campaign__panel-desc">{{ b.settings.description }}</p>{%- endif -%}
              <ul class="pd-campaign__checks">
                {%- for n in (1..3) -%}
                  {%- assign key = 'bullet_' | append: n -%}
                  {%- if b.settings[key] != blank -%}
                    <li><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor" opacity=".14"/><path d="M6 10.2l2.6 2.6L14 7.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ b.settings[key] }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
              <div class="pd-campaign__panel-actions">
                {%- if pv.available -%}
                  <button type="button" class="pd-campaign__btn pd-campaign__btn--blue" data-pd-atc data-variant-id="{{ pv.id }}"><span data-pd-atc-label>{{ section.settings.atc_text | default: 'Add To Cart' }}</span></button>
                {%- else -%}
                  <a class="pd-campaign__btn pd-campaign__btn--blue" href="{{ p.url }}">{{ section.settings.sold_out_text | default: 'See Details' }}</a>
                {%- endif -%}
                <a class="pd-campaign__link" href="{{ p.url }}">{{ section.settings.details_text | default: 'View details' }} <span aria-hidden="true">&rarr;</span></a>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ===================== SHOWDOWN ===================== {%- endcomment -%}
  <div class="pd-campaign__showdown">
    <div class="pd-campaign__wrap pd-campaign__showdown-grid">
      <div class="pd-campaign__showdown-media">
        <img src="{{ showdown_src }}" alt="{{ section.settings.showdown_alt | default: 'A player lifting the Popdarts National Championship trophy' | escape }}" width="900" height="506" loading="lazy" decoding="async">
        <span class="pd-campaign__sticker pd-campaign__sticker--live">{{ section.settings.showdown_sticker | default: 'Live on ESPN' }}</span>
      </div>
      <div class="pd-campaign__showdown-copy">
        <p class="pd-campaign__eyebrow pd-campaign__eyebrow--light">{{ section.settings.showdown_eyebrow | default: 'The real deal' }}</p>
        <h2 class="pd-campaign__h2 pd-campaign__h2--light">{{ section.settings.showdown_heading | default: 'From the living room to ESPN.' }}</h2>
        <p class="pd-campaign__sub pd-campaign__sub--light">{{ section.settings.showdown_body | default: 'The same game played at the Popdarts National Championship fits under your tree. Unwrap it in the morning, settle the family rivalry by dinner.' }}</p>
        <div class="pd-campaign__stats">
          <div><strong>{{ section.settings.stat_1_value | default: '1B+' }}</strong><span>{{ section.settings.stat_1_label | default: 'Social views' }}</span></div>
          <div><strong>{{ section.settings.stat_2_value | default: '5–95' }}</strong><span>{{ section.settings.stat_2_label | default: 'Ages it works for' }}</span></div>
          <div><strong>{{ section.settings.stat_3_value | default: '21' }}</strong><span>{{ section.settings.stat_3_label | default: 'Points to win' }}</span></div>
        </div>
        <a class="pd-campaign__btn pd-campaign__btn--grad" href="#pd-campaign-finder-{{ section.id }}">{{ section.settings.showdown_button_text | default: 'Pick Your Pack' }}</a>
      </div>
    </div>
  </div>

  {%- comment -%} ===================== HOW TO WIN ===================== {%- endcomment -%}
  <div class="pd-campaign__steps">
    <div class="pd-campaign__wrap">
      <div class="pd-campaign__head">
        <p class="pd-campaign__eyebrow">{{ section.settings.steps_eyebrow | default: 'Rules in 30 seconds' }}</p>
        <h2 class="pd-campaign__h2">{{ section.settings.steps_heading | default: 'How to win Christmas.' }}</h2>
      </div>
      <ol class="pd-campaign__step-list">
        <li class="pd-campaign__step">
          <span class="pd-campaign__step-n">01</span>
          <h3>{{ section.settings.step_1_title | default: 'Set the marker' }}</h3>
          <p>{{ section.settings.step_1_body | default: 'Stick the Target Marker on any smooth surface — a window, the fridge, a glass door.' }}</p>
        </li>
        <li class="pd-campaign__step">
          <span class="pd-campaign__step-n">02</span>
          <h3>{{ section.settings.step_2_title | default: 'Throw & stick' }}</h3>
          <p>{{ section.settings.step_2_body | default: 'Take turns throwing your 3 darts. Closest to the marker takes the round.' }}</p>
        </li>
        <li class="pd-campaign__step">
          <span class="pd-campaign__step-n">03</span>
          <h3>{{ section.settings.step_3_title | default: 'Score & gloat' }}</h3>
          <p>{{ section.settings.step_3_body | default: 'Cancellation scoring, first to 21 wins. Bragging rights last until next Christmas.' }}</p>
          <div class="pd-campaign__points">
            <span><b>+3</b> Closest</span>
            <span><b>+1</b> Every stick</span>
            <span><b>+10</b> On the PRO marker</span>
          </div>
        </li>
      </ol>
    </div>
  </div>

  {%- comment -%} ===================== REVIEWS ===================== {%- endcomment -%}
  {%- if reviews.size > 0 -%}
    <div class="pd-campaign__reviews">
      <div class="pd-campaign__wrap">
        <div class="pd-campaign__head">
          <p class="pd-campaign__eyebrow">{{ section.settings.reviews_eyebrow | default: 'Verified reviews' }}</p>
          <h2 class="pd-campaign__h2">{{ section.settings.reviews_heading | default: 'Unwrapped. Undefeated.' }}</h2>
        </div>
        <div class="pd-campaign__quotes">
          {%- for b in reviews -%}
            <figure class="pd-campaign__quote" {{ b.shopify_attributes }}>
              <div class="pd-campaign__stars" aria-label="5 out of 5 stars">★★★★★</div>
              <blockquote>{{ b.settings.quote }}</blockquote>
              <figcaption>{{ b.settings.name | default: 'Verified Buyer' }}</figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ===================== FAQ ===================== {%- endcomment -%}
  {%- if faqs.size > 0 -%}
    <div class="pd-campaign__faq">
      <div class="pd-campaign__wrap pd-campaign__faq-grid">
        <div class="pd-campaign__faq-head">
          <p class="pd-campaign__eyebrow">{{ section.settings.faq_eyebrow | default: 'Good to know' }}</p>
          <h2 class="pd-campaign__h2">{{ section.settings.faq_heading | default: 'Before you wrap it.' }}</h2>
        </div>
        <div class="pd-campaign__faq-list">
          {%- for b in faqs -%}
            <details class="pd-campaign__faq-item" {{ b.shopify_attributes }}>
              <summary>{{ b.settings.question }}<span class="pd-campaign__faq-icon" aria-hidden="true"></span></summary>
              <div class="pd-campaign__faq-a">{{ b.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ===================== FINAL CTA ===================== {%- endcomment -%}
  <div class="pd-campaign__final">
    {%- if section.settings.show_snow -%}
      <div class="pd-campaign__snow pd-campaign__snow--soft" aria-hidden="true">
        {%- for i in (1..16) -%}<i></i>{%- endfor -%}
      </div>
    {%- endif -%}
    <div class="pd-campaign__wrap pd-campaign__final-inner">
      <h2 class="pd-campaign__final-title">{{ section.settings.final_heading | default: 'Game night, wrapped.' }}</h2>
      <p class="pd-campaign__final-body">{{ section.settings.final_body | default: 'One box. Every generation at the table. The gift they will still be playing in January.' }}</p>
      <a class="pd-campaign__btn pd-campaign__btn--white" href="#pd-campaign-finder-{{ section.id }}">{{ section.settings.final_button_text | default: 'Find Their Gift' }}</a>
    </div>
  </div>
</section>

<style>
  .pd-campaign {
    --pdc-primary: #2B99FF;
    --pdc-primary-light: #55ADFF;
    --pdc-primary-deep: #278AE6;
    --pdc-primary-tint: #EAF5FF;
    --pdc-primary-glow: rgba(43, 153, 255, 0.45);
    --pdc-primary-grad: linear-gradient(135deg, #55ADFF 0%, #2B99FF 55%, #278AE6 100%);
    --pdc-access: #1E6BB3;
    --pdc-access-hover: #1A5C99;
    --pdc-ink: #0A0A0A;
    --pdc-ink-2: #414B57;
    --pdc-muted: #626D79;
    --pdc-paper: #FFFFFF;
    --pdc-mist: #F4F9FD;
    --pdc-line: #DFE3E8;
    --pdc-night: #0B1522;
    --pdc-success: #187647;
    --pdc-success-tint: #E8F1ED;
    --pdc-head: var(--font-heading-family, Inter, sans-serif);
    --pdc-body: var(--font-body-family, Inter, sans-serif);
    --pdc-gutter: clamp(20px, 5vw, 56px);
    background: var(--pdc-paper);
    color: var(--pdc-ink);
    font-family: var(--pdc-body);
    font-weight: 400;
    overflow-x: clip;
  }
  .pd-campaign *, .pd-campaign *::before, .pd-campaign *::after { box-sizing: border-box; }
  .pd-campaign img { display: block; max-width: 100%; height: auto; }
  .pd-campaign a { color: inherit; text-decoration: none; }
  .pd-campaign ul, .pd-campaign ol { list-style: none; margin: 0; padding: 0; }
  .pd-campaign p, .pd-campaign h1, .pd-campaign h2, .pd-campaign h3, .pd-campaign figure, .pd-campaign blockquote { margin: 0; }
  .pd-campaign button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    height: auto;
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
    white-space: normal;
    cursor: pointer;
  }
  .pd-campaign :focus-visible { outline: 3px solid var(--pdc-access); outline-offset: 3px; }

  .pd-campaign .pd-campaign__wrap { max-width: 1280px; margin-inline: auto; padding-inline: var(--pdc-gutter); }

  /* ---------- type ---------- */
  .pd-campaign .pd-campaign__eyebrow {
    font-family: var(--pdc-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pdc-access);
    margin-bottom: 12px;
  }
  .pd-campaign .pd-campaign__eyebrow--light { color: var(--pdc-primary-light); }
  .pd-campaign .pd-campaign__h2 {
    font-family: var(--pdc-head);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.95;
    font-size: clamp(32px, 5vw, 60px);
    color: var(--pdc-ink);
  }
  .pd-campaign .pd-campaign__h2--light { color: #fff; }
  .pd-campaign .pd-campaign__sub { font-size: clamp(16px, 1.5vw, 18px); line-height: 1.55; color: var(--pdc-ink-2); margin-top: 14px; }
  .pd-campaign .pd-campaign__sub--light { color: rgba(255, 255, 255, 0.72); }
  .pd-campaign .pd-campaign__head { text-align: center; max-width: 680px; margin: 0 auto clamp(32px, 5vw, 52px); }

  /* ---------- buttons ---------- */
  .pd-campaign .pd-campaign__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 56px;
    padding: 0 30px;
    border-radius: 999px;
    border: 2px solid transparent;
    font-family: var(--pdc-body);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }
  .pd-campaign .pd-campaign__btn:hover { transform: translateY(-2px); }
  .pd-campaign .pd-campaign__btn--white { background: #fff; color: var(--pdc-ink); box-shadow: 0 14px 30px -14px rgba(11, 21, 34, 0.55); }
  .pd-campaign .pd-campaign__btn--outline { background: transparent; color: var(--pdc-ink); border-color: var(--pdc-ink); }
  .pd-campaign .pd-campaign__btn--outline:hover { background: rgba(255, 255, 255, 0.22); }
  .pd-campaign .pd-campaign__btn--blue { background: var(--pdc-access); color: #fff; }
  .pd-campaign .pd-campaign__btn--blue:hover { background: var(--pdc-access-hover); }
  .pd-campaign .pd-campaign__btn--grad { background: var(--pdc-primary-grad); color: var(--pdc-ink); box-shadow: 0 16px 36px -14px var(--pdc-primary-glow); }
  .pd-campaign .pd-campaign__btn.is-busy { opacity: 0.7; pointer-events: none; }
  .pd-campaign .pd-campaign__btn.is-done { background: var(--pdc-success); color: #fff; }

  .pd-campaign .pd-campaign__link { font-weight: 700; font-size: 15px; color: var(--pdc-access); }
  .pd-campaign .pd-campaign__link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .pd-campaign .pd-campaign__sticker {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--pdc-primary);
    color: var(--pdc-ink);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: rotate(-4deg);
    box-shadow: 0 8px 18px -10px rgba(11, 21, 34, 0.6);
  }

  /* ---------- snow ---------- */
  .pd-campaign .pd-campaign__snow { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .pd-campaign .pd-campaign__snow i {
    position: absolute;
    top: -10px;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    opacity: 0.75;
    animation: pdc-snow 12s linear infinite;
  }
  .pd-campaign .pd-campaign__snow i:nth-child(3n) { width: 4px; height: 4px; opacity: 0.55; }
  .pd-campaign .pd-campaign__snow i:nth-child(4n) { width: 8px; height: 8px; opacity: 0.4; }
  .pd-campaign .pd-campaign__snow--soft i { opacity: 0.35; }
  @keyframes pdc-snow {
    0% { transform: translate3d(0, 0, 0); }
