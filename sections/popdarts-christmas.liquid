  .pd-campaign .pd-campaign__stars { color: var(--pdc-primary); letter-spacing: 3px; font-size: 18px; }
  .pd-campaign .pd-campaign__quote blockquote { flex: 1; margin-top: 14px; font-size: 18px; line-height: 1.5; font-weight: 700; color: var(--pdc-ink); }
