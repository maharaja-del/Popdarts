  }

  @media (prefers-reduced-motion: reduce) {
    .pd-campaign .pd-campaign__snow { display: none; }
    .pd-campaign .pd-campaign__ticker-track { animation: none; }
    .pd-campaign .pd-campaign__panel.is-entering { animation: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('pd-campaign-{{ section.id }}');
    if (!root || root.__pdcInit) return;
    root.__pdcInit = true;

    // Snow: randomise each flake's column, speed, delay and sideways drift.
    root.querySelectorAll('.pd-campaign__snow i').forEach(function (f) {
      f.style.left = (Math.random() * 100).toFixed(1) + '%';
      f.style.animationDuration = (9 + Math.random() * 10).toFixed(1) + 's';
      f.style.animationDelay = (-Math.random() * 18).toFixed(1) + 's';
      f.style.setProperty('--drift', (Math.random() * 80 - 40).toFixed(0) + 'px');
    });

    // Countdown — server renders a value; this keeps it right on cached pages.
    var cd = root.querySelector('[data-pd-countdown]');
    if (cd) {
      var target = new Date(cd.dataset.target + 'T00:00:00').getTime();
      var n = cd.querySelector('[data-pd-countdown-n]');
      var days = Math.ceil((target - Date.now()) / 86400000);
      if (days > 0) { n.textContent = days; } else { cd.hidden = true; }
    }

    // Gift finder tabs (click + arrow keys).
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-pd-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-pd-panel]'));
    function select(i, focus) {
      tabs.forEach(function (t, j) {
        var on = i === j;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        if (panels[j]) {
          panels[j].hidden = !on;
          panels[j].classList.toggle('is-entering', on);
        }
      });
      if (focus) tabs[i].focus();
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { select(i, false); });
      t.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
      });
    });

    // Add to cart.
    root.querySelectorAll('[data-pd-atc]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.classList.contains('is-busy')) return;
        var id = parseInt(btn.dataset.variantId, 10);
        if (!id) return;
        var label = btn.querySelector('[data-pd-atc-label]') || btn;
        var original = label.textContent;
        btn.classList.add('is-busy');
        label.textContent = 'Adding…';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
        })
          .then(function (res) {
            if (!res.ok) throw new Error('add failed');
            return fetch('/cart.js').then(function (r) { return r.json(); });
          })
          .then(function (cart) {
            btn.classList.remove('is-busy');
            btn.classList.add('is-done');
            label.textContent = 'Added ✓';
            document.querySelectorAll('[data-cart-count], .cart-count, .cart-count-bubble, [data-header-cart-count]').forEach(function (el) { el.textContent = cart.item_count; });
            ['cart:refresh', 'cart:change', 'cart:build', 'cart-drawer:refresh'].forEach(function (name) {
              document.documentElement.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: { cart: cart } }));
            });
            var toggle = document.querySelector('[data-cart-toggle], .cart-toggle, #cart-toggle, .js-cart-open');
            if (toggle) toggle.click();
            setTimeout(function () { btn.classList.remove('is-done'); label.textContent = original; }, 2400);
          })
          .catch(function () {
            btn.classList.remove('is-busy');
            label.textContent = original;
            window.location.href = '/cart';
          });
      });
    });
  })();
</script>

