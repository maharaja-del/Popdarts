  @keyframes pdc-ticker { to { transform: translateX(-50%); } }

  /* ---------- gift finder ---------- */
  .pd-campaign .pd-campaign__finder { background: var(--pdc-paper); padding-block: clamp(64px, 9vw, 120px); scroll-margin-top: 80px; }
  .pd-campaign .pd-campaign__tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: clamp(24px, 3vw, 36px); }
