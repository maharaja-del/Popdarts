  .pd-campaign .pd-campaign__faq { background: var(--pdc-mist); padding-block: clamp(64px, 9vw, 120px); }
  .pd-campaign .pd-campaign__faq-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .pd-campaign .pd-campaign__faq-head { position: sticky; top: 100px; }
  .pd-campaign .pd-campaign__faq-list { display: grid; gap: 12px; }
  .pd-campaign .pd-campaign__faq-item { background: #fff; border: 1px solid var(--pdc-line); border-radius: 20px; transition: border-color 0.18s ease; }
  .pd-campaign .pd-campaign__faq-item[open] { border-color: var(--pdc-primary); }
  .pd-campaign .pd-campaign__faq-item summary {
    display: flex;
    align-items: center;
