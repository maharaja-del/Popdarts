  #pd-campaign-{{ section.id }} .pd-campaign__quote { background: var(--pc-paper); border: 1px solid var(--pc-line); border-radius: 16px; padding: 24px; }
  #pd-campaign-{{ section.id }} .pd-campaign__quote-stars { color: var(--pc-primary-accessible); letter-spacing: 2px; font-size: 14px; margin-bottom: 12px; }
