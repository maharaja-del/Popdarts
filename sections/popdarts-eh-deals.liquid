{%- comment -%}
  Early Holiday: lineup hero + "the holiday edit". ONE section on purpose: Shopify sections can't read each other's settings, so the
  hero headline [pct], the hero buy panel and every deal card read the same approval register (the deal blocks).
  Other sections mirror approved savings at runtime from [data-cm-register] by variant id — never compute them.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign hide = st.hide_variants
  assign hide_terms = hide | downcase | split: ','

  assign headline_pct = 0
  assign x_pct = 0
  assign live_cards = 0
  assign keys = ''
  assign register = ''
  assign notes = ''
  assign tab_cards_1 = 0
  assign tab_cards_2 = 0
  assign tab_cards_3 = 0
  assign tab_cards_4 = 0
  assign tab_deals_1 = 0
  assign tab_deals_2 = 0
  assign tab_deals_3 = 0
  assign tab_deals_4 = 0

  for block in section.blocks
    assign p = block.settings.product
    if p == blank
      continue
    endif
    assign hay = p.handle | append: ' ' | append: p.title | downcase
    assign tag_list = p.tags | join: ',' | downcase
    assign ptype = p.type | downcase
    assign excluded = ''
    if hay contains 'elite' or tag_list contains 'elite'
      assign excluded = 'Elite is never discounted'
    elsif hay contains 'gift card' or hay contains 'gift-card' or ptype contains 'gift card'
      assign excluded = 'gift cards are never discounted'
    elsif hay contains 'slightly' or hay contains 'returned' or ptype == 'returns'
      assign excluded = 'slightly used / returned items are not part of the sale'
    endif
    if excluded != blank
      capture n
        echo '<li>Removed from deals: <b>' | append: p.title | append: '</b> (' | append: excluded | append: ').</li>'
      endcapture
      assign notes = notes | append: n
      continue
    endif

    assign bs = block.settings
    assign p_avail = 0
    assign p_deal = false
    assign p_inv = 0
    assign p_untracked = false
    assign oc_count = 0
    assign oc_max = 0
    assign oc_cap = 0
    for v in p.variants
      assign vt = v.title | downcase | strip
      assign is_hidden = false
      for h in hide_terms
        assign hs = h | strip
        if hs != blank and vt == hs
          assign is_hidden = true
        endif
      endfor
      if is_hidden or v.available == false
        continue
      endif
      assign p_avail = p_avail | plus: 1
      if v.inventory_management == blank or v.inventory_policy == 'continue'
        assign p_untracked = true
      elsif v.inventory_quantity > 0
        assign p_inv = p_inv | plus: v.inventory_quantity
      endif
      capture o
        render 'popdarts-cm-offer', variant: v, product: p, status: bs.offer, confirmed: bs.compare_confirmed, approved: bs.extended_approved, skus: bs.extended_skus, protected: bs.protected
      endcapture
      assign oo = o | strip | split: '|'
      if oo[1] == 'yes'
        assign p_deal = true
        assign vp = oo[0] | plus: 0
        if vp <= 20 and vp > headline_pct
          assign headline_pct = vp
        endif
        if vp > 20 and vp > x_pct
          assign x_pct = vp
        endif
        capture reg
          echo '<i data-id="'
          echo v.id
          echo '" data-was="'
          echo v.compare_at_price | money
          echo '" data-off="'
          echo vp
          echo '% off" data-save="Save '
          echo v.compare_at_price | minus: v.price | money
          echo '"></i>'
        endcapture
        assign register = register | append: reg
      elsif bs.offer != 'none' and oo[2] == 'over_cap'
        assign oc_count = oc_count | plus: 1
        assign ocp = oo[0] | plus: 0
        if ocp > oc_max
          assign oc_max = ocp
        endif
        assign oc_cap = oo[3]
      elsif bs.offer != 'none' and oo[2] == 'not_confirmed'
        capture n
          echo '<li>Saving hidden on <b>' | append: p.title | append: '</b>: tick “Compare-at confirmed as the regular price” once it is checked.</li>'
        endcapture
        unless notes contains n
          assign notes = notes | append: n
        endunless
      endif
    endfor

    if oc_count > 0
      capture n
        echo '<li>Saving hidden on <b>' | append: p.title | append: '</b> for ' | append: oc_count | append: ' option(s): up to ' | append: oc_max | append: '% off is over its ' | append: oc_cap | append: '% cap. Fix the price or the approval.</li>'
      endcapture
      assign notes = notes | append: n
    endif

    if p_avail == 0 and st.show_soldout == false
      capture n
        echo '<li><b>' | append: p.title | append: '</b> is sold out, so it is hidden.</li>'
      endcapture
      assign notes = notes | append: n
      continue
    endif

    assign t = bs.tab | default: '1'
    case t
      when '1'
        assign tab_cards_1 = tab_cards_1 | plus: 1
        if p_deal
          assign tab_deals_1 = tab_deals_1 | plus: 1
        endif
      when '2'
        assign tab_cards_2 = tab_cards_2 | plus: 1
        if p_deal
          assign tab_deals_2 = tab_deals_2 | plus: 1
        endif
      when '3'
        assign tab_cards_3 = tab_cards_3 | plus: 1
        if p_deal
          assign tab_deals_3 = tab_deals_3 | plus: 1
        endif
      else
        assign t = '4'
        assign tab_cards_4 = tab_cards_4 | plus: 1
        if p_deal
          assign tab_deals_4 = tab_deals_4 | plus: 1
        endif
    endcase
    if p_deal
      assign live_cards = live_cards | plus: 1
    endif

    assign avail_flag = 0
    if p_avail > 0
      assign avail_flag = 1
    endif
    if st.sort == 'inventory'
      if p_untracked
        assign primary = 19989999
      else
        assign primary = p_inv | at_most: 9989999 | plus: 10000000
      endif
    else
      assign primary = 9999 | minus: forloop.index0 | plus: 10000000
    endif
    assign idx = forloop.index0 | plus: 1000
    assign keys = keys | append: t | append: '|' | append: avail_flag | append: '|' | append: primary | append: '|' | append: idx | append: ';'
  endfor
  assign sorted = keys | split: ';' | sort | reverse

  assign headline_pct_s = headline_pct | append: ''
  assign x_pct_s = x_pct | append: ''
-%}
{% render 'popdarts-cm-assets' %}{% render 'popdarts-eh-assets' %}

{%- if request.design_mode -%}
  <div class="pdcm pdcm-editor-note" role="note">
    <strong>Early Holiday · deals setup check</strong>
    <span>Headline saving: <b>{% if headline_pct > 0 %}up to {{ headline_pct }}%{% else %}none approved yet (number-free headline){% endif %}</b>{% if x_pct > 20 %} · extended line: up to {{ x_pct }}%{% endif %} · cards with an approved saving: <b>{{ live_cards }}</b>{% if st.only_discounted %} (only these show while the sale is live){% endif %}. Only visible in the theme editor.</span>
    {%- if live_cards == 0 and st.only_discounted -%}<span><b>No approved deals yet</b> — the holiday edit is empty during the live sale until a product's Offer approval and compare-at confirmation are set.</span>{%- endif -%}
    {%- if notes != blank -%}<ul>{{ notes }}</ul>{%- endif -%}
  </div>
{%- endif -%}

<div hidden data-cm-register>{{ register }}</div>

<section class="pdcm pdcm--eh pdcm-hero pdcm-ehhero" id="cm-hero" aria-labelledby="cm-hero-title-{{ section.id }}">
  <div class="pdcm-wrap pdcm-ehhero__top">
    <div class="pdcm-ehhero__copy">
      <p class="pdcm-tag" data-cm-when="live"><span class="pdcm-tag__dot" aria-hidden="true"></span>{{ st.hero_eyebrow }}</p>
      <p class="pdcm-tag" data-cm-when="before"><span class="pdcm-tag__dot" aria-hidden="true"></span>{{ st.hero_eyebrow_before }}</p>
      <p class="pdcm-tag" data-cm-when="after">{{ st.hero_eyebrow_after }}</p>
      <h1 class="pdcm-ehhero__title" id="cm-hero-title-{{ section.id }}">
        <span class="pdcm-hero__line" data-cm-when="live before">{{ st.hero_line1 }}</span>
        <span class="pdcm-hero__line pdcm-ehhero__accent" data-cm-when="live before">{{ st.hero_line2 }}</span>
        <span class="pdcm-hero__line" data-cm-when="after">{{ st.hero_after_line1 }}</span>
        <span class="pdcm-hero__line pdcm-ehhero__accent" data-cm-when="after">{{ st.hero_after_line2 }}</span>
      </h1>
    </div>
    <div class="pdcm-ehhero__side">
      {%- if headline_pct > 0 -%}
        <p class="pdcm-ehhero__offer pdcm-hero__offer" data-cm-when="live"><span class="pdcm-ehhero__pre">{{ st.hero_offer_pre }} </span><span class="pdcm-ehhero__big">{{ st.hero_offer | replace: '[pct]', headline_pct_s }}</span> <span class="pdcm-ehhero__qual">{{ st.hero_qualifier }}</span></p>
      {%- else -%}
        <p class="pdcm-ehhero__offer pdcm-hero__offer is-plain" data-cm-when="live"><span class="pdcm-ehhero__big">{{ st.hero_nodeal }}</span></p>
      {%- endif -%}
      <p class="pdcm-ehhero__offer is-plain" data-cm-when="before"><span class="pdcm-ehhero__big">{{ st.hero_before_line }}</span></p>
      {%- if x_pct > 20 and st.hero_select != blank -%}
        <p class="pdcm-hero__select" data-cm-when="live">{{ st.hero_select | replace: '[xpct]', x_pct_s }}</p>
      {%- endif -%}
      <p class="pdcm-hero__sub" data-cm-when="live">{{ st.hero_sub }}</p>
      <p class="pdcm-hero__sub" data-cm-when="before">{{ st.hero_sub_before }}</p>
      <p class="pdcm-hero__sub" data-cm-when="after">{{ st.hero_sub_after }}</p>
      {% render 'popdarts-cm-timer', style: 'inline', label: st.timer_label %}
      <div class="pdcm-hero__actions">
        {%- assign hero_url = st.hero_cta_link | default: '/collections/all' -%}
        <a class="pdcm-btn pdcm-btn--blue pdcm-btn--lg" href="{{ hero_url }}" data-cm-when="live">{{ st.hero_cta }}<span class="pdcm-btn__arrow" aria-hidden="true"></span></a>
        <a class="pdcm-btn pdcm-btn--blue pdcm-btn--lg" href="{{ hero_url }}" data-cm-when="before">{{ st.hero_cta_before }}<span class="pdcm-btn__arrow" aria-hidden="true"></span></a>
        <a class="pdcm-btn pdcm-btn--blue pdcm-btn--lg" href="{{ st.after_link | default: '/collections/all' }}" data-cm-when="after">{{ st.hero_cta_after }}<span class="pdcm-btn__arrow" aria-hidden="true"></span></a>
        {%- if st.hero_link2_text != blank -%}
          {%- comment -%} Rookie or Pro? answers itself right here — a native disclosure, no jump to the FAQ {%- endcomment -%}
          <details class="pdcm-compare">
            <summary class="pdcm-btn pdcm-btn--outline pdcm-btn--lg">{{ st.hero_link2_text }}<span class="pdcm-compare__chev" aria-hidden="true"></span></summary>
            <div class="pdcm-compare__panel">
              <p class="pdcm-compare__row"><b class="pdcm-compare__name">Rookie</b><span>{{ st.compare_rookie }}</span></p>
              <p class="pdcm-compare__row"><b class="pdcm-compare__name">Pro</b><span>{{ st.compare_pro }}</span></p>
            </div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} The lineup: three games, each with its own colour dropdown + Add. Savings come only from the register. {%- endcomment -%}
  {%- if st.hero_lineup != blank -%}
    <div class="pdcm-wrap">
      <ul class="pdcm-lineup" role="list">
        {%- for p in st.hero_lineup limit: 3 -%}
          {%- liquid
            assign hay = p.handle | append: ' ' | append: p.title | downcase
            assign skip = false
            if hay contains 'elite' or hay contains 'slightly' or hay contains 'returned' or p.available == false
              assign skip = true
            endif
          -%}
          {%- if skip -%}{%- continue -%}{%- endif -%}
          {%- assign uid = section.id | append: '-lineup-' | append: forloop.index -%}
          {%- assign ds = false -%}{%- if forloop.first -%}{%- assign ds = true -%}{%- endif -%}
          {% render 'popdarts-cm-row', product: p, uid: uid, hide: hide, kind: 'tile', cutout: true, dock_source: ds %}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- capture hero_rating -%}{% render 'popdarts-cm-rating', product: st.hero_lineup.first, label: st.hero_lineup.first.title %}{%- endcapture -%}
  <div class="pdcm-trustbar">
    <ul class="pdcm-wrap pdcm-trustbar__list">
      {%- if hero_rating != blank -%}<li class="pdcm-trustbar__item pdcm-trustbar__item--rating">{{ hero_rating }}</li>{%- endif -%}
      {%- if st.trust_1 != blank -%}
        <li class="pdcm-trustbar__item"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{{ st.trust_1 }}</li>
      {%- endif -%}
      {%- if st.trust_2 != blank -%}
        <li class="pdcm-trustbar__item pdcm-trustbar__item--wide"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>{{ st.trust_2 }}</li>
      {%- endif -%}
      {%- if st.hero_trust != blank -%}
        <li class="pdcm-trustbar__item" data-cm-when="live"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="8" cy="8" r="1.6" fill="currentColor"/></svg>{{ st.hero_trust }}</li>
      {%- endif -%}
    </ul>
  </div>
</section>

<section class="pdcm pdcm--eh pdcm-deals pdcm-edit" id="cm-deals" aria-labelledby="cm-deals-title-{{ section.id }}" data-cm-dock-stop>
  <div class="pdcm-wrap" data-cm-filter data-limit="{{ st.edit_limit | default: 8 }}">
    <div class="pdcm-edit__head">
      <div class="pdcm-head pdcm-head--wide">
        <p class="pdcm-eyebrow" data-cm-when="live">{{ st.deals_eyebrow }}</p>
        <p class="pdcm-eyebrow" data-cm-when="before">{{ st.deals_eyebrow_before }}</p>
        <p class="pdcm-eyebrow" data-cm-when="after">{{ st.deals_eyebrow_after }}</p>
        <h2 class="pdcm-h2" id="cm-deals-title-{{ section.id }}">{{ st.deals_heading }}</h2>
        <p class="pdcm-lead" data-cm-when="live">{{ st.deals_sub }}</p>
        <p class="pdcm-lead" data-cm-when="before">{{ st.deals_sub_before }}</p>
        <p class="pdcm-lead" data-cm-when="after">{{ st.deals_sub_after }}</p>
      </div>
      <div class="pdcm-chips" role="group" aria-label="{{ st.filter_label | escape }}">
        <button type="button" class="pdcm-chipbtn" data-cm-filter-btn="all" aria-pressed="true">{{ st.filter_all }}</button>
        {%- for g in (1..4) -%}
          {%- liquid
        case g
          when 1
            assign tc = tab_cards_1
            assign td = tab_deals_1
          when 2
            assign tc = tab_cards_2
            assign td = tab_deals_2
          when 3
            assign tc = tab_cards_3
            assign td = tab_deals_3
          else
            assign tc = tab_cards_4
            assign td = tab_deals_4
        endcase
        assign label_key = 'tab_' | append: g
        assign tlabel = st[label_key]
      -%}
          {%- if tc == 0 or tlabel == blank -%}{%- continue -%}{%- endif -%}
          <button type="button" class="pdcm-chipbtn" data-cm-filter-btn="{{ g }}" aria-pressed="false"{% if st.only_discounted and td == 0 %} data-cm-when="before after"{% endif %}>{{ tlabel }}</button>
        {%- endfor -%}
      </div>
    </div>

    <div class="pdcm-edit__grid" data-cm-filter-grid>
      {%- assign shown_n = 0 -%}
      {%- for g in (1..4) -%}
        {%- assign gs = g | append: '' -%}
        {%- for key in sorted -%}
          {%- assign parts = key | split: '|' -%}
          {%- if parts[0] != gs -%}{%- continue -%}{%- endif -%}
          {%- assign bi = parts[3] | minus: 1000 -%}
          {%- assign blk = section.blocks[bi] -%}
          {%- assign eager = false -%}{%- if shown_n < 4 -%}{%- assign eager = true -%}{%- endif -%}
          <div class="pdcm-edit__item" data-cm-group="{{ gs }}" {{ blk.shopify_attributes }}>
            {%- render 'popdarts-cm-card', product: blk.settings.product, settings: blk.settings, block_id: blk.id, section_id: section.id, hide: hide, only_discounted: st.only_discounted, eager: eager, size: 'compact' -%}
          </div>
          {%- assign shown_n = shown_n | plus: 1 -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
    <div class="pdcm-edit__more">
      <button type="button" class="pdcm-btn pdcm-btn--outline pdcm-btn--lg" data-cm-more data-label="{{ st.show_all_text | escape }}" hidden><span data-cm-label>{{ st.show_all_text }}</span></button>
    </div>

    {%- if st.only_discounted and live_cards == 0 -%}
      <p class="pdcm-deals__empty" data-cm-when="live">{{ st.deals_empty }} <a class="pdcm-link" href="{{ st.after_link | default: '/collections/all' }}">Shop all games</a></p>
    {%- endif -%}
    {%- if st.exclusions != blank -%}
      <p class="pdcm-deals__note">{{ st.exclusions }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Early Holiday: Hero+Deals",
  "tag": "div",
  "class": "pdcm-deals-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The hero and the deals share ONE approval list (the Deal blocks), so the headline can never claim more than the cards show."
    },
    {
      "type": "paragraph",
      "content": "Savings appear only when a product's Offer approval is set AND its compare-at price is confirmed as the regular price. Elite, gift cards and returned items are removed automatically."
    },
    {
      "type": "header",
      "content": "Hero — during the sale"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Early holiday sale · Nov 10–26"
    },
    {
      "type": "text",
      "id": "hero_line1",
      "label": "Headline line 1",
      "default": "Shop early."
    },
    {
      "type": "text",
      "id": "hero_line2",
      "label": "Headline line 2",
      "default": "Play sooner."
    },
    {
      "type": "text",
      "id": "hero_offer_pre",
      "label": "Small line above the offer",
      "default": "Up to"
    },
    {
      "type": "text",
      "id": "hero_offer",
      "label": "Headline offer",
      "default": "[pct]% off",
      "info": "[pct] = the biggest APPROVED saving shown on this page, never above 20."
    },
    {
      "type": "text",
      "id": "hero_qualifier",
      "label": "Offer qualifier",
      "default": "eligible games & gear"
    },
    {
      "type": "text",
      "id": "hero_nodeal",
      "label": "Offer line when no saving is approved",
      "default": "Holiday shopping, sorted."
    },
    {
      "type": "text",
      "id": "hero_select",
      "label": "Extended offer line",
      "default": "Select items up to [xpct]% off",
      "info": "Shows only when a Daniel-approved, non-protected product above 20% is actually on the page."
    },
    {
      "type": "text",
      "id": "hero_sub",
      "label": "Support text",
      "default": "Get every game on your list before the holiday rush."
    },
    {
      "type": "text",
      "id": "hero_cta",
      "label": "Button",
      "default": "Shop all games"
    },
    {
      "type": "url",
      "id": "hero_cta_link",
      "label": "Button link",
      "info": "A real page, e.g. your holiday collection. Empty = /collections/all"
    },
    {
      "type": "text",
      "id": "hero_link2_text",
      "label": "Rookie or Pro? button",
      "default": "Rookie or Pro?",
      "info": "Opens a short comparison right in the hero. Empty = hidden."
    },
    {
      "type": "text",
      "id": "compare_rookie",
      "label": "Rookie line",
      "default": "For beginners and younger players — made for ages 5 to 95."
    },
    {
      "type": "text",
      "id": "compare_pro",
      "label": "Pro line",
      "default": "For competitors — the PRO Target Marker™ adds the 10-point shot."
    },
    {
      "type": "text",
      "id": "hero_trust",
      "label": "Trust bar item 3 (sale only)",
      "default": "No code needed"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust bar item 1",
      "default": "As seen on ESPN"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust bar item 2",
      "default": "Orders processed in 1–2 business days"
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Countdown label",
      "default": "Sale ends in",
      "info": "The countdown only appears when the deadline is confirmed in Early Holiday: Settings."
    },
    {
      "type": "header",
      "content": "Hero — before the sale"
    },
    {
      "type": "text",
      "id": "hero_eyebrow_before",
      "label": "Eyebrow",
      "default": "Early holiday sale starts Nov 10"
    },
    {
      "type": "text",
      "id": "hero_before_line",
      "label": "Line under the headline",
      "default": "Starts Nov 10."
    },
    {
      "type": "text",
      "id": "hero_sub_before",
      "label": "Support text",
      "default": "Early holiday prices land here on Nov 10. Start your list now."
    },
    {
      "type": "text",
      "id": "hero_cta_before",
      "label": "Button",
      "default": "Browse the games"
    },
    {
      "type": "header",
      "content": "Hero — after the sale"
    },
    {
      "type": "text",
      "id": "hero_eyebrow_after",
      "label": "Eyebrow",
      "default": "The early holiday sale has ended"
    },
    {
      "type": "text",
      "id": "hero_after_line1",
      "label": "Headline line 1",
      "default": "Gift"
    },
    {
      "type": "text",
      "id": "hero_after_line2",
      "label": "Headline line 2",
      "default": "game night."
    },
    {
      "type": "text",
      "id": "hero_sub_after",
      "label": "Support text",
      "default": "Every Popdarts game is ready to throw."
    },
    {
      "type": "text",
      "id": "hero_cta_after",
      "label": "Button",
      "default": "Shop all games"
    },
    {
      "type": "url",
      "id": "after_link",
      "label": "After-sale link",
      "info": "Empty = all products (/collections/all)."
    },
    {
      "type": "header",
      "content": "Hero — the lineup"
    },
    {
      "type": "product_list",
      "id": "hero_lineup",
      "label": "Lineup",
      "limit": 3,
