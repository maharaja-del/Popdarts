    </div>

    <!-- Headline -->
    <h2 class="qj4-headline qj4-reveal qj4-d1">
      Quality <mark>Materials</mark>
    </h2>

    <div class="qj4-inner">

      <!-- LEFT — American flag-themed target rings SVG -->
