            <circle cx="110" cy="118" r="76" stroke="rgba(255,255,255,0.1)"  stroke-width="1.5"/>
            <circle cx="110" cy="118" r="56" stroke="rgba(178,34,52,0.3)"    stroke-width="1.5"/>
            <circle cx="110" cy="118" r="36" stroke="rgba(255,255,255,0.18)" stroke-width="2"/>
            <circle cx="110" cy="118" r="18" stroke="#B22234"                stroke-width="2.5" opacity="0.8"/>
            <circle cx="110" cy="118" r="6"  fill="#B22234" opacity="0.9"/>
            <!-- Crosshairs -->
            <line x1="110" y1="22"  x2="110" y2="214" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="4 6"/>
            <line x1="14"  y1="118" x2="206" y2="118" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="4 6"/>
          </g>
          <!-- Dart silhouette — gold tip -->
          <g class="qj4-float" style="animation-delay:.8s">
            <line x1="158" y1="60" x2="122" y2="96" stroke="rgba(255,255,255,0.7)" stroke-width="2.5" stroke-linecap="round"/>
            <polygon points="122,96 115,103 128,90" fill="#FFD60A"/>
            <line x1="158" y1="60" x2="168" y2="50" stroke="rgba(255,255,255,0.4)" stroke-width="2" stroke-linecap="round"/>
            <line x1="168" y1="50" x2="172" y2="42" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round"/>
          </g>
          <!-- Orbit star dot -->
          <circle class="qj4-spin" cx="110" cy="22" r="4" fill="#FFD60A" opacity="0.7" style="transform-box:fill-box"/>
          <!-- Mini stars scattered -->
          <text x="52"  y="52"  font-size="8" fill="rgba(255,255,255,0.2)" text-anchor="middle">★</text>
          <text x="168" y="52"  font-size="8" fill="rgba(255,255,255,0.2)" text-anchor="middle">★</text>
          <text x="52"  y="195" font-size="8" fill="rgba(255,255,255,0.2)" text-anchor="middle">★</text>
          <text x="168" y="195" font-size="8" fill="rgba(255,255,255,0.2)" text-anchor="middle">★</text>
        </svg>
      </div>

      <!-- CENTER — product image -->
      <div class="qj4-stage qj4-reveal qj4-d3">
        <div class="qj4-ring" aria-hidden="true"></div>
        <div class="qj4-shadow-blob" aria-hidden="true"></div>
        <div class="qj4-stripe" aria-hidden="true"></div>
        <div class="qj4-bracket qj4-bracket--tl" aria-hidden="true"></div>
