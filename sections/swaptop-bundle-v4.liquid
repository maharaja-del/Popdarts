<script>
(function () {
  var SW4_BASE_PRICE   = {{ main_product.price }};
  var SW4_BASE_COMPARE = {{ main_product.compare_at_price | default: main_product.price }};
  var SW4_MAIN_VARIANT = {{ main_product.first_available_variant.id }};
  var SW4_MAIN_TITLE   = '{{ main_product.title | escape }}';

  var sectionEl = document.querySelector('.sw4-section-{{ sid }}');
  if (!sectionEl) return;

  var featuredImg     = document.getElementById('sw4-featured-img-{{ sid }}');
  var featuredNum     = document.getElementById('sw4-featured-num-{{ sid }}');
  var featuredThumbsWrap = document.getElementById('sw4-featured-thumbs-{{ sid }}');
  var featuredThumbs  = featuredThumbsWrap ? featuredThumbsWrap.querySelectorAll('.sw4-featured-thumb-{{ sid }}') : [];
  var totalEl         = document.getElementById('sw4-total-{{ sid }}');
  var savingsEl       = document.getElementById('sw4-savings-{{ sid }}');
  var receiptLinesEl  = document.getElementById('sw4-receipt-lines-{{ sid }}');
  var progressCountEl = document.getElementById('sw4-progress-count-{{ sid }}');
  var progressFillEl  = document.getElementById('sw4-progress-fill-{{ sid }}');
  var progressStamps  = document.querySelectorAll('.sw4-stamp-{{ sid }}');
  var ctaBtn          = document.getElementById('sw4-cta-{{ sid }}');
  var ctaText         = document.getElementById('sw4-cta-text-{{ sid }}');

  var SW4_CARD_INFO = {
    'sw4-card-football-{{ sid }}': { name: '{{ addon_football.title | escape }}', stamp: 'football' },
    'sw4-card-og-{{ sid }}':       { name: '{{ addon_og.title | escape }}',       stamp: 'og' },
    'sw4-card-popgolf-{{ sid }}':  { name: '{{ addon_popgolf.title | escape }}',  stamp: 'popgolf' }
  };

  function sw4PadTwo(n) { return n < 10 ? '0' + n : String(n); }
  function sw4Money(c)  { return '$' + (c / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

  featuredThumbs.forEach(function (t, i) {
    t.addEventListener('click', function () {
      featuredThumbs.forEach(function (x) { x.classList.remove('active'); });
      t.classList.add('active');
      if (!featuredImg) return;
      featuredImg.style.opacity = '0';
      setTimeout(function () {
        featuredImg.src = t.dataset.src;
        featuredImg.style.opacity = '1';
      }, 180);
    });
  });

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var canHover = window.matchMedia('(hover: hover)').matches;
  if (canHover && !reduceMotion) {
    document.querySelectorAll('.sw4-card-{{ sid }}').forEach(function (card) {
      var rafId = null;
      card.addEventListener('mousemove', function (e) {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(function () {
          var rect = card.getBoundingClientRect();
          var cx = e.clientX - rect.left;
          var cy = e.clientY - rect.top;
          var px = (cx / rect.width)  - 0.5;
          var py = (cy / rect.height) - 0.5;
          var rotateY = px *  8;
          var rotateX = py * -8;
          card.style.transform = 'perspective(900px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) translateZ(0)';
        });
      });
      card.addEventListener('mouseleave', function () {
        if (rafId) cancelAnimationFrame(rafId);
        card.style.transform = '';
      });
    });
  }

  function sw4OpenCartDrawer() {
    var btn = document.querySelector('[data-cart-toggle],.cart-toggle,#cart-toggle,.js-cart-open');
    if (btn) { btn.click(); return; }
    document.dispatchEvent(new CustomEvent('cart:open'));
    document.dispatchEvent(new CustomEvent('theme:cart:open'));
  }
  function sw4RefreshCart() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var n = cart.item_count;
      document.querySelectorAll('[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,#CartCount,.header__cart-count,.cart-count-bubble [aria-hidden]')
        .forEach(function(el){ el.textContent = n; });
    }).catch(function(){});
    fetch('/?sections=cart-drawer,cart-icon-bubble').then(function(r){ return r.json(); }).then(function(sections){
      if (sections['cart-drawer']) {
        var liveDrawer  = document.querySelector('cart-drawer');
        var sectionWrap = liveDrawer && liveDrawer.closest('[id^="shopify-section-"]');
        if (sectionWrap) {
          sectionWrap.innerHTML = sections['cart-drawer'];
        } else if (liveDrawer) {
          var doc = new DOMParser().parseFromString(sections['cart-drawer'], 'text/html');
          var fd  = doc.querySelector('cart-drawer');
          if (fd) liveDrawer.outerHTML = fd.outerHTML;
        }
      }
      if (sections['cart-icon-bubble']) {
        var countEl  = document.querySelector('[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,.cart-count-bubble');
        var iconWrap = countEl && countEl.closest('[id^="shopify-section-"]');
        if (iconWrap) iconWrap.innerHTML = sections['cart-icon-bubble'];
      }
    }).catch(function(){});
  }
  function sw4EnforceKitQty() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      for (var i = 0; i < cart.items.length; i++) {
        if (cart.items[i].variant_id === SW4_MAIN_VARIANT && cart.items[i].quantity > 1) {
          fetch('/cart/change.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ id: cart.items[i].key, quantity: 1 })
          }).then(function(r){ return r.json(); }).then(sw4RefreshCart).catch(function(){});
          break;
        }
      }
    }).catch(function(){});
  }

  function sw4ApplySelected(card, selected) { card.classList.toggle('selected', selected); }

  function sw4Render() {
    var count = 1;
    var selectedCards = [];
    document.querySelectorAll('.sw4-card-{{ sid }}.selected:not(.locked)').forEach(function (card) {
      selectedCards.push(card);
      count++;
    });

    if (receiptLinesEl) {
      var html = '';
      html += '<div class="sw4-receipt-line-{{ sid }}">' +
                '<span class="sw4-receipt-line-name-{{ sid }}">★ ' + SW4_MAIN_TITLE + '</span>' +
                '<span class="sw4-receipt-line-dots-{{ sid }}"></span>' +
                '<span class="sw4-receipt-line-amount-{{ sid }}">' + sw4Money(SW4_BASE_PRICE) + '</span>' +
              '</div>';
      selectedCards.forEach(function (card) {
        var info = SW4_CARD_INFO[card.id];
        var p = parseInt(card.dataset.price, 10) || 0;
        var rarity = card.dataset.rarity;
        var stars = rarity === 'legendary' ? '★★★' : rarity === 'rare' ? '★★' : '★';
        html += '<div class="sw4-receipt-line-{{ sid }}">' +
                  '<span class="sw4-receipt-line-name-{{ sid }}">' + stars + ' ' + (info ? info.name : '') + '</span>' +
                  '<span class="sw4-receipt-line-dots-{{ sid }}"></span>' +
                  '<span class="sw4-receipt-line-amount-{{ sid }}">+' + sw4Money(p) + '</span>' +
                '</div>';
      });
      if (!selectedCards.length) {
        html += '<div class="sw4-receipt-line-{{ sid }} is-empty">' +
                  '<span class="sw4-receipt-line-name-{{ sid }}">No tops claimed yet</span>' +
                  '<span class="sw4-receipt-line-dots-{{ sid }}"></span>' +
                  '<span class="sw4-receipt-line-amount-{{ sid }}">$0.00</span>' +
                '</div>';
      }
      receiptLinesEl.innerHTML = html;
    }

    var total   = SW4_BASE_PRICE;
    var compare = SW4_BASE_COMPARE;
    selectedCards.forEach(function (card) {
      var p = parseInt(card.dataset.price,   10) || 0;
      var c = parseInt(card.dataset.compare, 10) || 0;
      total   += p;
      compare += (c > 0 ? c : p);
    });
    if (totalEl) {
      totalEl.textContent = sw4Money(total);
      totalEl.classList.remove('bump');
      void totalEl.offsetWidth;
      totalEl.classList.add('bump');
      setTimeout(function () { totalEl.classList.remove('bump'); }, 300);
    }
    var saved = compare - total;
    if (savingsEl) {
      if (saved > 0) {
        savingsEl.textContent = '◆ SAVE ' + sw4Money(saved);
        savingsEl.style.cssText = 'display:inline-flex;';
      } else {
        savingsEl.style.cssText = 'display:none;';
      }
    }

    if (progressCountEl) progressCountEl.textContent = sw4PadTwo(count);
    if (progressFillEl)  progressFillEl.style.width  = ((count / 4) * 100) + '%';
    if (featuredNum)     featuredNum.textContent     = sw4PadTwo(count);

    var stampsLit = { frame: true };
    selectedCards.forEach(function (card) {
      var info = SW4_CARD_INFO[card.id];
      if (info) stampsLit[info.stamp] = true;
    });
    progressStamps.forEach(function (s) {
      s.classList.toggle('lit', !!stampsLit[s.dataset.stamp]);
    });
  }

  function sw4SyncFromCart() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var inCart = cart.items.map(function(i){ return i.variant_id; });
      document.querySelectorAll('.sw4-card-{{ sid }}').forEach(function(card){
        var v = parseInt(card.dataset.variant, 10);
        if (v && inCart.indexOf(v) !== -1) sw4ApplySelected(card, true);
      });
      sw4Render();
    }).catch(function(){});
  }

  window['sw4ToggleAddon_{{ sid }}'] = function (card) {
    if (!card) return;
    var selecting    = !card.classList.contains('selected');
    var addonVariant = parseInt(card.dataset.variant, 10);

    sw4ApplySelected(card, selecting);
    sw4Render();

    if (!addonVariant) return;

    if (selecting) {
      fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
        var inCart = cart.items.map(function(i){ return i.variant_id; });
        var items  = [];
        if (SW4_MAIN_VARIANT && inCart.indexOf(SW4_MAIN_VARIANT) === -1)
          items.push({ id: SW4_MAIN_VARIANT, quantity: 1 });
        if (inCart.indexOf(addonVariant) === -1)
          items.push({ id: addonVariant, quantity: 1 });
        if (!items.length) { sw4OpenCartDrawer(); return null; }
        return fetch('/cart/add.js', {
          method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
          body: JSON.stringify({ items: items })
        }).then(function(r){ return r.json(); });
      }).then(function(result){
        if (!result) return;
        sw4EnforceKitQty();
        sw4RefreshCart();
        sw4OpenCartDrawer();
      }).catch(function(){
        sw4ApplySelected(card, false);
        sw4Render();
      });
    } else {
      fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
        var addonKey = null;
        var kitKeys  = [];
        cart.items.forEach(function(item){
          if (String(item.variant_id) === String(addonVariant)) addonKey = item.key;
          if (item.variant_id === SW4_MAIN_VARIANT)             kitKeys.push(item.key);
        });
        var toRemove = kitKeys.slice();
        if (addonKey) toRemove.push(addonKey);
        if (!toRemove.length) return null;
        return Promise.all(toRemove.map(function(key){
          return fetch('/cart/change.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ id: key, quantity: 0 })
          }).then(function(r){ return r.json(); });
        }));
      }).then(function(result){
        if (result === null) return null;
        return fetch('/cart.js').then(function(r){ return r.json(); });
      }).then(function(cart){
        if (!cart) return null;
        var remaining = cart.items.filter(function(i){ return i.variant_id === SW4_MAIN_VARIANT; });
        if (!remaining.length) return true;
        return Promise.all(remaining.map(function(item){
          return fetch('/cart/change.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ id: item.key, quantity: 0 })
          }).then(function(r){ return r.json(); });
        })).then(function(){ return true; });
      }).then(function(ok){
        if (!ok) return null;
        return fetch('/cart/add.js', {
          method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
          body: JSON.stringify({ items: [{ id: SW4_MAIN_VARIANT, quantity: 1 }] })
        }).then(function(r){ return r.json(); });
      }).then(function(result){
        if (!result) return;
        sw4RefreshCart();
      }).catch(function(){
        sw4ApplySelected(card, true);
        sw4Render();
      });
    }
  };

  function sw4GetItems() {
    var items = [{ id: SW4_MAIN_VARIANT, quantity: 1 }];
    document.querySelectorAll('.sw4-card-{{ sid }}.selected').forEach(function (card) {
      if (card.dataset.variant) items.push({ id: parseInt(card.dataset.variant, 10), quantity: 1 });
    });
    return items;
  }

  window['sw4AddToCart_{{ sid }}'] = function () {
    if (!ctaBtn || ctaBtn.classList.contains('loading')) return;
    ctaBtn.classList.add('loading');
    if (ctaText) ctaText.textContent = 'Sealing...';
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var inCart   = cart.items.map(function(i){ return i.variant_id; });
      var allItems = sw4GetItems();
      var toAdd    = allItems.filter(function(item){ return inCart.indexOf(item.id) === -1; });
      sw4OpenCartDrawer();
      if (!toAdd.length) {
        ctaBtn.classList.remove('loading');
        if (ctaText) ctaText.textContent = 'Collection Sealed ✓';
        setTimeout(function() { if (ctaText) ctaText.textContent = 'Claim Your Collection'; }, 2000);
        return null;
      }
      return fetch('/cart/add.js', {
        method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
        body: JSON.stringify({ items: toAdd })
      }).then(function(r){ return r.json(); });
    }).then(function(data){
      if (!data) return;
      if (data.status && data.status >= 400) throw new Error(data.description || 'Cart error');
      sw4EnforceKitQty();
      sw4RefreshCart();
      ctaBtn.classList.remove('loading');
      if (ctaText) ctaText.textContent = 'Collection Sealed ✓';
      setTimeout(function() { if (ctaText) ctaText.textContent = 'Claim Your Collection'; }, 2000);
    }).catch(function(){
      ctaBtn.classList.remove('loading');
      if (ctaText) ctaText.textContent = 'Try Again';
      setTimeout(function() { if (ctaText) ctaText.textContent = 'Claim Your Collection'; }, 2500);
    });
  };

  window['sw4ScrollToReviews_{{ sid }}'] = function () {
    var target = document.querySelector('.jdgm-rev-widg__header');
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  document.querySelectorAll('.sw4-acc-{{ sid }} .sw4-acc-trigger-{{ sid }}').forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      var item   = trigger.closest('.sw4-acc-item-{{ sid }}');
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.sw4-acc-{{ sid }} .sw4-acc-item-{{ sid }}').forEach(function (i) {
        i.classList.remove('open');
        var trg = i.querySelector('.sw4-acc-trigger-{{ sid }}');
        if (trg) trg.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  sw4Render();
  sw4SyncFromCart();
})();
</script>

<script>
(function () {
  var SW4_LB_DEFAULT = [
    {% for image in main_product.images limit: 3 %}
      '{{ image | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  var SW4_FOOTBALL_LB = [
    {% for image in addon_football.images %}
      '{{ image | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  var SW4_OG_LB = [
    {% for image in addon_og.images %}
      '{{ image | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  var SW4_POPGOLF_LB = [
    {% for image in addon_popgolf.images %}
      '{{ image | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  var SW4_CARD_LB_MAP = {
    'sw4-card-football-{{ sid }}': SW4_FOOTBALL_LB,
    'sw4-card-og-{{ sid }}':       SW4_OG_LB,
    'sw4-card-popgolf-{{ sid }}':  SW4_POPGOLF_LB
  };

  var lightboxEl   = document.getElementById('sw4-lightbox-{{ sid }}');
  var lbImg        = document.getElementById('sw4-lb-img-{{ sid }}');
  var lbPrev       = document.getElementById('sw4-lb-prev-{{ sid }}');
  var lbNext       = document.getElementById('sw4-lb-next-{{ sid }}');
  var lbCounter    = document.getElementById('sw4-lb-counter-{{ sid }}');
  var lbImages     = SW4_LB_DEFAULT;
  var lbIndex      = 0;
  var lbTouchStart = 0;

  function sw4LbUpdate() {
    if (!lbImg) return;
    lbImg.style.opacity = '0';
    setTimeout(function () {
      lbImg.src = lbImages[lbIndex];
      lbImg.style.opacity = '1';
    }, 150);
    if (lbCounter) lbCounter.textContent = (lbIndex + 1) + ' / ' + lbImages.length;
    if (lbPrev) lbPrev.disabled = lbIndex === 0;
    if (lbNext) lbNext.disabled = lbIndex === lbImages.length - 1;
  }

  window['sw4OpenLightbox_{{ sid }}'] = function (images, startIdx) {
    lbImages = (images && images.length) ? images : SW4_LB_DEFAULT;
    lbIndex  = startIdx || 0;
    if (lbImg) lbImg.src = lbImages[lbIndex];
    if (lbCounter) lbCounter.textContent = (lbIndex + 1) + ' / ' + lbImages.length;
    if (lbPrev) lbPrev.disabled = lbIndex === 0;
    if (lbNext) lbNext.disabled = lbIndex === lbImages.length - 1;
    if (lightboxEl) lightboxEl.classList.add('active');
    document.body.style.overflow = 'hidden';
  };
  window['sw4CloseLightbox_{{ sid }}'] = function () {
    if (lightboxEl) lightboxEl.classList.remove('active');
    document.body.style.overflow = '';
  };
  window['sw4LightboxNav_{{ sid }}'] = function (dir) {
    var newIdx = lbIndex + dir;
    if (newIdx < 0 || newIdx >= lbImages.length) return;
    lbIndex = newIdx;
    sw4LbUpdate();
  };
  window['sw4CardImgClick_{{ sid }}'] = function (e, artEl) {
    e.stopPropagation();
    var card = artEl.closest('.sw4-card-{{ sid }}');
    if (!card) return;
    var imgs = SW4_CARD_LB_MAP[card.id];
    window['sw4OpenLightbox_{{ sid }}'](imgs && imgs.length ? imgs : SW4_LB_DEFAULT, 0);
  };

  if (lightboxEl) {
    lightboxEl.addEventListener('click', function (e) {
      if (e.target === lightboxEl) window['sw4CloseLightbox_{{ sid }}']();
    });
    lightboxEl.addEventListener('touchstart', function (e) { lbTouchStart = e.touches[0].clientX; }, { passive: true });
    lightboxEl.addEventListener('touchend', function (e) {
      var diff = e.changedTouches[0].clientX - lbTouchStart;
      if (Math.abs(diff) > 50) window['sw4LightboxNav_{{ sid }}'](diff > 0 ? -1 : 1);
    }, { passive: true });
  }
  document.addEventListener('keydown', function (e) {
    if (!lightboxEl || !lightboxEl.classList.contains('active')) return;
    if (e.key === 'Escape')     window['sw4CloseLightbox_{{ sid }}']();
    if (e.key === 'ArrowLeft')  window['sw4LightboxNav_{{ sid }}'](-1);
    if (e.key === 'ArrowRight') window['sw4LightboxNav_{{ sid }}'](1);
  });
})();
</script>

<script>
(function () {
  var SW4_QV_DATA = {
    'sw4-card-football-{{ sid }}': {
      title:   '{{ addon_football.title | escape }}',
      desc:    {{ addon_football.description | default: '<p>The fan-favorite top. Big fun, easy to play.</p>' | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_football.price }},
      compare: {{ addon_football.compare_at_price | default: addon_football.price }},
      images: [
        {% for image in addon_football.images %}'{{ image | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}{% endfor %}
      ],
      thumbs: [
        {% for image in addon_football.images %}'{{ image | image_url: width: 200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}
      ]
    },
    'sw4-card-og-{{ sid }}': {
      title:   '{{ addon_og.title | escape }}',
      desc:    {{ addon_og.description | default: '<p>The original heritage top. A classic for the collection.</p>' | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_og.price }},
      compare: {{ addon_og.compare_at_price | default: addon_og.price }},
      images: [
        {% for image in addon_og.images %}'{{ image | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}{% endfor %}
      ],
      thumbs: [
        {% for image in addon_og.images %}'{{ image | image_url: width: 200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}
      ]
    },
    'sw4-card-popgolf-{{ sid }}': {
      title:   '{{ addon_popgolf.title | escape }}',
      desc:    {{ addon_popgolf.description | default: '<p>Pro tier precision top. The legendary pick.</p>' | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_popgolf.price }},
      compare: {{ addon_popgolf.compare_at_price | default: addon_popgolf.price }},
      images: [
        {% for image in addon_popgolf.images %}'{{ image | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}{% endfor %}
      ],
      thumbs: [
        {% for image in addon_popgolf.images %}'{{ image | image_url: width: 200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}
      ]
    }
  };

  var SW4_CARD_INFO_QV = {
    'sw4-card-football-{{ sid }}': { rarity: 'common',    stars: '★ COMMON' },
    'sw4-card-og-{{ sid }}':       { rarity: 'rare',      stars: '★★ RARE' },
    'sw4-card-popgolf-{{ sid }}':  { rarity: 'legendary', stars: '★★★ LEGENDARY' }
  };

  var qvOverlay = document.getElementById('sw4-qv-overlay-{{ sid }}');
  var qvPanel   = document.getElementById('sw4-qv-panel-{{ sid }}');
  var qvTitle   = document.getElementById('sw4-qv-title-{{ sid }}');
  var qvDesc    = document.getElementById('sw4-qv-desc-{{ sid }}');
  var qvPriceSale    = document.getElementById('sw4-qv-price-sale-{{ sid }}');
  var qvPriceCompare = document.getElementById('sw4-qv-price-compare-{{ sid }}');
  var qvPriceBadge   = document.getElementById('sw4-qv-price-badge-{{ sid }}');
  var qvMainImg = document.getElementById('sw4-qv-main-img-{{ sid }}');
  var qvCount   = document.getElementById('sw4-qv-count-{{ sid }}');
  var qvThumbs  = document.getElementById('sw4-qv-thumbs-{{ sid }}');
  var qvAdd     = document.getElementById('sw4-qv-add-{{ sid }}');
  var qvAddLabel = document.getElementById('sw4-qv-add-label-{{ sid }}');
  var qvPrev    = document.getElementById('sw4-qv-prev-{{ sid }}');
  var qvNext    = document.getElementById('sw4-qv-next-{{ sid }}');

  var qvCurrentCardId = null;
  var qvIndex = 0;
  var qvImgs  = [];
  var qvTouchStart = 0;

  function sw4QvMoney(c) { return '$' + (c / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

  function sw4QvShowImg(i) {
    if (!qvImgs.length || !qvMainImg) return;
    qvIndex = i;
    qvMainImg.style.opacity = '0';
    setTimeout(function () {
      qvMainImg.src = qvImgs[i];
      qvMainImg.style.opacity = '1';
    }, 150);
    if (qvCount) qvCount.textContent = (i + 1) + ' / ' + qvImgs.length;
    if (qvThumbs) qvThumbs.querySelectorAll('.sw4-qv-thumb-{{ sid }}').forEach(function(t, idx){
      t.classList.toggle('active', idx === i);
    });
    if (qvPrev) qvPrev.classList.toggle('off', i === 0);
    if (qvNext) qvNext.classList.toggle('off', i === qvImgs.length - 1);
  }

  window['sw4QvOpen_{{ sid }}'] = function (cardId) {
    var data = SW4_QV_DATA[cardId];
    var info = SW4_CARD_INFO_QV[cardId];
    if (!data || !info) return;
    qvCurrentCardId = cardId;
    qvImgs = data.images;
    qvIndex = 0;
    if (qvTitle) qvTitle.textContent = data.title;
    if (qvDesc)  qvDesc.innerHTML  = data.desc;
    if (qvPriceSale) qvPriceSale.textContent = sw4QvMoney(data.price);
    if (qvPriceCompare) {
      if (data.compare > data.price) {
        qvPriceCompare.textContent = sw4QvMoney(data.compare);
        qvPriceCompare.style.display = '';
      } else qvPriceCompare.style.display = 'none';
    }
    if (qvPriceBadge) {
      if (data.compare > data.price) {
        var pct = Math.round(((data.compare - data.price) / data.compare) * 100);
        qvPriceBadge.textContent = '◆ SAVE ' + pct + '%';
        qvPriceBadge.style.display = 'inline-flex';
      } else qvPriceBadge.style.display = 'none';
    }
    if (qvThumbs) {
      var html = '';
      data.thumbs.forEach(function (src, i) {
        html += '<div class="sw4-qv-thumb-{{ sid }}' + (i === 0 ? ' active' : '') + '" data-idx="' + i + '" onclick="sw4QvThumb_{{ sid }}(' + i + ')"><img src="' + src + '" alt=""></div>';
      });
      qvThumbs.innerHTML = html;
    }
    sw4QvShowImg(0);

    var card = document.getElementById(cardId);
    if (qvAdd) {
      qvAdd.classList.remove('in-bundle');
      qvAdd.style.display = '';
      qvAdd.classList.remove('common', 'rare', 'legendary');
      qvAdd.classList.add(info.rarity);
      qvAdd.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg><span id="sw4-qv-add-label-{{ sid }}">Claim ' + info.stars + '</span>';
      qvAddLabel = document.getElementById('sw4-qv-add-label-{{ sid }}');
      if (card && card.classList.contains('selected')) {
        qvAdd.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Claimed ' + info.stars + '</span>';
        qvAdd.classList.add('in-bundle');
      }
    }

    if (qvOverlay) qvOverlay.classList.add('active');
    qvOverlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  };

  window['sw4QvClose_{{ sid }}'] = function () {
    if (qvOverlay) qvOverlay.classList.remove('active');
    qvOverlay.style.display = 'none';
    document.body.style.overflow = '';
    qvCurrentCardId = null;
  };
  window['sw4QvNav_{{ sid }}'] = function (dir) {
    var n = qvIndex + dir;
    if (n < 0 || n >= qvImgs.length) return;
    sw4QvShowImg(n);
  };
  window['sw4QvThumb_{{ sid }}'] = function (i) { sw4QvShowImg(i); };

  window['sw4QvAccToggle_{{ sid }}'] = function (trigger) {
    var item = trigger.closest('.sw4-qv-acc-{{ sid }}');
    if (!item) return;
    var isOpen = item.classList.contains('open');
    document.querySelectorAll('.sw4-qv-acc-{{ sid }}').forEach(function (i) {
      i.classList.remove('open');
      var trg = i.querySelector('.sw4-qv-acc-trigger-{{ sid }}');
      if (trg) trg.setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      item.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    }
  };

  window['sw4QvCtaClick_{{ sid }}'] = function () {
    if (!qvCurrentCardId) return;
    var card = document.getElementById(qvCurrentCardId);
    if (!card) return;
    if (card.classList.contains('selected')) {
      window['sw4QvClose_{{ sid }}']();
      return;
    }
    window['sw4ToggleAddon_{{ sid }}'](card);
    window['sw4QvClose_{{ sid }}']();
  };

  if (qvOverlay) {
    qvOverlay.addEventListener('click', function (e) {
      if (e.target === qvOverlay) window['sw4QvClose_{{ sid }}']();
    });
    qvOverlay.addEventListener('touchstart', function (e) { qvTouchStart = e.touches[0].clientX; }, { passive: true });
    qvOverlay.addEventListener('touchend', function (e) {
      if (!qvOverlay.classList.contains('active')) return;
      var diff = e.changedTouches[0].clientX - qvTouchStart;
      if (Math.abs(diff) > 50) window['sw4QvNav_{{ sid }}'](diff > 0 ? -1 : 1);
    }, { passive: true });
  }
  document.addEventListener('keydown', function (e) {
    if (!qvOverlay || !qvOverlay.classList.contains('active')) return;
    if (e.key === 'Escape')     window['sw4QvClose_{{ sid }}']();
    if (e.key === 'ArrowLeft')  window['sw4QvNav_{{ sid }}'](-1);
    if (e.key === 'ArrowRight') window['sw4QvNav_{{ sid }}'](1);
  });
})();
</script>

<script>
(function () {
  var SW4_MAIN_VARIANT = {{ main_product.first_available_variant.id }};
  var SW4_CARD_INFO_P = {
    'sw4-card-football-{{ sid }}': { variant: {{ addon_football.first_available_variant.id }} },
    'sw4-card-og-{{ sid }}':       { variant: {{ addon_og.first_available_variant.id }} },
    'sw4-card-popgolf-{{ sid }}':  { variant: {{ addon_popgolf.first_available_variant.id }} }
  };
  var lastSig = '';
  function sw4PollCart() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var sig = cart.items.map(function(i){ return i.variant_id + 'x' + i.quantity; }).sort().join('|');
      if (sig === lastSig) return;
      lastSig = sig;
      var inCart = cart.items.map(function(i){ return i.variant_id; });
      document.querySelectorAll('.sw4-card-{{ sid }}').forEach(function(card){
        var v = parseInt(card.dataset.variant, 10);
        if (!v) return;
        var present = inCart.indexOf(v) !== -1;
        card.classList.toggle('selected', present);
      });
      if (typeof window['sw4Render_{{ sid }}'] === 'function') window['sw4Render_{{ sid }}']();
      // re-trigger main render via existing closure handle
      var totalEl = document.getElementById('sw4-total-{{ sid }}');
      if (totalEl) {
        var ev = new Event('sw4:refresh-{{ sid }}');
        document.dispatchEvent(ev);
      }
    }).catch(function(){});
  }
  setInterval(sw4PollCart, 2500);
  document.addEventListener('cart:refresh',  sw4PollCart);
  document.addEventListener('cart:updated',  sw4PollCart);
  document.addEventListener('cart:added',    sw4PollCart);
  document.addEventListener('cart:changed',  sw4PollCart);
})();
</script>

<script>
(function () {
  var injected = false;
  function inject(target) {
    if (injected) return;
    var styleEl = document.createElement('style');
    styleEl.setAttribute('data-sw4-upcart-{{ sid }}', '');
    styleEl.textContent = "\
      #CartPopup, .upcart-modal, .upcart-cart { background: #050505 !important; color: #fff !important; font-family: 'Inter', sans-serif !important; }\
      #CartPopup *, .upcart-modal * { border-color: rgba(255,255,255,0.08) !important; }\
      #CartPopup h1, #CartPopup h2, #CartPopup h3, .upcart-header, .upcart-cart-title { font-family: 'Russo One', sans-serif !important; letter-spacing: 0.04em !important; text-transform: uppercase !important; color: #fff !important; }\
      #CartPopup .upcart-cart-subtotal-text, #CartPopup .upcart-checkout-text { color: #23ff53 !important; }\
      #CartPopup .upcart-checkout-button, #CartPopup button[type='submit'] { background: linear-gradient(135deg, #23ff53, #1be047) !important; color: #000 !important; font-family: 'Russo One', sans-serif !important; letter-spacing: 0.08em !important; text-transform: uppercase !important; border-radius: 10px !important; }\
      #CartPopup .upcart-line-item, .upcart-product { border-bottom: 1px dashed rgba(255,255,255,0.12) !important; }\
      #CartPopup a { color: #23ff53 !important; }\
    ";
    target.appendChild(styleEl);
    injected = true;
  }
  function check() {
    var popup = document.getElementById('CartPopup') || document.querySelector('.upcart-modal, .upcart-cart');
    if (popup) inject(document.head);
  }
  check();
  if ('MutationObserver' in window) {
    var mo = new MutationObserver(check);
    mo.observe(document.body, { childList: true, subtree: true });
  } else {
    document.addEventListener('cart:open', check);
  }
})();
</script>

