{% comment %}
  Swaptop Bundle v4 — Collector's Edition Configurator
  Drop into: sections/swaptop-bundle-v4.liquid
{% endcomment %}

{% assign main_product   = all_products['swaptop-kit'] %}
{% assign addon_football = all_products['swaptop-football'] %}
{% assign addon_og       = all_products['swaptop-og'] %}
{% assign addon_popgolf  = all_products['swaptop-popgolf'] %}

{% assign sid = section.id | replace: '-', '_' | replace: '.', '_' %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Russo+One&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap');

  /* SHELL + HALFTONE BG */
  .sw4-section-{{ sid }} {
    --sw4-bg: #050505;
    --sw4-bg-2: #0a0a0a;
    --sw4-bg-card: #0c0c0c;
    --sw4-accent: #23ff53;
    --sw4-accent-2: #1be047;
    --sw4-fg: #ffffff;
    --sw4-fg-mute: rgba(255,255,255,0.62);
    --sw4-fg-low: rgba(255,255,255,0.35);
    --sw4-border: rgba(255,255,255,0.08);
    --sw4-border-2: rgba(255,255,255,0.16);
    --sw4-common-a: #23ff53;
    --sw4-common-b: #00d4ff;
    --sw4-rare-a: #c0c0c0;
    --sw4-rare-b: #ffffff;
    --sw4-rare-c: #8a9aa5;
    --sw4-legend-a: #ffd700;
    --sw4-legend-b: #ffed4e;
    --sw4-legend-c: #ff8c00;
    --sw4-display: 'Russo One', 'Impact', sans-serif;
    --sw4-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --sw4-mono: 'JetBrains Mono', 'SF Mono', 'Roboto Mono', monospace;
    position: relative;
    background: var(--sw4-bg);
    color: var(--sw4-fg);
    overflow-x: clip;
    isolation: isolate;
    font-family: var(--sw4-body);
  }
  .sw4-section-{{ sid }} *,
  .sw4-section-{{ sid }} *::before,
  .sw4-section-{{ sid }} *::after { box-sizing: border-box; }
  .sw4-section-{{ sid }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1.4px);
    background-size: 16px 16px;
    pointer-events: none;
    z-index: 0;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 85%);
  }
  .sw4-section-{{ sid }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(800px 500px at 15% -5%,  rgba(35,255,83,0.10), transparent 60%),
      radial-gradient(700px 500px at 92% 35%,  rgba(35,255,83,0.06), transparent 60%),
      radial-gradient(600px 400px at 50% 110%, rgba(255,215,0,0.04), transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .sw4-section-{{ sid }}-inner {
    position: relative;
    z-index: 1;
    max-width: 1380px;
    margin: 0 auto;
    padding: 28px 18px 52px;
  }
  .sw4-section-{{ sid }} button,
  body > .sw4-modal-{{ sid }} button {
    -webkit-appearance: none !important;
    appearance: none !important;
    border: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    min-width: 0 !important;
    min-height: 0 !important;
    line-height: 1 !important;
    font: inherit !important;
    color: inherit !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    cursor: pointer;
    box-sizing: border-box !important;
    box-shadow: none;
    background: transparent;
  }
  .sw4-section-{{ sid }} button::before,
  .sw4-section-{{ sid }} button::after,
  body > .sw4-modal-{{ sid }} button::before,
  body > .sw4-modal-{{ sid }} button::after {
    display: none !important;
    content: none !important;
  }

  /* COLLECTOR HEADER */
  .sw4-header-{{ sid }} { display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 28px; position: relative; }
  .sw4-header-top-{{ sid }} { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .sw4-eyebrow-{{ sid }} {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 12px; border-radius: 4px;
    background: linear-gradient(135deg, rgba(255,215,0,0.14), rgba(35,255,83,0.10));
    border: 1px solid rgba(255,215,0,0.35);
    font-family: var(--sw4-mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: #ffd700;
  }
  .sw4-eyebrow-{{ sid }} .sw4-spark {
    display: inline-block; width: 6px; height: 6px;
    background: #ffd700; transform: rotate(45deg);
    box-shadow: 0 0 8px #ffd700;
  }
  .sw4-edition-{{ sid }} {
    font-family: var(--sw4-mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--sw4-fg-low);
  }
  .sw4-edition-{{ sid }} b { color: var(--sw4-fg); font-weight: 700; }
  .sw4-headline-{{ sid }} {
    margin: 0; font-family: var(--sw4-display); font-weight: 400;
    font-size: clamp(56px, 12vw, 132px); line-height: 0.92;
    letter-spacing: 0.01em; color: var(--sw4-fg); text-transform: uppercase;
  }
  .sw4-headline-{{ sid }} em {
    font-style: normal;
    background: linear-gradient(135deg, #23ff53 0%, #00d4ff 45%, #ffd700 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    position: relative;
  }
  .sw4-sub-{{ sid }} {
    margin: 0; font-size: 14px; line-height: 1.55;
    color: var(--sw4-fg-mute); max-width: 560px; font-weight: 500;
  }
  .sw4-progress-{{ sid }} {
    margin-top: 4px; padding: 14px 16px;
    border: 1px solid var(--sw4-border-2); border-radius: 14px;
    background: linear-gradient(180deg, rgba(35,255,83,0.04) 0%, rgba(255,255,255,0.01) 100%), rgba(0,0,0,0.3);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    display: flex; flex-direction: column; gap: 10px;
  }
  .sw4-progress-row-{{ sid }} { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .sw4-progress-label-{{ sid }} {
    font-family: var(--sw4-mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--sw4-fg-mute);
  }
  .sw4-progress-count-{{ sid }} {
    font-family: var(--sw4-display); font-size: 20px;
    color: var(--sw4-fg); letter-spacing: 0.04em;
  }
  .sw4-progress-count-{{ sid }} b {
    background: linear-gradient(135deg, #23ff53, #ffd700);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .sw4-progress-track-{{ sid }} {
    height: 6px; border-radius: 100px;
    background: rgba(255,255,255,0.08);
    overflow: hidden; position: relative;
  }
  .sw4-progress-fill-{{ sid }} {
    height: 100%; width: 25%; border-radius: 100px;
    background: linear-gradient(90deg, #23ff53, #00d4ff, #ffd700);
    box-shadow: 0 0 12px rgba(35,255,83,0.4);
    transition: width 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sw4-progress-stamps-{{ sid }} { display: flex; gap: 6px; align-items: center; }
  .sw4-stamp-{{ sid }} {
    width: 22px; height: 22px; border-radius: 5px;
    border: 1.5px dashed rgba(255,255,255,0.18);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--sw4-mono); font-size: 9px; font-weight: 700;
    color: var(--sw4-fg-low);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sw4-stamp-{{ sid }}.lit {
    border-style: solid; border-color: var(--sw4-accent);
    background: rgba(35,255,83,0.18); color: var(--sw4-accent);
    box-shadow: 0 0 12px rgba(35,255,83,0.4);
    transform: rotate(-3deg) scale(1.04);
  }
  .sw4-stamp-{{ sid }}.legendary.lit {
    border-color: #ffd700; background: rgba(255,215,0,0.18);
    color: #ffd700; box-shadow: 0 0 14px rgba(255,215,0,0.45);
  }
  .sw4-stars-{{ sid }} {
    display: inline-flex !important; align-items: center !important;
    gap: 8px !important; background: transparent !important; padding: 0 !important;
  }
  .sw4-stars-icons-{{ sid }} { display: flex; gap: 1px; }
  .sw4-stars-icons-{{ sid }} span { color: #f59e0b; font-size: 14px; line-height: 1; }
  .sw4-stars-label-{{ sid }} {
    font-family: var(--sw4-mono); font-size: 10px; font-weight: 700;
    color: var(--sw4-fg-mute); letter-spacing: 0.12em;
    transition: color 0.2s ease;
  }
  .sw4-stars-{{ sid }}:hover .sw4-stars-label-{{ sid }} { color: var(--sw4-accent); }

  /* BUILDER + HERO */
  .sw4-builder-{{ sid }} { display: grid; grid-template-columns: 1fr; gap: 18px; align-items: start; }
  .sw4-hero-col-{{ sid }} { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .sw4-featured-{{ sid }} {
    position: relative; padding: 2px; border-radius: 22px;
    background: linear-gradient(135deg, rgba(35,255,83,0.5) 0%, rgba(0,212,255,0.5) 30%, rgba(255,215,0,0.5) 60%, rgba(35,255,83,0.5) 100%);
    background-size: 300% 300%;
    animation: sw4foilSlow-{{ sid }} 8s linear infinite;
  }
  @keyframes sw4foilSlow-{{ sid }} { from { background-position: 0% 0%; } to { background-position: 300% 300%; } }
  .sw4-featured-inner-{{ sid }} {
    position: relative; border-radius: 20px; overflow: hidden;
    background: linear-gradient(160deg, #111 0%, #050505 100%);
    aspect-ratio: 1 / 1;
  }
  .sw4-featured-stage-{{ sid }} { position: absolute; inset: 0; cursor: pointer; }
  .sw4-featured-stage-{{ sid }}::before {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(circle at 25% 25%, rgba(35,255,83,0.16), transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(255,215,0,0.06), transparent 60%);
    pointer-events: none; z-index: 0;
  }
  .sw4-featured-stage-{{ sid }}::after {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1.2px);
    background-size: 18px 18px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 85%);
    pointer-events: none; z-index: 0;
  }
  .sw4-featured-rarity-{{ sid }} {
    position: absolute; top: 0; left: 0; right: 0; z-index: 5;
    padding: 9px 14px;
    background: linear-gradient(90deg, rgba(35,255,83,0.18) 0%, rgba(0,212,255,0.14) 50%, rgba(255,215,0,0.18) 100%);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.12);
    font-family: var(--sw4-mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--sw4-fg);
    display: flex; align-items: center; justify-content: space-between;
    pointer-events: none;
  }
  .sw4-featured-rarity-{{ sid }} .sw4-r-stars { color: #ffd700; letter-spacing: 0.06em; }
  .sw4-featured-rarity-{{ sid }} .sw4-r-label {
    background: linear-gradient(135deg, #23ff53, #ffd700);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .sw4-featured-num-{{ sid }} {
    position: absolute; left: 16px; bottom: -34px; z-index: 0;
    font-family: var(--sw4-display);
    font-size: clamp(180px, 32vw, 320px);
    line-height: 0.78; color: rgba(255,255,255,0.035);
    letter-spacing: -0.02em; pointer-events: none; user-select: none;
  }
  .sw4-featured-img-{{ sid }} {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: contain; padding: 64px 38px 80px;
    display: block; z-index: 2;
    transition: opacity 0.25s ease;
    animation: sw4float-{{ sid }} 7s ease-in-out infinite;
  }
  @keyframes sw4float-{{ sid }} { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  .sw4-featured-stamp-{{ sid }} {
    position: absolute; bottom: 14px; right: 14px; z-index: 4;
    width: 76px; height: 76px; border-radius: 50%;
    border: 2px dashed rgba(35,255,83,0.55);
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    font-family: var(--sw4-mono); font-size: 8px; font-weight: 700;
    letter-spacing: 0.14em; color: var(--sw4-accent);
    text-align: center; line-height: 1.3;
    transform: rotate(-8deg);
  }
  .sw4-featured-stamp-{{ sid }} b {
    font-family: var(--sw4-display); font-size: 14px;
    letter-spacing: 0.04em; color: var(--sw4-accent);
  }
  .sw4-featured-thumbs-{{ sid }} {
    position: absolute; bottom: 14px; left: 14px; z-index: 4;
    display: flex; gap: 6px;
  }
  .sw4-featured-thumb-{{ sid }} {
    width: 42px !important; height: 42px !important;
    border-radius: 7px !important; overflow: hidden !important;
    border: 1.5px solid rgba(255,255,255,0.18) !important;
    background: rgba(0,0,0,0.55) !important;
    backdrop-filter: blur(10px) !important; -webkit-backdrop-filter: blur(10px) !important;
    cursor: pointer; transition: border-color 0.2s, transform 0.2s !important;
    padding: 0 !important;
  }
  .sw4-featured-thumb-{{ sid }}.active,
  .sw4-featured-thumb-{{ sid }}:hover {
    border-color: var(--sw4-accent) !important;
    transform: scale(1.06) !important;
  }
  .sw4-featured-thumb-{{ sid }} img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sw4-featured-info-{{ sid }} {
    padding: 14px 16px; border: 1px solid var(--sw4-border);
    border-radius: 14px; background: rgba(0,0,0,0.35);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center;
  }
  .sw4-featured-info-title-{{ sid }} {
    margin: 0; font-family: var(--sw4-display); font-size: 18px;
    line-height: 1; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--sw4-fg);
  }
  .sw4-featured-info-meta-{{ sid }} {
    margin: 6px 0 0; font-family: var(--sw4-mono); font-size: 9px;
    font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--sw4-fg-low);
  }
  .sw4-featured-info-meta-{{ sid }} b { color: var(--sw4-accent); }
  .sw4-featured-info-price-{{ sid }} {
    font-family: var(--sw4-display); font-size: 22px;
    color: var(--sw4-accent); letter-spacing: 0.02em; line-height: 1;
  }

  /* TOPS COLUMN */
  .sw4-tops-col-{{ sid }} { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .sw4-tops-head-{{ sid }} {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 12px; flex-wrap: wrap; padding: 0 2px;
  }
  .sw4-tops-title-{{ sid }} {
    margin: 0; font-family: var(--sw4-display); font-size: 28px;
    line-height: 1; letter-spacing: 0.03em; color: var(--sw4-fg);
    text-transform: uppercase;
  }
  .sw4-tops-title-{{ sid }} em {
    font-style: normal;
    background: linear-gradient(135deg, #23ff53, #ffd700);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .sw4-tops-meta-{{ sid }} {
    font-family: var(--sw4-mono); font-size: 9px; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--sw4-fg-low);
  }
  .sw4-cards-grid-{{ sid }} { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .sw4-card-{{ sid }} {
    position: relative; border-radius: 16px; background: var(--sw4-bg-card);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-style: preserve-3d; will-change: transform;
    cursor: pointer; isolation: isolate;
  }
  .sw4-card-{{ sid }}::before {
    content: ''; position: absolute; inset: -2px; border-radius: 18px;
    background: linear-gradient(135deg, var(--sw4-common-a), var(--sw4-common-b), var(--sw4-common-a));
    background-size: 200% 200%; z-index: -1; opacity: 0.4;
    transition: opacity 0.3s ease;
  }
  .sw4-card-{{ sid }}[data-rarity="rare"]::before {
    background: linear-gradient(135deg, var(--sw4-rare-a), var(--sw4-rare-b), var(--sw4-rare-c), var(--sw4-rare-b), var(--sw4-rare-a));
    background-size: 200% 200%;
  }
  .sw4-card-{{ sid }}[data-rarity="legendary"]::before {
    background: linear-gradient(135deg, var(--sw4-legend-a), var(--sw4-legend-b), var(--sw4-legend-c), var(--sw4-legend-b), var(--sw4-legend-a));
    background-size: 200% 200%; opacity: 0.55;
  }
  .sw4-card-{{ sid }}:hover::before { opacity: 0.85; animation: sw4foil-{{ sid }} 3s linear infinite; }
  .sw4-card-{{ sid }}.selected::before { opacity: 1; animation: sw4foil-{{ sid }} 3s linear infinite; }
  @keyframes sw4foil-{{ sid }} { from { background-position: 0% 0%; } to { background-position: 200% 200%; } }
  .sw4-card-{{ sid }}.selected {
    box-shadow: 0 0 0 1px rgba(35,255,83,0.2), 0 16px 40px rgba(0,0,0,0.5), 0 0 24px rgba(35,255,83,0.18);
  }
  .sw4-card-{{ sid }}[data-rarity="legendary"].selected {
    box-shadow: 0 0 0 1px rgba(255,215,0,0.25), 0 16px 40px rgba(0,0,0,0.5), 0 0 28px rgba(255,215,0,0.28);
  }
  .sw4-card-rarity-{{ sid }} {
    position: relative; padding: 8px 12px; border-radius: 16px 16px 0 0;
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    font-family: var(--sw4-mono); font-size: 9px; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase;
    background: linear-gradient(90deg, rgba(35,255,83,0.18), rgba(0,212,255,0.06));
    border-bottom: 1px solid rgba(35,255,83,0.25); color: var(--sw4-common-a);
  }
  .sw4-card-{{ sid }}[data-rarity="rare"] .sw4-card-rarity-{{ sid }} {
    background: linear-gradient(90deg, rgba(192,192,192,0.18), rgba(192,192,192,0.04));
    border-bottom-color: rgba(192,192,192,0.3); color: var(--sw4-rare-b);
  }
  .sw4-card-{{ sid }}[data-rarity="legendary"] .sw4-card-rarity-{{ sid }} {
    background: linear-gradient(90deg, rgba(255,215,0,0.22), rgba(255,140,0,0.08));
    border-bottom-color: rgba(255,215,0,0.4); color: var(--sw4-legend-b);
  }
  .sw4-card-rarity-{{ sid }} .sw4-r-stars { letter-spacing: 0.04em; font-size: 10px; }
  .sw4-card-rarity-{{ sid }} .sw4-r-num {
    font-family: var(--sw4-display); font-size: 11px;
    letter-spacing: 0.05em; color: var(--sw4-fg); opacity: 0.7;
  }
  .sw4-card-stamp-{{ sid }} {
    position: absolute; top: 50px; right: 12px; z-index: 6;
    width: 70px; height: 70px; border-radius: 50%;
    border: 2.5px dashed var(--sw4-accent);
    background: rgba(35,255,83,0.15);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    font-family: var(--sw4-mono); font-size: 7px; font-weight: 700;
    letter-spacing: 0.16em; color: var(--sw4-accent);
    text-align: center; line-height: 1.3;
    transform: rotate(-12deg) scale(0); opacity: 0;
    transition: transform 0.4s cubic-bezier(0.34, 1.7, 0.64, 1), opacity 0.3s;
    pointer-events: none;
  }
  .sw4-card-stamp-{{ sid }} b { font-family: var(--sw4-display); font-size: 12px; letter-spacing: 0.04em; }
  .sw4-card-{{ sid }}.selected .sw4-card-stamp-{{ sid }} { transform: rotate(-12deg) scale(1); opacity: 1; }
  .sw4-card-{{ sid }}[data-rarity="legendary"].selected .sw4-card-stamp-{{ sid }} {
    border-color: #ffd700; background: rgba(255,215,0,0.18); color: #ffd700;
  }
  .sw4-card-{{ sid }}[data-rarity="legendary"].selected .sw4-card-stamp-{{ sid }} b { color: #ffd700; }
  .sw4-card-art-{{ sid }} {
    position: relative; aspect-ratio: 16 / 11; overflow: hidden;
    background: linear-gradient(160deg, #181818, #0a0a0a);
  }
  .sw4-card-art-{{ sid }}::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at center, rgba(35,255,83,0.1), transparent 60%);
    z-index: 0;
  }
  .sw4-card-{{ sid }}[data-rarity="legendary"] .sw4-card-art-{{ sid }}::before {
    background: radial-gradient(circle at center, rgba(255,215,0,0.1), transparent 60%);
  }
  .sw4-card-art-{{ sid }} img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; z-index: 1;
    transition: transform 0.4s ease;
  }
  .sw4-card-{{ sid }}:hover .sw4-card-art-{{ sid }} img { transform: scale(1.05); }
  .sw4-card-art-shine-{{ sid }} {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(135deg, transparent 30%, rgba(255,255,255,0.08) 50%, transparent 70%);
    pointer-events: none; opacity: 0;
    transition: opacity 0.4s ease;
  }
