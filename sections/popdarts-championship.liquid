<section class="pd-page championship" id="championship-{{ section.id }}" aria-labelledby="championship-title-{{ section.id }}">
  <div class="championship__media" aria-hidden="true">
    <img src="{% if section.settings.bg_image %}{{ section.settings.bg_image | image_url: width: 1920 }}{% else %}{{ 'pd-championship-arena.jpg' | asset_url }}{% endif %}" alt="A packed arena crowd cheering at the Popdarts National Championship.">
    <div class="championship__scrim"></div>
    <div class="championship__overlay" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; background-color: #000000; opacity: {{ section.settings.overlay_opacity | default: 0 }}%; pointer-events: none;"></div>
  </div>

  <div class="pd-wrap">
    <div class="championship__inner">
      <p class="championship__eyebrow">
        {{ section.settings.eyebrow | default: 'The Popdarts Championship · Presented by APL' }}
        {%- if section.settings.apl_link != blank %} <a class="championship__apl-link" href="{{ section.settings.apl_link }}">Join APL →</a>{% endif -%}
      </p>
      <h2 id="championship-title-{{ section.id }}" style="color: #fdfdfd;">{{ section.settings.heading | default: 'The whole arena<br>is watching.' }}</h2>
      <p class="championship__body">{{ section.settings.body | default: "What starts in your driveway can end in a sold-out arena, broadcast live on ESPN. This is the top of the game — and it started exactly where you're standing right now." }}</p>

      {%- if section.settings.dadbod_line != blank -%}
        <div class="championship__dadbod-row">
          <img class="championship__dadbod-img" alt="A fan wearing dart suction cups over his sunglasses like eyes, laughing."
            src="{% if section.settings.dadbod_image %}{{ section.settings.dadbod_image | image_url: width: 400 }}{% else %}{{ 'pd-dadbod-sunglasses.jpg' | asset_url }}{% endif %}">
          <p class="championship__dadbod">{{ section.settings.dadbod_line }} <span>{{ section.settings.dadbod_sub }}</span></p>
        </div>
      {%- endif -%}

      <a class="btn btn--primary btn--lg" href="{{ section.settings.cta_link | default: '/products/pro-pack' }}">{{ section.settings.cta_text | default: 'Get Your Pro Pack' }}</a>

      <p class="championship__stat">
        <strong>{{ section.settings.stat_number | default: '1B+' }}</strong> {{ section.settings.stat_label | default: 'Social Views' }}
        &nbsp;·&nbsp; {{ section.settings.stat_secondary | default: 'Live on ESPN' }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The Championship",
  "tag": "section",
  "class": "pd-section-championship",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Extra black overlay opacity",
      "info": "Adds darkness on top of the built-in gradient, if you need more contrast for the text.",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Popdarts Championship · Presented by APL"
    },
    {
      "type": "url",
      "id": "apl_link",
      "label": "APL membership link",
      "info": "Optional. Adds a \"Join APL\" link next to the eyebrow, e.g. https://iplayapl.com/pages/get-a-membership"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The whole arena is watching."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "What starts in your driveway can end in a sold-out arena, broadcast live on ESPN. This is the top of the game — and it started exactly where you're standing right now."
    },
    {
      "type": "header",
      "content": "Optional caption line (leave blank to hide)"
    },
    {
      "type": "image_picker",
      "id": "dadbod_image",
      "label": "Caption proof image"
    },
    {
      "type": "text",
      "id": "dadbod_line",
      "label": "Line 1"
    },
    {
      "type": "text",
      "id": "dadbod_sub",
      "label": "Line 2"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Get Your Pro Pack"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Stat line"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat number",
      "default": "1B+"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Stat label",
      "default": "Social Views"
    },
    {
      "type": "text",
      "id": "stat_secondary",
      "label": "Secondary stat",
      "default": "Live on ESPN"
    }
  ],
  "presets": [
    {
      "name": "The Championship"
    }
  ]
}
{% endschema %}
