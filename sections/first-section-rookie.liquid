<script>
function spbOpenCart(e) {
  if (e) { e.preventDefault(); e.stopPropagation(); }

  document.dispatchEvent(new CustomEvent('cart:open'));
  document.dispatchEvent(new CustomEvent('theme:cart:open'));

  var drawerEl = document.querySelector('cart-drawer');
  if (drawerEl && typeof drawerEl.open === 'function') { drawerEl.open(); return; }

  var selectors = [
    '[data-cart-toggle]', '[data-drawer-toggle="cart-drawer"]',
    '.cart-drawer-toggle', '#cart-icon-bubble', '.header__icon--cart',
    '[aria-controls="cart-drawer"]', '[data-action="toggle-cart"]',
    '.js-cart-toggle', '[data-cart-drawer-trigger]'
  ];
  for (var i = 0; i < selectors.length; i++) {
    var btn = document.querySelector(selectors[i]);
    if (btn) { btn.click(); return; }
  }

  var allEls = document.querySelectorAll('[id*="cart-drawer"], [class*="cart-drawer"]');
  for (var j = 0; j < allEls.length; j++) {
    var el = allEls[j];
    if (el.tagName === 'BUTTON' || el.tagName === 'A') { el.click(); return; }
    el.setAttribute('open', '');
    el.removeAttribute('hidden');
    el.style.display = '';
    el.style.visibility = 'visible';
  }
}
</script>

