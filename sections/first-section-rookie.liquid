<style>
  div#epb_container { display: none !important; }
  #up-upsell-carousel { display: none !important; }
</style>

<script>
(function () {
  function hide() {
    var el = document.getElementById('up-upsell-carousel');
    if (el) el.style.setProperty('display', 'none', 'important');
    function checkShadows(root) {
      root.querySelectorAll('*').forEach(function (node) {
        if (node.id === 'up-upsell-carousel') {
          node.style.setProperty('display', 'none', 'important');
        }
        if (node.shadowRoot) checkShadows(node.shadowRoot);
      });
    }
    checkShadows(document);
  }
  new MutationObserver(hide).observe(document.documentElement, { childList: true, subtree: true });
  var t = setInterval(hide, 200);
  window.addEventListener('load', function () {
    setTimeout(function () { clearInterval(t); }, 15000);
  });
})();
</script>

<style>
  .spb-announcement {
    background: linear-gradient(90deg, #C8102E 0%, #C8102E 55%, #002868 100%);
    width: 100%;
    padding: 0;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 10000;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
    height: 38px;
  }
  .spb-announcement__slider { position: relative; width: 100%; height: 100%; }
  .spb-announcement__slide {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    padding: 0 24px;
    opacity: 0; transform: translateY(100%);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }
  .spb-announcement__slide.active { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .spb-announcement__slide.exit { opacity: 0; transform: translateY(-100%); }
  .spb-announcement__text {
    font-size: 13px; font-weight: 700; color: #ffffff;
    letter-spacing: 0.06em; text-transform: uppercase;
    margin: 0; white-space: nowrap;
  }
  .spb-announcement__text a { color: #ffffff; text-decoration: underline; text-underline-offset: 2px; }

  @media (min-width: 640px) {
    button.spb-subnav-cart svg { color: white; }
    button.spb-subnav-cart { background: #C8102E; }
  }

  @media (max-width: 640px) {
    .spb-announcement { height: 34px; }
    .spb-announcement__slide { padding: 0 16px; }
    .spb-announcement__text { font-size: 11px; }
    span.spb-corner { display: none; }
  }
</style>

<div class="spb-announcement">
  <div class="spb-announcement__slider" id="spb-announcement-slider">
    <div class="spb-announcement__slide active">
      <p class="spb-announcement__text">🎁 <strong>FREE GIFT CARD</strong> WITH EVERY ORDER OVER $210</p>
    </div>
    <div class="spb-announcement__slide">
      <p class="spb-announcement__text">🇺🇸 <strong>FREE SHIPPING</strong> IN THE USA</p>
    </div>
  </div>
</div>

<script>
(function() {
  const slides = document.querySelectorAll('#spb-announcement-slider .spb-announcement__slide');
  let current = 0;
  setInterval(() => {
    slides[current].classList.add('exit');
    slides[current].classList.remove('active');
    current = (current + 1) % slides.length;
    slides[current].classList.add('active');
    slides[current].classList.remove('exit');
    const prev = (current - 1 + slides.length) % slides.length;
    setTimeout(() => slides[prev].classList.remove('exit'), 550);
  }, 3500);
})();
</script>

<style>
  .shopify-section-header,
  .shopify-section-footer,
  .shopify-section-announcement-bar,
  #shopify-section-header,
  #shopify-section-footer,
  #shopify-section-announcement-bar,
  .announcement-bar,
  .header-wrapper,
  .footer,
  header.header,
  footer.footer,
  .site-header,
  .site-footer { display: none !important; }

  .spb-wrap *,
  .spb-wrap *::before,
  .spb-wrap *::after { box-sizing: border-box; }

  .spb-wrap {
    font-family: 'Inter', sans-serif;
    position: sticky;
    top: 38px;
    z-index: 9999;
  }

  .spb-bar {
    background: #000;
    overflow: visible;
    padding: 0 24px;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .spb-bar::before {
    content: '';
    position: absolute;
    bottom: 0; left: -100%;
    width: 60%; height: 1px;
    background: linear-gradient(to right, transparent, #C8102E, transparent);
    animation: spb-scan 4s ease-in-out infinite;
  }

  @keyframes spb-scan {
    0%   { left: -60%; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  .spb-corner { display: none !important; }

  .spb-logo-link { display: flex; align-items: center; justify-content: center; text-decoration: none; z-index: 1; }
  .spb-logo-link:hover .spb-logo { filter: drop-shadow(0 0 6px #C8102E); }
  .spb-logo { height: 28px; width: auto; display: block; transition: filter 0.3s ease; }
  .spb-logo-text {
    font-size: 22px; font-weight: 800; color: #fff;
    letter-spacing: 0.06em; text-transform: uppercase; transition: color 0.3s ease;
  }
  .spb-logo-link:hover .spb-logo-text { color: #C8102E; }

  .spb-bar-left, .spb-bar-right { display: none; }

  .spb-subnav {
    background: #0a0a0a;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex; align-items: center; justify-content: center;
    gap: 32px; padding: 0 24px; height: 58px;
    position: relative; overflow: visible;
  }

  .spb-subnav-link {
    font-size: 12px; font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none; letter-spacing: 0.05em; text-transform: uppercase;
    position: relative; padding-bottom: 2px;
    transition: color 0.3s ease;
  }
  .spb-subnav-link::after {
    content: ''; position: absolute; bottom: 0; left: 0;
    width: 0; height: 1.5px; background: #C8102E;
    transition: width 0.3s ease;
  }
  .spb-subnav-link:hover { color: #fff; }
  .spb-subnav-link:hover::after { width: 100%; }

  .spb-subnav-icons {
    position: absolute; right: 20px; top: 50%;
    transform: translateY(-50%);
    display: flex; align-items: center; gap: 6px;
  }

  .spb-subnav-icon {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    background: none; border: none; cursor: pointer;
    color: rgba(255, 255, 255, 0.75);
    transition: color 0.25s ease, transform 0.2s ease;
    padding: 0; text-decoration: none;
  }
  .spb-subnav-icon:hover { color: #C8102E; transform: translateY(-1px); }
  .spb-subnav-icon svg { width: 20px; height: 20px; display: block; flex-shrink: 0; pointer-events: none; }

  .spb-subnav-cart {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    border: none; cursor: pointer;
    color: rgba(255, 255, 255, 0.75);
    transition: color 0.25s ease, transform 0.2s ease;
    padding: 0; overflow: visible; border-radius: 8px;
  }
  .spb-subnav-cart:hover { color: #C8102E; transform: translateY(-1px); }
  .spb-subnav-cart svg { width: 20px; height: 20px; display: block; flex-shrink: 0; pointer-events: none; }

  .spb-subnav-cart__count {
    position: absolute; top: -4px; right: -4px;
    background: #000; color: #C8102E;
    font-size: 9px; font-weight: 800;
    min-width: 16px; height: 16px;
    border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
    padding: 0 4px; line-height: 1; pointer-events: none;
    border: 1.5px solid #C8102E;
  }
  .spb-subnav-cart__count[data-count="0"] { display: none; }

  .spb-mobile-menu { display: none; position: absolute; }

  /* ════════════════════════════════════════════ */
  /* ── PRESS STRIP — locked inside header ── */
  /* ════════════════════════════════════════════ */
  .spb-press {
    display: block !important;
    visibility: visible !important;
    background: #0a0a0a !important;
    padding: 10px 0 !important;
    position: relative !important;
    overflow: hidden !important;
    border-top: 1px solid rgba(200,16,46, 0.18) !important;
    border-bottom: 1px solid rgba(200,16,46, 0.18) !important;
    width: 100% !important;
    min-height: 42px !important;
    z-index: 1;
  }

  .spb-press-track-outer {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 22px;
  }

  .spb-press-track-outer::before,
  .spb-press-track-outer::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }
  .spb-press-track-outer::before {
    left: 0;
    background: linear-gradient(to right, #0a0a0a 0%, transparent 100%);
  }
  .spb-press-track-outer::after {
    right: 0;
    background: linear-gradient(to left, #0a0a0a 0%, transparent 100%);
  }

  .spb-press-track {
    display: flex !important;
    width: max-content;
    animation: spb-press-scroll 35s linear infinite;
    height: 22px;
  }
  .spb-press-track:hover { animation-play-state: paused; }

  @keyframes spb-press-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .spb-press-set {
    display: flex !important;
    align-items: center;
    flex-shrink: 0;
  }

  .spb-press-item {
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: 0 28px;
    opacity: 0.75;
    transition: opacity 0.25s ease;
  }
  .spb-press-item:hover { opacity: 1; }

  .spb-press-logo {
    height: 22px !important;
    width: auto !important;
    max-width: 120px !important;
    object-fit: contain;
    display: block !important;
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .spb-wrap { top: 34px; }
    .spb-subnav { display: none; }

    .spb-bar { height: 72px; padding: 0 12px; justify-content: space-between; }
    .spb-bar-left { display: flex; align-items: center; width: auto; min-width: 36px; flex-shrink: 0; }
    .spb-logo-link { flex: 1; display: flex; align-items: center; justify-content: center; position: static; transform: none; }
    .spb-logo { height: 22px; }
    .spb-bar-right { display: flex; align-items: center; gap: 0; width: auto; flex-shrink: 0; justify-content: flex-end; }

    .spb-bar-icon {
      display: flex; align-items: center; justify-content: center;
      width: 36px; height: 36px;
      background: none; border: none; cursor: pointer;
      color: #fff; text-decoration: none; flex-shrink: 0; padding: 0;
    }
    .spb-bar-icon svg { width: 20px; height: 20px; display: block; color: #fff; }

    .spb-bar-cart {
      display: flex !important; align-items: center !important; justify-content: center !important;
      width: 36px !important; height: 36px !important;
      color: #fff !important; text-decoration: none; cursor: pointer;
      background: none !important; border: none !important;
      position: relative; flex-shrink: 0; overflow: visible; padding: 0 !important;
    }
    .spb-bar-cart svg { width: 20px !important; min-width: 20px !important; height: 20px !important; display: block !important; color: #fff !important; fill: none; }

    .spb-bar-cart__count {
      position: absolute; top: 4px; right: 2px;
      background: #C8102E; color: #fff;
      font-size: 9px; font-weight: 800;
      min-width: 14px; height: 14px;
      border-radius: 999px;
      display: flex; align-items: center; justify-content: center;
      padding: 0 3px; line-height: 1; pointer-events: none;
    }
    .spb-bar-cart__count[data-count="0"] { display: none; }

    .spb-hamburger {
      display: flex; align-items: center; justify-content: center;
      width: 36px; height: 36px;
      background: none; border: none; cursor: pointer;
      padding: 0; flex-shrink: 0; position: static; transform: none;
    }
    .spb-hamburger-icon,
    .spb-hamburger-icon::before,
    .spb-hamburger-icon::after {
      display: block; width: 20px; height: 1.5px;
      background: #fff; border-radius: 1px; transition: all 0.3s ease;
    }
    .spb-hamburger-icon { position: relative; }
    .spb-hamburger-icon::before, .spb-hamburger-icon::after { content: ''; position: absolute; left: 0; }
    .spb-hamburger-icon::before { top: -6px; }
    .spb-hamburger-icon::after  { top: 6px; }
    .spb-hamburger.is-open .spb-hamburger-icon { background: transparent; }
    .spb-hamburger.is-open .spb-hamburger-icon::before { top: 0; transform: rotate(45deg); background: #C8102E; }
    .spb-hamburger.is-open .spb-hamburger-icon::after { top: 0; transform: rotate(-45deg); background: #C8102E; }

    .spb-mobile-menu {
      display: flex; flex-direction: column; align-items: center;
      top: 100%; left: 0; right: 0;
      background: #000;
      border-top: 1px solid rgba(200,16,46, 0.15);
      max-height: 0; overflow: hidden;
      transition: max-height 0.35s ease, padding 0.35s ease;
      padding: 0 16px;
      z-index: 9998;
    }
    .spb-mobile-menu.is-open { max-height: 400px; padding: 14px 16px 18px; }
    .spb-mobile-link {
      font-size: 14px; font-weight: 600;
      color: #fff; text-decoration: none;
      letter-spacing: 0.05em; text-transform: uppercase;
      padding: 12px 0; width: 100%; text-align: center;
      transition: color 0.3s ease;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .spb-mobile-link:last-child { border-bottom: none; }
    .spb-mobile-link:hover, .spb-mobile-link:active { color: #C8102E; }

    /* Press strip mobile */
    .spb-press { padding: 8px 0 !important; min-height: 32px !important; }
    .spb-press-track-outer { height: 16px; }
    .spb-press-track { height: 16px; }
    .spb-press-item { padding: 0 18px; }
    .spb-press-logo { height: 16px !important; max-width: 80px !important; }
    .spb-press-track-outer::before, .spb-press-track-outer::after { width: 40px; }
  }
</style>

