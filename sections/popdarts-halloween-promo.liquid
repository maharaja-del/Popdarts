{%- comment -%}
  Seasonal campaign card: the artwork at full width, unobstructed, with a
  slim dark bar under it (label, one-line headline, button). No text is
  ever drawn over the picture. Image: picker → URL (Shopify-CDN URLs get
  a responsive srcset) → bundled asset fallback.
{%- endcomment -%}
{%- assign hw_srcset = '' -%}
{%- if section.settings.image -%}
  {%- assign hw_src = section.settings.image | image_url: width: 2000 -%}
  {%- capture hw_srcset -%}{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w{%- endcapture -%}
{%- elsif section.settings.image_url != blank -%}
  {%- assign hw_src = section.settings.image_url -%}
  {%- if hw_src contains 'cdn.shopify.com' -%}
    {%- if hw_src contains '?' -%}{%- assign sep = '&' -%}{%- else -%}{%- assign sep = '?' -%}{%- endif -%}
    {%- capture hw_srcset -%}{{ hw_src }}{{ sep }}width=800 800w, {{ hw_src }}{{ sep }}width=1200 1200w, {{ hw_src }}{{ sep }}width=1600 1600w, {{ hw_src }}{{ sep }}width=2000 2000w{%- endcapture -%}
  {%- endif -%}
{%- else -%}
  {%- assign hw_src = 'pd-hw-table.jpg' | asset_url -%}
{%- endif -%}

<section class="pd-page hw-promo" id="hw-promo-{{ section.id }}" aria-labelledby="hw-promo-title-{{ section.id }}">
  <div class="pd-wrap">
    <div class="hw-card is-auto" data-hw-card>
      <a class="hw-card__media" href="{{ section.settings.cta_link | default: '/pages/pro-pack-halloween' }}" aria-hidden="true" tabindex="-1">
        <img src="{{ hw_src }}" alt="" loading="lazy" decoding="async"
          {%- if hw_srcset != blank %} srcset="{{ hw_srcset }}" sizes="(max-width: 1440px) 100vw, 1400px"{% endif %}>
        <span class="hw-card__vignette"></span>
        <span class="hw-card__light"></span>
        <span class="hw-card__flash"></span>
      </a>

      <div class="hw-card__bar">
        <div class="hw-card__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="hw-card__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 id="hw-promo-title-{{ section.id }}" style="color: #fdfdfd !important;">
            {{ section.settings.heading | default: 'Something Wicked' }}
            {%- if section.settings.heading_accent != blank %} <span class="hw-card__accent">{{ section.settings.heading_accent }}</span>{% endif -%}
          </h2>
          {%- if section.settings.body != blank -%}
            <p class="hw-card__body">{{ section.settings.body }}</p>
          {%- endif -%}
        </div>
        <div class="hw-card__cta">
          <a class="btn btn--lg hw-card__btn" href="{{ section.settings.cta_link | default: '/pages/pro-pack-halloween' }}">{{ section.settings.cta_text | default: 'Shop the Halloween Sale' }}</a>
          {%- if section.settings.end_date != blank -%}
            <span class="hw-card__note" data-hw-countdown data-end="{{ section.settings.end_date }}" data-ended="{{ section.settings.note | default: 'While supplies last' | escape }}">
              <span>Sale ends in</span> <strong data-hw-countdown-value>—</strong>
            </span>
          {%- elsif section.settings.note != blank -%}
            <span class="hw-card__note">{{ section.settings.note }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Halloween Promo",
  "tag": "section",
  "class": "pd-section-hw-promo",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "image_url",
      "label": "Image URL",
      "info": "Used if Image is empty."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "Limited Edition · Halloween"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Something Wicked"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Headline, orange part",
      "default": "This Way Throws."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "One line (optional)",
      "info": "Leave empty to keep it to a headline and button."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop the Halloween Sale"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Defaults to /pages/pro-pack-halloween"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Countdown end (date/time)",
      "info": "e.g. 2026-11-01T00:00 — shows a live \"Sale ends in\" countdown under the button. Leave empty to show the note instead.",
      "default": "2026-11-01T00:00"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the button",
      "info": "Shown when there's no countdown, or once the countdown has ended.",
      "default": "While supplies last"
    }
  ],
  "presets": [
    {
      "name": "Halloween Promo"
    }
  ]
}
{% endschema %}
