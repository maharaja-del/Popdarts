less hype.<\/p><p>Closest to the Target Marker: 3 points<br\/>Every other Popdart that sticks: 1 point<br\/>Use cancellation scoring like cornhole.<\/p><p>Example: Player A scores 6 points. Player B scores 4 points. Player A takes the round with 2 points. First to 21 wins. Going over is allowed!<\/p><p><strong>What’s Inside: 📦<\/strong><br\/>3 Elite Popdarts® in blue (Player 1)<br\/>3 Elite Popdarts® in green (Player 2)<br\/>1 Elite Target Marker™<br\/>1 Carrying Bag with built-in ruler and game rules<\/p>","page":"","default_open":true}},"collapsible_tab_CyXkFT":{"type":"collapsible_tab","settings":{"heading":"SHIPPING & RETURNS","icon":"package","content":"<ul><li><strong>All Popdarts® orders ship next business day. <\/strong><\/li><li>Standard shipping in the USA takes 3-5 business days.<\/li><li>Returns are easy. Simply contact us at <a href=\"mailto:support@popdartsgame.com\" target=\"_blank\" title=\"mailto:support@popdartsgame.com\">support@popdartsgame.com<\/a>.<\/li><\/ul>","page":"","default_open":false}}},"block_order":["title","badges","judge_me_reviews_preview_badge_BRBtLa","variant_picker","price_mfgW3j","buy_buttons","custom_liquid_AMhnr9","collapsible_tab_eYWtfb","collapsible_tab_CyXkFT"],"settings":{"color_scheme":"scheme-9","enable_sticky_info":true,"media_size":"small","gallery_layout":"carousel","mobile_thumbnails":"hide","enable_image_zoom":true,"enable_video_looping":true,"padding_top":0,"padding_bottom":0,"enable_variant_gallery":false}},"ss_product_vidoes_nPLQAN":{"type":"ss-product-vidoes","blocks":{"video_WxCwqK":{"type":"video","settings":{"video":"shopify:\/\/files\/videos\/06_Elite - unboxing_Elite - unboxing only.mp4","video_url":"","modal_heading":"","modal_text":"","label":"<p>Elite Unboxing<\/p>"}},"video_rDJUD6":{"type":"video","settings":{"video":"shopify:\/\/files\/videos\/05_Elite - First to 11 on the new elite set.mp4","video_url":"","modal_heading":"","modal_text":"","label":"<p>Elite in action<\/p>"}},"video_yBaRaa":{"type":"v