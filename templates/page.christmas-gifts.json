    "faq": {
      "type": "popdarts-xm-faq",
      "settings": {},
      "blocks": {
        "sale": {
          "type": "faq",
          "settings": {
            "question": "What's on sale — and do I need a code?",
            "answer": "<p>Eligible products on this page show their Christmas price and saving, and that's the price you pay — no code needed. It isn't a sitewide sale: only products showing a saving here are included. Taxes and shipping are calculated at checkout.</p>",
            "anchor": "",
            "show_in": "not_after"
          }
        },
        "ended": {
          "type": "faq",
          "settings": {
            "question": "Is Christmas pricing still on?",
            "answer": "<p>The Christmas sale has ended, so prices are back to regular. <a href=\"/collections/all\">Shop every Popdarts game</a>.</p>",
            "anchor": "",
            "show_in": "after"
          }
        },
        "arrive": {
          "type": "faq",
          "settings": {
            "question": "Will my gift arrive in time?",
            "answer": "<p>Orders are processed within 1–2 business days (excluding weekends and holidays) and ship with tracking. You'll see the shipping options and rates for your address at checkout — the earlier you order, the more time your gift has to arrive. See our <a href=\"/policies/shipping-policy\">Shipping Policy</a>.</p>",
            "anchor": "",
            "show_in": "all"
          }
        },
        "returns": {
          "type": "faq",
          "settings": {
            "question": "Can a gift be returned?",
            "answer": "<p>Full-price items can be returned within 30 days if unused and in the original packaging. Sale items and gift cards are final sale. If something arrives damaged, defective or wrong, email <a href=\"mailto:Support@popdartsgame.com\">Support@popdartsgame.com</a> right away so we can make it right. See our <a href=\"/policies/refund-policy\">Refund Policy</a>.</p>",
            "anchor": "",
            "show_in": "all"
          }
        },
        "giftcard": {
          "type": "faq",
          "settings": {
            "question": "Not sure what they'd like?",
            "answer": "<p>The Popdarts e-gift card arrives as an instant code by email, so it's the fastest gift on the page. Gift cards aren't discounted and can't be returned.</p>",
            "anchor": "",
            "show_in": "all"
          }
        },
        "excluded": {
          "type": "faq",
          "settings": {
            "question": "Is anything excluded?",
            "answer": "<p>Yes. Elite products and gift cards are never discounted, and slightly used or returned items aren't part of this sale.</p>",
            "anchor": "",
            "show_in": "all"
          }
        },
        "rookiepro": {
          "type": "faq",
          "settings": {
            "question": "Rookie or Pro?",
            "answer": "<p>Rookie for beginners and younger players — the Rookie Pack is made for ages 5 to 95. Pro for competitors — the Pro Pack adds the PRO Target Marker™, where landing on top scores 10. Both packs come with 6 Popdarts (3 per player), a Target Marker, a carrying bag with the rules and a built-in ruler, and stickers.</p>",
            "anchor": "",
            "show_in": "all"
          }
        },
        "play": {
          "type": "faq",
          "settings": {
            "question": "Where can we play?",
            "answer": "<p>Anywhere with a smooth surface — glass, windows, countertops, even the fridge — indoors or out. Popdarts are suction cups, so they won't stick to textured or porous surfaces like wood.</p>",
            "anchor": "",
            "show_in": "all"
          }
        },
        "score": {
          "type": "faq",
          "settings": {
            "question": "How does scoring work?",
            "answer": "<p>The closest Popdart to the Target Marker scores 3 points, and every other Popdart that sticks scores 1. Land on top of the PRO Target Marker™ (in the Pro Pack) for 10. It's cancellation scoring, like cornhole — first to 21 wins, and going over is allowed. <a href=\"/pages/play\">Full rules</a></p>",
            "anchor": "",
            "show_in": "all"
          }
        }
      },
