{% doc %}
  @prompt
    a cool looking bar that shows our Support Email support@popdartsgame.com
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-support-email-bar-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-support-email-bar__content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.gap }}px;
    position: relative;
    z-index: 2;
  }

  .ai-support-email-bar__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-support-email-bar__text-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-support-email-bar__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: {{ block.settings.label_weight }};
    color: {{ block.settings.label_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-support-email-bar__email-{{ ai_gen_id }} {
    font-size: {{ block.settings.email_size }}px;
    font-weight: {{ block.settings.email_weight }};
    color: {{ block.settings.email_color }};
    text-decoration: none;
    transition: color 0.3s ease;
    line-height: 1.2;
  }

  .ai-support-email-bar__email-{{ ai_gen_id }}:hover {
    color: {{ block.settings.email_hover_color }};
  }

  .ai-support-email-bar__background-effect-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: {{ block.settings.effect_opacity }};
    pointer-events: none;
    z-index: 1;
  }

  .ai-support-email-bar__gradient-{{ ai_gen_id }} {
    position: absolute;
    width: 200%;
    height: 200%;
    top: -50%;
    left: -50%;
    background: linear-gradient(
      45deg,
      {{ block.settings.gradient_color_1 }} 0%,
      {{ block.settings.gradient_color_2 }} 50%,
      {{ block.settings.gradient_color_1 }} 100%
    );
    animation: ai-support-email-bar-gradient-{{ ai_gen_id }} 8s ease infinite;
  }

  @keyframes ai-support-email-bar-gradient-{{ ai_gen_id }} {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(-25%, -25%) rotate(180deg);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-support-email-bar__content-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
      text-align: {{ block.settings.mobile_text_align }};
    }

    .ai-support-email-bar__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-support-email-bar__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }

    .ai-support-email-bar__email-{{ ai_gen_id }} {
      font-size: {{ block.settings.email_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<support-email-bar-{{ ai_gen_id }}
  class="ai-support-email-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.show_background_effect %}
    <div class="ai-support-email-bar__background-effect-{{ ai_gen_id }}">
      <div class="ai-support-email-bar__gradient-{{ ai_gen_id }}"></div>
    </div>
  {% endif %}

  <div class="ai-support-email-bar__content-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <div class="ai-support-email-bar__icon-{{ ai_gen_id }}">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </div>
    {% endif %}

    <div class="ai-support-email-bar__text-wrapper-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <div class="ai-support-email-bar__label-{{ ai_gen_id }}">
          {{ block.settings.label }}
        </div>
      {% endif %}

      <a
        href="mailto:{{ block.settings.email }}"
        class="ai-support-email-bar__email-{{ ai_gen_id }}"
      >
        {{ block.settings.email }}
      </a>
    </div>
  </div>
</support-email-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class SupportEmailBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const emailLink = this.querySelector('.ai-support-email-bar__email-{{ ai_gen_id }}');
        if (emailLink) {
          emailLink.setAttribute('aria-label', 'Send email to support');
        }
      }
    }

    customElements.define('support-email-bar-{{ ai_gen_id }}', SupportEmailBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
