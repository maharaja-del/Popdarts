<script>
(function() {
  var sectionId = '{{ section.id }}';
  var pfx = '.j4vs-' + sectionId;
  var root = document.querySelector('.j4vs-' + sectionId);
  if (!root) return;

  var cards     = root.querySelectorAll('[data-video-index]');
  var cardVideos = root.querySelectorAll('.j4vs-' + sectionId + '-card video');

  /* Autoplay on scroll */
  var playObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      var v = entry.target;
      if (entry.isIntersecting) v.play().catch(function(){});
      else v.pause();
    });
  }, { threshold: 0.1 });

  cardVideos.forEach(function(v) {
    playObserver.observe(v);
    v.play().catch(function(){});
  });

  /* Animated stats */
  var stats = root.querySelectorAll('[data-count-to]');
  function animateCount(el) {
    var target   = parseFloat(el.dataset.countTo);
    var divisor  = parseFloat(el.dataset.divisor)  || 1;
    var suffix   = el.dataset.suffix  || '';
    var decimals = parseInt(el.dataset.decimals || '0', 10);
    var duration = 1800;
    var start    = performance.now();
    (function step(now) {
      var t = Math.min(1, (now - start) / duration);
      var e = 1 - Math.pow(1 - t, 3);
      var num = (target * e) / divisor;
      el.textContent = (decimals ? num.toFixed(decimals) : Math.round(num)) + suffix;
      if (t < 1) requestAnimationFrame(step);
    })(start);
  }
  var statObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) { animateCount(entry.target); statObs.unobserve(entry.target); }
    });
  }, { threshold: 0.5 });
  stats.forEach(function(s) { statObs.observe(s); });

  /* Modal */
  var modal       = root.querySelector('[data-modal]');
  var modalVideo  = root.querySelector('[data-modal-video]');
  var modalMute   = root.querySelector('[data-modal-mute]');
  var modalClose  = root.querySelector('[data-modal-close]');
  var modalPrev   = root.querySelector('[data-modal-prev]');
  var modalNext   = root.querySelector('[data-modal-next]');
  var modalCounter = root.querySelector('[data-modal-counter]');
  var videoSrcs   = Array.from(cards).map(function(c) { return c.querySelector('video').src; });
  var currentIndex = 0;

  cards.forEach(function(card) {
    card.addEventListener('click', function() { openModal(parseInt(card.dataset.videoIndex, 10)); });
  });

  function openModal(index) {
    currentIndex = index;
    loadModalVideo();
    document.body.style.overflow = 'hidden';
    modal.classList.add('is-open');
  }
  function closeModal() {
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    modalVideo.pause();
    modalVideo.removeAttribute('src');
    modalVideo.load();
  }
  function loadModalVideo() {
    modalVideo.src = videoSrcs[currentIndex];
    modalVideo.muted = !modalMute.classList.contains('is-on');
    modalVideo.load();
    modalVideo.play().catch(function(){});
    modalCounter.textContent = (currentIndex + 1) + ' / ' + videoSrcs.length;
    modalPrev.disabled = currentIndex === 0;
    modalNext.disabled = currentIndex === videoSrcs.length - 1;
  }

  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  modalPrev.addEventListener('click', function() { if (currentIndex > 0) { currentIndex--; loadModalVideo(); } });
  modalNext.addEventListener('click', function() { if (currentIndex < videoSrcs.length - 1) { currentIndex++; loadModalVideo(); } });
  modalMute.addEventListener('click', function() {
    modalMute.classList.toggle('is-on');
    modalVideo.muted = !modalMute.classList.contains('is-on');
  });
  document.addEventListener('keydown', function(e) {
    if (!modal.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft' && currentIndex > 0) { currentIndex--; loadModalVideo(); }
    if (e.key === 'ArrowRight' && currentIndex < videoSrcs.length - 1) { currentIndex++; loadModalVideo(); }
  });

  /* Move modal to body to escape theme containers */
  if (modal && modal.parentElement !== document.body) document.body.appendChild(modal);
})();
</script>

