<footer class="pd-page pd-footer" role="contentinfo">
  <div class="pd-wrap">
    <div class="pd-footer__grid">
      <div>
        <p class="pd-footer__brand">POPDARTS<span class="pd-footer__brand-dot">.</span></p>
        <p class="pd-footer__tagline">{{ section.settings.tagline | default: 'Three darts. One target. Become the Popdarts Champion.' }}</p>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_column' -%}
          <div {{ block.shopify_attributes }}>
            <p class="pd-footer__heading">{{ block.settings.heading | default: 'Shop' }}</p>
            <div class="pd-footer__links">
              {%- for i in (1..4) -%}
                {%- assign link_text_key = 'link_' | append: i | append: '_text' -%}
                {%- assign link_url_key = 'link_' | append: i | append: '_url' -%}
                {%- assign link_text = block.settings[link_text_key] -%}
                {%- if link_text != blank -%}
                  <a href="{{ block.settings[link_url_key] | default: '#' }}">{{ link_text }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="pd-footer__bottom">
      <span>{{ section.settings.copyright | default: '© 2026 Popdarts. All rights reserved.' }}</span>
      <div class="pd-footer__social">
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.tiktok_url != blank -%}
          <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M16.6 5.2c-.9-.8-1.4-2-1.4-3.2h-3.1v13.6c0 1.4-1.1 2.5-2.5 2.5s-2.5-1.1-2.5-2.5 1.1-2.5 2.5-2.5c.3 0 .5 0 .8.1v-3.2c-.3 0-.5-.1-.8-.1-3.1 0-5.6 2.5-5.6 5.6s2.5 5.6 5.6 5.6 5.6-2.5 5.6-5.6V9c1.2.9 2.7 1.4 4.2 1.4V7.3c-.9 0-1.9-.3-2.8-1z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.youtube_url != blank -%}
          <a href="{{ section.settings.youtube_url }}" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="5.5" width="19" height="13" rx="3"/><path d="M10.5 9.5l5 2.5-5 2.5z" fill="currentColor" stroke="none"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Prodigy Footer",
  "tag": "footer",
  "class": "pd-section-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Three darts. One target. Become the Popdarts Champion."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "default": "© 2026 Popdarts. All rights reserved."
    },
    {
      "type": "header",
      "content": "Social links (leave blank to hide)"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Column heading", "default": "Shop" },
        { "type": "text", "id": "link_1_text", "label": "Link 1 text" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_text", "label": "Link 2 text" },
        { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_text", "label": "Link 3 text" },
        { "type": "url", "id": "link_3_url", "label": "Link 3 URL" },
        { "type": "text", "id": "link_4_text", "label": "Link 4 text" },
        { "type": "url", "id": "link_4_url", "label": "Link 4 URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prodigy Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "heading": "Shop",
            "link_1_text": "Rookie Pack", "link_1_url": "/products/rookie-pack",
            "link_2_text": "Pro Pack", "link_2_url": "/products/pro-pack",
            "link_3_text": "Swaptop Kit", "link_3_url": "/products/swaptop-kit"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Learn",
            "link_1_text": "How to Play", "link_1_url": "#experience",
            "link_2_text": "FAQ", "link_2_url": "#faq-list"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Support",
            "link_1_text": "Contact Us", "link_1_url": "mailto:support@popdartsgame.com",
            "link_2_text": "Shipping & Returns", "link_2_url": "/pages/shipping"
          }
        }
      ]
    }
  ]
}
{% endschema %}
