<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<style>
.hiw4-swiper-wrapper-fix {
  margin-top: 10px !important;
}
.hiw4-step-number, .hiw4-pagination { display: none !important; }

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

/* ═══════════════════════════
   SHELL
═══════════════════════════ */
.hiw4-section {
  font-family: 'Inter', sans-serif;
  padding: 70px 20px;
  background: #010A1E;
  overflow: hidden;
  position: relative;
}

/* Red/White/Blue top stripe */
.hiw4-section::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, #B22234 33%, #fff 33%, #fff 66%, #002868 66%);
}

/* Subtle star-grid overlay */
.hiw4-section::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.016) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.016) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
  pointer-events: none;
  z-index: 0;
}

.hiw4-container {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* ═══════════════════════════
   HEADER
═══════════════════════════ */
.hiw4-header {
  text-align: center;
  margin-bottom: 56px;
}

/* July 4th eyebrow badge */
.hiw4-eyebrow-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 16px;
}
.hiw4-eyebrow-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #8B0000, #B22234 50%, #8B0000);
  color: #fff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  padding: 7px 18px;
  border-radius: 4px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(178,34,52,0.4);
}
.hiw4-eyebrow-badge::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
  animation: hiw4Sheen 3s ease-in-out infinite;
}
@keyframes hiw4Sheen { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
.hiw4-eyebrow-star { color: #FFD60A; font-size: 12px; filter: drop-shadow(0 0 4px rgba(255,215,0,0.8)); }

.hiw4-title {
  font-size: 52px;
  font-weight: 900;
  margin: 0 0 16px;
  color: #ffffff;
  letter-spacing: -0.03em;
  line-height: 1;
}

/* "HOW IT WORKS" — animate the words */
.hiw4-title .hiw4-accent { color: #B22234; }

.hiw4-subtitle {
  font-size: 16px;
  color: rgba(255,255,255,0.55);
  font-weight: 500;
  max-width: 650px;
  margin: 0 auto;
  line-height: 1.6;
}

/* ═══════════════════════════
   SWIPER CONTAINER
═══════════════════════════ */
.hiw4-swiper-container {
  padding-bottom: 60px;
  position: relative;
}
.hiw4-swiper-container .swiper-slide {
  height: auto;
  position: relative;
}

/* Patriotic curved arrows between slides — red instead of green */
.hiw4-swiper-container .swiper-slide::after {
  content: '';
  position: absolute;
  right: -44px;
  top: 35%;
  transform: translateY(-50%);
  width: 70px;
  height: 60px;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 70 60' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M8 30 Q 35 15, 62 30' stroke='%23B22234' stroke-width='3.5' fill='none' stroke-linecap='round'/%3E%3Cpath d='M56 25 L62 30 L56 35' stroke='%23B22234' stroke-width='3.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  z-index: 50;
  pointer-events: none;
}
.hiw4-swiper-container .swiper-slide:nth-child(even)::after {
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 70 60' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M8 30 Q 35 45, 62 30' stroke='%23B22234' stroke-width='3.5' fill='none' stroke-linecap='round'/%3E%3Cpath d='M56 25 L62 30 L56 35' stroke='%23B22234' stroke-width='3.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
}
.hiw4-swiper-container .swiper-slide:last-child::after { display: none; }
@media (max-width: 768px) {
  .hiw4-swiper-container .swiper-slide::after { display: none; }
}

/* ═══════════════════════════
   STEP CARDS
═══════════════════════════ */
.hiw4-step {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s ease;
}
.hiw4-step:hover {
  transform: translateY(-6px);
  z-index: 10;
}

/* Step number badge — navy with gold star */
.hiw4-step-number {
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #002868;
  color: #FFD60A;
  font-size: 18px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  border: 4px solid #010A1E;
  transition: all 0.3s ease;
  pointer-events: none;
  box-shadow: 0 0 0 2px rgba(178,34,52,0.4);
}
.hiw4-step:hover .hiw4-step-number {
  background: #B22234;
  color: #fff;
  box-shadow: 0 0 0 2px rgba(178,34,52,0.8), 0 0 20px rgba(178,34,52,0.4);
}

/* Image container — dark navy card with patriotic hover */
.hiw4-image-container {
  width: 100%;
  aspect-ratio: 1;
  background: #fff;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  margin-bottom: 20px;
  border: 3px solid rgba(255,255,255,0.08);
  transition: all 0.3s ease;
  overflow: hidden;
  position: relative;
  z-index: 1;
}
.hiw4-step:hover .hiw4-image-container {
  border-color: #B22234;
  box-shadow: 0 12px 32px rgba(178,34,52,0.2);
}
.hiw4-image-container img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.3s ease;
}
.hiw4-step:hover .hiw4-image-container img { transform: scale(1.05); }

/* Step number overlay inside image on hover */
.hiw4-step-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #002868;
  color: #FFD60A;
  font-size: 14px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid rgba(255,255,255,0.3);
  z-index: 5;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
}

/* Step content */
.hiw4-step-content {
  text-align: center;
  padding: 0 8px;
}
.hiw4-step-title {
  font-size: 17px;
  font-weight: 900;
  color: #ffffff;
  margin: 0 0 10px;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.2;
}
.hiw4-step-desc {
  font-size: 14px;
  color: rgba(255,255,255,0.5);
  line-height: 1.6;
  margin: 0;
  font-weight: 500;
}

/* ═══════════════════════════
   PAGINATION — red pill
═══════════════════════════ */
.hiw4-swiper-container .swiper-pagination-bullet {
  width: 10px;
  height: 10px;
  background: rgba(255,255,255,0.15);
  opacity: 1;
  transition: all 0.3s ease;
}
.hiw4-swiper-container .swiper-pagination-bullet-active {
  background: #B22234;
  width: 32px;
  border-radius: 5px;
}

/* ═══════════════════════════
   RESPONSIVE
═══════════════════════════ */
@media (max-width: 480px) {
  .hiw4-section    { padding: 40px 16px; }
  .hiw4-header     { margin-bottom: 36px; }
  .hiw4-eyebrow-badge { font-size: 9px; padding: 6px 12px; letter-spacing: 0.22em; }
  .hiw4-title      { font-size: 28px; }
  .hiw4-subtitle   { font-size: 14px; }
  .hiw4-swiper-container { padding-bottom: 50px; }
  .hiw4-step-number { width: 36px; height: 36px; font-size: 16px; border-width: 3px; }
  .hiw4-image-container { padding: 16px; margin-bottom: 16px; border-width: 2px; border-radius: 16px; }
  .hiw4-step-title { font-size: 15px; margin-bottom: 8px; }
  .hiw4-step-desc  { font-size: 13px; line-height: 1.5; }
  .hiw4-step-content { padding: 0 6px; }
}

@media (min-width: 481px) and (max-width: 768px) {
  .hiw4-section    { padding: 50px 16px; }
  .hiw4-header     { margin-bottom: 40px; }
  .hiw4-eyebrow-badge { font-size: 10px; }
  .hiw4-title      { font-size: 36px; }
  .hiw4-subtitle   { font-size: 15px; }
  .hiw4-step-number { width: 38px; height: 38px; font-size: 17px; }
  .hiw4-image-container { padding: 18px; border-radius: 18px; }
  .hiw4-step-title { font-size: 15px; margin-bottom: 8px; }
  .hiw4-step-desc  { font-size: 13px; line-height: 1.5; }
  .hiw4-step-content { padding: 0 6px; }
}

@media (min-width: 769px) and (max-width: 1024px) {
  .hiw4-section  { padding: 60px 20px; }
  .hiw4-title    { font-size: 44px; }
  .hiw4-step-title { font-size: 16px; margin-bottom: 9px; }
  .hiw4-step-desc { font-size: 13px; line-height: 1.55; }
}
</style>

<section class="hiw4-section">
  <div class="hiw4-container">

    <!-- HEADER -->
    <div class="hiw4-header">
      <div class="hiw4-eyebrow-wrap">
        <div class="hiw4-eyebrow-badge">
          <span class="hiw4-eyebrow-star">★</span>
          July 4th · Independence Day
          <span class="hiw4-eyebrow-star">★</span>
        </div>
      </div>
      <h2 class="hiw4-title">HOW IT <span class="hiw4-accent">WORKS</span></h2>
    </div>

    <!-- SWIPER -->
    <div class="hiw4-swiper-container swiper">
      <div class="swiper-wrapper hiw4-swiper-wrapper-fix">

        <!-- Step 1 -->
        <div class="swiper-slide">
          <div class="hiw4-step">
            <div class="hiw4-step-number">1</div>
            <div class="hiw4-image-container">
              <div class="hiw4-step-badge">1</div>
              <img src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/step_1.jpg?v=1757453870" alt="Frame It" loading="lazy">
            </div>
            <div class="hiw4-step-content">
              <h3 class="hiw4-step-title">1. Frame It</h3>
              <p class="hiw4-step-desc">Set up your Swaptop™ frame.</p>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="swiper-slide">
          <div class="hiw4-step">
            <div class="hiw4-step-number">2</div>
            <div class="hiw4-image-container">
              <div class="hiw4-step-badge">2</div>
              <img src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/STEP_2.jpg?v=1757453871" alt="Clip It" loading="lazy">
            </div>
            <div class="hiw4-step-content">
              <h3 class="hiw4-step-title">2. Clip It</h3>
              <p class="hiw4-step-desc">Center the board on the bottom frame, then clip into the top frame.</p>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="swiper-slide">
          <div class="hiw4-step">
            <div class="hiw4-step-number">3</div>
            <div class="hiw4-image-container">
              <div class="hiw4-step-badge">3</div>
              <img src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/STEP_3.jpg?v=1757453871" alt="Play It" loading="lazy">
            </div>
            <div class="hiw4-step-content">
              <h3 class="hiw4-step-title">3. Play It</h3>
              <p class="hiw4-step-desc">Play and keep score with the built-in scorekeepers.</p>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="swiper-slide">
          <div class="hiw4-step">
            <div class="hiw4-step-number">4</div>
            <div class="hiw4-image-container">
              <div class="hiw4-step-badge">4</div>
              <img src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/STEP_4.jpg?v=1758731692" alt="Swap It" loading="lazy">
            </div>
            <div class="hiw4-step-content">
              <h3 class="hiw4-step-title">4. Swap It</h3>
              <p class="hiw4-step-desc">Unclip the top frame and flip the board.</p>
            </div>
          </div>
        </div>

        <!-- Step 5 -->
        <div class="swiper-slide">
          <div class="hiw4-step">
            <div class="hiw4-step-number">5</div>
            <div class="hiw4-image-container">
              <div class="hiw4-step-badge">5</div>
              <img src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/STEP_5.jpg?v=1757453871" alt="Repeat It" loading="lazy">
            </div>
            <div class="hiw4-step-content">
              <h3 class="hiw4-step-title">5. Repeat It</h3>
              <p class="hiw4-step-desc">Clip in the top frame and keep playing!</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Pagination -->
      <div class="swiper-pagination hiw4-pagination"></div>
    </div>

  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
new Swiper('.hiw4-swiper-container', {
  slidesPerView: 1.2,
  spaceBetween: 16,
  centeredSlides: false,
  loop: false,
  pagination: {
    el: '.hiw4-swiper-container .swiper-pagination',
    clickable: true,
  },
  breakpoints: {
    480:  { slidesPerView: 1.8, spaceBetween: 18 },
    640:  { slidesPerView: 2.2, spaceBetween: 20 },
    768:  { slidesPerView: 2.5, spaceBetween: 22 },
    1024: { slidesPerView: 3.5, spaceBetween: 24 },
    1280: { slidesPerView: 4.2, spaceBetween: 24 },
    1400: { slidesPerView: 5,   spaceBetween: 24 }
  }
});
</script>
