{% comment %}
  Swaptop Bundle List — v5
  sections/swaptop-bundle-list.liquid
{% endcomment %}

{% assign main_product   = all_products['swaptop-kit'] %}
{% assign addon_football = all_products['swaptop-football'] %}
{% assign addon_og       = all_products['swaptop-og'] %}
{% assign addon_popgolf  = all_products['swaptop-popgolf'] %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  .bbl *, .bbl *::before, .bbl *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .bbl {
    font-family: 'Inter', sans-serif;
    background: #fafafa;
    padding: 56px 24px 48px;
  }

  .bbl-inner { max-width: 1080px; margin: 0 auto; }

  /* ─── HEADER ─── */
  .bbl-header { text-align: center; margin-bottom: 40px; }

  .bbl-header__eyebrow {
    font-size: 11px; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: #16a34a; margin-bottom: 8px;
  }

  .bbl-header__title {
    font-size: clamp(24px, 3.6vw, 34px); font-weight: 800; color: #111;
    letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 6px;
  }

  .bbl-header__sub {
    font-size: 14px; color: #888; line-height: 1.55;
    max-width: 380px; margin: 0 auto;
  }

  /* ─── GRID ─── */
  .bbl-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 32px;
  }

  /* ─── CARD ─── */
  .bbl-card {
    background: #fff; border: 1.5px solid #ebebeb; border-radius: 14px;
    overflow: hidden; cursor: pointer; user-select: none; position: relative;
    display: flex; flex-direction: column;
    transition: border-color 0.2s, box-shadow 0.25s;
  }
  .bbl-card:hover { border-color: #ccc; box-shadow: 0 4px 16px rgba(0,0,0,0.05); }
  .bbl-card.selected { border-color: #22c55e; box-shadow: 0 0 0 1.5px #22c55e, 0 4px 20px rgba(34,197,94,0.1); }
  .bbl-card.locked { cursor: default; }

  .bbl-card__check {
    position: absolute; top: 10px; left: 10px; width: 22px; height: 22px;
    border-radius: 6px; border: 1.5px solid #d4d4d4; background: #fff;
    display: flex; align-items: center; justify-content: center; z-index: 2;
    transition: border-color 0.2s, background 0.2s;
  }
  .bbl-card.selected .bbl-card__check { border-color: #22c55e; background: #22c55e; }
  .bbl-card__check svg { width: 12px; height: 12px; opacity: 0; transition: opacity 0.15s; }
  .bbl-card.selected .bbl-card__check svg { opacity: 1; }

  .bbl-card__badge {
    position: absolute; top: 10px; right: 10px; padding: 3px 8px; border-radius: 5px;
    background: #111; color: #fff; font-size: 9px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; z-index: 2;
  }

  .bbl-card__img-wrap {
    position: relative; width: 100%; aspect-ratio: 1/1;
    background: #f5f5f5; overflow: hidden;
  }
  .bbl-card__img {
    width: 100%; height: 100%; object-fit: contain; padding: 16px;
    transition: transform 0.35s ease;
  }
  .bbl-card:hover .bbl-card__img { transform: scale(1.04); }

  .bbl-card__qv {
    position: absolute; bottom: 10px; left: 50%;
    transform: translateX(-50%) translateY(4px); opacity: 0;
    padding: 6px 14px; border-radius: 6px; border: none; background: #111; color: #fff;
    font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600;
    letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer;
    transition: opacity 0.2s, transform 0.2s; white-space: nowrap; z-index: 3;
    pointer-events: none; visibility: hidden;
  }

  @media (hover: hover) and (min-width: 901px) {
    .bbl-card:hover .bbl-card__qv {
      opacity: 1; visibility: visible; pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
  }

  /* Mobile quick-view icon */
  .bbl-card__qv-icon {
    display: none;
  }

  @media (max-width: 900px) {
    .bbl-card__qv-icon {
      display: flex;
      position: absolute; top: 8px; right: 8px;
      width: 32px; height: 32px; min-width: 32px; min-height: 32px;
      border-radius: 8px; border: none; padding: 0;
      background: rgba(255,255,255,0.92);
      box-shadow: 0 1px 6px rgba(0,0,0,0.1);
      align-items: center; justify-content: center;
      cursor: pointer; z-index: 4;
      transition: background 0.2s;
    }
    .bbl-card__qv-icon:active { background: #fff; }
    .bbl-card__qv-icon svg {
      width: 16px !important; height: 16px !important;
      display: block; flex-shrink: 0;
    }
  }

  .bbl-card__body {
    padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 2px;
    border-top: 1px solid #f0f0f0;
  }
  .bbl-card__name {
    font-size: 13px; font-weight: 600; color: #222; line-height: 1.3;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .bbl-card__price { font-size: 12px; font-weight: 500; color: #999; }
  .bbl-card__price--inc { color: #16a34a; font-weight: 600; }

  /* ─── FOOTER ─── */
  .bbl-footer {
    background: #fff; border: 1.5px solid #ebebeb; border-radius: 16px;
    padding: 22px 28px; display: flex; align-items: center; gap: 24px;
  }

  .bbl-footer__info { flex: 1; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }

  .bbl-footer__total-wrap { display: flex; flex-direction: column; }
  .bbl-footer__total-label {
    font-size: 11px; font-weight: 600; color: #aaa;
    text-transform: uppercase; letter-spacing: 0.06em; line-height: 1; margin-bottom: 2px;
  }
  .bbl-footer__total {
    font-size: 28px; font-weight: 800; color: #111;
    letter-spacing: -0.02em; line-height: 1.1;
  }

  .bbl-footer__dot {
    width: 3px; height: 3px; border-radius: 50%; background: #ccc;
    flex-shrink: 0; align-self: center;
  }

  .bbl-footer__count { font-size: 13px; color: #999; font-weight: 500; padding-bottom: 4px; }

  .bbl-footer__actions { display: flex; gap: 10px; flex-shrink: 0; }

  .bbl-footer__cta {
    padding: 14px 32px; border-radius: 10px; background: #111; color: #fff;
    font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700;
    letter-spacing: 0.05em; text-transform: uppercase; border: none; cursor: pointer;
    transition: background 0.2s, transform 0.15s; white-space: nowrap;
  }
  .bbl-footer__cta:hover { background: #333; transform: translateY(-1px); }
  .bbl-footer__cta:active { transform: translateY(0); }
  .bbl-footer__cta.loading { opacity: 0.6; pointer-events: none; }

  .bbl-footer__atc {
    padding: 14px 24px; border-radius: 10px; background: transparent; color: #777;
    font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600;
    letter-spacing: 0.04em; text-transform: uppercase; border: 1.5px solid #ddd;
    cursor: pointer; transition: border-color 0.2s, color 0.2s, transform 0.15s;
    white-space: nowrap;
  }
  .bbl-footer__atc:hover { border-color: #111; color: #111; transform: translateY(-1px); }

  /* ───────────────────────────────
     POPUP
  ─────────────────────────────── */
  body.bbl-no-scroll { overflow: hidden !important; }

  .bbl-popup-wrap {
    position: fixed; inset: 0; z-index: 9998;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.25);
    opacity: 0; visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .bbl-popup-wrap.active { opacity: 1; visibility: visible; }

  .bbl-popup {
    position: relative;
    background: #fff; border-radius: 20px;
    box-shadow: 0 32px 100px rgba(0,0,0,0.22);
    width: 92vw; max-width: 820px; max-height: 88vh;
    overflow: hidden;
    transform: scale(0.96);
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1);
  }
  .bbl-popup-wrap.active .bbl-popup {
    transform: scale(1);
  }

  /* Close button */
  .bbl-popup__close {
    position: absolute; top: 16px; right: 16px;
    width: 36px; height: 36px; min-width: 36px; min-height: 36px;
    border-radius: 50%; border: none; padding: 0;
    background: rgba(255,255,255,0.9); backdrop-filter: blur(4px);
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    z-index: 5; transition: background 0.2s, transform 0.2s;
    box-shadow: 0 1px 6px rgba(0,0,0,0.1); flex-shrink: 0;
  }
  .bbl-popup__close:hover { background: #fff; transform: scale(1.05); }
  .bbl-popup__close svg { width: 16px !important; height: 16px !important; display: block; flex-shrink: 0; }

  .bbl-popup__layout {
    display: grid; grid-template-columns: 1.1fr 1fr; min-height: 440px;
  }

  /* Gallery */
  .bbl-popup__gallery {
    background: #f3f3f3; position: relative; display: flex;
    flex-direction: column; justify-content: center; align-items: center;
    padding: 28px; gap: 14px; overflow: hidden;
  }

  .bbl-popup__hero-wrap {
    position: relative; width: 100%; flex: 1;
    display: flex; align-items: center; justify-content: center;
  }

  .bbl-popup__hero {
    max-width: 100%; max-height: 340px; object-fit: contain;
    border-radius: 12px; transition: opacity 0.25s;
  }

  /* Arrows */
  .bbl-popup__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 38px; height: 38px; min-width: 38px; min-height: 38px;
    border-radius: 50%; border: none; padding: 0;
    background: rgba(255,255,255,0.92); backdrop-filter: blur(4px);
    box-shadow: 0 1px 8px rgba(0,0,0,0.1); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    z-index: 3; transition: background 0.2s, transform 0.2s; flex-shrink: 0;
  }
  .bbl-popup__arrow:hover { background: #fff; transform: translateY(-50%) scale(1.06); }
  .bbl-popup__arrow svg {
    width: 16px !important; height: 16px !important; display: block; flex-shrink: 0;
  }
  .bbl-popup__arrow--prev { left: 12px; }
  .bbl-popup__arrow--next { right: 12px; }
  .bbl-popup__arrow[disabled] { opacity: 0.3; pointer-events: none; }

  /* Thumbnails */
  .bbl-popup__thumbs {
    display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none;
    width: 100%; justify-content: center;
  }
  .bbl-popup__thumbs::-webkit-scrollbar { display: none; }

  .bbl-popup__thumb {
    width: 52px; height: 52px; flex-shrink: 0; object-fit: contain;
    border-radius: 8px; border: 2px solid transparent; background: #fff;
    cursor: pointer; padding: 4px; transition: border-color 0.2s;
  }
  .bbl-popup__thumb:hover { border-color: #ccc; }
  .bbl-popup__thumb.active { border-color: #111; }

  /* Counter pill */
  .bbl-popup__counter {
    position: absolute; bottom: 16px; right: 16px;
    background: rgba(0,0,0,0.55); color: #fff; font-size: 11px;
    font-weight: 600; padding: 4px 10px; border-radius: 20px;
    letter-spacing: 0.03em; z-index: 3;
  }

  /* Info panel */
  .bbl-popup__info {
    padding: 36px 32px; display: flex; flex-direction: column;
    gap: 14px; overflow-y: auto; max-height: 88vh;
  }

  .bbl-popup__name {
    font-size: 22px; font-weight: 800; color: #111;
    letter-spacing: -0.02em; line-height: 1.2;
  }

  .bbl-popup__price { font-size: 18px; font-weight: 700; color: #16a34a; }

  .bbl-popup__desc { font-size: 13px; color: #777; line-height: 1.65; }

  .bbl-popup__variants-label {
    font-size: 11px; font-weight: 700; color: #aaa;
    text-transform: uppercase; letter-spacing: 0.08em;
  }

  .bbl-popup__variants { display: flex; flex-wrap: wrap; gap: 8px; }

  .bbl-popup__vbtn {
    padding: 8px 16px; border-radius: 8px; border: 1.5px solid #e5e5e5;
    background: #fff; font-family: 'Inter', sans-serif; font-size: 13px;
    font-weight: 600; color: #333; cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .bbl-popup__vbtn:hover { border-color: #bbb; }
  .bbl-popup__vbtn.active { border-color: #111; background: #f8f8f8; color: #111; }
  .bbl-popup__vbtn:disabled { opacity: 0.3; cursor: not-allowed; text-decoration: line-through; }

  /* Action button (Add / Remove) */
  .bbl-popup__action {
    width: 100%; padding: 15px; border-radius: 10px; border: none;
    font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700;
    letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer;
    transition: background 0.2s, transform 0.15s; margin-top: auto;
  }
  .bbl-popup__action:hover { transform: translateY(-1px); }

  .bbl-popup__action--add { background: #22c55e; color: #fff; }
  .bbl-popup__action--add:hover { background: #16a34a; }

  .bbl-popup__action--remove { background: #fee2e2; color: #dc2626; }
  .bbl-popup__action--remove:hover { background: #fecaca; }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .bbl-row { grid-template-columns: repeat(2, 1fr); }
    .bbl-card__qv { display: none !important; }
    .bbl-footer { flex-direction: column; align-items: stretch; gap: 16px; }
    .bbl-footer__info { justify-content: center; }
    .bbl-footer__actions { flex-direction: column; }
    .bbl-footer__cta, .bbl-footer__atc { width: 100%; text-align: center; }
  }

    @media (min-width: 900px) {
h2.bbl-header__title
Specificity: (0,1,1)
 {
    font-size: 42px;
    font-weight: 900;
}
    }
  @media (max-width: 640px) {
    .bbl { padding: 40px 16px 40px; }
    .bbl-row { gap: 10px; }
    .bbl-card__img-wrap { aspect-ratio: 1/1; }
    .bbl-card__img { padding: 12px; }
    .bbl-card__body { padding: 10px 10px 12px; }
    .bbl-card__name { font-size: 12px; }
    .bbl-card__price { font-size: 11px; }
    .bbl-footer { padding: 20px; border-radius: 14px; }
    .bbl-footer__total { font-size: 24px; }

    .bbl-popup-wrap { padding: 0; background: rgba(0,0,0,0); }
    .bbl-popup { width: 100%; max-width: 100%; max-height: 100vh; height: 100vh; border-radius: 0; overflow: hidden; }
    .bbl-popup__close { top: 12px; right: 12px; z-index: 10; }

    .bbl-popup__layout {
      grid-template-columns: 1fr;
      height: 100vh;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 80px;
    }

    .bbl-popup__gallery {
      border-radius: 0;
      flex-shrink: 0;
      padding: 16px 16px 12px;
      gap: 10px;
      max-height: none;
      overflow: visible;
    }

    .bbl-popup__hero-wrap {
      flex: none;
      height: auto;
      min-height: 200px;
    }

    .bbl-popup__hero {
      max-height: 220px;
      width: 100%;
    }

    .bbl-popup__arrow {
      width: 32px; height: 32px; min-width: 32px; min-height: 32px;
    }
    .bbl-popup__arrow--prev { left: 6px; }
    .bbl-popup__arrow--next { right: 6px; }

    .bbl-popup__thumbs {
      justify-content: flex-start;
      gap: 6px;
      padding: 2px 0;
      flex-shrink: 0;
    }

    .bbl-popup__thumb {
      width: 48px; height: 48px; min-width: 48px;
      border-radius: 6px; padding: 3px;
    }

    .bbl-popup__counter { bottom: auto; top: 10px; right: 52px; }

    .bbl-popup__info {
      padding: 20px 20px 24px;
      max-height: none;
    }

    .bbl-popup__name { font-size: 18px; }
    .bbl-popup__price { font-size: 16px; }

    .bbl-popup__action {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      border-radius: 0;
      padding: 18px 20px;
      z-index: 10;
      margin: 0;
      box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
    }
  }

  @media (max-width: 380px) {
    .bbl-row { grid-template-columns: 1fr 1fr; gap: 8px; }
  }
</style>

<div class="bbl">
  <div class="bbl-inner">

    <div class="bbl-header">
      <p class="bbl-header__eyebrow">Limited Tops Deal</p>
      <h2 class="bbl-header__title">Build Your Tops &amp; Save</h2>
      <p class="bbl-header__sub">Pick the add-ons you want — the more you bundle, the more you save.</p>
    </div>

    <div class="bbl-row" id="bbl-row">

      <!-- 1 · Kit (locked) -->
      <div class="bbl-card selected locked" id="bbl-main">
        <span class="bbl-card__badge">Included</span>
        <div class="bbl-card__check"><svg viewBox="0 0 14 14" fill="none"><polyline points="2,7 6,11 12,3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div class="bbl-card__img-wrap">
          <img class="bbl-card__img" src="{{ main_product.featured_image | image_url: width: 600 }}" alt="{{ main_product.title }}">
          <button class="bbl-card__qv" type="button" data-handle="swaptop-kit" onclick="bblOpen(this);event.stopPropagation();">Quick View</button>
        </div>
        <div class="bbl-card__body">
          <span class="bbl-card__name">{{ main_product.title }}</span>
          <span class="bbl-card__price bbl-card__price--inc">Included</span>
        </div>
      </div>

      <!-- 2 · Football -->
      <div class="bbl-card" data-variant="{{ addon_football.first_available_variant.id }}" data-price="{{ addon_football.price }}" onclick="bblToggle(this)">
        <div class="bbl-card__check"><svg viewBox="0 0 14 14" fill="none"><polyline points="2,7 6,11 12,3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div class="bbl-card__img-wrap">
          <img class="bbl-card__img" src="{{ addon_football.featured_image | image_url: width: 600 }}" alt="{{ addon_football.title }}">
          <button class="bbl-card__qv" type="button" data-handle="swaptop-football" onclick="bblOpen(this);event.stopPropagation();">Quick View</button>
          <button class="bbl-card__qv-icon" type="button" data-handle="swaptop-football" onclick="bblOpen(this);event.stopPropagation();" aria-label="Quick View">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/></svg>
          </button>
        </div>
        <div class="bbl-card__body">
          <span class="bbl-card__name">{{ addon_football.title }}</span>
          <span class="bbl-card__price">+ {{ addon_football.price | money_without_trailing_zeros }}</span>
        </div>
      </div>

      <!-- 3 · OG -->
      <div class="bbl-card" data-variant="{{ addon_og.first_available_variant.id }}" data-price="{{ addon_og.price }}" onclick="bblToggle(this)">
        <div class="bbl-card__check"><svg viewBox="0 0 14 14" fill="none"><polyline points="2,7 6,11 12,3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div class="bbl-card__img-wrap">
          <img class="bbl-card__img" src="{{ addon_og.featured_image | image_url: width: 600 }}" alt="{{ addon_og.title }}">
          <button class="bbl-card__qv" type="button" data-handle="swaptop-og" onclick="bblOpen(this);event.stopPropagation();">Quick View</button>
          <button class="bbl-card__qv-icon" type="button" data-handle="swaptop-og" onclick="bblOpen(this);event.stopPropagation();" aria-label="Quick View">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/></svg>
          </button>
        </div>
        <div class="bbl-card__body">
          <span class="bbl-card__name">{{ addon_og.title }}</span>
          <span class="bbl-card__price">+ {{ addon_og.price | money_without_trailing_zeros }}</span>
        </div>
      </div>

      <!-- 4 · PopGolf -->
      <div class="bbl-card" data-variant="{{ addon_popgolf.first_available_variant.id }}" data-price="{{ addon_popgolf.price }}" onclick="bblToggle(this)">
        <div class="bbl-card__check"><svg viewBox="0 0 14 14" fill="none"><polyline points="2,7 6,11 12,3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div class="bbl-card__img-wrap">
          <img class="bbl-card__img" src="{{ addon_popgolf.featured_image | image_url: width: 600 }}" alt="{{ addon_popgolf.title }}">
          <button class="bbl-card__qv" type="button" data-handle="swaptop-popgolf" onclick="bblOpen(this);event.stopPropagation();">Quick View</button>
          <button class="bbl-card__qv-icon" type="button" data-handle="swaptop-popgolf" onclick="bblOpen(this);event.stopPropagation();" aria-label="Quick View">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/></svg>
          </button>
        </div>
        <div class="bbl-card__body">
          <span class="bbl-card__name">{{ addon_popgolf.title }}</span>
          <span class="bbl-card__price">+ {{ addon_popgolf.price | money_without_trailing_zeros }}</span>
        </div>
      </div>

    </div>

    <div class="bbl-footer" id="bbl-footer">
      <div class="bbl-footer__info">
        <div class="bbl-footer__total-wrap">
          <span class="bbl-footer__total-label">Bundle Total</span>
          <span class="bbl-footer__total" id="bbl-total">{{ main_product.price | money }}</span>
        </div>
        <span class="bbl-footer__dot"></span>
        <span class="bbl-footer__count" id="bbl-count">1 item</span>
      </div>
      <div class="bbl-footer__actions">
        <button class="bbl-footer__cta" id="bbl-cta" type="button" onclick="bblConfirm()">Add Bundle to Cart</button>
        <button class="bbl-footer__atc" id="bbl-atc" type="button" onclick="bblJustKit()">Just the Kit</button>
      </div>
    </div>

  </div>
</div>

<!-- ═══ POPUP ═══ -->
<div class="bbl-popup-wrap" id="bbl-popup-wrap">
  <div class="bbl-popup" id="bbl-popup" role="dialog" aria-modal="true">
    <button class="bbl-popup__close" id="bbl-popup-close" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="18" y1="6" x2="6" y2="18"/>
      </svg>
    </button>
    <div class="bbl-popup__layout" id="bbl-popup-layout"></div>
  </div>
</div>

<script>
(function () {

  var BASE_PRICE   = {{ main_product.price }};
  var MAIN_VARIANT = {{ main_product.first_available_variant.id }};

  var PRODUCTS = {
    'swaptop-kit': {
      title: {{ main_product.title | json }},
      price: {{ main_product.price }},
      description: {{ main_product.description | strip_html | truncate: 240 | json }},
      images: [{%- for img in main_product.images -%}{{ img | image_url: width: 600 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      variants: [{%- for v in main_product.variants -%}{id:{{ v.id }},title:{{ v.title | json }},price:{{ v.price }},available:{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
    },
    'swaptop-football': {
      title: {{ addon_football.title | json }},
      price: {{ addon_football.price }},
      description: {{ addon_football.description | strip_html | truncate: 240 | json }},
      images: [{%- for img in addon_football.images -%}{{ img | image_url: width: 600 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      variants: [{%- for v in addon_football.variants -%}{id:{{ v.id }},title:{{ v.title | json }},price:{{ v.price }},available:{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
    },
    'swaptop-og': {
      title: {{ addon_og.title | json }},
      price: {{ addon_og.price }},
      description: {{ addon_og.description | strip_html | truncate: 240 | json }},
      images: [{%- for img in addon_og.images -%}{{ img | image_url: width: 600 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      variants: [{%- for v in addon_og.variants -%}{id:{{ v.id }},title:{{ v.title | json }},price:{{ v.price }},available:{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
    },
    'swaptop-popgolf': {
      title: {{ addon_popgolf.title | json }},
      price: {{ addon_popgolf.price }},
      description: {{ addon_popgolf.description | strip_html | truncate: 240 | json }},
      images: [{%- for img in addon_popgolf.images -%}{{ img | image_url: width: 600 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
      variants: [{%- for v in addon_popgolf.variants -%}{id:{{ v.id }},title:{{ v.title | json }},price:{{ v.price }},available:{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
    }
  };

  /* ── Helpers ── */
  function money(c) { return '$' + (c / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

  function updateFooter() {
    var total = BASE_PRICE, count = 1;
    document.querySelectorAll('.bbl-card:not(.locked).selected').forEach(function (c) {
      total += parseInt(c.dataset.price, 10); count++;
    });
    document.getElementById('bbl-total').textContent = money(total);
    document.getElementById('bbl-count').textContent = count + (count === 1 ? ' item' : ' items');
  }

  function getItems() {
    var items = [{ id: MAIN_VARIANT, quantity: 1 }];
    document.querySelectorAll('.bbl-card:not(.locked).selected').forEach(function (c) {
      if (c.dataset.variant) items.push({ id: parseInt(c.dataset.variant, 10), quantity: 1 });
    });
    return items;
  }

  function findCard(handle) {
    var btn = document.querySelector('.bbl-card__qv[data-handle="' + handle + '"]');
    return btn ? btn.closest('.bbl-card') : null;
  }

  function isCardSelected(handle) {
    var card = findCard(handle);
    return card && card.classList.contains('selected');
  }

  /* ── Toggle ── */
  window.bblToggle = function (card) {
    if (card.classList.contains('locked')) return;
    card.classList.toggle('selected');
    updateFooter();
  };

  /* ── Popup state ── */
  var popupWrap = document.getElementById('bbl-popup-wrap');
  var popup     = document.getElementById('bbl-popup');
  var layout    = document.getElementById('bbl-popup-layout');
  var curHandle = null;
  var curIdx    = 0;
  var curImages = [];

  function lockScroll()   { document.body.classList.add('bbl-no-scroll'); }
  function unlockScroll() { document.body.classList.remove('bbl-no-scroll'); }

  function openPopup()  { popupWrap.classList.add('active'); lockScroll(); }
  function closePopup() { popupWrap.classList.remove('active'); unlockScroll(); curHandle = null; }

  /* Click outside content box to close */
  popupWrap.addEventListener('click', function (e) {
    if (e.target === popupWrap) closePopup();
  });
  document.getElementById('bbl-popup-close').addEventListener('click', closePopup);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePopup(); });

  /* ── Arrow navigation ── */
  function goTo(idx) {
    if (idx < 0 || idx >= curImages.length) return;
    curIdx = idx;
    var hero = document.getElementById('bbl-hero');
    if (hero) { hero.style.opacity = '0'; setTimeout(function () { hero.src = curImages[curIdx]; hero.style.opacity = '1'; }, 120); }
    document.querySelectorAll('.bbl-popup__thumb').forEach(function (t, i) { t.classList.toggle('active', i === curIdx); });
    var ctr = document.getElementById('bbl-counter');
    if (ctr) ctr.textContent = (curIdx + 1) + ' / ' + curImages.length;
    var prev = document.getElementById('bbl-arrow-prev');
    var next = document.getElementById('bbl-arrow-next');
    if (prev) prev.disabled = curIdx === 0;
    if (next) next.disabled = curIdx === curImages.length - 1;
  }

  /* ── Build popup ── */
  window.bblOpen = function (btn) {
    var handle = btn.dataset.handle;
    var p = PRODUCTS[handle];
    if (!p) return;
    curHandle = handle;
    curIdx = 0;
    curImages = p.images.length ? p.images : [''];

    var isLocked   = handle === 'swaptop-kit';
    var isSelected = isCardSelected(handle);
    var hasV = p.variants.length > 1 || (p.variants.length === 1 && p.variants[0].title !== 'Default Title');
    var multi = curImages.length > 1;

    /* Gallery */
    var g = '<div class="bbl-popup__gallery">';
    g += '<div class="bbl-popup__hero-wrap">';
    if (multi) {
      g += '<button class="bbl-popup__arrow bbl-popup__arrow--prev" id="bbl-arrow-prev" type="button" onclick="bblArrow(-1)" disabled>'
         + '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#333" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>';
      g += '<button class="bbl-popup__arrow bbl-popup__arrow--next" id="bbl-arrow-next" type="button" onclick="bblArrow(1)"' + (curImages.length <= 1 ? ' disabled' : '') + '>'
         + '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#333" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></button>';
    }
    g += '<img class="bbl-popup__hero" id="bbl-hero" src="' + curImages[0] + '" alt="">';
    if (multi) g += '<span class="bbl-popup__counter" id="bbl-counter">1 / ' + curImages.length + '</span>';
    g += '</div>';

    if (multi) {
      g += '<div class="bbl-popup__thumbs">';
      curImages.forEach(function (src, i) {
        g += '<img class="bbl-popup__thumb' + (i === 0 ? ' active' : '') + '" src="' + src + '" alt="" onclick="bblThumb(' + i + ')">';
      });
      g += '</div>';
    }
    g += '</div>';

    /* Info */
    var r = '<div class="bbl-popup__info">';
    r += '<div class="bbl-popup__name">' + p.title + '</div>';
    r += '<div class="bbl-popup__price">' + money(p.price) + '</div>';
    if (p.description) r += '<p class="bbl-popup__desc">' + p.description + '</p>';

    if (hasV) {
      r += '<div class="bbl-popup__variants-label">Select Option</div>';
      r += '<div class="bbl-popup__variants">';
      p.variants.forEach(function (v, i) {
        r += '<button class="bbl-popup__vbtn' + (i === 0 ? ' active' : '') + '"'
           + ' data-vid="' + v.id + '" data-vprice="' + v.price + '"'
           + (v.available ? '' : ' disabled')
           + ' onclick="bblPickV(this)">' + v.title + '</button>';
      });
      r += '</div>';
    }

    /* Action button: Add or Remove */
    if (isLocked) {
      /* Kit is always included — no action needed */
    } else if (isSelected) {
      r += '<button class="bbl-popup__action bbl-popup__action--remove" type="button" onclick="bblPopupRemove()">Remove from Bundle</button>';
    } else {
      r += '<button class="bbl-popup__action bbl-popup__action--add" type="button" onclick="bblPopupAdd()">Add to Bundle</button>';
    }

    r += '</div>';

    layout.innerHTML = g + r;
    openPopup();
  };

  window.bblArrow = function (dir) { goTo(curIdx + dir); };
  window.bblThumb = function (i) { goTo(i); };

  window.bblPickV = function (btn) {
    btn.closest('.bbl-popup__variants').querySelectorAll('.bbl-popup__vbtn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    if (curHandle) {
      var card = findCard(curHandle);
      if (card && !card.classList.contains('locked')) {
        card.dataset.variant = btn.dataset.vid;
        card.dataset.price   = btn.dataset.vprice;
      }
    }
  };

  window.bblPopupAdd = function () {
    if (!curHandle) return;
    var card = findCard(curHandle);
    if (card && !card.classList.contains('locked') && !card.classList.contains('selected')) {
      card.classList.add('selected');
      updateFooter();
    }
    closePopup();
  };

  window.bblPopupRemove = function () {
    if (!curHandle) return;
    var card = findCard(curHandle);
    if (card && !card.classList.contains('locked') && card.classList.contains('selected')) {
      card.classList.remove('selected');
      updateFooter();
    }
    closePopup();
  };

  /* ── Just the Kit — uncheck all add-ons, cart only main ── */
  window.bblJustKit = function () {
    document.querySelectorAll('.bbl-card:not(.locked).selected').forEach(function (c) {
      c.classList.remove('selected');
    });
    updateFooter();

    var btn = document.getElementById('bbl-atc');
    btn.style.opacity = '0.6'; btn.style.pointerEvents = 'none'; btn.textContent = 'Adding\u2026';
    cartPost([{ id: MAIN_VARIANT, quantity: 1 }], function (ok) {
      btn.textContent = ok ? 'Added \u2713' : 'Just the Kit';
      setTimeout(function () { btn.textContent = 'Just the Kit'; btn.style.opacity = ''; btn.style.pointerEvents = ''; if (ok) cartRedirect(); }, 1000);
    });
  };

  /* ── Cart helpers ── */
  function cartPost(items, cb) {
    fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
      .then(function (r) { return r.json(); }).then(function () { cb(true); }).catch(function () { cb(false); });
  }

  function cartRedirect() {
    var t = document.querySelector('[data-cart-toggle]');
    t ? t.click() : (window.location.href = '/cart');
  }

  window.bblConfirm = function () {
    var btn = document.getElementById('bbl-cta');
    btn.classList.add('loading'); btn.textContent = 'Adding\u2026';
    cartPost(getItems(), function (ok) {
      btn.textContent = ok ? 'Added \u2713' : 'Add Bundle to Cart';
      setTimeout(function () { btn.classList.remove('loading'); btn.textContent = 'Add Bundle to Cart'; if (ok) cartRedirect(); }, 1000);
    });
  };

  updateFooter();
})();
</script>

{% schema %}
{
  "name": "Bundle List",
  "tag": "section",
  "class": "swaptop-bundle-list-wrapper",
  "settings": [],
  "presets": [{ "name": "Bundle List" }]
}
{% endschema %}
