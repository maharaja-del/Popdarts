  .bnd-addon-card.selected .bnd-add-top-btn{background:#16a34a;color:#fff;pointer-events:none;cursor:default}
  .bnd-addon-card.selected .bnd-add-top-btn svg{stroke:#fff}
  .bnd-add-top-btn .bnd-icon-plus{display:block}.bnd-add-top-btn .bnd-icon-check{display:none}
  .bnd-addon-card.selected .bnd-add-top-btn .bnd-icon-plus{display:none}.bnd-addon-card.selected .bnd-add-top-btn .bnd-icon-check{display:block}
  .bnd-included-badge{position:absolute;top:7px;right:7px;background:#fff;color:#16a34a;font-family:'Inter',sans-serif;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:4px 9px;border-radius:20px;border:1.5px solid #23ff53;display:flex;align-items:center;gap:4px;z-index:8;pointer-events:none;min-height:26px;box-shadow:0 1px 6px rgba(0,0,0,.12)}
