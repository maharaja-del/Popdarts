  .bnd-add-top-btn{position:absolute;top:7px;right:7px;background:#23ff53;color:#000;font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:5px 10px 5px 8px;border-radius:20px;border:none;display:flex;align-items:center;gap:4px;z-index:8;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.22);transition:background .2s,transform .15s,box-shadow .2s;min-height:30px}
