<script>
/* ═══════════════════════════════════════
   SECTION 1 JS — MEMORIAL DAY HERO
═══════════════════════════════════════ */
(function () {
  /* ── FLOATING STARS ── */
  var container = document.getElementById('mhero-stars-container');
  for (var i = 0; i < 28; i++) {
    var star = document.createElement('div');
    star.className = 'mhero-star';
    star.style.left = Math.random() * 100 + '%';
    star.style.top  = Math.random() * 100 + '%';
    star.style.setProperty('--dur', (2 + Math.random() * 4) + 's');
    star.style.setProperty('--del', (Math.random() * 5) + 's');
    var size = 2 + Math.random() * 4;
    star.style.width  = size + 'px';
    star.style.height = size + 'px';
    container.appendChild(star);
  }

  /* ── COUNTDOWN TO MEMORIAL DAY (last Monday of May in current year) ── */
  function getMDTarget() {
    var now  = new Date();
    var year = now.getFullYear();
    /* Memorial Day = last Monday of May */
    var may31 = new Date(year, 4, 31); /* May 31 */
    var dow = may31.getDay(); /* 0=Sun */
    var lastMonday = new Date(year, 4, 31 - ((dow === 0 ? 7 : dow) - 1));
    /* End of Memorial Day (midnight) */
    lastMonday.setHours(23, 59, 59, 0);
    /* If already past, target next year */
    if (lastMonday < now) {
      var nm = new Date(year + 1, 4, 31);
      var nd = nm.getDay();
      lastMonday = new Date(year + 1, 4, 31 - ((nd === 0 ? 7 : nd) - 1));
      lastMonday.setHours(23, 59, 59, 0);
    }
    return lastMonday;
  }

  var mheroTarget = getMDTarget();

  function mheroPad(n) { return n < 10 ? '0' + n : '' + n; }

  function mheroTick() {
    var now  = new Date();
    var diff = Math.max(0, Math.floor((mheroTarget - now) / 1000));
    var d = Math.floor(diff / 86400);
    var h = Math.floor((diff % 86400) / 3600);
    var m = Math.floor((diff % 3600) / 60);
    var s = diff % 60;
    document.getElementById('mhero-d').textContent = mheroPad(d);
    document.getElementById('mhero-h').textContent = mheroPad(h);
    document.getElementById('mhero-m').textContent = mheroPad(m);
    document.getElementById('mhero-s').textContent = mheroPad(s);
  }

  mheroTick();
  setInterval(mheroTick, 1000);
})();

/* ═══════════════════════════════════════
   SECTION 2 JS — BACKYARD EXPERIENCE
═══════════════════════════════════════ */
(function () {
  /* Intersection observer card reveal */
  var cards = document.querySelectorAll('.bce-card');
  if (!cards.length) return;

  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          var idx = Array.prototype.indexOf.call(cards, entry.target);
          entry.target.style.transitionDelay = (idx * 0.1) + 's';
          entry.target.classList.add('bce-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    cards.forEach(function (card) { observer.observe(card); });
  } else {
    cards.forEach(function (card) { card.classList.add('bce-visible'); });
  }
})();
</script>

