  .bnd-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .bnd-info{display:flex;flex-direction:column;gap:0;padding-bottom:48px}
  .bnd-title{font-size:38px;font-weight:800;color:#111;margin:0 0 2px;line-height:1.1;letter-spacing:-.04em;background:linear-gradient(135deg,#111 60%,#23ff53 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
