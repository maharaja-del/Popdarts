  .bnd-qv-close{position:absolute;top:14px;right:14px;width:36px;height:36px;border-radius:50%;background:#f3f4f6;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10;transition:background .2s;padding:0}
  .bnd-qv-close:hover{background:#e5e7eb}.bnd-qv-close svg{width:16px;height:16px;stroke:#111;display:block}
  .bnd-qv-body{display:grid;grid-template-columns:54% 1fr;flex:1;overflow:hidden}
  .bnd-qv-gallery{background:#f5f5f5;display:flex;flex-direction:column;overflow:hidden}
  .bnd-qv-img-wrap{position:relative;flex:1;display:flex;align-items:center;justify-content:center;overflow:hidden;min-height:300px}
  .bnd-qv-main-img{max-width:100%;max-height:420px;object-fit:contain;display:block;border-radius:8px;transition:opacity .2s ease}
  .bnd-qv-nav{position:absolute;top:50%;transform:translateY(-50%);width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.92);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 10px rgba(0,0,0,.14);transition:background .2s,opacity .2s;padding:0;z-index:4}
  .bnd-qv-nav:hover{background:#fff}.bnd-qv-nav.off{opacity:0;pointer-events:none}.bnd-qv-nav svg{width:18px;height:18px;stroke:#111;display:block}.bnd-qv-nav--prev{left:10px}.bnd-qv-nav--next{right:10px}
  .bnd-qv-img-count{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);font-family:'Inter',sans-serif;font-size:11px;font-weight:600;color:rgba(255,255,255,.9);background:rgba(0,0,0,.42);padding:3px 10px;border-radius:20px;letter-spacing:.06em;white-space:nowrap}
  .bnd-qv-thumbs{display:flex;gap:6px;padding:10px 14px;overflow-x:auto;background:#f5f5f5;scrollbar-width:none;justify-content:center;flex-wrap:wrap}
  .bnd-qv-thumbs::-webkit-scrollbar{display:none}
  .bnd-qv-thumb{width:58px;height:58px;border-radius:8px;overflow:hidden;flex-shrink:0;cursor:pointer;border:2px solid transparent;transition:border-color .2s;background:#eee}
  .bnd-qv-thumb.active{border-color:#23ff53}.bnd-qv-thumb:hover{border-color:#86efac}.bnd-qv-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .bnd-qv-info{padding:24px 26px 22px;display:flex;flex-direction:column;gap:12px;overflow:hidden}
  .bnd-qv-title{font-size:22px;font-weight:800;color:#111;line-height:1.15;letter-spacing:-.03em;margin:0}
  .bnd-qv-price-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .bnd-qv-price-sale{font-size:26px;font-weight:800;color:#111;letter-spacing:-.03em}
  .bnd-qv-price-compare{font-size:16px;color:#aaa;text-decoration:line-through;font-weight:500}
  .bnd-qv-price-badge{font-size:11px;font-weight:700;color:#16a34a;background:#dcfce7;padding:3px 10px;border-radius:20px}
  .bnd-qv-divider{height:1px;background:#f0f0f0;flex-shrink:0}
  .bnd-qv-acc{border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;flex-shrink:0}
  .bnd-qv-acc-trigger{width:100%;display:flex;align-items:center;justify-content:space-between;padding:12px 14px;background:#f9fafb;border:none;cursor:pointer;font-family:'Inter',sans-serif;text-align:left;gap:10px}
  .bnd-qv-acc-trigger:hover{background:#f3f4f6}
  .bnd-qv-acc-label{font-size:13px;font-weight:700;color:#111;letter-spacing:-.01em}
  .bnd-qv-acc-icon{flex-shrink:0;width:20px;height:20px;border-radius:50%;border:1.5px solid #ccc;display:flex;align-items:center;justify-content:center;transition:border-color .2s,background .2s}
  .bnd-qv-acc-icon svg{width:12px;height:12px;transition:transform .3s ease}
  .bnd-qv-acc.open .bnd-qv-acc-icon{border-color:#23ff53;background:#23ff53}
  .bnd-qv-acc.open .bnd-qv-acc-icon svg{transform:rotate(45deg);color:#fff}
  .bnd-qv-acc.open .bnd-qv-acc-icon path{fill:#fff}
  .bnd-qv-acc-body{overflow:hidden;max-height:0;transition:max-height .32s ease;background:#fff}
  .bnd-qv-acc.open .bnd-qv-acc-body{max-height:260px}
  .bnd-qv-desc{font-size:13px;color:#555;line-height:1.7;padding:12px 14px;overflow-y:auto;max-height:220px;scrollbar-width:thin}
  .bnd-qv-desc p{margin:0 0 8px}.bnd-qv-desc p:last-child{margin:0}.bnd-qv-desc ul{margin:0 0 8px;padding-left:18px}.bnd-qv-desc li{margin-bottom:4px}
  .bnd-qv-cta{flex-shrink:0;padding:14px 28px 22px;background:#fff;border-top:1px solid #f0f0f0;margin-left:54%}
  .bnd-qv-add-btn{width:100%;padding:15px;border-radius:12px;background:#23ff53;color:#000;font-family:'Inter',sans-serif;font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:background .2s,transform .15s}
  .bnd-qv-add-btn:hover{background:#16a34a;transform:translateY(-1px)}.bnd-qv-add-btn:active{transform:translateY(0)}
  .bnd-qv-add-btn.in-bundle{background:#16a34a;color:#fff;pointer-events:none;cursor:default}.bnd-qv-add-btn svg{width:16px;height:16px;stroke:currentColor;flex-shrink:0;display:block}
  .bnd-browse-btns{display:flex;gap:4px;flex-shrink:0;margin-left:auto}
  .bnd-browse-btn{width:28px;height:28px;border-radius:7px;background:#f3f4f6;border:1px solid #e5e7eb;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;transition:background .15s,border-color .15s;flex-shrink:0}
  .bnd-browse-btn:hover{background:#e5e7eb;border-color:#d1d5db}.bnd-browse-btn svg{width:13px;height:13px;stroke:#555;display:block}
  button#bnd-atc-btn{font-weight:900}
  .bnd-added-popup{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;pointer-events:none;opacity:0;background:rgba(0,0,0,0);transition:opacity .2s ease,background .2s ease;border-radius:8px}
  .bnd-added-popup.show{opacity:1;background:rgba(0,0,0,.42)}
  .bnd-added-popup-badge{background:#23ff53;color:#000;font-family:'Inter',sans-serif;font-size:17px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;padding:14px 26px;border-radius:50px;display:flex;align-items:center;gap:9px;box-shadow:0 0 0 4px rgba(35,255,83,.3),0 8px 32px rgba(0,0,0,.45),0 0 60px rgba(35,255,83,.4);transform:scale(.6) rotate(-4deg);transition:transform .4s cubic-bezier(.34,1.7,.64,1)}
  .bnd-added-popup.show .bnd-added-popup-badge{transform:scale(1) rotate(0deg)}
  .bnd-added-popup-badge svg{width:18px;height:18px;stroke:#000;flex-shrink:0}
  @media(max-width:768px){.bnd-section{padding:32px 16px 0}.bnd-wrap{grid-template-columns:1fr;gap:24px}.bnd-gallery{position:static}.bnd-title{font-size:26px}.bnd-price-sale{font-size:26px}.bnd-addon-name{font-size:11px}.bnd-addon-price{font-size:11px}.bnd-info{padding-bottom:32px}.bnd-browse-btn{display:none}}
  @media(max-width:480px){.pd-nav-btn{margin:0 4px}.pd-reel-wrap{width:min(320px,82vw)}}
  @media(max-width:640px){.bnd-qv-overlay{padding:0;align-items:stretch}.bnd-qv-panel{border-radius:0;max-height:100%;height:100%;width:100%;display:flex;flex-direction:column}.bnd-qv-body{grid-template-columns:1fr;display:flex;flex-direction:column;overflow:hidden;flex:1;min-height:0}.bnd-qv-gallery{flex-shrink:0;height:300px;min-height:300px}.bnd-qv-img-wrap{min-height:0;flex:1}.bnd-qv-main-img{max-height:230px;width:auto;max-width:100%}.bnd-qv-info{padding:18px 20px 8px;gap:12px;overflow-y:auto;flex:1;min-height:0;-webkit-overflow-scrolling:touch}.bnd-qv-title{font-size:18px}.bnd-qv-price-sale{font-size:22px}.bnd-qv-cta{margin-left:0;padding:12px 20px 28px;width:100%}}
</style>

<!-- BUNDLE HTML -->
<div class="bnd-section">
  <div class="bnd-wrap">
    <div class="bnd-gallery">
      <div class="bnd-main-img-wrap" onclick="bndOpenLightbox()">
        <img id="bnd-main-img" class="bnd-main-img" src="{{ main_product.featured_image | image_url: width: 800 }}" alt="{{ main_product.title }}" loading="eager" fetchpriority="high" decoding="async">
      </div>
      <div class="bnd-thumbs">
        {% assign first_img = main_product.images | first %}
        <div class="bnd-thumb active" data-src="{{ first_img | image_url: width: 800 }}"><img src="{{ first_img | image_url: width: 200 }}" alt="{{ main_product.title }} 1" loading="eager" fetchpriority="high"></div>
        <div class="bnd-thumb" data-src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Images_Popdarts_Images1.jpg?v=1778015525"><img src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Images_Popdarts_Images1.jpg?v=1778015525" alt="{{ main_product.title }} lifestyle" loading="eager"></div>
        <div class="bnd-thumb" data-src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Group_1484581343.png?v=1778015640"><img src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Group_1484581343.png?v=1778015640" alt="{{ main_product.title }} bundle" loading="eager"></div>
        {% for image in main_product.images limit: 3 %}{% unless forloop.first %}<div class="bnd-thumb" data-src="{{ image | image_url: width: 800 }}"><img src="{{ image | image_url: width: 200 }}" alt="{{ main_product.title }} {{ forloop.index }}" loading="eager"></div>{% endunless %}{% endfor %}
      </div>
    </div>
    <div class="bnd-info">
      <h1 class="bnd-title">{{ main_product.title }}</h1>
      <button class="bnd-stars-row" onclick="bndScrollToReviews()" aria-label="Read 17 reviews">
        <span class="bnd-stars-icons"><span class="bnd-star">★</span><span class="bnd-star">★</span><span class="bnd-star">★</span><span class="bnd-star">★</span><span class="bnd-star">★</span></span>
        <span class="bnd-stars-label">(17) Reviews</span>
      </button>
      <div class="bnd-price-row">
        {% if main_product.compare_at_price > main_product.price %}<span class="bnd-price-original">{{ main_product.compare_at_price | money }}</span>{% endif %}
        <span class="bnd-price-sale">{{ main_product.price | money }}</span>
        {% if main_product.compare_at_price > main_product.price %}{% assign savings = main_product.compare_at_price | minus: main_product.price %}<span class="bnd-price-badge">Save {{ savings | money }}</span>{% endif %}
      </div>
      <div class="bnd-shipping-tag">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span><span class="bnd-shipping-free">Free</span> Shipping in the USA</span>
      </div>
      <p class="bnd-bundle-label">Add Your Tops</p>
      <div class="bnd-addons-outer">
        <div class="bnd-addons" id="bnd-addons-track">
          <div class="bnd-addon-card selected locked" id="bnd-card-main">
            <div class="bnd-included-badge"><svg viewBox="0 0 12 12" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,6 5,9 10,3"/></svg>Included</div>
            <div class="bnd-addon-img-zone" onclick="bndImgZoneClick(event,this)">
              <div class="bnd-addon-slider" data-idx="0">
                <div class="bnd-addon-slides">{% for img in main_product.images limit: 4 %}<div class="bnd-addon-slide"><img src="{{ img | image_url: width: 600 }}" alt="{{ main_product.title }} {{ forloop.index }}" loading="eager" fetchpriority="high"></div>{% endfor %}</div>
                <div class="bnd-slide-pills">{% for img in main_product.images limit: 4 %}<span class="bnd-slide-pill {% if forloop.first %}active{% endif %}"></span>{% endfor %}</div>
              </div>
            </div>
            <div class="bnd-addon-footer" style="pointer-events:none">
              <div class="bnd-addon-text"><p class="bnd-addon-name">{{ main_product.title }}</p><p class="bnd-addon-price included">Included</p></div>
              <div class="bnd-browse-btns"><button class="bnd-browse-btn" onclick="bndFooterNav(event,this,-1)"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button><button class="bnd-browse-btn" onclick="bndFooterNav(event,this,1)"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button></div>
              <div class="bnd-toggle"></div>
            </div>
            <div class="bnd-kit-included-bar"><svg viewBox="0 0 16 16" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,8 6,12 14,4"/></svg>Included</div>
          </div>
