  .pd-thumb-wrap{position:relative;width:100%;aspect-ratio:9/16;border-radius:10px;overflow:hidden;background:#111}
  .pd-card-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
