  .bnd-acc-title{font-size:15px;font-weight:600;color:#111;letter-spacing:-.01em}
  .bnd-acc-icon{flex-shrink:0;width:20px;height:20px;border-radius:50%;border:1.5px solid #ccc;display:flex;align-items:center;justify-content:center;transition:border-color .2s,background .2s,transform .3s}
  .bnd-acc-icon svg{width:12px;height:12px;transition:transform .3s ease}
  .bnd-acc-item.open .bnd-acc-icon{border-color:#23ff53;background:#23ff53}
  .bnd-acc-item.open .bnd-acc-icon svg{transform:rotate(45deg);color:#fff}
  .bnd-acc-item.open .bnd-acc-icon path{fill:#fff}
  .bnd-acc-body{overflow:hidden;max-height:0;transition:max-height .35s ease,padding .35s ease;padding-bottom:0}
  .bnd-acc-item.open .bnd-acc-body{max-height:600px;padding-bottom:16px}
  .bnd-acc-content{font-size:15px;color:#555;line-height:1.75;font-weight:400}
  .bnd-acc-content p{margin:0 0 8px}.bnd-acc-content p:last-child{margin:0}.bnd-acc-content ul{margin:0 0 8px;padding-left:18px}.bnd-acc-content li{margin-bottom:4px}
  .bnd-price-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .bnd-price-original{font-size:20px;color:#aaa;text-decoration:line-through;font-weight:500}
  .bnd-price-sale{font-size:34px;font-weight:800;color:#111;letter-spacing:-.03em}
  .bnd-price-badge{background:#dcfce7;color:#16a34a;font-size:13px;font-weight:700;padding:5px 12px;border-radius:20px}
  .bnd-shipping-tag{display:flex;align-items:center;justify-content:center;gap:8px;background:#111;color:#fff;font-family:'Inter',sans-serif;font-size:13px;font-weight:800;padding:11px 16px;border-radius:8px;letter-spacing:.06em;text-transform:uppercase;width:100%}
  .bnd-shipping-tag svg{width:17px;height:17px;stroke:white;flex-shrink:0}
  .bnd-shipping-free{color:white}
  .bnd-bundle-label{font-size:13px;font-weight:800;color:black;margin:4px 0 2px;letter-spacing:.08em;text-transform:uppercase;padding:9px 0;border-radius:8px;display:inline-block}
  .bnd-addons-outer{position:relative;overflow:visible}
