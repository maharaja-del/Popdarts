{% comment %}
  PopDarts — Memorial Day Full Page
  Sections (top to bottom):
    1. Memorial Day Hero Takeover
    2. Backyard Competition Experience
    3. Swaptop Bundle (original)
    4. Viral Social Proof
  Drop into: sections/popdarts-memorial-day-full.liquid
  { "type": "popdarts-memorial-day-full" }
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

  /* ═══════════════════════════════════════
     SECTION 1 — MEMORIAL DAY HERO
  ═══════════════════════════════════════ */
.mhero-section *,
  .mhero-section *::before,
  .mhero-section *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .mhero-section {
    font-family: 'Inter', sans-serif;
    background: #0a0a0a;
    position: relative;
    overflow: hidden;
    min-height: 92vh;
    display: flex;
    align-items: center;
  }

  /* ── BACKGROUND TEXTURE ── */
  .mhero-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(35,255,83,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(35,255,83,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    z-index: 0;
  }

  .mhero-bg-glow {
    position: absolute;
    top: -200px;
    right: -200px;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(35,255,83,0.12) 0%, transparent 65%);
    z-index: 0;
    pointer-events: none;
  }

  .mhero-bg-glow-2 {
    position: absolute;
    bottom: -300px;
    left: -100px;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(22,163,74,0.08) 0%, transparent 65%);
    z-index: 0;
    pointer-events: none;
  }

  /* ── STARS / CONFETTI ── */
  .mhero-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .mhero-star {
    position: absolute;
    width: 4px;
    height: 4px;
    background: #23ff53;
    border-radius: 50%;
    opacity: 0;
    animation: mheroStarPulse var(--dur, 3s) ease-in-out infinite;
    animation-delay: var(--del, 0s);
  }

  @keyframes mheroStarPulse {
    0%, 100% { opacity: 0; transform: scale(0.5); }
    50%       { opacity: 0.7; transform: scale(1); }
  }

  /* ── LAYOUT ── */
  .mhero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px 40px;
    display: grid;
    grid-template-columns: 55% 1fr;
    gap: 60px;
    align-items: center;
  }

  /* ── LEFT: CONTENT ── */
  .mhero-content { display: flex; flex-direction: column; gap: 0; }

  .mhero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(35,255,83,0.1);
    border: 1px solid rgba(35,255,83,0.3);
    border-radius: 100px;
    padding: 8px 18px;
    margin-bottom: 24px;
    width: fit-content;
  }

  .mhero-eyebrow-flag {
    display: flex;
    gap: 2px;
    align-items: center;
  }

  .mhero-flag-stripe {
    width: 8px;
    height: 14px;
    border-radius: 2px;
  }

  .mhero-eyebrow-text {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #23ff53;
  }

  .mhero-title {
    font-size: clamp(46px, 5.5vw, 80px);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: #fff;
    margin-bottom: 8px;
  }

  .mhero-title-accent {
    background: linear-gradient(135deg, #23ff53 0%, #16a34a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: block;
  }

  .mhero-subtitle {
    font-size: clamp(15px, 1.4vw, 18px);
    color: rgba(255,255,255,0.55);
    font-weight: 400;
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: 36px;
    margin-top: 16px;
  }

  .mhero-subtitle strong {
    color: rgba(255,255,255,0.9);
    font-weight: 700;
  }

  /* ── STATS ROW ── */
  .mhero-stats {
    display: flex;
    gap: 32px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .mhero-stat { display: flex; flex-direction: column; gap: 2px; }

  .mhero-stat-num {
    font-size: 28px;
    font-weight: 900;
    color: #23ff53;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .mhero-stat-label {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mhero-stat-divider {
    width: 1px;
    background: rgba(255,255,255,0.1);
    align-self: stretch;
    flex-shrink: 0;
  }

  /* ── CTA AREA ── */
  .mhero-cta-group {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .mhero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #23ff53;
    color: #000;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 17px 32px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 0 0 0 rgba(35,255,83,0);
    position: relative;
    overflow: hidden;
  }

  .mhero-btn-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%);
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .mhero-btn-primary:hover {
    background: #16a34a;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(35,255,83,0.4);
  }

  .mhero-btn-primary:hover::after { opacity: 1; }
  .mhero-btn-primary:active { transform: translateY(0); }

  .mhero-btn-primary svg { width: 17px; height: 17px; stroke: #000; flex-shrink: 0; }

  .mhero-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: rgba(255,255,255,0.7);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 17px 24px;
    border-radius: 10px;
    border: 1.5px solid rgba(255,255,255,0.15);
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .mhero-btn-ghost:hover {
    border-color: rgba(35,255,83,0.4);
    color: #23ff53;
    background: rgba(35,255,83,0.05);
  }

  /* ── TRUST BAR ── */
  .mhero-trust {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .mhero-trust-item {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .mhero-trust-icon {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(35,255,83,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mhero-trust-icon svg { width: 10px; height: 10px; stroke: #23ff53; }

  .mhero-trust-text {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,0.45);
  }

  .mhero-trust-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    flex-shrink: 0;
  }

  /* ── RIGHT: VISUAL ── */
  .mhero-visual {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
  }

  .mhero-img-main {
    border-radius: 20px;
    overflow: hidden;
    background: rgba(35,255,83,0.05);
    border: 1px solid rgba(35,255,83,0.15);
    aspect-ratio: 4/5;
    position: relative;
  }

  .mhero-img-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Deal badge floating on image */
  .mhero-deal-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    background: #23ff53;
    color: #000;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: 100px;
    box-shadow: 0 4px 20px rgba(35,255,83,0.5);
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 6px;
    animation: mheroBadgePop 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
    animation-delay: 0.8s;
  }

  @keyframes mheroBadgePop {
    from { opacity: 0; transform: scale(0.6) rotate(-8deg); }
    to   { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .mhero-deal-badge::before {
    content: '🔥';
    font-size: 13px;
  }

  /* Stars floating badge */
  .mhero-stars-badge {
    position: absolute;
    bottom: 18px;
    right: 18px;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 12px 16px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 4px;
    animation: mheroSlideUp 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
    animation-delay: 1.0s;
  }

  @keyframes mheroSlideUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .mhero-stars-badge-stars {
    display: flex;
    gap: 2px;
  }

  .mhero-stars-badge-stars span {
    font-size: 14px;
    color: #f59e0b;
  }

  .mhero-stars-badge-label {
    font-size: 11px;
    font-weight: 700;
    color: rgba(255,255,255,0.6);
  }

  /* Small cards beside main image */
  .mhero-img-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    position: absolute;
    right: -20px;
    top: 50%;
    transform: translateY(-50%);
    width: 140px;
  }

  /* ── COUNTDOWN TIMER ── */
  .mhero-countdown {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .mhero-countdown-label {
    font-size: 11px;
    font-weight: 800;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .mhero-timer {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mhero-timer-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .mhero-timer-num {
    font-size: 24px;
    font-weight: 900;
    color: #23ff53;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    min-width: 42px;
    text-align: center;
    background: rgba(35,255,83,0.08);
    border-radius: 8px;
    padding: 4px 6px;
  }

  .mhero-timer-label {
    font-size: 9px;
    font-weight: 700;
    color: rgba(255,255,255,0.3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mhero-timer-sep {
    font-size: 20px;
    font-weight: 900;
    color: rgba(255,255,255,0.2);
    line-height: 1;
    padding-bottom: 14px;
  }

  /* ── SCROLL INDICATOR ── */
  .mhero-scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 2;
    opacity: 0.4;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .mhero-scroll-indicator:hover { opacity: 0.7; }

  .mhero-scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0.5) 100%);
    position: relative;
    overflow: hidden;
  }

  .mhero-scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: #23ff53;
    animation: mheroScrollDrop 1.6s ease-in-out infinite;
  }

  @keyframes mheroScrollDrop {
    0% { top: -100%; }
    100% { top: 200%; }
  }

  .mhero-scroll-text {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    writing-mode: vertical-lr;
    transform: rotate(180deg);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .mhero-section { min-height: auto; }

    .mhero-inner {
      grid-template-columns: 1fr;
      padding: 60px 20px 80px;
      gap: 40px;
    }

    .mhero-title { font-size: 40px; }
    .mhero-img-cards { display: none; }
    .mhero-img-main { aspect-ratio: 4/3; }
    .mhero-stats { gap: 20px; }
    .mhero-stat-num { font-size: 22px; }
    .mhero-scroll-indicator { display: none; }
  }

  @media (max-width: 480px) {
    .mhero-btn-primary, .mhero-btn-ghost { width: 100%; justify-content: center; }
    .mhero-cta-group { flex-direction: column; }
    .mhero-trust { gap: 12px; }
    .mhero-trust-dot { display: none; }
  }

  /* ── ENTRANCE ANIMATIONS ── */
  .mhero-animate {
    opacity: 0;
    transform: translateY(24px);
    animation: mheroFadeUp 0.7s cubic-bezier(0.22,1,0.36,1) forwards;
  }

  @keyframes mheroFadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ═══════════════════════════════════════
     SECTION 2 — BACKYARD EXPERIENCE
  ═══════════════════════════════════════ */
.bce-section *,
  .bce-section *::before,
  .bce-section *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .bce-section {
    font-family: 'Inter', sans-serif;
    background: #111;
    padding: 80px 40px;
    position: relative;
    overflow: hidden;
  }

  /* ── SUBTLE TEXTURE ── */
  .bce-bg-texture {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 80%, rgba(35,255,83,0.06) 0%, transparent 50%),
                      radial-gradient(circle at 80% 20%, rgba(22,163,74,0.04) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .bce-inner {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── HEADER ── */
  .bce-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .bce-header-left { flex: 1; min-width: 280px; }

  .bce-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .bce-eyebrow-line {
    width: 28px;
    height: 2px;
    background: #23ff53;
    border-radius: 2px;
  }

  .bce-eyebrow-text {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #23ff53;
  }

  .bce-title {
    font-size: clamp(30px, 3.5vw, 48px);
    font-weight: 900;
    color: #fff;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .bce-title-muted { color: rgba(255,255,255,0.35); }

  .bce-header-desc {
    font-size: 15px;
    color: rgba(255,255,255,0.45);
    line-height: 1.7;
    max-width: 340px;
    align-self: flex-end;
  }

  /* ── CARDS GRID ── */
  .bce-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* ── CARD ── */
  .bce-card {
    border-radius: 20px;
    overflow: hidden;
    background: #1a1a1a;
    border: 1px solid rgba(255,255,255,0.07);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.35s cubic-bezier(0.22,1,0.36,1), border-color 0.3s, box-shadow 0.35s;
    cursor: pointer;
  }

  .bce-card:hover {
    transform: translateY(-8px);
    border-color: rgba(35,255,83,0.3);
    box-shadow: 0 24px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(35,255,83,0.15), 0 0 60px rgba(35,255,83,0.08);
  }

  /* Image zone */
  .bce-card-img {
    position: relative;
    aspect-ratio: 3/2;
    overflow: hidden;
    background: #222;
    flex-shrink: 0;
  }

  .bce-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
    filter: brightness(0.85);
  }

  .bce-card:hover .bce-card-img img {
    transform: scale(1.06);
    filter: brightness(1);
  }

  /* Overlay gradient on image */
  .bce-card-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.7) 100%);
    pointer-events: none;
  }

  /* Emoji tag top-left */
  .bce-card-emoji {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 3;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 20px;
    line-height: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .bce-card-emoji-label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Intensity meter top-right */
  .bce-intensity {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: flex-end;
  }

  .bce-intensity-label {
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }

  .bce-intensity-bars {
    display: flex;
    gap: 3px;
  }

  .bce-intensity-bar {
    width: 6px;
    height: 16px;
    border-radius: 3px;
    background: rgba(255,255,255,0.15);
    transition: background 0.3s;
  }

  .bce-intensity-bar.on { background: #23ff53; }
  .bce-card:hover .bce-intensity-bar.on { background: #23ff53; box-shadow: 0 0 6px rgba(35,255,83,0.6); }

  /* Body */
  .bce-card-body {
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .bce-card-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #23ff53;
    padding: 4px 10px;
    background: rgba(35,255,83,0.1);
    border-radius: 100px;
    width: fit-content;
    border: 1px solid rgba(35,255,83,0.2);
  }

  .bce-card-title {
    font-size: 22px;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .bce-card-desc {
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    line-height: 1.7;
    flex: 1;
  }

  /* Feature list */
  .bce-card-features {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-top: 4px;
  }

  .bce-card-feature {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,0.55);
  }

  .bce-card-feature-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #23ff53;
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .bce-card:hover .bce-card-feature-dot { opacity: 1; }

  /* Arrow link at bottom */
  .bce-card-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,0.07);
    margin-top: 4px;
  }

  .bce-card-cta-text {
