  .bnd-kit-included-bar svg{width:14px;height:14px;stroke:#16a34a;flex-shrink:0}
  .bnd-qv-btn{width:100%;padding:13px 14px;background:#23ff53;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;font-family:'Inter',sans-serif;font-size:13px;font-weight:800;color:#000;letter-spacing:.06em;text-transform:uppercase;transition:transform .2s,box-shadow .2s,filter .2s;border-radius:0 0 12px 12px;box-shadow:0 4px 14px rgba(34,197,94,.35);animation:bndQvPulse 2.5s ease-in-out infinite}
  @keyframes bndQvPulse{0%,100%{box-shadow:0 4px 14px rgba(34,197,94,.35)}50%{box-shadow:0 6px 24px rgba(34,197,94,.55)}}
  .bnd-qv-btn:hover{transform:translateY(-2px);filter:brightness(1.1);box-shadow:0 8px 28px rgba(34,197,94,.5);animation:none}.bnd-qv-btn:active{transform:translateY(0)}.bnd-qv-btn svg{width:14px;height:14px;stroke:#fff;flex-shrink:0;display:block}
