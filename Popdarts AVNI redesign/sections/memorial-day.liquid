<script>
(function(){
  var BP={{ main_product.price }},BC={{ main_product.compare_at_price | default: main_product.price }},BV={{ main_product.first_available_variant.id }};
  function showPopup(card){var o=card&&card.querySelector('.bnd-added-popup');if(!o)return;if(o._t)clearTimeout(o._t);o.classList.add('show');o._t=setTimeout(function(){o.classList.remove('show');},1500);}
  var mImg=document.getElementById('bnd-main-img');
  document.querySelectorAll('.bnd-thumb').forEach(function(t){t.addEventListener('click',function(){document.querySelectorAll('.bnd-thumb').forEach(function(x){x.classList.remove('active');});t.classList.add('active');mImg.style.opacity='0';setTimeout(function(){mImg.src=t.dataset.src;mImg.style.opacity='1';},180);});});
  function openCart(){var b=document.querySelector('[data-cart-toggle],.cart-toggle,#cart-toggle,.js-cart-open');if(b){b.click();return;}document.dispatchEvent(new CustomEvent('cart:open'));document.dispatchEvent(new CustomEvent('theme:cart:open'));}
  function refreshCart(){fetch('/cart.js').then(function(r){return r.json();}).then(function(c){document.querySelectorAll('[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,#CartCount').forEach(function(el){el.textContent=c.item_count;});}).catch(function(){});fetch('/?sections=cart-drawer,cart-icon-bubble').then(function(r){return r.json();}).then(function(s){if(s['cart-drawer']){var d=document.querySelector('cart-drawer'),w=d&&d.closest('[id^="shopify-section-"]');if(w){w.innerHTML=s['cart-drawer'];}else if(d){var doc=new DOMParser().parseFromString(s['cart-drawer'],'text/html'),fd=doc.querySelector('cart-drawer');if(fd)d.outerHTML=fd.outerHTML;}}}).catch(function(){});}
  function enforceQty(){fetch('/cart.js').then(function(r){return r.json();}).then(function(cart){for(var i=0;i<cart.items.length;i++){if(cart.items[i].variant_id===BV&&cart.items[i].quantity>1){fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({id:cart.items[i].key,quantity:1})}).then(function(r){return r.json();}).then(refreshCart).catch(function(){});break;}}}).catch(function(){});}
  function applySelected(card,sel){card.classList.toggle('selected',sel);var b=card.querySelector('.bnd-add-top-btn');if(b){var l=b.querySelector('.bnd-add-top-label');if(l)l.textContent=sel?'Added':'Add Top';}}
  function syncFromCart(){fetch('/cart.js').then(function(r){return r.json();}).then(function(cart){var ic=cart.items.map(function(i){return i.variant_id;});document.querySelectorAll('.bnd-addon-card:not(.locked)').forEach(function(card){var v=parseInt(card.dataset.variant,10);if(v&&ic.indexOf(v)!==-1)applySelected(card,true);});updateTotal();}).catch(function(){});}
  window.bndToggleAddon=function(card){if(!card||card.classList.contains('locked'))return;var sel=!card.classList.contains('selected'),av=parseInt(card.dataset.variant,10);applySelected(card,sel);updateTotal();if(sel)showPopup(card);if(!av)return;if(sel){fetch('/cart.js').then(function(r){return r.json();}).then(function(cart){var ic=cart.items.map(function(i){return i.variant_id;}),items=[];if(BV&&ic.indexOf(BV)===-1)items.push({id:BV,quantity:1});if(ic.indexOf(av)===-1)items.push({id:av,quantity:1});if(!items.length){openCart();return null;}return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({items:items})}).then(function(r){return r.json();});}).then(function(res){if(!res)return;enforceQty();refreshCart();openCart();}).catch(function(){applySelected(card,false);updateTotal();});}else{fetch('/cart.js').then(function(r){return r.json();}).then(function(cart){var ak=null,kk=[];cart.items.forEach(function(item){if(String(item.variant_id)===String(av))ak=item.key;if(item.variant_id===BV)kk.push(item.key);});var tr=kk.slice();if(ak)tr.push(ak);if(!tr.length)return null;return Promise.all(tr.map(function(key){return fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({id:key,quantity:0})}).then(function(r){return r.json();});}));}).then(function(res){if(res===null)return null;return fetch('/cart.js').then(function(r){return r.json();});}).then(function(cart){if(!cart)return null;var rem=cart.items.filter(function(i){return i.variant_id===BV;});if(!rem.length)return true;return Promise.all(rem.map(function(item){return fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({id:item.key,quantity:0})}).then(function(r){return r.json();});})).then(function(){return true;});}).then(function(ok){if(!ok)return null;return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({items:[{id:BV,quantity:1}]})}).then(function(r){return r.json();});}).then(function(res){if(!res)return;refreshCart();}).catch(function(){applySelected(card,true);updateTotal();});}};
