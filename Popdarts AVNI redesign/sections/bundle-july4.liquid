<script>
/* ── ACCORDION ── */
document.querySelectorAll('.bnd-accordion .bnd-acc-trigger').forEach(function (trigger) {
  trigger.addEventListener('click', function () {
    var item   = trigger.closest('.bnd-acc-item');
    var isOpen = item.classList.contains('open');
    document.querySelectorAll('.bnd-accordion .bnd-acc-item').forEach(function (i) {
      i.classList.remove('open');
      i.querySelector('.bnd-acc-trigger').setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      item.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    }
  });
});
</script>

