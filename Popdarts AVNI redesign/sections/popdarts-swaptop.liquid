<section class="pd-page swaptop" id="swaptop-{{ section.id }}" aria-labelledby="swaptop-title-{{ section.id }}">
  <div class="pd-wrap swaptop__grid">
    <div class="swaptop__content">
      <p class="swaptop__eyebrow">{{ section.settings.eyebrow | default: 'Swaptop™ Kit' }}</p>
      <h2 id="swaptop-title-{{ section.id }}" style="color: #0a0c10 !important;">{{ section.settings.heading | default: 'Cornhole is outdated,' }}</h2>
      <h2 style="color: rgba(10,12,16,0.7) !important;">{{ section.settings.heading_2a | default: 'Cornhole is dead -' }} <span style="color: #17c440;">{{ section.settings.heading_2b | default: 'Be the life of the party.' }}</span></h2>
      <p class="swaptop__body">{{ section.settings.body | default: "The new American classic game. One Frame, Endless Games™ — Swaptop swaps between game boards with a single clip-in frame, so your backyard, patio or game night never has to stop to switch games." }}</p>

      <ol class="swaptop__steps">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span>{{ block.settings.label | default: 'Frame it' }}</span></li>
        {%- endfor -%}
      </ol>

      <div class="swaptop__price">
        <span class="swaptop__price-now">{{ section.settings.price_now | default: '$159.99' }}</span>
        <span class="swaptop__price-was">{{ section.settings.price_was | default: '$179.99' }}</span>
      </div>
      <p class="swaptop__includes">{{ section.settings.includes | default: 'Frame · double-sided Swaptop board · carrying case · 6 Rookie darts · bonus Pro Popdart' }}</p>

      <a class="btn btn--green" href="{{ section.settings.cta_link | default: '/products/swaptop-kit' }}">{{ section.settings.cta_text | default: 'Shop the Swaptop Kit' }}</a>
    </div>

    <div class="swaptop__media">
      <img src="{% if section.settings.image %}{{ section.settings.image | image_url: width: 1200 }}{% else %}{{ 'pd-marquee-court-cheer.jpg' | asset_url }}{% endif %}" alt="Players celebrating courtside — the host of the party, not just the game." loading="lazy">
      <span class="swaptop__media-tag">{{ section.settings.image_tag | default: 'Anyone who can play cornhole can play Swaptop' }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swaptop Showcase",
  "tag": "section",
  "class": "pd-section-swaptop",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Swaptop™ Kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading line 1",
      "default": "Cornhole is outdated,"
    },
    {
      "type": "text",
      "id": "heading_2a",
      "label": "Heading line 2 (white)",
      "default": "Cornhole is dead -"
    },
    {
      "type": "text",
      "id": "heading_2b",
      "label": "Heading line 2, part 2 (green)",
      "default": "Be the life of the party."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The new American classic game. One Frame, Endless Games™ — Swaptop swaps between game boards with a single clip-in frame, so your backyard, patio or game night never has to stop to switch games."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "image_tag",
      "label": "Image badge text",
      "default": "Anyone who can play cornhole can play Swaptop"
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "text",
      "id": "price_now",
      "label": "Price",
      "default": "$159.99"
    },
    {
      "type": "text",
      "id": "price_was",
      "label": "Compare-at price",
      "default": "$179.99"
    },
    {
      "type": "text",
      "id": "includes",
      "label": "What's included",
      "default": "Frame · double-sided Swaptop board · carrying case · 6 Rookie darts · bonus Pro Popdart"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop the Swaptop Kit"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Step label", "default": "Frame it" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swaptop Showcase",
      "blocks": [
        { "type": "step", "settings": { "label": "Frame it" } },
        { "type": "step", "settings": { "label": "Clip it" } },
        { "type": "step", "settings": { "label": "Play it" } },
        { "type": "step", "settings": { "label": "Swap it" } },
        { "type": "step", "settings": { "label": "Repeat it" } }
      ]
    }
  ]
}
{% endschema %}
