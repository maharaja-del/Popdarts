<script>
(function() {
  const sectionId = '{{ section.id }}';
  const root = document.querySelector('.vshow-' + sectionId);
  if (!root) return;

  const cards = root.querySelectorAll('[data-video-index]');
  const cardVideos = root.querySelectorAll('.vshow-' + sectionId + '-card video');

  const playObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const v = entry.target;
      if (entry.isIntersecting) v.play().catch(() => {});
      else v.pause();
    });
  }, { threshold: 0.1 });

  cardVideos.forEach(v => {
    playObserver.observe(v);
    v.play().catch(() => {});
  });

  const stats = root.querySelectorAll('[data-count-to]');
  const formatStat = (val, divisor, suffix, decimals) => {
    const num = val / divisor;
    return (decimals ? num.toFixed(decimals) : Math.round(num)) + suffix;
  };
  const animateCount = (el) => {
    const target = parseFloat(el.dataset.countTo);
    const divisor = parseFloat(el.dataset.divisor) || 1;
    const suffix = el.dataset.suffix || '';
    const decimals = parseInt(el.dataset.decimals || '0', 10);
    const duration = 1800;
    const start = performance.now();
    const step = (now) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = formatStat(target * eased, divisor, suffix, decimals);
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  const statObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        animateCount(entry.target);
        statObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });
  stats.forEach(s => statObserver.observe(s));

  const modal = root.querySelector('[data-modal]');
  const modalVideo = root.querySelector('[data-modal-video]');
  const modalMute = root.querySelector('[data-modal-mute]');
  const modalClose = root.querySelector('[data-modal-close]');
  const modalPrev = root.querySelector('[data-modal-prev]');
  const modalNext = root.querySelector('[data-modal-next]');
  const modalCounter = root.querySelector('[data-modal-counter]');

  const videoSrcs = Array.from(cards).map(c => c.querySelector('video').src);
  let currentIndex = 0;

  cards.forEach(card => {
    card.addEventListener('click', () => openModal(parseInt(card.dataset.videoIndex, 10)));
  });

  function openModal(index) {
    currentIndex = index;
    loadModalVideo();
    document.body.style.overflow = 'hidden';
    modal.classList.add('is-open');
  }
  function closeModal() {
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    modalVideo.pause();
    modalVideo.removeAttribute('src');
    modalVideo.load();
  }
  function loadModalVideo() {
    modalVideo.src = videoSrcs[currentIndex];
    modalVideo.muted = !modalMute.classList.contains('is-on');
    modalVideo.load();
    modalVideo.play().catch(() => {});
    modalCounter.textContent = (currentIndex + 1) + ' / ' + videoSrcs.length;
    modalPrev.disabled = currentIndex === 0;
    modalNext.disabled = currentIndex === videoSrcs.length - 1;
  }

  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  modalPrev.addEventListener('click', () => { if (currentIndex > 0) { currentIndex--; loadModalVideo(); } });
  modalNext.addEventListener('click', () => { if (currentIndex < videoSrcs.length - 1) { currentIndex++; loadModalVideo(); } });
  modalMute.addEventListener('click', () => {
    modalMute.classList.toggle('is-on');
    modalVideo.muted = !modalMute.classList.contains('is-on');
  });
  document.addEventListener('keydown', (e) => {
    if (!modal.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft' && currentIndex > 0) { currentIndex--; loadModalVideo(); }
    if (e.key === 'ArrowRight' && currentIndex < videoSrcs.length - 1) { currentIndex++; loadModalVideo(); }
  });

  // Move modal to body to escape any theme container constraints
  if (modal && modal.parentElement !== document.body) {
    document.body.appendChild(modal);
  }
})();
</script>

