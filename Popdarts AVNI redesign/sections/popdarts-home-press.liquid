<section class="pd-page home-press" id="home-press-{{ section.id }}" aria-labelledby="home-press-title-{{ section.id }}">
  <div class="pd-wrap home-press__grid">
    <div class="home-press__content">
      <p class="home-press__eyebrow">{{ section.settings.eyebrow | default: 'Free App' }}</p>
      <h2 id="home-press-title-{{ section.id }}" style="color: #0a0c10 !important;">{{ section.settings.heading | default: 'Track every match with Score Keeper.' }}</h2>
      <p class="home-press__body">{{ section.settings.body | default: "Cancellation scoring, done for you. Log rounds, settle arguments, and see who really has the aim — free on iOS and Android." }}</p>

      <div class="home-press__stores">
        <a class="store-badge" href="{{ section.settings.ios_url | default: 'https://apps.apple.com/us/app/popdarts-score-keeper/id6499262827' }}" aria-label="Download on the App Store">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M17.05 12.04c-.03-2.66 2.17-3.94 2.27-4-.01-.02-1.24-1.79-3.03-1.83-1.5-.15-2.75.83-3.46.83-.71 0-1.85-.81-3.05-.79-1.57.02-3.02.91-3.83 2.31-1.63 2.83-.42 7.02 1.17 9.32.78 1.13 1.72 2.4 2.94 2.35 1.18-.05 1.63-.76 3.06-.76s1.83.76 3.07.74c1.27-.02 2.08-1.15 2.86-2.29.9-1.31 1.27-2.58 1.28-2.65-.03-.01-2.45-.94-2.28-3.43zM14.65 4.6c.65-.79 1.09-1.88 .97-2.97-.94.04-2.07.63-2.75 1.41-.6.7-1.13 1.83-.99 2.9 1.05.08 2.12-.53 2.77-1.34z"/></svg>
          <span>
            <small>Download on the</small>
            App Store
          </span>
        </a>
        <a class="store-badge" href="{{ section.settings.android_url | default: 'https://play.google.com/store/apps/details?id=com.firebase.popdarts' }}" aria-label="Get it on Google Play">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M3.6 2.6c-.35.2-.6.6-.6 1.1v16.6c0 .5.25.9.6 1.1l9.35-9.4L3.6 2.6zm11.05 9.4 2.65 2.65 4-2.3c.7-.4.7-1.3 0-1.7l-4-2.3-2.65 2.65zM4.6 21.4l9.3-9.4-9.3-9.4c-.3.2-.5.5-.5.9v17c0 .4.2.7.5.9z"/></svg>
          <span>
            <small>Get it on</small>
            Google Play
          </span>
        </a>
      </div>

      <p class="home-press__apl">{{ section.settings.apl_note | default: 'Ready to compete for real?' }} <a href="{{ section.settings.apl_link | default: 'https://iplayapl.com/pages/get-a-membership' }}">Join the American Popdarts League →</a></p>
    </div>

    <div class="home-press__media" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="100%" height="100%" role="img" aria-label="Popdarts Score Keeper app icon">
        <rect x="60" y="16" width="200" height="288" rx="32" fill="#0a0c10"/>
        <rect x="72" y="40" width="176" height="216" rx="10" fill="#2b99ff"/>
        <circle cx="160" cy="132" r="52" fill="none" stroke="#fdfdfd" stroke-width="6"/>
        <circle cx="160" cy="132" r="30" fill="none" stroke="#fdfdfd" stroke-width="6"/>
        <circle cx="160" cy="132" r="10" fill="#fdfdfd"/>
        <rect x="96" y="204" width="128" height="14" rx="7" fill="#fdfdfd" opacity="0.85"/>
        <rect x="96" y="228" width="88" height="14" rx="7" fill="#fdfdfd" opacity="0.55"/>
        <circle cx="160" cy="284" r="10" fill="#fdfdfd" opacity="0.9"/>
      </svg>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home App + APL Promo",
  "tag": "section",
  "class": "pd-section-home-press",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Free App"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Track every match with Score Keeper."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Cancellation scoring, done for you. Log rounds, settle arguments, and see who really has the aim — free on iOS and Android."
    },
    {
      "type": "header",
      "content": "Store links"
    },
    {
      "type": "url",
      "id": "ios_url",
      "label": "App Store URL",
      "info": "Defaults to the live Popdarts Score Keeper App Store listing."
    },
    {
      "type": "url",
      "id": "android_url",
      "label": "Google Play URL",
      "info": "Defaults to the live Popdarts Score Keeper Play Store listing."
    },
    {
      "type": "header",
      "content": "APL"
    },
    {
      "type": "text",
      "id": "apl_note",
      "label": "APL line lead-in",
      "default": "Ready to compete for real?"
    },
    {
      "type": "url",
      "id": "apl_link",
      "label": "APL membership link",
      "info": "Defaults to https://iplayapl.com/pages/get-a-membership"
    }
  ],
  "presets": [
    {
      "name": "Home App + APL Promo"
    }
  ]
}
{% endschema %}
