{% comment %} How To Play POPDARTS — 4th of July USA Edition (static) {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
#htp{
  --navy:#0A1733;
  --blue:#1D4ED8;
  --red:#D7263D;
  --red2:#BF0A30;
  --gold:#FFC83D;
  --ink:#0A1733;
  --muted:#5b6b85;
  --e:cubic-bezier(.16,1,.3,1);

  font-family:'Inter',sans-serif;
  position:relative;
  overflow:hidden;
  padding:80px 0 92px;
  background:
    radial-gradient(900px 480px at 12% -10%, rgba(29,78,216,.30), transparent 60%),
    radial-gradient(900px 520px at 88% 0%, rgba(215,38,61,.26), transparent 60%),
    linear-gradient(180deg, #0A1733 0%, #0c1c44 55%, #0A1733 100%);
}

/* top + bottom stripe accents */
#htp .htp-stripe{
  position:absolute;left:0;right:0;height:6px;z-index:1;
  background:repeating-linear-gradient(90deg,var(--red) 0 40px,#fff 40px 80px,var(--blue) 80px 120px);
  opacity:.9;
}
#htp .htp-stripe--top{top:0}
#htp .htp-stripe--bot{bottom:0}

#htp .htp-wrap{
  position:relative;z-index:2;
  max-width:1240px;margin:0 auto;padding:0 28px;
}

/* ── HEADER ── */
#htp .htp-head{text-align:center;margin-bottom:54px}
#htp .htp-eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-size:11px;font-weight:800;letter-spacing:.26em;text-transform:uppercase;
  color:var(--gold);margin-bottom:16px;
  padding:8px 16px;border-radius:999px;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);
}
#htp .htp-eyebrow svg{width:13px;height:13px;fill:var(--gold)}
#htp .htp-title{
  margin:0;color:#fff;font-weight:900;text-transform:uppercase;
  font-size:clamp(30px,6vw,58px);line-height:.96;letter-spacing:-.03em;
  display:flex;align-items:center;justify-content:center;gap:.35em;flex-wrap:wrap;
}
#htp .htp-title .flag{font-size:.8em;filter:drop-shadow(0 4px 14px rgba(0,0,0,.4))}
#htp .htp-sub{
  margin:16px auto 0;max-width:560px;
  color:rgba(255,255,255,.62);font-size:15px;line-height:1.55;font-weight:400;
}

/* ── GRID ── */
#htp .htp-grid{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:22px;align-items:stretch;
}

/* ── STEP CARD ── */
#htp .htp-step{
  position:relative;
  background:linear-gradient(180deg,#ffffff 0%,#f6f8ff 100%);
  border:1px solid rgba(255,255,255,.7);
  border-radius:20px;
  padding:30px 24px 28px;
  box-shadow:0 18px 40px -22px rgba(3,10,32,.8);
  overflow:hidden;
  opacity:0;transform:translateY(22px);
  transition:opacity .6s var(--e),transform .6s var(--e),box-shadow .35s var(--e);
}
#htp .htp-step.in{opacity:1;transform:translateY(0)}
#htp .htp-step:hover{
  transform:translateY(-6px);
  box-shadow:0 26px 50px -20px rgba(3,10,32,.85);
}
/* top accent bar */
#htp .htp-step::before{
  content:'';position:absolute;top:0;left:0;right:0;height:5px;
  background:linear-gradient(90deg,var(--red),var(--blue));
}
#htp .htp-step-title{
  margin:0 0 9px;color:var(--ink);
  font-size:19px;font-weight:900;letter-spacing:-.01em;text-transform:uppercase;
}
/* small accent under each title */
#htp .htp-step-title::after{
  content:'';display:block;width:34px;height:3px;border-radius:2px;margin-top:12px;
  background:linear-gradient(90deg,var(--red),var(--blue));
}
#htp .htp-step-text{
  margin:0;color:var(--muted);font-size:14.5px;line-height:1.55;font-weight:500;
}

/* connector arrow between cards (desktop) */
#htp .htp-step:not(:last-child)::after{
  content:'';position:absolute;top:50%;right:-22px;transform:translateY(-50%);
  width:22px;height:2px;z-index:3;
  background:repeating-linear-gradient(90deg,rgba(255,255,255,.55) 0 5px,transparent 5px 10px);
}

/* ── VIDEO SHOWCASE ── */
#htp .htp-video-wrap{
  margin-top:70px;text-align:center;
  opacity:0;transform:translateY(28px);
  transition:opacity .75s var(--e),transform .75s var(--e);
}
#htp .htp-video-wrap.in{opacity:1;transform:translateY(0)}
#htp .htp-video-eyebrow{
  display:inline-flex;align-items:center;gap:12px;margin-bottom:24px;
  font-size:11px;font-weight:800;letter-spacing:.28em;text-transform:uppercase;color:#fff;
}
#htp .htp-video-eyebrow .ln{width:38px;height:1px;background:linear-gradient(90deg,transparent,var(--gold))}
#htp .htp-video-eyebrow .ln:last-child{background:linear-gradient(90deg,var(--gold),transparent)}
#htp .htp-video-eyebrow svg{width:14px;height:14px;fill:var(--gold)}

#htp .htp-video-stage{position:relative;max-width:940px;margin:0 auto}
#htp .htp-video-glow{
  position:absolute;left:50%;top:52%;transform:translate(-50%,-50%);
  width:90%;height:80%;z-index:0;pointer-events:none;border-radius:40px;
  background:
    radial-gradient(60% 60% at 28% 38%,rgba(215,38,61,.48),transparent 70%),
    radial-gradient(60% 60% at 76% 62%,rgba(29,78,216,.52),transparent 70%);
  filter:blur(56px);opacity:.85;
  animation:htp-glow 6s ease-in-out infinite;
}
@keyframes htp-glow{0%,100%{opacity:.6;transform:translate(-50%,-50%) scale(1)}50%{opacity:.95;transform:translate(-50%,-50%) scale(1.05)}}

#htp .htp-video-frame{
  position:relative;z-index:1;border-radius:26px;padding:3px;overflow:hidden;
  box-shadow:0 46px 100px -36px rgba(0,0,0,.95),0 0 0 1px rgba(255,255,255,.05);
}
#htp .htp-video-frame::before{
  content:'';position:absolute;inset:-60%;z-index:0;
  background:conic-gradient(from 0deg,var(--red),#ffffff,var(--blue),var(--red));
  animation:htp-spin 7s linear infinite;
}
#htp .htp-video-inner{
  position:relative;z-index:1;border-radius:23px;overflow:hidden;
  background:#000;aspect-ratio:16/9;cursor:pointer;
}
#htp .htp-video-inner video{width:100%;height:100%;object-fit:cover;display:block}
#htp .htp-video-inner::after{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(180deg,rgba(255,255,255,.05),transparent 28%,transparent 72%,rgba(0,0,0,.4));
}

/* center play / pause */
#htp .htp-vctrls{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;pointer-events:none}
#htp .htp-vplay{
  pointer-events:auto;width:76px;height:76px;border-radius:50%;cursor:pointer;
  background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.45);
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 12px 34px -8px rgba(0,0,0,.65);
  transition:transform .25s var(--e),background .25s,opacity .35s;
}
#htp .htp-vplay:hover{transform:scale(1.08);background:rgba(255,255,255,.28)}
#htp .htp-vplay svg{width:28px;height:28px;fill:#fff;stroke:none}
#htp .htp-vplay .ic-play{margin-left:4px}
#htp .htp-vplay .ic-pause{display:none}
#htp.is-playing .htp-vplay{opacity:0}
#htp.is-playing .htp-vplay .ic-play{display:none}
#htp.is-playing .htp-vplay .ic-pause{display:block}
#htp .htp-video-stage:hover .htp-vplay{opacity:1}

/* sound toggle */
#htp .htp-sound{
  pointer-events:auto;position:absolute;right:14px;bottom:14px;z-index:3;
  width:42px;height:42px;border-radius:12px;cursor:pointer;
  background:rgba(10,23,51,.55);border:1px solid rgba(255,255,255,.28);
  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);
  display:flex;align-items:center;justify-content:center;
  transition:background .2s,transform .2s;
}
#htp .htp-sound:hover{background:rgba(10,23,51,.85);transform:translateY(-2px)}
#htp .htp-sound svg{width:18px;height:18px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#htp .htp-sound .ic-unmuted{display:none}
#htp.is-unmuted .htp-sound .ic-muted{display:none}
#htp.is-unmuted .htp-sound .ic-unmuted{display:block}

/* ── CTA ── */
#htp .htp-cta-wrap{text-align:center;margin-top:48px}
#htp .htp-cta{
  display:inline-flex;align-items:center;gap:11px;
  background:linear-gradient(135deg,var(--red),var(--red2));
  color:#fff;font-size:14px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  text-decoration:none;border-radius:999px;padding:0 34px;height:56px;
  box-shadow:0 14px 30px -12px rgba(215,38,61,.85);
  transition:transform .2s var(--e),box-shadow .2s var(--e);
}
#htp .htp-cta:hover{transform:translateY(-2px);box-shadow:0 20px 38px -12px rgba(215,38,61,.9)}
#htp .htp-cta svg{width:17px;height:17px;fill:none;stroke:#fff;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

@keyframes htp-spin{to{transform:rotate(360deg)}}

/* ── TABLET ── */
@media(max-width:1023px){
  #htp .htp-grid{grid-template-columns:repeat(2,1fr);gap:18px}
  #htp .htp-step:not(:last-child)::after{display:none}
  #htp .htp-video-wrap{margin-top:56px}
}
/* ── MOBILE ── */
@media(max-width:599px){
  #htp{padding:54px 0 64px}
  #htp .htp-wrap{padding:0 18px}
  #htp .htp-head{margin-bottom:34px}
  #htp .htp-grid{grid-template-columns:1fr;gap:14px}
  #htp .htp-step{padding:22px 20px}
  #htp .htp-step-title{font-size:17px}
  #htp .htp-video-wrap{margin-top:42px}
  #htp .htp-video-eyebrow{margin-bottom:18px;letter-spacing:.2em}
  #htp .htp-video-frame{border-radius:20px}
  #htp .htp-video-inner{border-radius:17px}
  #htp .htp-vplay{width:60px;height:60px}
  #htp .htp-vplay svg{width:23px;height:23px}
  #htp .htp-cta-wrap{margin-top:30px}
}

@media(prefers-reduced-motion:reduce){
  #htp .htp-step{opacity:1 !important;transform:none !important;transition:none}
  #htp .htp-video-wrap{opacity:1 !important;transform:none !important}
  #htp .htp-video-frame::before{animation:none;background:linear-gradient(135deg,var(--red),#fff,var(--blue))}
  #htp .htp-video-glow{animation:none}
}
</style>

<section id="htp" aria-label="How To Play POPDARTS">
  <span class="htp-stripe htp-stripe--top" aria-hidden="true"></span>

  <div class="htp-wrap">

    <div class="htp-head">
      <div class="htp-eyebrow">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.2l7.1-.6z"/></svg>
        Game Guide
      </div>
      <h2 class="htp-title">
        <span class="flag">🇺🇸</span>
        How To Play POPDARTS
      </h2>
      <p class="htp-sub">Four easy steps to your next backyard showdown. Set it up anywhere — driveway, beach, or BBQ.</p>
    </div>

    <div class="htp-grid">

      <!-- STEP 1 — SETUP -->
      <div class="htp-step">
        <h3 class="htp-step-title">Setup</h3>
        <p class="htp-step-text">Place the target marker on a smooth surface and stand back at least 10 ft.</p>
      </div>

      <!-- STEP 2 — THROW -->
      <div class="htp-step">
        <h3 class="htp-step-title">Throw</h3>
        <p class="htp-step-text">Take turns throwing Popdarts towards the target.</p>
      </div>

      <!-- STEP 3 — SCORE -->
      <div class="htp-step">
        <h3 class="htp-step-title">Score</h3>
        <p class="htp-step-text">Use cancellation scoring to score the round. The team with the most points wins the round.</p>
      </div>

      <!-- STEP 4 — REPEAT -->
      <div class="htp-step">
        <h3 class="htp-step-title">Repeat</h3>
        <p class="htp-step-text">Winner of the previous round throws first next round. First to 21 points wins!</p>
      </div>

    </div>

    <!-- VIDEO SHOWCASE -->
    <div class="htp-video-wrap">
      <div class="htp-video-eyebrow">
        <span class="ln"></span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.2l7.1-.6z"/></svg>
        See It In Action
        <span class="ln"></span>
      </div>

      <div class="htp-video-stage">
        <div class="htp-video-glow" aria-hidden="true"></div>
        <div class="htp-video-frame">
          <div class="htp-video-inner">
            <video class="htp-video"
              src="https://cdn.shopify.com/videos/c/o/v/3b5aca1a17e04693a754534ea91669d3.mp4"
              autoplay muted loop playsinline preload="metadata" aria-label="POPDARTS gameplay"></video>

            <div class="htp-vctrls">
              <button class="htp-vplay" type="button" aria-label="Play or pause video">
                <svg class="ic-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <svg class="ic-pause" viewBox="0 0 24 24"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
              </button>
            </div>

            <button class="htp-sound" type="button" aria-label="Toggle sound">
              <svg class="ic-muted" viewBox="0 0 24 24"><path d="M11 5L6 9H2v6h4l5 4z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
              <svg class="ic-unmuted" viewBox="0 0 24 24"><path d="M11 5L6 9H2v6h4l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a9 9 0 0 1 0 14"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="htp-cta-wrap">
      <a class="htp-cta" href="#goti">
        Get Pro Pack
        <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

  </div>

  <span class="htp-stripe htp-stripe--bot" aria-hidden="true"></span>
</section>

<script>
(function(){
  var root = document.getElementById('htp');
  if(!root) return;

  /* ── video controls ── */
  var v = root.querySelector('.htp-video');
  if(v){
    var playBtn = root.querySelector('.htp-vplay');
    var soundBtn = root.querySelector('.htp-sound');
    var inner = root.querySelector('.htp-video-inner');
    var sync = function(){ root.classList.toggle('is-playing', !v.paused && !v.ended); };
    var toggle = function(){ if(v.paused){ v.play(); } else { v.pause(); } };
    v.addEventListener('play', sync);
    v.addEventListener('pause', sync);
    if(playBtn) playBtn.addEventListener('click', toggle);
    if(inner) inner.addEventListener('click', function(e){
      if(e.target.closest('.htp-sound') || e.target.closest('.htp-vplay')) return;
      toggle();
    });
    if(soundBtn) soundBtn.addEventListener('click', function(e){
      e.stopPropagation();
      v.muted = !v.muted;
      root.classList.toggle('is-unmuted', !v.muted);
    });
    sync();
  }

  /* ── scroll reveal ── */
  var revealEls = root.querySelectorAll('.htp-step, .htp-video-wrap');
  if(!('IntersectionObserver' in window)){
    revealEls.forEach(function(s){ s.classList.add('in'); });
    return;
  }
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting) return;
      e.target.classList.add('in');
      obs.unobserve(e.target);
    });
  },{threshold:0.15, rootMargin:'0px 0px -40px 0px'});
  root.querySelectorAll('.htp-step').forEach(function(s, i){ s.style.transitionDelay = (i * 90) + 'ms'; obs.observe(s); });
  var vw = root.querySelector('.htp-video-wrap');
  if(vw) obs.observe(vw);
})();
</script>
