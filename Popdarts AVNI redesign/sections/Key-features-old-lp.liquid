        <div class="sw2-hero-stage-{{ sid }}" onclick="sw2OpenLightbox_{{ sid }}()">

          <span class="sw2-hero-counter-{{ sid }}" id="sw2-hero-counter-{{ sid }}">01 / 05</span>

          <img
            id="sw2-hero-img-{{ sid }}"
            class="sw2-hero-img-{{ sid }}"
            src="{{ main_product.featured_image | image_url: width: 1200 }}"
            alt="{{ main_product.title }}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        </div>

        <div class="sw2-hero-thumbs-{{ sid }}" id="sw2-hero-thumbs-{{ sid }}">
          {% assign first_img = main_product.images | first %}
          <button type="button" class="sw2-hero-thumb-{{ sid }} active" data-src="{{ first_img | image_url: width: 1600 }}" data-idx="0" aria-label="Image 1">
            <img src="{{ first_img | image_url: width: 200 }}" alt="{{ main_product.title }} 1" loading="eager">
          </button>

          {% for image in main_product.images limit: 8 %}
            {% unless forloop.first %}
              <button type="button" class="sw2-hero-thumb-{{ sid }}" data-src="{{ image | image_url: width: 1600 }}" data-idx="{{ forloop.index | minus: 1 }}" aria-label="Image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 200 }}" alt="{{ main_product.title }} {{ forloop.index }}" loading="eager">
              </button>
            {% endunless %}
          {% endfor %}
        </div>
      </div>

      <!-- ── RIGHT COLUMN: info (addons + action bar + trust) ── -->
