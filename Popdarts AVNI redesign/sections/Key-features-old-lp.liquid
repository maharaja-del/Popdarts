        <span class="sw2-stars-icons-{{ sid }}">
          <span class="sw2-star-{{ sid }}">★</span>
          <span class="sw2-star-{{ sid }}">★</span>
          <span class="sw2-star-{{ sid }}">★</span>
          <span class="sw2-star-{{ sid }}">★</span>
          <span class="sw2-star-{{ sid }}">★</span>
