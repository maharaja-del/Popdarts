{% comment %}
  Swaptop Bundle v2 — Premium Configurator
  Drop into: sections/swaptop-bundle-v2.liquid
  Brand DNA matches "SS - Premium Video Showcase v5"
  Layout: Hero gallery (left) + 2x2 addon grid (right) + clean action bar
  Reuses v1's cart logic with sw2- class prefix (no collision with v1 bnd-)
{% endcomment %}

{% assign main_product   = all_products['swaptop-kit'] %}
{% assign addon_football = all_products['swaptop-football'] %}
{% assign addon_og       = all_products['swaptop-og'] %}
{% assign addon_popgolf  = all_products['swaptop-popgolf'] %}

{%- comment -%}
  sid = section.id sanitized to a valid JS identifier (no hyphens or dots).
  Used everywhere section.id was previously used so that JS function names,
  CSS class names, and DOM ids all stay in sync and onclick handlers work
  even when Shopify/Replo generates hyphenated section ids.
{%- endcomment -%}
{% assign sid = section.id | replace: '-', '_' | replace: '.', '_' %}

<style>
  /* ──────────────────────────────────────────────────────────
     SHELL — matches video showcase reference exactly
  ────────────────────────────────────────────────────────── */
  .sw2-section-{{ sid }} {
    position: relative;
    background: #050505;
    color: #fff;
    overflow-x: clip;
    isolation: isolate;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }
  .sw2-section-{{ sid }} *,
  .sw2-section-{{ sid }} *::before,
  .sw2-section-{{ sid }} *::after { box-sizing: border-box; }

  .sw2-section-{{ sid }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at center, black 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 25%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .sw2-section-{{ sid }}-inner {
    position: relative;
    z-index: 1;
    max-width: 1380px;
    margin: 0 auto;
    padding: 40px 18px 44px;
  }

  /* ──────────────────────────────────────────────────────────
     BULLETPROOF BUTTON RESET
  ────────────────────────────────────────────────────────── */
  .sw2-section-{{ sid }} button,
  body > .sw2-modal-{{ sid }} button {
    -webkit-appearance: none !important;
    appearance: none !important;
    border: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    min-width: 0 !important;
    min-height: 0 !important;
    line-height: 1 !important;
    font: inherit !important;
    color: inherit !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    cursor: pointer;
    box-sizing: border-box !important;
    box-shadow: none;
    background: transparent;
  }
  .sw2-section-{{ sid }} button::before,
  .sw2-section-{{ sid }} button::after,
  body > .sw2-modal-{{ sid }} button::before,
  body > .sw2-modal-{{ sid }} button::after {
    display: none !important;
    content: none !important;
  }

  /* ──────────────────────────────────────────────────────────
     EDITORIAL HEADER
  ────────────────────────────────────────────────────────── */
  .sw2-header-{{ sid }} {
    text-align: center;
    margin-bottom: 22px;
  }
  .sw2-headline-{{ sid }} {
    margin: 0;
    font-size: 36px;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: #fff;
  }
  .sw2-headline-{{ sid }} em {
    font-style: normal;
    color: #23ff53;
  }
  .sw2-sub-{{ sid }} {
    margin: 12px auto 0;
    font-size: 13px;
    line-height: 1.55;
    color: #fff;
    opacity: 0.65;
    max-width: 520px;
  }

  /* ──────────────────────────────────────────────────────────
     STATS ROW
  ────────────────────────────────────────────────────────── */
  .sw2-stats-{{ sid }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 22px auto 28px;
    max-width: 720px;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .sw2-stat-{{ sid }} {
    text-align: center;
    padding: 14px 8px;
  }
  .sw2-stat-{{ sid }} + .sw2-stat-{{ sid }} {
    border-left: 1px solid rgba(255,255,255,0.08);
  }
  .sw2-stat-num-{{ sid }} {
    display: block;
    font-size: 24px;
    font-weight: 900;
    line-height: 1;
    color: #fff;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .sw2-stat-num-{{ sid }}.is-accent { color: #23ff53; }
  .sw2-stat-num-{{ sid }} .sw2-star { color: #f59e0b; font-size: 18px; }
  .sw2-stat-label-{{ sid }} {
    display: block;
    margin-top: 6px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0.5;
  }

  /* ──────────────────────────────────────────────────────────
     MAIN BUNDLE LAYOUT — sticky hero left, info column right
  ────────────────────────────────────────────────────────── */
  .sw2-bundle-{{ sid }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: start;
  }

  .sw2-info-col-{{ sid }} {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  /* ──────────────────────────────────────────────────────────
     HERO GALLERY
  ────────────────────────────────────────────────────────── */
  .sw2-hero-{{ sid }} {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(160deg, #0f0f0f 0%, #050505 100%);
    border: 1px solid rgba(255,255,255,0.08);
    aspect-ratio: 4 / 4;
    display: flex;
    flex-direction: column;
  }

  .sw2-hero-stage-{{ sid }} {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: pointer;
  }
  .sw2-hero-stage-{{ sid }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 30%, rgba(35,255,83,0.12), transparent 50%),
      radial-gradient(circle at 70% 70%, rgba(35,255,83,0.04), transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .sw2-hero-stage-{{ sid }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(35,255,83,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(35,255,83,0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }

  .sw2-hero-img-{{ sid }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 36px 32px 78px;
    display: block;
    z-index: 1;
    transition: opacity 0.25s ease;
  }

  .sw2-hero-pill-{{ sid }} {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 4;
    padding: 5px 11px;
    border-radius: 5px;
    background: rgba(35,255,83,0.18);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(35,255,83,0.5);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #23ff53;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sw2-pulse-{{ sid }} {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #23ff53;
    box-shadow: 0 0 8px #23ff53;
    animation: sw2pulse-{{ sid }} 1.6s ease-in-out infinite;
  }
  @keyframes sw2pulse-{{ sid }} {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }

  .sw2-hero-counter-{{ sid }} {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 4;
    padding: 5px 11px;
    border-radius: 5px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.18);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .sw2-hero-thumbs-{{ sid }} {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    z-index: 4;
    display: flex;
    gap: 6px;
    justify-content: center;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sw2-hero-thumbs-{{ sid }}::-webkit-scrollbar { display: none; }

  .sw2-hero-thumb-{{ sid }} {
    width: 48px !important;
    height: 48px !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    cursor: pointer;
    border: 1.5px solid rgba(255,255,255,0.18) !important;
    background: rgba(0,0,0,0.55) !important;
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    flex-shrink: 0;
    transition: border-color 0.2s, transform 0.2s !important;
    padding: 0 !important;
  }
  .sw2-hero-thumb-{{ sid }}.active,
  .sw2-hero-thumb-{{ sid }}:hover {
    border-color: #23ff53 !important;
    transform: scale(1.05) !important;
  }
  .sw2-hero-thumb-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ──────────────────────────────────────────────────────────
     2X2 ADDON GRID
  ────────────────────────────────────────────────────────── */
  .sw2-addons-heading-{{ sid }} {
    margin: 0 0 2px;
    font-size: 20px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.025em;
    color: #fff;
  }

  .sw2-addons-{{ sid }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    align-content: stretch;
  }

  .sw2-card-{{ sid }} {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(160deg, #0f0f0f 0%, #050505 100%);
    border: 1px solid rgba(255,255,255,0.08);
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .sw2-card-{{ sid }}:not(.locked):hover {
    border-color: rgba(35,255,83,0.4);
    transform: translateY(-2px);
  }
  .sw2-card-{{ sid }}.selected {
    border-color: rgba(35,255,83,0.5);
    box-shadow: 0 0 0 1px rgba(35,255,83,0.25), 0 12px 32px rgba(35,255,83,0.16);
  }
  .sw2-card-{{ sid }}.locked {
    border-color: rgba(35,255,83,0.4);
  }

  .sw2-card-img-{{ sid }} {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(160deg, #1a1a1a, #0a0a0a);
    cursor: pointer;
  }
  .sw2-card-img-{{ sid }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(35,255,83,0.08), transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .sw2-card-img-{{ sid }} img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 1;
  }
  .sw2-card-img-{{ sid }}::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.55) 0%,
      rgba(0,0,0,0.1) 35%,
      rgba(0,0,0,0) 65%
    );
    pointer-events: none;
  }

  .sw2-card-tag-{{ sid }} {
    position: absolute;
    top: 9px;
    left: 9px;
    z-index: 4;
    padding: 4px 9px;
    border-radius: 5px;
    background: rgba(255,255,255,0.14);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.18);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }
  .sw2-card-tag-{{ sid }}.is-included {
    background: rgba(35,255,83,0.2);
    border-color: rgba(35,255,83,0.5);
    color: #23ff53;
  }
  .sw2-card-tag-{{ sid }}.is-fave {
    background: #d50000;
    border-color: #d50000;
    color: #fff;
    font-weight: 900;
    box-shadow: 0 4px 14px rgba(213,0,0,0.45);
  }

  .sw2-card-action-{{ sid }} {
    position: absolute !important;
    top: 9px !important;
    right: 9px !important;
    z-index: 4 !important;
    width: 32px !important;
    height: 32px !important;
    aspect-ratio: 1 !important;
    border-radius: 50% !important;
    background: rgba(0,0,0,0.55) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255,255,255,0.2) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.25s ease !important;
  }
  .sw2-card-action-{{ sid }}:hover {
    background: #23ff53 !important;
    border-color: #23ff53 !important;
    transform: scale(1.08) !important;
  }
  .sw2-card-action-{{ sid }}:hover svg { stroke: #000 !important; }
  .sw2-card-action-{{ sid }} svg {
    width: 14px;
    height: 14px;
    stroke: #fff;
    transition: stroke 0.2s ease;
  }
  .sw2-card-{{ sid }}.selected .sw2-card-action-{{ sid }} {
    background: #23ff53 !important;
    border-color: #23ff53 !important;
    box-shadow: 0 0 18px rgba(35,255,83,0.5) !important;
  }
  .sw2-card-{{ sid }}.selected .sw2-card-action-{{ sid }} svg { stroke: #000 !important; }
  .sw2-card-{{ sid }}.locked .sw2-card-action-{{ sid }} {
    background: rgba(35,255,83,0.2) !important;
    border-color: rgba(35,255,83,0.5) !important;
    pointer-events: none !important;
  }
  .sw2-card-{{ sid }}.locked .sw2-card-action-{{ sid }} svg { stroke: #23ff53 !important; }

  .sw2-card-action-{{ sid }} .sw2-icon-check { display: none; }
  .sw2-card-action-{{ sid }} .sw2-icon-plus  { display: block; }
  .sw2-card-{{ sid }}.selected .sw2-card-action-{{ sid }} .sw2-icon-plus  { display: none; }
  .sw2-card-{{ sid }}.selected .sw2-card-action-{{ sid }} .sw2-icon-check { display: block; }
  .sw2-card-{{ sid }}.locked .sw2-card-action-{{ sid }} .sw2-icon-plus  { display: none; }
  .sw2-card-{{ sid }}.locked .sw2-card-action-{{ sid }} .sw2-icon-check { display: block; }

  .sw2-card-body-{{ sid }} {
    padding: 12px 14px 13px;
    background: rgba(0,0,0,0.35);
    border-top: 1px solid rgba(255,255,255,0.06);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
    min-height: 86px;
    cursor: pointer;
  }
  .sw2-card-{{ sid }}.selected .sw2-card-body-{{ sid }},
  .sw2-card-{{ sid }}.locked   .sw2-card-body-{{ sid }} {
    border-top-color: rgba(35,255,83,0.25);
  }
  .sw2-card-{{ sid }}.locked .sw2-card-body-{{ sid }} { cursor: default; }

  .sw2-card-eyebrow-{{ sid }} {
    display: block;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0.55;
    margin-bottom: 4px;
  }
  .sw2-card-{{ sid }}.selected .sw2-card-eyebrow-{{ sid }},
  .sw2-card-{{ sid }}.locked   .sw2-card-eyebrow-{{ sid }} {
    color: #23ff53;
    opacity: 1;
  }

  .sw2-card-title-{{ sid }} {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.18;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .sw2-card-meta-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 4px;
  }

  .sw2-card-price-{{ sid }} {
    font-size: 13px;
    font-weight: 800;
    color: #fff;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .sw2-card-{{ sid }}.selected .sw2-card-price-{{ sid }},
  .sw2-card-{{ sid }}.locked   .sw2-card-price-{{ sid }} {
    color: #23ff53;
  }

  .sw2-card-detail-btn-{{ sid }} {
    font-size: 9px !important;
    font-weight: 800 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    color: #fff !important;
    opacity: 0.55;
    background: transparent !important;
    padding: 4px 0 !important;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  .sw2-card-detail-btn-{{ sid }}:hover { opacity: 1; color: #23ff53 !important; }

  /* ──────────────────────────────────────────────────────────
     INCLUDED BASE BANNER — clearly shows what's already in the kit,
     high contrast & easy to read, sits above "Add more tops"
  ────────────────────────────────────────────────────────── */
  .sw2-included-{{ sid }} {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 14px;
    background: linear-gradient(160deg, rgba(35,255,83,0.10) 0%, rgba(10,10,10,0.5) 100%);
    border: 1px solid rgba(35,255,83,0.45);
    box-shadow: 0 0 0 1px rgba(35,255,83,0.15), 0 10px 28px rgba(35,255,83,0.10);
  }
  .sw2-included-img-{{ sid }} {
    position: relative;
    width: 74px;
    height: 74px;
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(160deg, #1a1a1a, #0a0a0a);
    cursor: pointer;
  }
  .sw2-included-img-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sw2-included-body-{{ sid }} {
    flex: 1;
    min-width: 0;
  }
  .sw2-included-eyebrow-{{ sid }} {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #23ff53;
    margin-bottom: 5px;
  }
  .sw2-included-eyebrow-{{ sid }} svg {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }
  .sw2-included-title-{{ sid }} {
    margin: 0;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.15;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .sw2-included-price-{{ sid }} {
    flex-shrink: 0;
    align-self: center;
    font-size: 15px;
    font-weight: 900;
    color: #fff;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .sw2-addons-sub-{{ sid }} {
    margin: 0 0 4px;
    font-size: 12px;
    line-height: 1.45;
    color: #fff;
    opacity: 0.6;
  }

  /* Added popup overlay on card */
  .sw2-card-popup-{{ sid }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
    background: rgba(0, 0, 0, 0);
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .sw2-card-popup-{{ sid }}.show {
    opacity: 1;
    background: rgba(0, 0, 0, 0.55);
  }
  .sw2-card-popup-badge-{{ sid }} {
    background: #23ff53;
    color: #000;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 10px 18px;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 7px;
    box-shadow:
      0 0 0 4px rgba(35,255,83,0.3),
      0 8px 32px rgba(0,0,0,0.45),
      0 0 60px rgba(35,255,83,0.4);
    transform: scale(0.6) rotate(-4deg);
    transition: transform 0.4s cubic-bezier(0.34, 1.7, 0.64, 1);
  }
  .sw2-card-popup-{{ sid }}.show .sw2-card-popup-badge-{{ sid }} {
    transform: scale(1) rotate(0deg);
  }
  .sw2-card-popup-badge-{{ sid }} svg {
    width: 14px;
    height: 14px;
    stroke: #000;
    flex-shrink: 0;
  }
</style>

<style>
  /* ──────────────────────────────────────────────────────────
     ACTION BAR — single row: total left, CTA right (auto-width on desktop)
  ────────────────────────────────────────────────────────── */
  .sw2-actionbar-{{ sid }} {
    margin-top: 4px;
    background: linear-gradient(180deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.015) 100%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .sw2-total-row-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    width: 100%;
  }

  .sw2-total-label-{{ sid }} {
    font-size: 15px;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .sw2-total-prices-{{ sid }} {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .sw2-total-compare-{{ sid }} {
    font-size: 16px;
    color: #fff;
