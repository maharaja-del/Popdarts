<script>
(function () {

  /* ── PRICES (cents from Liquid) ── */
  var SW2_BASE_PRICE   = {{ main_product.price }};
  var SW2_BASE_COMPARE = {{ main_product.compare_at_price | default: main_product.price }};
  var SW2_MAIN_VARIANT = {{ main_product.first_available_variant.id }};

  /* ── DOM REFS ── */
  var sectionEl    = document.querySelector('.sw2-section-{{ sid }}');
  if (!sectionEl) return;

  var heroImg      = document.getElementById('sw2-hero-img-{{ sid }}');
  var heroCounter  = document.getElementById('sw2-hero-counter-{{ sid }}');
  var heroThumbsWrap = document.getElementById('sw2-hero-thumbs-{{ sid }}');
  var heroThumbBtns  = heroThumbsWrap ? heroThumbsWrap.querySelectorAll('.sw2-hero-thumb-{{ sid }}') : [];
  var totalEl      = document.getElementById('sw2-total-{{ sid }}');
  var totalCompareEl = document.getElementById('sw2-total-compare-{{ sid }}');
  var totalSavingsEl = null;
  var totalSavingsText = null;
  var kitPillsEl   = document.getElementById('sw2-kit-pills-{{ sid }}');
  var ctaBtn       = document.getElementById('sw2-cta-{{ sid }}');
  var ctaText      = document.getElementById('sw2-cta-text-{{ sid }}');

  /* ── KIT PILL HTML BUILDER (image + name) ── */
  var SW2_PILL_DATA = {
    'sw2-card-football-{{ sid }}': {
      name: '{{ addon_football.title | escape }}',
      img:  '{{ addon_football.featured_image | image_url: width: 100 }}'
    },
    'sw2-card-og-{{ sid }}': {
      name: '{{ addon_og.title | escape }}',
      img:  '{{ addon_og.featured_image | image_url: width: 100 }}'
    },
    'sw2-card-popgolf-{{ sid }}': {
      name: '{{ addon_popgolf.title | escape }}',
      img:  '{{ addon_popgolf.featured_image | image_url: width: 100 }}'
    }
  };

  var SW2_FRAME_PILL_HTML =
    '<span class="sw2-kit-pill-{{ sid }}">' +
      '<span class="sw2-kit-pill-img-{{ sid }}">' +
        '<img src="{{ main_product.featured_image | image_url: width: 100 }}" alt="">' +
      '</span>Frame</span>';

  /* ──────────────────────────────────────────
     ADDED POPUP
  ────────────────────────────────────────── */
  function sw2ShowAddedPopup(card) {
    var overlay = card && card.querySelector('.sw2-card-popup-{{ sid }}');
    if (!overlay) return;
    if (overlay._hideTimer) clearTimeout(overlay._hideTimer);
    overlay.classList.add('show');
    overlay._hideTimer = setTimeout(function () { overlay.classList.remove('show'); }, 1500);
  }

  /* ──────────────────────────────────────────
     HERO THUMBS + LIGHTBOX SOURCES
  ────────────────────────────────────────── */
  var SW2_LB_IMAGES = [];
  heroThumbBtns.forEach(function (t, i) {
    SW2_LB_IMAGES.push(t.dataset.src);
    t.addEventListener('click', function () {
      heroThumbBtns.forEach(function (x) { x.classList.remove('active'); });
      t.classList.add('active');
      heroImg.style.opacity = '0';
      setTimeout(function () {
        heroImg.src = t.dataset.src;
        heroImg.style.opacity = '1';
      }, 180);
      var total = heroThumbBtns.length;
      heroCounter.textContent = String(i + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');
    });
  });
  if (heroCounter) {
    var total = heroThumbBtns.length;
    heroCounter.textContent = '01 / ' + String(total).padStart(2, '0');
  }

  /* ──────────────────────────────────────────
     CART HELPERS
  ────────────────────────────────────────── */
  function sw2OpenCartDrawer() {
    var btn = document.querySelector('[data-cart-toggle],.cart-toggle,#cart-toggle,.js-cart-open');
    if (btn) { btn.click(); return; }
    document.dispatchEvent(new CustomEvent('cart:open'));
    document.dispatchEvent(new CustomEvent('theme:cart:open'));
  }

  function sw2RefreshCart() {
    fetch('/cart.js')
      .then(function(r){ return r.json(); })
      .then(function(cart){
        var n = cart.item_count;
        document.querySelectorAll(
          '[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,#CartCount,.header__cart-count,.cart-count-bubble [aria-hidden]'
        ).forEach(function(el){ el.textContent = n; });
      }).catch(function(){});

    fetch('/?sections=cart-drawer,cart-icon-bubble')
      .then(function(r){ return r.json(); })
      .then(function(sections){
        if (sections['cart-drawer']) {
          var liveDrawer  = document.querySelector('cart-drawer');
          var sectionWrap = liveDrawer && liveDrawer.closest('[id^="shopify-section-"]');
          if (sectionWrap) {
            sectionWrap.innerHTML = sections['cart-drawer'];
          } else if (liveDrawer) {
            var doc = new DOMParser().parseFromString(sections['cart-drawer'], 'text/html');
            var fd  = doc.querySelector('cart-drawer');
            if (fd) liveDrawer.outerHTML = fd.outerHTML;
          }
        }
        if (sections['cart-icon-bubble']) {
          var countEl  = document.querySelector('[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,.cart-count-bubble');
          var iconWrap = countEl && countEl.closest('[id^="shopify-section-"]');
          if (iconWrap) iconWrap.innerHTML = sections['cart-icon-bubble'];
        }
      }).catch(function(){});
  }

  function sw2EnforceKitQty() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      for (var i = 0; i < cart.items.length; i++) {
        if (cart.items[i].variant_id === SW2_MAIN_VARIANT && cart.items[i].quantity > 1) {
          fetch('/cart/change.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ id: cart.items[i].key, quantity: 1 })
          }).then(function(r){ return r.json(); }).then(sw2RefreshCart).catch(function(){});
          break;
        }
      }
    }).catch(function(){});
  }

  /* ──────────────────────────────────────────
     APPLY SELECTED STATE
  ────────────────────────────────────────── */
  function sw2ApplySelected(card, selected) {
    card.classList.toggle('selected', selected);
  }

  /* ──────────────────────────────────────────
     KIT PILLS — rebuild from current selection
  ────────────────────────────────────────── */
  function sw2RenderKitPills() {
    if (!kitPillsEl) return;
    var html = SW2_FRAME_PILL_HTML;
    document.querySelectorAll('.sw2-card-{{ sid }}.selected:not(.locked)').forEach(function (card) {
      var data = SW2_PILL_DATA[card.id];
      if (!data) return;
      html += '<span class="sw2-kit-plus-{{ sid }}">+</span>';
      html += '<span class="sw2-kit-pill-{{ sid }}">' +
                '<span class="sw2-kit-pill-img-{{ sid }}">' +
                  '<img src="' + data.img + '" alt="">' +
                '</span>' +
                data.name.split(' ')[0] +
              '</span>';
    });
    kitPillsEl.innerHTML = html;
  }

  /* ──────────────────────────────────────────
     SYNC FROM CART ON LOAD
  ────────────────────────────────────────── */
  function sw2SyncFromCart() {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var inCart = cart.items.map(function(i){ return i.variant_id; });
      document.querySelectorAll('.sw2-card-{{ sid }}:not(.locked)').forEach(function(card){
        var v = parseInt(card.dataset.variant, 10);
        if (v && inCart.indexOf(v) !== -1) sw2ApplySelected(card, true);
      });
      sw2UpdateTotal();
      sw2RenderKitPills();
    }).catch(function(){});
  }

  /* ──────────────────────────────────────────
     TOGGLE ADDON (UI + cart sync)
  ────────────────────────────────────────── */
  window['sw2ToggleAddon_{{ sid }}'] = function (card) {
    if (!card || card.classList.contains('locked')) return;
    var selecting    = !card.classList.contains('selected');
    var addonVariant = parseInt(card.dataset.variant, 10);

    sw2ApplySelected(card, selecting);
    sw2UpdateTotal();
    sw2RenderKitPills();

    if (selecting) sw2ShowAddedPopup(card);
    if (!addonVariant) return;

    if (selecting) {
      /* ── ADD ── */
      fetch('/cart.js')
        .then(function(r){ return r.json(); })
        .then(function(cart){
          var inCart = cart.items.map(function(i){ return i.variant_id; });
          var items  = [];
          if (SW2_MAIN_VARIANT && inCart.indexOf(SW2_MAIN_VARIANT) === -1)
            items.push({ id: SW2_MAIN_VARIANT, quantity: 1 });
          if (inCart.indexOf(addonVariant) === -1)
            items.push({ id: addonVariant, quantity: 1 });
          if (!items.length) { sw2OpenCartDrawer(); return null; }
          return fetch('/cart/add.js', {
            method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ items: items })
          }).then(function(r){ return r.json(); });
        })
        .then(function(result){
          if (!result) return;
          sw2EnforceKitQty();
          sw2RefreshCart();
          sw2OpenCartDrawer();
        })
        .catch(function(){
          sw2ApplySelected(card, false);
          sw2UpdateTotal();
          sw2RenderKitPills();
        });

    } else {
      /* ── REMOVE ── */
      fetch('/cart.js')
        .then(function(r){ return r.json(); })
        .then(function(cart){
          var addonKey = null;
          var kitKeys  = [];
          cart.items.forEach(function(item){
            if (String(item.variant_id) === String(addonVariant)) addonKey = item.key;
            if (item.variant_id === SW2_MAIN_VARIANT)             kitKeys.push(item.key);
          });
          var toRemove = kitKeys.slice();
          if (addonKey) toRemove.push(addonKey);
          if (!toRemove.length) return null;
          return Promise.all(toRemove.map(function(key){
            return fetch('/cart/change.js', {
              method:'POST',
              headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
              body: JSON.stringify({ id: key, quantity: 0 })
            }).then(function(r){ return r.json(); });
          }));
        })
        .then(function(result){
          if (result === null) return null;
          return fetch('/cart.js').then(function(r){ return r.json(); });
        })
        .then(function(cart){
          if (!cart) return null;
          var remaining = cart.items.filter(function(i){ return i.variant_id === SW2_MAIN_VARIANT; });
          if (!remaining.length) return true;
          return Promise.all(remaining.map(function(item){
            return fetch('/cart/change.js', {
              method:'POST',
              headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
              body: JSON.stringify({ id: item.key, quantity: 0 })
            }).then(function(r){ return r.json(); });
          })).then(function(){ return true; });
        })
        .then(function(ok){
          if (!ok) return null;
          return fetch('/cart/add.js', {
            method:'POST',
            headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body: JSON.stringify({ items: [{ id: SW2_MAIN_VARIANT, quantity: 1 }] })
          }).then(function(r){ return r.json(); });
        })
        .then(function(result){
          if (!result) return;
          sw2RefreshCart();
        })
        .catch(function(){
          sw2ApplySelected(card, true);
          sw2UpdateTotal();
          sw2RenderKitPills();
        });
    }
  };

  /* ──────────────────────────────────────────
     FORMAT MONEY
  ────────────────────────────────────────── */
  function sw2Money(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  /* ──────────────────────────────────────────
     UPDATE TOTAL
  ────────────────────────────────────────── */
  function sw2UpdateTotal() {
    var total   = SW2_BASE_PRICE;
    var compare = SW2_BASE_COMPARE;

    document.querySelectorAll('.sw2-card-{{ sid }}:not(.locked).selected').forEach(function (card) {
      var p = parseInt(card.dataset.price,   10) || 0;
      var c = parseInt(card.dataset.compare, 10) || 0;
      total   += p;
      compare += (c > 0 ? c : p);
    });

    if (totalEl) totalEl.textContent = sw2Money(total);

    var saved = compare - total;
    if (saved > 0) {
      if (totalCompareEl) {
        totalCompareEl.textContent = sw2Money(compare);
        totalCompareEl.style.cssText = 'display:inline;';
      }
      if (totalSavingsEl) {
        if (totalSavingsText) totalSavingsText.textContent = 'SAVE ' + sw2Money(saved);
        totalSavingsEl.style.cssText = 'display:inline-flex;';
      }
    } else {
      if (totalCompareEl) totalCompareEl.style.cssText = 'display:none;';
      if (totalSavingsEl) totalSavingsEl.style.cssText = 'display:none;';
    }

    if (totalEl) {
      totalEl.classList.remove('bump');
      void totalEl.offsetWidth;
      totalEl.classList.add('bump');
      setTimeout(function () { totalEl.classList.remove('bump'); }, 300);
    }
  }

  /* ──────────────────────────────────────────
     COLLECT CART ITEMS
  ────────────────────────────────────────── */
  function sw2GetItems() {
    var items = [{ id: SW2_MAIN_VARIANT, quantity: 1 }];
    document.querySelectorAll('.sw2-card-{{ sid }}:not(.locked).selected').forEach(function (card) {
      if (card.dataset.variant) items.push({ id: parseInt(card.dataset.variant, 10), quantity: 1 });
    });
    return items;
  }

  /* ──────────────────────────────────────────
     ADD TO CART (main CTA)
  ────────────────────────────────────────── */
  window['sw2AddToCart_{{ sid }}'] = function () {
    if (!ctaBtn) return;
    if (ctaBtn.classList.contains('loading')) return;
    ctaBtn.classList.add('loading');
    if (ctaText) ctaText.textContent = 'Adding...';

    document.querySelectorAll('.sw2-card-{{ sid }}:not(.locked).selected').forEach(function(card, i) {
      setTimeout(function(){ sw2ShowAddedPopup(card); }, i * 120);
    });

    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var inCart   = cart.items.map(function (i) { return i.variant_id; });
        var allItems = sw2GetItems();
        var toAdd    = allItems.filter(function (item) { return inCart.indexOf(item.id) === -1; });
        sw2OpenCartDrawer();
        if (!toAdd.length) {
          ctaBtn.classList.remove('loading');
          if (ctaText) ctaText.textContent = 'Added ✓';
          setTimeout(function () { if (ctaText) ctaText.textContent = 'Add to Cart'; }, 2000);
          return null;
        }
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ items: toAdd })
        }).then(function (r) { return r.json(); });
      })
      .then(function (data) {
        if (!data) return;
        if (data.status && data.status >= 400) throw new Error(data.description || 'Cart error');
        sw2EnforceKitQty();
        sw2RefreshCart();
        ctaBtn.classList.remove('loading');
        if (ctaText) ctaText.textContent = 'Added ✓';
        setTimeout(function () { if (ctaText) ctaText.textContent = 'Add to Cart'; }, 2000);
      })
      .catch(function () {
        ctaBtn.classList.remove('loading');
        if (ctaText) ctaText.textContent = 'Try Again';
        setTimeout(function () { if (ctaText) ctaText.textContent = 'Add to Cart'; }, 2500);
      });
  };

  /* ──────────────────────────────────────────
     SCROLL TO REVIEWS
  ────────────────────────────────────────── */
  window['sw2ScrollToReviews_{{ sid }}'] = function () {
    var target = document.querySelector('.jdgm-rev-widg__header');
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  /* ──────────────────────────────────────────
     ACCORDION
  ────────────────────────────────────────── */
  document.querySelectorAll('.sw2-acc-{{ sid }} .sw2-acc-trigger-{{ sid }}').forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      var item   = trigger.closest('.sw2-acc-item-{{ sid }}');
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.sw2-acc-{{ sid }} .sw2-acc-item-{{ sid }}').forEach(function (i) {
        i.classList.remove('open');
        var trg = i.querySelector('.sw2-acc-trigger-{{ sid }}');
        if (trg) trg.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* ──────────────────────────────────────────
     INITIAL RENDER — must run on first paint
     so strikethrough + savings show immediately
  ────────────────────────────────────────── */
  sw2UpdateTotal();
  sw2SyncFromCart();

})();
</script>

<script>
(function () {
  /* ──────────────────────────────────────────
     LIGHTBOX (hero gallery)
  ────────────────────────────────────────── */
  var SW2_LB_IMAGES_DEFAULT = [
    {% assign first_img = main_product.images | first %}
    '{{ first_img | image_url: width: 1600 }}',
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Images_Popdarts_Images1.jpg?v=1778015525',
    'https://cdn.shopify.com/s/files/1/0471/3375/3505/files/Group_1484581343.png?v=1778015640'
    {% for image in main_product.images limit: 3 %}{% unless forloop.first %},'{{ image | image_url: width: 1600 }}'{% endunless %}{% endfor %}
  ];

  var SW2_FOOTBALL_LB = [{% for img in addon_football.images %}'{{ img | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}{% endfor %}];
  var SW2_OG_LB       = [{% for img in addon_og.images       %}'{{ img | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}{% endfor %}];
  var SW2_POPGOLF_LB  = [{% for img in addon_popgolf.images  %}'{{ img | image_url: width: 1600 }}'{% unless forloop.last %},{% endunless %}{% endfor %}];

  var SW2_CARD_LB_MAP = {
    'sw2-card-football-{{ sid }}': SW2_FOOTBALL_LB,
    'sw2-card-og-{{ sid }}':       SW2_OG_LB,
    'sw2-card-popgolf-{{ sid }}':  SW2_POPGOLF_LB
  };

  var lbEl       = document.getElementById('sw2-lightbox-{{ sid }}');
  var lbImg      = document.getElementById('sw2-lb-img-{{ sid }}');
  var lbPrev     = document.getElementById('sw2-lb-prev-{{ sid }}');
  var lbNext     = document.getElementById('sw2-lb-next-{{ sid }}');
  var lbCounter  = document.getElementById('sw2-lb-counter-{{ sid }}');
  var lbImages   = SW2_LB_IMAGES_DEFAULT.slice();
  var lbIndex    = 0;

  function sw2RenderLb() {
    if (!lbImg) return;
    lbImg.style.opacity = '0';
    setTimeout(function () {
      lbImg.src = lbImages[lbIndex];
      lbImg.style.opacity = '1';
    }, 120);
    if (lbCounter) lbCounter.textContent = String(lbIndex + 1).padStart(2, '0') + ' / ' + String(lbImages.length).padStart(2, '0');
    if (lbPrev) lbPrev.disabled = lbIndex === 0;
    if (lbNext) lbNext.disabled = lbIndex === lbImages.length - 1;
  }

  window['sw2OpenLightbox_{{ sid }}'] = function (imageList, startIndex) {
    if (!lbEl) return;
    if (Array.isArray(imageList) && imageList.length) {
      lbImages = imageList.slice();
      lbIndex  = startIndex || 0;
    } else {
      lbImages = SW2_LB_IMAGES_DEFAULT.slice();
      var activeThumb = document.querySelector('.sw2-hero-thumb-{{ sid }}.active');
      lbIndex = activeThumb ? parseInt(activeThumb.dataset.idx, 10) || 0 : 0;
    }
    lbEl.classList.add('active');
    document.body.style.overflow = 'hidden';
    sw2RenderLb();
  };

  window['sw2CloseLightbox_{{ sid }}'] = function () {
    if (!lbEl) return;
    lbEl.classList.remove('active');
    document.body.style.overflow = '';
  };

  window['sw2LightboxNav_{{ sid }}'] = function (delta) {
    var next = lbIndex + delta;
    if (next < 0 || next > lbImages.length - 1) return;
    lbIndex = next;
    sw2RenderLb();
  };

  /* Card image click → open lightbox if there are multiple images, else toggle */
  window['sw2CardImgClick_{{ sid }}'] = function (e, imgEl) {
    e.stopPropagation();
    var card = imgEl.closest('.sw2-card-{{ sid }}');
    if (!card) return;
    var imgList = SW2_CARD_LB_MAP[card.id];
    if (imgList && imgList.length > 0) {
      window['sw2OpenLightbox_{{ sid }}'](imgList, 0);
    } else {
      window['sw2ToggleAddon_{{ sid }}'](card);
    }
  };

  /* Click outside to close */
  if (lbEl) {
    lbEl.addEventListener('click', function (e) {
      if (e.target === lbEl) window['sw2CloseLightbox_{{ sid }}']();
    });
  }

  /* Keyboard nav */
  document.addEventListener('keydown', function (e) {
    if (!lbEl || !lbEl.classList.contains('active')) return;
    if (e.key === 'Escape')      window['sw2CloseLightbox_{{ sid }}']();
    if (e.key === 'ArrowLeft')   window['sw2LightboxNav_{{ sid }}'](-1);
    if (e.key === 'ArrowRight')  window['sw2LightboxNav_{{ sid }}'](1);
  });

  /* Touch swipe */
  var lbTouchX = null;
  if (lbEl) {
    lbEl.addEventListener('touchstart', function (e) { lbTouchX = e.touches[0].clientX; }, { passive: true });
    lbEl.addEventListener('touchend',   function (e) {
      if (lbTouchX === null) return;
      var dx = e.changedTouches[0].clientX - lbTouchX;
      if (Math.abs(dx) > 60) window['sw2LightboxNav_{{ sid }}'](dx > 0 ? -1 : 1);
      lbTouchX = null;
    }, { passive: true });
  }
})();
</script>

<script>
(function () {
  /* ──────────────────────────────────────────
     QUICK VIEW MODAL
  ────────────────────────────────────────── */
  var SW2_QV_DATA = {
    'sw2-card-football-{{ sid }}': {
      title:   '{{ addon_football.title | escape }}',
      desc:    {{ addon_football.description | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_football.price }},
      compare: {{ addon_football.compare_at_price | default: 0 }},
      images:  [{% for img in addon_football.images %}'{{ img | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}],
      thumbs:  [{% for img in addon_football.images %}'{{ img | image_url: width: 120 }}'{% unless forloop.last %},{% endunless %}{% endfor %}]
    },
    'sw2-card-og-{{ sid }}': {
      title:   '{{ addon_og.title | escape }}',
      desc:    {{ addon_og.description | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_og.price }},
      compare: {{ addon_og.compare_at_price | default: 0 }},
      images:  [{% for img in addon_og.images %}'{{ img | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}],
      thumbs:  [{% for img in addon_og.images %}'{{ img | image_url: width: 120 }}'{% unless forloop.last %},{% endunless %}{% endfor %}]
    },
    'sw2-card-popgolf-{{ sid }}': {
      title:   '{{ addon_popgolf.title | escape }}',
      desc:    {{ addon_popgolf.description | json | replace: '</script>', '<\/script>' }},
      price:   {{ addon_popgolf.price }},
      compare: {{ addon_popgolf.compare_at_price | default: 0 }},
      images:  [{% for img in addon_popgolf.images %}'{{ img | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}],
      thumbs:  [{% for img in addon_popgolf.images %}'{{ img | image_url: width: 120 }}'{% unless forloop.last %},{% endunless %}{% endfor %}]
    }
  };

  var qvOverlay = document.getElementById('sw2-qv-overlay-{{ sid }}');
  var qvPanel   = document.getElementById('sw2-qv-panel-{{ sid }}');
  var qvTitle   = document.getElementById('sw2-qv-title-{{ sid }}');
  var qvDesc    = document.getElementById('sw2-qv-desc-{{ sid }}');
  var qvImg     = document.getElementById('sw2-qv-main-img-{{ sid }}');
  var qvThumbs  = document.getElementById('sw2-qv-thumbs-{{ sid }}');
  var qvPrev    = document.getElementById('sw2-qv-prev-{{ sid }}');
  var qvNext    = document.getElementById('sw2-qv-next-{{ sid }}');
  var qvCount   = document.getElementById('sw2-qv-count-{{ sid }}');
  var qvSale    = document.getElementById('sw2-qv-price-sale-{{ sid }}');
  var qvCompare = document.getElementById('sw2-qv-price-compare-{{ sid }}');
  var qvBadge   = document.getElementById('sw2-qv-price-badge-{{ sid }}');
  var qvBtn     = document.getElementById('sw2-qv-add-{{ sid }}');
  var qvBtnLabel = document.getElementById('sw2-qv-add-label-{{ sid }}');

  var qvCurrentCardId = null;
  var qvImgIdx = 0;

  function sw2QvMoney(c) {
    return '$' + (c / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function sw2QvRenderImg() {
    var d = SW2_QV_DATA[qvCurrentCardId];
    if (!d || !qvImg) return;
    qvImg.style.opacity = '0';
    setTimeout(function () {
      qvImg.src = d.images[qvImgIdx];
      qvImg.style.opacity = '1';
    }, 120);
    if (qvCount) qvCount.textContent = (qvImgIdx + 1) + ' / ' + d.images.length;
    if (qvPrev) qvPrev.classList.toggle('off', qvImgIdx === 0);
    if (qvNext) qvNext.classList.toggle('off', qvImgIdx === d.images.length - 1);
    if (qvThumbs) {
      qvThumbs.querySelectorAll('.sw2-qv-thumb-{{ sid }}').forEach(function (t, i) {
        t.classList.toggle('active', i === qvImgIdx);
      });
    }
  }

  function sw2QvSyncBtn() {
    if (!qvCurrentCardId || !qvBtn) return;
    var card = document.getElementById(qvCurrentCardId);
    var inBundle = card && card.classList.contains('selected');
    if (inBundle) {
      qvBtn.classList.add('in-bundle');
      if (qvBtnLabel) qvBtnLabel.textContent = 'Already in Bundle';
    } else {
      qvBtn.classList.remove('in-bundle');
      if (qvBtnLabel) qvBtnLabel.textContent = 'Add to Bundle';
    }
  }

  window['sw2QvOpen_{{ sid }}'] = function (cardId) {
    var d = SW2_QV_DATA[cardId];
    if (!d || !qvOverlay) return;
    qvCurrentCardId = cardId;
    qvImgIdx = 0;

    if (qvTitle) qvTitle.textContent = d.title;
    if (qvDesc)  qvDesc.innerHTML    = d.desc || '';
    if (qvSale)  qvSale.textContent  = sw2QvMoney(d.price);

    if (d.compare && d.compare > d.price) {
      if (qvCompare) {
        qvCompare.textContent = sw2QvMoney(d.compare);
        qvCompare.style.cssText = 'display:inline;';
      }
      if (qvBadge) {
        var saved = d.compare - d.price;
        qvBadge.textContent = 'SAVE ' + sw2QvMoney(saved);
        qvBadge.style.cssText = 'display:inline-flex;';
      }
    } else {
      if (qvCompare) qvCompare.style.cssText = 'display:none;';
      if (qvBadge)   qvBadge.style.cssText   = 'display:none;';
    }

    if (qvThumbs) {
      qvThumbs.innerHTML = '';
      d.thumbs.forEach(function (t, i) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'sw2-qv-thumb-{{ sid }}' + (i === 0 ? ' active' : '');
        btn.innerHTML = '<img src="' + t + '" alt="">';
        btn.onclick = function () {
          qvImgIdx = i;
          sw2QvRenderImg();
        };
        qvThumbs.appendChild(btn);
      });
    }

    sw2QvRenderImg();
    sw2QvSyncBtn();
    qvOverlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  };

  window['sw2QvClose_{{ sid }}'] = function () {
    if (!qvOverlay) return;
    qvOverlay.style.display = 'none';
    document.body.style.overflow = '';
    qvCurrentCardId = null;

    /* Close any open accordion items */
    if (qvPanel) {
      qvPanel.querySelectorAll('.sw2-qv-acc-{{ sid }}.open').forEach(function (acc) {
        acc.classList.remove('open');
      });
    }
  };

  window['sw2QvNav_{{ sid }}'] = function (delta) {
    var d = SW2_QV_DATA[qvCurrentCardId];
    if (!d) return;
    var next = qvImgIdx + delta;
    if (next < 0 || next > d.images.length - 1) return;
    qvImgIdx = next;
    sw2QvRenderImg();
  };

  window['sw2QvAccToggle_{{ sid }}'] = function (trigger) {
    var item = trigger.parentElement;
    item.classList.toggle('open');
    trigger.setAttribute('aria-expanded', item.classList.contains('open') ? 'true' : 'false');
  };

  window['sw2QvCtaClick_{{ sid }}'] = function () {
    if (!qvCurrentCardId) return;
    if (qvBtn && qvBtn.classList.contains('in-bundle')) return;
    var card = document.getElementById(qvCurrentCardId);
    if (!card) return;
    if (typeof window['sw2ToggleAddon_{{ sid }}'] === 'function') {
      window['sw2ToggleAddon_{{ sid }}'](card);
    }
    setTimeout(function () { sw2QvSyncBtn(); }, 120);
    setTimeout(function () { window['sw2QvClose_{{ sid }}'](); }, 350);
  };

  /* Click outside to close */
  if (qvOverlay) {
    qvOverlay.addEventListener('click', function (e) {
      if (e.target === qvOverlay) window['sw2QvClose_{{ sid }}']();
    });
  }

  /* Keyboard */
  document.addEventListener('keydown', function (e) {
    if (!qvOverlay || qvOverlay.style.display !== 'flex') return;
    if (e.key === 'Escape')     window['sw2QvClose_{{ sid }}']();
    if (e.key === 'ArrowLeft')  window['sw2QvNav_{{ sid }}'](-1);
    if (e.key === 'ArrowRight') window['sw2QvNav_{{ sid }}'](1);
  });

  /* Touch swipe on image */
  var qvTouchX = null;
  var imgWrap  = qvPanel && qvPanel.querySelector('.sw2-qv-img-wrap-{{ sid }}');
  if (imgWrap) {
    imgWrap.addEventListener('touchstart', function (e) { qvTouchX = e.touches[0].clientX; }, { passive: true });
    imgWrap.addEventListener('touchend',   function (e) {
      if (qvTouchX === null) return;
      var dx = e.changedTouches[0].clientX - qvTouchX;
      if (Math.abs(dx) > 50) window['sw2QvNav_{{ sid }}'](dx > 0 ? -1 : 1);
      qvTouchX = null;
    }, { passive: true });
  }
})();
</script>

<script>
(function () {
  /* ──────────────────────────────────────────
     VIDEO REELS — inline + overlay
  ────────────────────────────────────────── */
  var SW2_REELS = [
    { url: 'https://cdn.shopify.com/videos/c/o/v/82b6e4e61510421e8d96ec8939aeb02f.mp4', title: "What's Swaptop?" },
    { url: 'https://cdn.shopify.com/videos/c/o/v/b163bf830556460ba6fa9ac912debc50.mp4', title: "What's Included" },
    { url: 'https://cdn.shopify.com/videos/c/o/v/c093e4799d554399a99542aa17674570.mp4', title: 'Other Tops'    }
  ];

  /* Lazy-load reel videos. We DON'T set src up front — otherwise the browser
     downloads all three clips on page load (heavy). Instead we stash the URL
     and only attach it once the card nears the viewport. */
  var reelCards = document.querySelectorAll('.sw2-section-{{ sid }} .sw2-reel-{{ sid }}');
  reelCards.forEach(function (card, i) {
    var v = card.querySelector('.sw2-reel-video-{{ sid }}');
    if (!v || !SW2_REELS[i]) return;
    v.muted = true;
    v.setAttribute('muted', '');
    v.setAttribute('playsinline', '');
    v.setAttribute('webkit-playsinline', '');
    v.preload = 'none';
    v.dataset.src = SW2_REELS[i].url;
  });

  function sw2LoadReel(v) {
    if (!v || v.src || !v.dataset.src) return;
    v.src = v.dataset.src;
    var p = v.play(); if (p && p.catch) p.catch(function(){});
  }

  /* IntersectionObserver: load + play when (nearly) visible, pause offscreen */
  if ('IntersectionObserver' in window && reelCards.length) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var v = entry.target.querySelector('.sw2-reel-video-{{ sid }}');
        if (!v) return;
        if (entry.isIntersecting) {
          sw2LoadReel(v);
          var p = v.play(); if (p && p.catch) p.catch(function(){});
        } else {
          v.pause();
        }
      });
    }, { root: null, rootMargin: '200px 0px', threshold: 0.1 });
    reelCards.forEach(function (c) { io.observe(c); });
  } else {
    /* No IntersectionObserver support — fall back to loading them directly. */
    reelCards.forEach(function (c) { sw2LoadReel(c.querySelector('.sw2-reel-video-{{ sid }}')); });
  }

  /* Overlay refs */
  var ovEl       = document.getElementById('sw2-reel-overlay-{{ sid }}');
  var ovVideo    = document.getElementById('sw2-reel-video-{{ sid }}');
  var ovTitle    = document.getElementById('sw2-reel-overlay-title-{{ sid }}');
  var ovCounter  = document.getElementById('sw2-reel-counter-{{ sid }}');
  var ovClose    = document.getElementById('sw2-reel-close-{{ sid }}');
  var ovPrev     = document.getElementById('sw2-reel-prev-{{ sid }}');
  var ovNext     = document.getElementById('sw2-reel-next-{{ sid }}');
  var ovMute     = document.getElementById('sw2-reel-mute-{{ sid }}');
  var ovIndex    = 0;

  function sw2OvRender() {
    if (!ovVideo) return;
    var reel = SW2_REELS[ovIndex];
    if (!reel) return;
    ovVideo.src = reel.url;
    ovVideo.muted = false;
    ovVideo.volume = 1;
    if (ovMute) ovMute.classList.remove('is-on');  // is-on class shows speaker (sound on); default state shows muted icon, but volume here is on
    ovVideo.play().catch(function () {
      ovVideo.muted = true;
      if (ovMute) ovMute.classList.add('is-on');
      ovVideo.play().catch(function(){});
    });
    if (ovTitle) ovTitle.textContent = reel.title;
    if (ovCounter) ovCounter.textContent = (ovIndex + 1) + ' / ' + SW2_REELS.length;
    if (ovPrev) ovPrev.disabled = ovIndex === 0;
    if (ovNext) ovNext.disabled = ovIndex === SW2_REELS.length - 1;
  }

  /* Note: when sound is ACTUALLY on, we want speaker icon. When muted, we want muted icon.
     Class .is-on shows the speaker (sound on) icon. So:
     - not muted → add .is-on (speaker icon)
     - muted     → remove .is-on (muted icon) */
  function sw2OvUpdateMuteIcon() {
    if (!ovMute || !ovVideo) return;
    if (ovVideo.muted) ovMute.classList.remove('is-on');
    else                ovMute.classList.add('is-on');
  }

  reelCards.forEach(function (card) {
    var open = function () {
      ovIndex = parseInt(card.dataset.reelIndex, 10) || 0;
      if (!ovEl) return;
      ovEl.classList.add('active');
      document.body.style.overflow = 'hidden';
      sw2OvRender();
      sw2OvUpdateMuteIcon();
    };
    card.addEventListener('click', open);
  });

  function sw2OvClose() {
    if (!ovEl) return;
    ovEl.classList.remove('active');
    document.body.style.overflow = '';
    if (ovVideo) {
      ovVideo.pause();
      try { ovVideo.removeAttribute('src'); ovVideo.load(); } catch (e) {}
    }
  }

  if (ovClose) ovClose.addEventListener('click', sw2OvClose);
  if (ovEl) {
    ovEl.addEventListener('click', function (e) {
      if (e.target === ovEl) sw2OvClose();
    });
  }
  if (ovPrev) ovPrev.addEventListener('click', function () {
    if (ovIndex > 0) { ovIndex--; sw2OvRender(); sw2OvUpdateMuteIcon(); }
  });
  if (ovNext) ovNext.addEventListener('click', function () {
    if (ovIndex < SW2_REELS.length - 1) { ovIndex++; sw2OvRender(); sw2OvUpdateMuteIcon(); }
  });
  if (ovMute) ovMute.addEventListener('click', function () {
    if (!ovVideo) return;
    ovVideo.muted = !ovVideo.muted;
    sw2OvUpdateMuteIcon();
  });

  document.addEventListener('keydown', function (e) {
    if (!ovEl || !ovEl.classList.contains('active')) return;
    if (e.key === 'Escape')     sw2OvClose();
    if (e.key === 'ArrowLeft' && ovIndex > 0)                       { ovIndex--; sw2OvRender(); sw2OvUpdateMuteIcon(); }
    if (e.key === 'ArrowRight' && ovIndex < SW2_REELS.length - 1)   { ovIndex++; sw2OvRender(); sw2OvUpdateMuteIcon(); }
  });

  /* Touch swipe on overlay */
  var ovTouchX = null;
  if (ovEl) {
    ovEl.addEventListener('touchstart', function (e) { ovTouchX = e.touches[0].clientX; }, { passive: true });
    ovEl.addEventListener('touchend',   function (e) {
      if (ovTouchX === null) return;
      var dx = e.changedTouches[0].clientX - ovTouchX;
      if (Math.abs(dx) > 60) {
        if (dx < 0 && ovIndex < SW2_REELS.length - 1) { ovIndex++; sw2OvRender(); sw2OvUpdateMuteIcon(); }
        if (dx > 0 && ovIndex > 0)                    { ovIndex--; sw2OvRender(); sw2OvUpdateMuteIcon(); }
      }
      ovTouchX = null;
    }, { passive: true });
  }
})();
</script>

<script>
(function () {
  /* ──────────────────────────────────────────
     CART POLLING — keeps UI in sync if user
     edits cart in another tab/drawer
  ────────────────────────────────────────── */
  var SW2_LAST_FP = '';

  function sw2PollCart() {
    fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
      var fp = cart.items.map(function (i) { return i.variant_id + ':' + i.quantity; }).sort().join('|');
      if (fp === SW2_LAST_FP) return;
      SW2_LAST_FP = fp;

      var inCart = cart.items.map(function (i) { return i.variant_id; });
      document.querySelectorAll('.sw2-section-{{ sid }} .sw2-card-{{ sid }}:not(.locked)').forEach(function (card) {
        var v = parseInt(card.dataset.variant, 10);
        if (!v) return;
        var should = inCart.indexOf(v) !== -1;
        if (card.classList.contains('selected') !== should) {
          card.classList.toggle('selected', should);
        }
      });

      /* Recompute total + pills */
      if (typeof window.dispatchEvent === 'function') {
        document.dispatchEvent(new CustomEvent('sw2:cartUpdated-{{ sid }}'));
      }
    }).catch(function () {});
  }

  /* Initial sync after section JS loaded */
  setTimeout(sw2PollCart, 600);
  setInterval(sw2PollCart, 2500);

  /* When poller updates classes, retrigger total + pills via the public hooks */
  document.addEventListener('sw2:cartUpdated-{{ sid }}', function () {
    /* Manually refire by dispatching click-equivalent: simplest is a small DOM walk */
    var totalEl = document.getElementById('sw2-total-{{ sid }}');
    if (!totalEl) return;
    var basePrice   = {{ main_product.price }};
    var baseCompare = {{ main_product.compare_at_price | default: main_product.price }};
    var total = basePrice;
    var compare = baseCompare;
    document.querySelectorAll('.sw2-card-{{ sid }}:not(.locked).selected').forEach(function (card) {
      var p = parseInt(card.dataset.price,   10) || 0;
      var c = parseInt(card.dataset.compare, 10) || 0;
      total   += p;
      compare += (c > 0 ? c : p);
    });
    totalEl.textContent = '$' + (total / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    var saved = compare - total;
    var compareEl = document.getElementById('sw2-total-compare-{{ sid }}');
    if (saved > 0) {
      if (compareEl) { compareEl.textContent = '$' + (compare / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); compareEl.style.cssText = 'display:inline;'; }
    } else {
      if (compareEl) compareEl.style.cssText = 'display:none;';
    }

    /* Rebuild pills */
    var kitPillsEl = document.getElementById('sw2-kit-pills-{{ sid }}');
    if (!kitPillsEl) return;
    var SW2_PILL_DATA_LOCAL = {
      'sw2-card-football-{{ sid }}': { name: '{{ addon_football.title | escape }}', img: '{{ addon_football.featured_image | image_url: width: 100 }}' },
      'sw2-card-og-{{ sid }}':       { name: '{{ addon_og.title | escape }}',       img: '{{ addon_og.featured_image | image_url: width: 100 }}' },
      'sw2-card-popgolf-{{ sid }}':  { name: '{{ addon_popgolf.title | escape }}',  img: '{{ addon_popgolf.featured_image | image_url: width: 100 }}' }
    };
    var html =
      '<span class="sw2-kit-pill-{{ sid }}">' +
        '<span class="sw2-kit-pill-img-{{ sid }}">' +
          '<img src="{{ main_product.featured_image | image_url: width: 100 }}" alt="">' +
        '</span>Frame</span>';
    document.querySelectorAll('.sw2-card-{{ sid }}.selected:not(.locked)').forEach(function (card) {
      var d = SW2_PILL_DATA_LOCAL[card.id];
      if (!d) return;
      html += '<span class="sw2-kit-plus-{{ sid }}">+</span>';
      html += '<span class="sw2-kit-pill-{{ sid }}">' +
                '<span class="sw2-kit-pill-img-{{ sid }}">' +
                  '<img src="' + d.img + '" alt="">' +
                '</span>' + d.name.split(' ')[0] + '</span>';
    });
    kitPillsEl.innerHTML = html;
  });
})();
</script>

