        <span class="sw2-stat-label-{{ sid }}">17 Reviews</span>
      </div>
      <div class="sw2-stat-{{ sid }}">
        <span class="sw2-stat-num-{{ sid }} is-accent">10s</span>
        <span class="sw2-stat-label-{{ sid }}">Swap Time</span>
      </div>
    </div>

    <!-- ── BUNDLE LAYOUT ── -->
