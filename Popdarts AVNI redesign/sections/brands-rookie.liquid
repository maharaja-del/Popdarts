{% comment %}
  As Seen On — Infinite Marquee Section
  Drop into: sections/as-seen-on.liquid
  { "type": "as-seen-on" }
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;700&display=swap');

  :root {
    --aso-bg: #000000;
    --aso-green: #23FF53;
    --aso-white: #ffffff;
  }

  .aso-section {
    background: var(--aso-bg);
    padding: 64px 0 72px;
    position: relative;
    overflow: hidden;
  }

  .aso-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  /* ── HEADER ── */
  .aso-header {
    position: relative;
    z-index: 1;
    text-align: center;
    margin-bottom: 52px;
    padding: 0 20px;
  }

  .aso-eyebrow {
    display: none !important;
  }

  .aso-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(44px, 8vw, 80px);
    color: var(--aso-white);
    margin: 0;
    line-height: 0.95;
    letter-spacing: 0.02em;
  }

  .aso-title span {
    color: var(--aso-green);
  }

  .aso-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: rgba(255,255,255,0.45);
    margin: 12px 0 0;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  /* ── TICKER ── */
  .aso-ticker-outer {
    position: relative;
    z-index: 1;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }

  .aso-ticker-outer::before,
  .aso-ticker-outer::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 160px;
    z-index: 2;
    pointer-events: none;
  }

  .aso-ticker-outer::before {
    left: 0;
    background: linear-gradient(to right, #000 0%, transparent 100%);
  }

  .aso-ticker-outer::after {
    right: 0;
    background: linear-gradient(to left, #000 0%, transparent 100%);
  }

  .aso-ticker-bar {
    border-top: 1px solid rgba(35,255,83,0.2);
    border-bottom: 1px solid rgba(35,255,83,0.2);
    padding: 28px 0;
  }

  .aso-ticker-track {
    display: flex;
    width: max-content;
    animation: aso-scroll 40s linear infinite;
  }

  .aso-ticker-track:hover {
    animation-play-state: paused;
  }

  @keyframes aso-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .aso-ticker-set {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* ── LOGO ITEM ── */
  .aso-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 52px;
    position: relative;
    transition: opacity 0.3s;
  }

  .aso-item::after {
    content: '✦';
    position: absolute;
    right: -2px;
    font-size: 10px;
    color: var(--aso-green);
    opacity: 0.5;
  }

  .aso-ticker-track:hover .aso-item {
    opacity: 0.4;
  }

  .aso-ticker-track:hover .aso-item:hover {
    opacity: 1;
  }

  /* ── LOGO IMAGES ── */
  .aso-logo-img {
    height: 48px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    display: block;
    transition: filter 0.3s, transform 0.3s;
  }

  .aso-item:hover .aso-logo-img {
    filter: drop-shadow(0 0 10px rgba(35,255,83,0.4));
    transform: scale(1.06);
  }

  /* ── STATS (hidden) ── */
  .aso-stats {
    display: none !important;
  }

  @media (max-width: 640px) {
    .aso-section  { padding: 48px 0 56px; }
    .aso-item     { padding: 0 32px; }

    .aso-ticker-outer::before,
    .aso-ticker-outer::after { width: 60px; }

    .aso-logo-img { height: 36px; }
  }
</style>

