<script>
(function() {
  var SID = '{{ section.id }}';

  function loadSwiper(cb) {
    if (window.Swiper) { cb(); return; }
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/swiper@8.4.7/swiper-bundle.min.js';
    s.onload = cb;
    document.head.appendChild(s);
  }

  function init(sectionId) {
    var el = document.querySelector('.sv-slider-' + sectionId);
    if (!el) return;
    el.classList.remove('preview');

    var slider = new Swiper('.sv-slider-' + sectionId, {
      speed: 340,
      breakpoints: {
        320:  { spaceBetween: 14, slidesPerView: 1.18 },
        560:  { spaceBetween: 16, slidesPerView: 2.1 },
        1024: { spaceBetween: 18, slidesPerView: 3 }
      }
    });

    var modal    = document.querySelector('.sv-modal-' + sectionId);
    var closeBtn = document.querySelector('.sv-modal-close-' + sectionId);

    var slider2 = new Swiper('.sv-modal-slider-' + sectionId, {
      speed: 300, slidesPerView: 1, spaceBetween: 0, allowTouchMove: false,
      navigation: {
        nextEl: '.sv-modal-next-' + sectionId,
        prevEl: '.sv-modal-prev-' + sectionId
      },
      on: {
        slideChange: function() {
          this.slides.forEach(function(slide, i) {
            var v = slide.querySelector('video');
            if (!v) return;
            if (i === this.activeIndex) { v.play(); v.muted = false; }
            else v.pause();
          }, this);
        }
      }
    });

    /* Lazy load + autoplay on scroll */
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        var v = e.target;
        if (!v.dataset.src) return;
        if (e.isIntersecting) {
          if (!v.src || v.src === location.href) { v.src = v.dataset.src; v.load(); }
          v.play().catch(function(){});
        } else { v.pause(); }
      });
    }, { threshold: 0.2 });

    document.querySelectorAll('.sv-slider-' + sectionId + ' video').forEach(function(v) {
      obs.observe(v);
    });

    /* Open modal on card click */
    document.querySelectorAll('.sv-video-wrap-' + sectionId).forEach(function(wrap, i) {
      wrap.addEventListener('click', function(e) {
        if (e.target.id !== sectionId) return;
        slider2.slideTo(i);
        setTimeout(function() {
          document.body.style.overflow = 'hidden';
          modal.classList.add('active');
          var v = slider2.slides[i] && slider2.slides[i].querySelector('video');
          if (v) {
            if (v.dataset.src && (!v.src || v.src === location.href)) { v.src = v.dataset.src; v.load(); }
            v.play(); v.muted = false;
          }
        }, 160);
      });
    });

    /* Close modal */
    function closeModal() {
      document.body.style.overflow = '';
      modal.classList.remove('active');
      modal.querySelectorAll('video').forEach(function(v) { v.pause(); });
    }
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });

    /* Mute toggles in modal */
    document.querySelectorAll('.sv-modal-mute-btn-' + sectionId).forEach(function(btn) {
      btn.addEventListener('click', function() {
        btn.classList.toggle('active');
        var v = btn.closest('.sv-modal-video-' + sectionId).querySelector('video');
        if (v) v.muted = !btn.classList.contains('active');
      });
    });

    /* Add to cart — slider buttons */
    [
      ['sv-form-1-' + sectionId, '[data-shoppable-button--1]'],
      ['sv-form-2-' + sectionId, '[data-shoppable-button--2]'],
      ['sv-form-3-' + sectionId, '[data-shoppable-button--3]']
    ].forEach(function(pair) {
      var form = document.getElementById(pair[0]);
      var btn  = document.querySelector(pair[1]);
      if (!form || !btn) return;
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        await fetch('/cart/add.js', { method: 'POST', body: new FormData(form) });
        var bubble = document.querySelector('.cart-count-bubble span');
        if (bubble) bubble.textContent = (parseInt(bubble.textContent) || 0) + 1;
        btn.textContent = '✓ Added';
        setTimeout(function() { btn.textContent = 'Add to Cart'; }, 2000);
      });
    });

    /* Add to cart — modal buttons */
    [
      ['sv-modal-form-1-' + sectionId, '[data-shoppable-modal-button--1]'],
      ['sv-modal-form-2-' + sectionId, '[data-shoppable-modal-button--2]'],
      ['sv-modal-form-3-' + sectionId, '[data-shoppable-modal-button--3]']
    ].forEach(function(pair) {
      var form = document.getElementById(pair[0]);
      var btn  = document.querySelector(pair[1]);
      if (!form || !btn) return;
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        await fetch('/cart/add.js', { method: 'POST', body: new FormData(form) });
        var bubble = document.querySelector('.cart-count-bubble span');
        if (bubble) bubble.textContent = (parseInt(bubble.textContent) || 0) + 1;
        btn.textContent = '✓ Added';
        setTimeout(function() { btn.textContent = 'Add To Cart'; }, 2000);
      });
    });
  }

  function boot() {
    loadSwiper(function() { init(SID); });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', boot)
    : boot();

  if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.querySelector('.sv-' + SID)) {
        loadSwiper(function() { init(e.detail.sectionId); });
      }
    });
  }
})();
</script>

