<section class="pd-page competition" id="competition-{{ section.id }}" aria-labelledby="competition-title-{{ section.id }}">
  <div class="pd-wrap pd-wrap--bleed">
    <div class="pd-wrap">
      <div class="competition__head">
        <h2 id="competition-title-{{ section.id }}">
          <span class="c-green" style="color: #17c440;">{{ section.settings.heading_part1 | default: 'Over 1 Billion Views.' }}</span><br>
          <span class="c-red" style="color: #ff3f3f;">{{ section.settings.heading_espn | default: 'ESPN' }}</span>
          <span class="c-blue" style="color: #2b99ff;">{{ section.settings.heading_part2 | default: 'Tournament.' }}</span>
        </h2>
      </div>
    </div>

    <div class="slider" data-slider aria-roledescription="carousel" aria-label="Popdarts gameplay and community moments">
      <div class="slider__track" data-slider-track tabindex="0" role="group" aria-label="Slides">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}
            <article class="slide slide--story" {{ block.shopify_attributes }}>
              <video class="slide__media" src="{{ block.settings.video_url | default: 'https://cdn.shopify.com/videos/c/o/v/95bbe2abdb884992a8241d2f4dc69f0f.mp4' }}" muted loop playsinline preload="metadata" data-slide-video aria-label="{{ block.settings.label | escape }}"></video>
              <button class="slide__play" type="button" data-slide-playbtn aria-label="Play video">▶</button>
            </article>
          {%- elsif block.type == 'photo' -%}
            <article class="slide slide--story slide--photo" {{ block.shopify_attributes }}>
              <img class="slide__media" src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 800 }}{% elsif block.settings.fallback_url != blank %}{{ block.settings.fallback_url }}{% else %}{{ block.settings.asset_filename | asset_url }}{% endif %}" alt="{{ block.settings.label | escape }}" loading="lazy">
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="slider__controls">
        <button class="slider__arrow" type="button" data-slider-prev aria-label="Previous slide">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="slider__arrow" type="button" data-slider-next aria-label="Next slide">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    <div class="pd-wrap competition__cta">
      <a class="btn btn--primary btn--lg" href="{{ section.settings.cta_link | default: '/products/pro-pack' }}">{{ section.settings.cta_text | default: 'Get Your Pro Pack' }}</a>
    </div>

    <div class="pd-wrap competition__reviews">
      <p class="home-reviews__eyebrow">{{ section.settings.reviews_heading | default: 'What Players Are Saying' }}</p>
      <div class="quote-carousel">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="quote-slide" {{ block.shopify_attributes }}>
              <div class="quote-slide__stars" aria-hidden="true">
                {%- for i in (1..5) -%}{%- if i <= block.settings.rating -%}&#9733;{%- else -%}&#9734;{%- endif -%}{%- endfor -%}
              </div>
              <p class="quote-slide__text">&ldquo;{{ block.settings.quote | default: 'Great game for the whole family.' }}&rdquo;</p>
              <p class="quote-slide__name">{{ block.settings.reviewer | default: 'Verified Buyer' }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
