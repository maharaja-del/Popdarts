  "name": "VS Comparison",
  "settings": [
    {"type":"image_picker","id":"traditional_img","label":"Traditional Games Image"},
    {"type":"image_picker","id":"popdarts_img","label":"POPDARTS SWAPTOP Image"},
    {
      "type":"text",
      "id":"variant_id",
      "label":"Swaptop Kit Variant ID",
      "info":"Optional. Paste the exact variant ID. If blank, auto-discovers from the product handle 'swaptop-kit'."
    }
  ],
  "presets":[{"name":"VS Comparison"}]
}
{% endschema %}
