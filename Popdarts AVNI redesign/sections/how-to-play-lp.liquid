        <p class="vsc-item-text">Only offer one game type</p>
      </div>
      <div class="vr r4 vsc-item">
        <div class="vsc-ico vsc-ico--ok"><div class="vsc-ico-shell">
          <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </div></div>
        <p class="vsc-item-text">Swappable boards with different game play</p>
