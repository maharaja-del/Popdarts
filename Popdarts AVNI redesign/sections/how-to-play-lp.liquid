        <div class="vsc-ico vsc-ico--ok"><div class="vsc-ico-shell">
          <svg viewBox="0 0 24 24"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17" y1="15" x2="9" y2="15"/></svg>
        </div></div>
        <p class="vsc-item-text">Easy to bring &amp; store</p>
      </div>

      <!-- ROW 4 — Item 2 -->
      <div class="vl r4 vsc-item">
        <div class="vsc-ico vsc-ico--x"><div class="vsc-ico-shell">
