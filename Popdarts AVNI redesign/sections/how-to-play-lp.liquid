      <!-- ROW 5 — Item 3 -->
      <div class="vl r5 vsc-item">
        <div class="vsc-ico vsc-ico--x"><div class="vsc-ico-shell">
          <svg viewBox="0 0 24 24"><path d="M20 17.58A5 5 0 0 0 18 8h-1.26A8 8 0 1 0 4 16.25"/><line x1="8" y1="19" x2="8" y2="21"/><line x1="12" y1="19" x2="12" y2="21"/><line x1="16" y1="19" x2="16" y2="21"/></svg>
        </div></div>
        <p class="vsc-item-text">Only made for indoor or outdoor play</p>
      </div>
      <div class="vr r5 vsc-item">
        <div class="vsc-ico vsc-ico--ok"><div class="vsc-ico-shell">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </div></div>
        <p class="vsc-item-text">Great for indoors or outdoors</p>
      </div>

    </div>

    <!-- ── CTA ── -->
    <div class="vsc-cta-wrap">
      <button class="vsc-cta" id="vsc-add-btn" aria-label="Add Swaptop Kit to cart">
        <span class="vsc-cta__icon">
          <svg viewBox="0 0 24 24">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
        </span>
        <span class="vsc-cta__label">Add Swaptop Kit to Cart</span>
      </button>
      <span class="vsc-cta-note">Free shipping in the USA &nbsp;·&nbsp; Free gift card over $210</span>
    </div>

  </div>
</section>

<script>
(function(){
  var split = document.querySelector('.vsc-split');
  var items = document.querySelectorAll('.vsc-item');

  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting) return;
      e.target.classList.add('vsc-in');
      obs.unobserve(e.target);
    });
  },{threshold:0.08, rootMargin:'0px 0px -32px 0px'});

  if(split) obs.observe(split);

  var iObs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting) return;
      var el = e.target;
      setTimeout(function(){ el.classList.add('vsc-item-in'); }, parseInt(el.dataset.idx) * 80);
      iObs.unobserve(el);
    });
  },{threshold:0.1});

  items.forEach(function(el, i){ el.dataset.idx = i; iObs.observe(el); });

  /* ── Add to Cart ── */
  var btn = document.getElementById('vsc-add-btn');
  var label = btn && btn.querySelector('.vsc-cta__label');
  if(!btn) return;

  function openCart(){
    document.dispatchEvent(new CustomEvent('cart:open'));
    document.dispatchEvent(new CustomEvent('theme:cart:open'));
    var d = document.querySelector('cart-drawer');
    if(d && typeof d.open==='function') d.open();
  }

  function doAdd(vid){
    btn.classList.add('is-loading');
    label.textContent = 'Adding…';
    fetch('/cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({id:vid, quantity:1})
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.classList.remove('is-loading');
      if(data.id){
        btn.classList.add('is-added');
        label.textContent = '✓ Added to Cart!';
        openCart();
        setTimeout(function(){
          btn.classList.remove('is-added');
          label.textContent = 'Add Swaptop Kit to Cart';
        }, 3000);
      } else {
        label.textContent = 'Try Again';
        setTimeout(function(){ label.textContent = 'Add Swaptop Kit to Cart'; }, 2000);
      }
    })
    .catch(function(){
      btn.classList.remove('is-loading');
      label.textContent = 'Error — Try Again';
      setTimeout(function(){ label.textContent = 'Add Swaptop Kit to Cart'; }, 2000);
    });
  }

  btn.addEventListener('click', function(){
    if(btn.classList.contains('is-loading') || btn.classList.contains('is-added')) return;
    var vid = {{ section.settings.variant_id | default: 'null' }};
    if(vid){
      doAdd(vid);
    } else {
      fetch('/products/swaptop-kit.js')
        .then(function(r){ return r.json(); })
        .then(function(p){
          var id = p.variants && p.variants[0] && p.variants[0].id;
          if(id){ doAdd(id); }
          else {
            label.textContent = 'Product Not Found';
            setTimeout(function(){ label.textContent = 'Add Swaptop Kit to Cart'; }, 2000);
          }
        })
        .catch(function(){
          btn.classList.remove('is-loading');
          label.textContent = 'Error — Try Again';
          setTimeout(function(){ label.textContent = 'Add Swaptop Kit to Cart'; }, 2000);
        });
    }
  });
})();
</script>

