{% render 'halloween-lp-head' %}
{%- assign fallback = section.settings.cta_fallback | default: '/products/pro-pack' -%}
<div class="hw hw-sticky" data-hw-sticky>
  <div class="hw-sticky__inner">
    <span class="hw-sticky__thumb"><img src="{{ 'pd-hw-dart-6.png' | asset_url }}" alt="" width="935" height="1000" loading="lazy"></span>
    <span class="hw-sticky__info">
      <span class="hw-sticky__name">{{ section.settings.name }}</span>
      <span class="hw-sticky__price">{{ section.settings.price_line }}</span>
    </span>
    <a class="hw-btn hw-sticky__btn" href="{{ fallback }}" data-hw-atc data-variant-id="{{ section.settings.variant_id }}">{{ section.settings.cta_label }}</a>
  </div>
</div>

{% schema %}
{
  "name": "HW Sticky Add To Cart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "name", "label": "Product name", "default": "Halloween Pro Pack" },
    { "type": "text", "id": "price_line", "label": "Price line", "default": "$39.99 · Limited run" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "variant_id", "label": "Halloween variant ID", "info": "Leave empty to link to the product page instead." },
    { "type": "text", "id": "cta_fallback", "label": "Button fallback link", "default": "/products/pro-pack" }
  ],
  "presets": [{ "name": "HW Sticky Add To Cart" }]
}
{% endschema %}
