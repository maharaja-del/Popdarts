<section class="pd-page home-showcase" id="home-showcase-{{ section.id }}" aria-labelledby="home-showcase-title-{{ section.id }}">
  <div class="pd-wrap">
    <div class="home-showcase__head">
      <p class="home-showcase__eyebrow">{{ section.settings.eyebrow | default: 'Shop by Collection' }}</p>
      <h2 id="home-showcase-title-{{ section.id }}" style="color: #0a0c10 !important;">{{ section.settings.heading | default: 'Find your pack.' }}</h2>
    </div>

    <div class="home-showcase__grid">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign has_collection = false -%}
        {%- if c != blank and c.title != blank -%}{%- assign has_collection = true -%}{%- endif -%}
        <a class="showcase-tile" href="{% if has_collection %}{{ c.url }}{% elsif block.settings.fallback_link != blank %}{{ block.settings.fallback_link }}{% else %}/collections/all{% endif %}" {{ block.shopify_attributes }}>
          <div class="showcase-tile__media">
            {%- if has_collection and c.featured_image -%}
              <img src="{{ c.featured_image | image_url: width: 700 }}" alt="{{ c.title | escape }}" loading="lazy">
            {%- elsif block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- elsif block.settings.fallback_image_url != blank -%}
              <img src="{{ block.settings.fallback_image_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- elsif block.settings.asset_filename != blank -%}
              <img src="{{ block.settings.asset_filename | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- else -%}
              <img src="https://cdn.shopify.com/s/files/1/0471/3375/3505/files/FlyingV-USA.jpg" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="showcase-tile__body">
            <span class="showcase-tile__title">{% if has_collection %}{{ c.title }}{% elsif block.settings.title != blank %}{{ block.settings.title }}{% else %}Pro Pack{% endif %}</span>
            <span class="showcase-tile__cta">
              Shop
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12h14m0 0-6-6m6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home Showcase (Light)",
  "tag": "section",
  "class": "pd-section-home-showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your pack."
    }
  ],
  "blocks": [
    {
      "type": "collection_tile",
      "name": "Collection tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "If left empty, the fallback fields below are used."
        },
        { "type": "image_picker", "id": "image", "label": "Fallback image" },
        { "type": "url", "id": "fallback_image_url", "label": "Fallback image URL" },
        { "type": "text", "id": "asset_filename", "label": "Bundled theme asset filename", "info": "Used only if Image and Fallback image URL are both empty, e.g. pd-why-target-macro.jpg" },
        { "type": "text", "id": "title", "label": "Fallback title", "default": "Pro Pack" },
        { "type": "url", "id": "fallback_link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Showcase (Light)",
      "blocks": [
        { "type": "collection_tile", "settings": { "title": "Rookie Pack", "fallback_image_url": "https://cdn.shopify.com/s/files/1/0471/3375/3505/files/FlyingV-USA.jpg", "fallback_link": "/collections/rookie-pack" } },
        { "type": "collection_tile", "settings": { "title": "Pro Pack", "fallback_image_url": "https://cdn.shopify.com/s/files/1/0471/3375/3505/files/FlyingV-USA.jpg", "fallback_link": "/collections/pro-pack" } },
        { "type": "collection_tile", "settings": { "title": "Swaptop", "fallback_image_url": "https://popdartsgame.com/cdn/shop/files/SwapTopKitHero.jpg?v=1763652488&width=1200", "fallback_link": "/collections/swaptop" } }
      ]
    }
  ]
}
{% endschema %}
