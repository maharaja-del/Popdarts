{%- liquid
  assign swatch_file_extension = 'png'
  assign swatch_count = 0
-%}
{%- for option in product.options_with_values -%}
  {%- liquid
    assign option_index = forloop.index0
    assign value = ''
    assign max_swatch_count = settings.pcard_maximum_swatches_to_show
    assign show_all_swatches = settings.pcard_show_all_color_swatches
  -%}
  <div class="product-card__swatches flex flex-wrap items-center gap-2">
    <ul class="swatches swatches--product-card flex items-center{% if settings.pcard_swatches_type == 'variant_image' %} swatches--variant-image{% endif %}{% if product.variants.size < 4 %} no-variant-overflow{% endif %}">
      {%- for variant in product.variants -%}
        {%- liquid
          assign value = variant.options[option_index]
        -%}
        {%- unless values contains value -%}
          {%- liquid
            assign values = values | join: ',' | append: ',' | append: value | split: ','
            assign swatch_count = swatch_count | plus: 1
            assign swatch_title = product.title | append: ' - ' | append: value
            assign swatch_url = variant.url
            assign image_url = variant.featured_image.src

            assign swatch = blank
            if value.swatch != blank
              assign swatch = value.swatch
            endif

            if settings.pcard_swatches_type == 'variant_image' and variant.image
              assign swatch = variant
            endif

            assign swatches = swatch
            if settings.pcard_swatches_type == 'color_swatch'
              assign swatches = ''
            endif
          -%}
          {%- if swatch_count <= max_swatch_count or show_all_swatches == true -%}
            <li data-tooltip>
              {%- render 'swatch',
                href: swatch_url,
                title: swatch_title,
                value: value,
                file_extension: swatch_file_extension,
                swatch: swatches,
                tooltip: value,
                hover: true,
                productId: productId,
                image_url: image_url
              -%}
            </li>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </ul>
    {%- if swatch_count > max_swatch_count and show_all_swatches == false  -%}
      <a
        href="{{ product.url }}"
        class="reversed-link"
        aria-controls="{{ quick_view_modal_id }}"
        aria-expanded="false"
        >+{{ swatch_count | minus: max_swatch_count -}}
      </a>
    {%- endif -%}
  </div>
{%- endfor -%}
