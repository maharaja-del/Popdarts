{% layout none %}<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"
 xmlns:g="http://base.google.com/ns/1.0"
 xmlns:atom="http://www.w3.org/2005/Atom">

<channel>
  <title>{{ shop.name | escape }}</title>
  <description>Product Feed for Facebook</description>
  <link>{{ shop.url }}</link>

  <atom:link href="{{ shop.url }}/pages/facebook-feed" rel="self" type="application/rss+xml" />

  {% assign currency = shop.currency %}

  {% paginate collections.all.products by 250 %}
    {% for product in collections.all.products %}
      {% for variant in product.variants %}

        {% assign price = variant.price | money_without_currency | remove: ',' %}
        {% assign compare_price = variant.compare_at_price | money_without_currency | remove: ',' %}

        <item>
          <g:item_group_id>{{ product.id }}</g:item_group_id>

          {% if variant.barcode %}
            <g:gtin>{{ variant.barcode }}</g:gtin>
          {% endif %}

          <g:google_product_category>
            Sporting Goods
          </g:google_product_category>

          <g:id>{{ variant.id }}</g:id>

          <g:title><![CDATA[
            {{ product.title }}{% unless variant.title == "Default Title" %} - {{ variant.title }}{% endunless %}
          ]]></g:title>

          <g:description><![CDATA[
            {{ product.description | strip_html | truncate: 5000 }}
          ]]></g:description>

          <g:link>{{ shop.url }}/products/{{ product.handle }}?variant={{ variant.id }}</g:link>

          {% if variant.image %}
            <g:image_link>https:{{ variant.image | image_url: width: 1200 | escape }}</g:image_link>
          {% else %}
            <g:image_link>https:{{ product.featured_image | image_url: width: 1200 | escape }}</g:image_link>
          {% endif %}

          {%- comment -%} Additional images {%- endcomment -%}
          {% for image in product.images limit: 3 %}
            <additional_image_link>
              https:{{ image | image_url: width: 1200 | escape }}
            </additional_image_link>
          {% endfor %}

          {% if variant.option1 and variant.option1 != 'Default Title' %}
            <color>{{ variant.option1 | escape }}</color>
          {% endif %}

          <g:brand><![CDATA[{{ product.vendor }}]]></g:brand>
          <g:condition>New</g:condition>

          <g:availability>
            {% if variant.available %}in stock{% else %}out of stock{% endif %}
          </g:availability>

          {% if variant.compare_at_price and variant.compare_at_price > variant.price %}
            <g:price>{{ compare_price }} {{ currency }}</g:price>
            <g:sale_price>{{ price }} {{ currency }}</g:sale_price>
          {% else %}
            <g:price>{{ price }} {{ currency }}</g:price>
          {% endif %}

        </item>

      {% endfor %}
    {% endfor %}
  {% endpaginate %}

</channel>
</rss>